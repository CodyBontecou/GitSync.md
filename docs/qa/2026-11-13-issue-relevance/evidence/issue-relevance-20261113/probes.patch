+    @MainActor
+    func testIssueAudit40UnavailableBookmarkPreservesClonedStateDuringRefresh() throws {
+        let fixture = try GitFixtureFactory.make(state: .clean)
+        defer { fixture.cleanup() }
+        fixture.repository.hasGitDirectoryValue = false
+        let state = AppState(gitRepositoryFactory: { _ in fixture.repository }, loadPersistedState: false)
+        var config = fixture.repoConfig
+        config.customVaultBookmarkData = Data("invalid synthetic bookmark".utf8)
+        state.repos = [config]
+        XCTAssertFalse(state.hasLocalRepositoryAccess(repoID: config.id))
+        XCTAssertTrue(state.vaultURL(for: config.id).path.hasPrefix("/dev/null/"), "No app-storage fallback")
+        state.validateClonedRepos()
+        XCTAssertEqual(state.repos[0].gitState, config.gitState, "Launch validation must preserve unavailable state")
+        state.detectChanges(repoID: config.id)
+        XCTAssertEqual(state.repos[0].gitState, config.gitState, "Status refresh must preserve unavailable state too")
+    }
