+    @MainActor
+    func testIssueAudit43MarkdownCheckoutAttentionIsNotLFS() async throws {
+        let fixture = try GitFixtureFactory.make(state: .clean)
+        defer { fixture.cleanup() }
+        let newSHA = String(repeating: "d", count: 40)
+        fixture.repository.pullPlanResult = PullPlan(
+            action: .fastForward, branch: "main", localCommitSHA: fixture.repoConfig.gitState.commitSHA,
+            remoteCommitSHA: newSHA, hasLocalChanges: false, aheadBy: 0, behindBy: 1
+        )
+        let attention = PullPostUpdateAttention.checkoutIncomplete(message: "Fixture Markdown checkout incomplete")
+        fixture.repository.pullResult = .success(LocalPullResult(updated: true, newCommitSHA: newSHA, attention: attention))
+        let state = AppState(gitRepositoryFactory: { _ in fixture.repository }, loadPersistedState: false)
+        state.repos = [fixture.repoConfig]
+        let result = await state.pullOnly(repoID: fixture.repoConfig.id, showsProgressDelay: false)
+        XCTAssertEqual(result, .updatedWithAttention(branch: "main", commitSHA: newSHA, attention: attention))
+        XCTAssertEqual(state.repos[0].gitState.commitSHA, newSHA)
+        XCTAssertFalse(state.syncProgress.contains("LFS"), "Ordinary Markdown checkout must not show LFS progress")
+        XCTAssertNotEqual(state.pullOutcomeByRepo[fixture.repoConfig.id]?.kind, .lfsHydrationBlocked)
+    }
