+    // Temporary issue-relevance probes; preserved as an audit patch, not product fixes.
+    @MainActor
+    func testIssueAudit42RefreshAdoptsExternalHEADAndBranch() async throws {
+        let fixture = try GitFixtureFactory.make(state: .clean)
+        defer { fixture.cleanup() }
+        let state = AppState(gitRepositoryFactory: { _ in fixture.repository }, loadPersistedState: false)
+        state.repos = [fixture.repoConfig]
+        let configuredBranch = fixture.repoConfig.branch
+        let newSHA = String(repeating: "e", count: 40)
+        fixture.repository.repoInfoResult = LocalRepoInfo(branch: "external-branch", commitSHA: newSHA, changeCount: 7)
+        state.detectChanges(repoID: fixture.repoConfig.id)
+        for _ in 0..<80 {
+            if state.changeCounts[fixture.repoConfig.id] == 7 { break }
+            try await Task.sleep(for: .milliseconds(25))
+        }
+        XCTAssertEqual(state.changeCounts[fixture.repoConfig.id], 7, "Refresh must actually complete")
+        XCTAssertEqual(state.repos[0].gitState.commitSHA, newSHA, "Displayed HEAD must follow external Git")
+        XCTAssertEqual(state.repos[0].gitState.branch, "external-branch", "Displayed branch must follow external Git")
+        XCTAssertEqual(state.repos[0].branch, configuredBranch, "Configured auto-sync branch must stay unchanged")
+    }
