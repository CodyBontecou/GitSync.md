    <string name="stop_tracking_error_not_tracked">"«%1$s» не отслеживается Git и уже игнорируется."</string>
    <string name="stop_tracking_error_busy" formatted="false">"Дождитесь завершения текущей операции Git."</string>
    <string name="stop_tracking_error_conflicts" formatted="false">"Сначала разрешите конфликты"</string>
