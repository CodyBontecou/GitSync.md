<?xml version="1.0" encoding="utf-8"?>
<!--
  Android data extraction rules (API 31+).

  Gitsync.md is a paid-up-front app, so there is no in-app purchase or
  repository-limit state to preserve. Exclude volatile auth/app state from cloud backup
  and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude auth tokens and volatile app state -->
        <exclude domain="sharedpref" path="sync_md_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Exclude auth tokens and volatile app state -->
        <exclude domain="sharedpref" path="sync_md_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
