# Copy this file to keystore.properties (git-ignored) and fill in real values.
# You can also provide these via environment variables or ~/.gradle/gradle.properties.

# Android release signing
RELEASE_STORE_FILE=/absolute/path/to/your-upload-key.jks
RELEASE_STORE_PASSWORD=change-me
RELEASE_KEY_ALIAS=upload
RELEASE_KEY_PASSWORD=change-me

# Google Play Publisher service account JSON key
# Optional: defaults to ~/.config/play-console/play-publisher-crested-drive-492000-u7.json
PLAY_CONSOLE_KEY_PATH=/absolute/path/to/play-console-key.json
