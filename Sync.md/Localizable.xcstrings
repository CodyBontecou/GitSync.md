    "Changed files and commits to push or pull, without touching the network.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات المتغيرة وعمليات commit المنتظرة لـ push أو pull، دون استخدام الشبكة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrede filer og commits, der skal pushes eller pulles, uden at bruge netværket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geänderte Dateien und Commits zum Pushen oder Pullen, ohne Netzwerkzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos cambiados y commits para enviar o recibir, sin usar la red."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttuneet tiedostot sekä lähetettävät ja haettavat commitit ilman verkkoyhteyttä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers modifiés et commits à envoyer ou récupérer, sans accès réseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים ששונו ו-commits שממתינים ל-push או ל-pull, בלי לגשת לרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदली गई फ़ाइलें और push या pull के लिए commit, नेटवर्क का उपयोग किए बिना।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusholandó vagy pullolandó módosult fájlok és commitok, hálózat használata nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang berubah dan commit untuk di-push atau di-pull, tanpa mengakses jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File modificati e commit da inviare o ricevere, senza usare la rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続せずに、変更されたファイルとプッシュ/プルするコミットを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 접속하지 않고 변경된 파일과 푸시 또는 풀할 커밋을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endrede filer og commits som skal pushes eller pulles, uten å bruke nettverket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewijzigde bestanden en commits om te pushen of pullen, zonder netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienione pliki i commity do push lub pull, bez łączenia z siecią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos alterados e commits para push ou pull, sem acessar a rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменённые файлы и commit для push или pull без обращения к сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrade filer och commits att pusha eller hämta, utan att använda nätverket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่เปลี่ยนและ commit ที่รอ push หรือ pull โดยไม่ใช้เครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push veya pull edilecek değişen dosyalar ve commit'ler, ağa dokunmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінені файли й commit для push або pull без звернення до мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp đã thay đổi và commit cần push hoặc pull, không cần dùng mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示已更改的文件和待推送或拉取的提交，无需联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示已變更的檔案以及待推送或拉取的提交，不需連線。"
          }
        }
      }
    },
