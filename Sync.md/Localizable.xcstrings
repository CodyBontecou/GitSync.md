          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Version, die bleibt, oder behalten Sie beide und räumen Sie danach auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la versión que se queda, o conserva ambas y ordénalo después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse säilytettävä versio tai säilytä molemmat ja siisti jälkikäteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la version à garder, ou gardez les deux et faites le tri après."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את הגרסה לשמירה, או שמרו את שתיהן וסדרו אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखने के लिए वर्शन चुनें, या दोनों रखें और बाद में साफ़ करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki a megtartandó verziót, vagy tartsa meg mindkettőt, és rendezze később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih versi yang disimpan, atau simpan keduanya dan rapikan nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la versione da tenere, oppure tienile entrambe e sistema dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残すバージョンを選ぶか、両方残して後で整理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지할 버전을 선택하거나, 둘 다 유지하고 나중에 정리하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg versjonen som skal beholdes, eller behold begge og rydd opp etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de versie die blijft, of behoud beide en ruim daarna op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wersję do zachowania lub zachowaj obie i uporządkuj później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a versão a manter, ou mantenha ambas e organize depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите версию, которую оставить, или оставьте обе и приберитесь потом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj versionen att behålla, eller behåll båda och städa upp efteråt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเวอร์ชันที่จะเก็บ หรือเก็บทั้งสองแล้วค่อยจัดระเบียบภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutulacak sürümü seçin ya da ikisini de tutup sonra düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть версію, яку залишити, або залиште обидві й наведіть лад потім."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn phiên bản cần giữ, hoặc giữ cả hai và dọn dẹp sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要保留的版本，或两者都保留稍后再整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要保留的版本，或兩者都保留之後再整理。"
          }
        }
      }
    },
