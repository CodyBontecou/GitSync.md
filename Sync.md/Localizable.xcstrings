    "Replay local commits on top of remote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تشغيل الالتزامات المحلية أعلى جهاز التحكم عن بعد\nتنظيف"
          }
        },
        "da": {
          "stringUnit": {
