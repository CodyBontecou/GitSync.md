        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Звідки-небудь було запитано кріденції для HTTPS, але для цього репозиторію не збережено жодного токена чи пароля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hệ thống đã yêu cầu thông tin xác thực HTTPS từ máy chủ từ xa, nhưng không có token hay mật khẩu nào được lưu cho kho dữ liệu này."
          }
