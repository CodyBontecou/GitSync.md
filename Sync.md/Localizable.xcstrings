            "state": "translated",
            "value": "Entfernen Sie alte Repository-Kopien auf dem Gerät direkt aus der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimine las copias antiguas del repositorio del dispositivo directamente desde la aplicación."
