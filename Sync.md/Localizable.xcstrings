    "Could not restore your edits after stashing. They are saved in the stash list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت استعادة تعديلاتك بعد stash. إنها محفوظة في قائمة stash."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gendanne dine ændringer efter stash. De er gemt på stash-listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Änderungen konnten nach dem Stashen nicht wiederhergestellt werden. Sie sind in der Stash-Liste gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar tus cambios tras el stash. Están guardados en la lista de stash."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkauksiasi ei voitu palauttaa kätköön tallentamisen jälkeen. Ne ovat tallessa kätkölistassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer vos modifications après le stash. Elles sont enregistrées dans la liste des stashs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשחזר את העריכות שלכם אחרי ה-stash. הן שמורות ברשימת ה-stash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "stash के बाद आपके संपादन बहाल नहीं हो सके। वे stash सूची में सहेजे गए हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A stash után nem sikerült visszaállítani a módosításait. A stash-listában megtalálhatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memulihkan editan Anda setelah stash. Editan tersimpan di daftar stash."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ripristinare le modifiche dopo lo stash. Sono salvate nell'elenco degli stash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタッシュ後に編集内容を復元できませんでした。編集内容はスタッシュ一覧に保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스태시 후 편집 내용을 복원할 수 없습니다. 편집 내용은 스태시 목록에 저장되어 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gjenopprette endringene dine etter stash. De er lagret i stash-listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw wijzigingen konden na het stashen niet worden hersteld. Ze staan in de stashlijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przywrócić Twoich zmian po stash. Są zapisane na liście stash."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar suas edições após o stash. Elas estão salvas na lista de stashes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить ваши правки после stash. Они сохранены в списке stash."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte återställa dina ändringar efter stash. De finns sparade i stash-listan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนการแก้ไขของคุณหลัง stash ไม่ได้ การแก้ไขถูกบันทึกไว้ในรายการ stash"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash sonrası düzenlemeleriniz geri yüklenemedi. Stash listesinde kayıtlılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити ваші правки після stash. Їх збережено в списку stash."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khôi phục chỉnh sửa của bạn sau khi stash. Chúng đã được lưu trong danh sách stash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "储藏后无法恢复你的编辑。它们已保存在储藏列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲藏後無法恢復你的編輯。它們已儲存在儲藏列表中。"
          }
        }
      }
    },
