    "Deletion is pending. Automatic sync and conflicting relay controls remain disabled until the authenticated removal succeeds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف معلق. المزامنة التلقائية والمتضاربة relay تظل عناصر التحكم معطلة حتى تتم عملية الإزالة المعتمدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletning er på vej. Automatisk synkronisering og konflikter relay Kontrollerne forbliver deaktiverede, indtil den autentificerede fjerning lykkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen ist in Bearbeitung. Automatische Synchronisation und Konflikte relay Die Steuerungselemente bleiben deaktiviert, bis die authentifizierte Entfernung erfolgreich abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación está pendiente. Sincronización automática y conflictos. relay Los controles permanecen desactivados hasta que la eliminación autenticada tenga éxito."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaminen on odotuksessa. Automaattinen synkronointi ja ristiriidat relay Kontrollit pysyvät käyttöönottamattomina, kunnes tunnistettu poistaminen onnistuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression est en attente. Syncro automatique et conflits relay Les contrôles restent désactivés jusqu'à ce que la suppression authentifiée réussisse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने की प्रक्रिया अभी अपेक्षित है। स्वचालित सिंक तथा टकराव relay नियंत्रण तब तक निष्क्रिय रहते हैं जब तक प्रमाणित हटाने की प्रक्रिया सफल नहीं हो जाती।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törölés jelenleg váró állapotban van. Automatikus szinkronizáció és konfliktusok relay A vezérlők kiszűrik, amíg a hitelesített eltávolítás sikeresen nem teljesül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan sedang diproses. Sinkronisasi otomatis dan konflik relay Fitur kontrol tetap tidak aktif sampai proses penghapusan setelah autentikasi berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cancellazione è in attesa. Sincronizzazione automatica e conflitti relay I controlli rimangono disabilitati fino a quando la rimozione autenticata non ha successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除処理が保留中です。自動同期および競合状態があります。 relay 認証済みの削除操作が成功するまで、コントロールは無効状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 작업이 대기 중입니다. 자동 동기화 및 충돌 발생 relay 인증된 제거 작업이 성공할 때까지 제어 기능은 비활성화 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletting er på vente. Automatisk synkronisering og konflikter relay Kontrollene forblir deaktiverte til den autentiserte fjerningen lykkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdering is in behandeling. Automatische synchronisatie en conflicten relay De controles blijven uitgeschakeld tot de geauthentificeerde verwijdering succesvol is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie jest w trakcie обработki. Automatyczna synchronizacja oraz konflikty relay Kontrole pozostają wyłączone do momentu, gdy usunięcie po uwierzytelnieniu zostanie zakończone pomyślnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão está pendente. Sincronização automática e conflitos. relay Os controles permanecem desativados até que a remoção autenticada seja bem-sucedida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление в обработке. Автоматическая синхронизация и конфликты relay Контроллеры остаются недоступными до тех пор, пока удаление объекта с аутентификацией не будет успешно завершено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raväxling är på väg. Automatisk synkronisering och konflikter relay Kontroller förblir inaktiverade tills den autentiserade fjärkörningen lyckas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบข้อมูลยังอยู่ในระหว่างการดำเนินการ — การซิงค์อัตโนมัติและปัญหาความขัดแย้ง relay ระบบควบคุมจะยังไม่สามารถใช้งานได้จนกว่าการลบข้อมูลโดยผ่านการยืนยันตัวตนจะสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme işlemi beklemektedir. Otomatik senkronizasyon ve çakışma relay Kontroller, oturum açılıp kaldırma işlemi başarılı olana kadar devre dışı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення очікується. Автоматична синхронізація та конфлікти relay Контрольні механізми залишаються вимкненими до того часу, поки успішно не завершиться автентифіковане видалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động xóa đang chờ xử lý. Đồng bộ hóa tự động và xung đột relay Các chức năng điều khiển vẫn bị vô hiệu hóa cho đến khi thao tác xóa dữ liệu sau khi xác thực thành công."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחיקה תלויה ועומדת. סינכרון אוטומטי וסתירה relay פקדים נשארים נכים עד שההסרה המאומתת מצליחה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除操作待处理。自动同步与冲突 relay 控制功能在认证后的移除操作成功之前均处于禁用状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除操作待處理。自動同步與衝突 relay 控制功能在認證後的移除操作成功之前均處於禁用狀態。"
          }
        }
      }
    },
