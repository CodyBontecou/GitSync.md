          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק .git שנמצא ישירות בתוך התיקייה שנבחרה מוסר. תיקיות מקומיות ב-iPhone שלי בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल चुने गए फ़ोल्डर के सीधे अंदर का .git हटाया जाता है। केवल मेरे iPhone पर के स्थानीय फ़ोल्डर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a kijelölt mappában közvetlenül lévő .git kerül eltávolításra. Csak helyi Az iPhone-omon mappák."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya .git yang langsung berada di folder terpilih yang dihapus. Hanya folder lokal Di iPhone Saya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimosso solo il .git direttamente nella cartella selezionata. Solo cartelle locali Su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダ直下の .git のみ削除されます。「このiPhone内」のローカルフォルダのみ対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더 바로 안에 있는 .git만 제거됩니다. 나의 iPhone의 로컬 폴더만 해당됩니다."
          }
        },
        "nb": {
