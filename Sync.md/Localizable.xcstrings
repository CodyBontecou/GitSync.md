            "state": "translated",
            "value": ": Quel dépôt devrait-on choisir ? GitSync.md : tirer ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": איזה מאגר יש לבחור? GitSync.md – pulling?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": कौन सा रिपॉजिटरी चुनना चाहिए? GitSync.md पुल?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mely adatmagazinot kell használni? GitSync.md nyomás?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori mana yang harus digunakan? GitSync.md pull?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quale repository si deve GitSync.md : tirare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：どのリポジトリを使用すべきでしょうか？ GitSync.md プル？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 저장소를 사용해야 할까요? GitSync.md 풀 여부?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hvilket lagringsmottaker bør brukes? GitSync.md trekking?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welk repository moet GitSync.md trekken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do jakiego reposituarium należy GitSync.md – wyciąganie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual repositório deve ser usado? GitSync.md puxar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой репозиторий следует использовать? GitSync.md — подтягивание?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilket lagringsplats ska användas? GitSync.md -täckning?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควรเลือก repositori ใด? GitSync.md ดึงหรือไม่?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi depolama sistemi kullanılmalıdır? GitSync.md çekme işlemi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Який репозиторій слід використати? GitSync.md – підтягування?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nên sử dụng kho lưu trữ nào? GitSync.md kéo?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应使用哪个存储库？ GitSync.md 拉力测试？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應使用哪個存儲庫？ GitSync.md 拉力測試？"
          }
        }
      }
    },
