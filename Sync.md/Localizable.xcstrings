    "Sign in as the personal-account owner or an organization owner to connect that installation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول بصفتك مالك الحساب الشخصي أو مالك المؤسسة لربط ذلك التثبيت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind som ejer af den personlige konto eller ejer af en organisation for at forbinde den installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich als Inhaber des persönlichen Kontos oder einer Organisation an, um diese Installation zu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión como propietario de la cuenta personal o de una organización para conectar esa instalación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu henkilökohtaisen tilin omistajana tai organisaation omistajana yhdistääksesi asennuksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous en tant que propriétaire du compte personnel ou d’une organisation pour connecter cette installation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו כבעלים של החשבון האישי או כבעלים של הארגון כדי לחבר את ההתקנה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस इंस्टॉलेशन को कनेक्ट करने के लिए निजी खाते के स्वामी या संगठन के स्वामी के रूप में साइन इन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepítés csatlakoztatásához jelentkezzen be a személyes fiók vagy a szervezet tulajdonosaként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk sebagai pemilik akun pribadi atau pemilik organisasi untuk menghubungkan instalasi tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi come proprietario dell'account personale o di un'organizzazione per collegare quell'installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのインストールを接続するには、個人アカウントのオーナーまたは組織のオーナーとしてサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 설치를 연결하려면 개인 계정 소유자 또는 조직 소유자로 로그인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på som eier av den personlige kontoen eller en organisasjonseier for å koble til den installasjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in als eigenaar van het persoonlijke account of een organisatie om die installatie te koppelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się jako właściciel konta osobistego lub organizacji, aby połączyć tę instalację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre como proprietário da conta pessoal ou da organização para conectar essa instalação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите как владелец личного аккаунта или организации, чтобы подключить эту установку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in som ägaren till det personliga kontot eller en ägare av organisationen för att ansluta den installationen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าในฐานะเจ้าของบัญชีส่วนตัวหรือเจ้าขององค์กรเพื่อเชื่อมต่อการติดตั้งนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumu bağlamak için kişisel hesap sahibi veya kuruluş sahibi olarak oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть як власник особистого облікового запису чи організації, щоб підключити це встановлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập với tư cách chủ sở hữu tài khoản cá nhân hoặc chủ sở hữu tổ chức để kết nối bản cài đặt đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以个人账户所有者或组织所有者身份登录以连接该安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以個人帳號擁有者或組織擁有者身分登入以連接該安裝。"
          }
        }
      }
    },
    "Sign in to GitHub to check this repo.": {
