    "Pull blocked by local changes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حظر السحب بسبب التغييرات المحلية"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk blokeret af lokale ændringer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull durch lokale Änderungen blockiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extracción bloqueada por cambios locales"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallisten muutosten estäminen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull bloqué par les changements locaux"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הפעולה נעצרת עקב שינויים מקומיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्थानीय परिवर्तनों के कारण बाधित हुआ है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": helyi módosítások miatt blokkolva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Pengambilan terhambat akibat perubahan lokal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il pull è bloccato a causa di modifiche locali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカル変更によりプル操作がブロックされました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 지역 변경으로 인해 끌림이 차단됨"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tvinging blokkert av lokale endringer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "wordt geblokkeerd door lokale wijzigingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": pobieranie blokowane przez lokalne zmiany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": A ação de pull foi bloqueada por alterações locais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": операция pull заблокирована из-за локальных изменений"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tvingning blockerad av lokala ändringar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การดึงถูกปิดกั้นเนื่องจากการเปลี่ยนแปลงในระดับท้องถิ่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel değişiklikler nedeniyle bloke edildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Зміна виключена через місцеві зміни"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Vật liệu kéo bị chặn do các thay đổi tại chỗ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：因本地变更而被拉取阻断"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：因本地變更而被拉取阻斷"
          }
        }
      }
    },
    "Pull blocked by local changes. Commit, stash, or discard changes before syncing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حظر السحب بسبب وجود تغييرات محلية. التزم بالتغييرات أو خزّنها مؤقتًا أو تجاهلها قبل المزامنة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull er blokeret af lokale ændringer. Commit, stash eller kassér ændringerne før synkronisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull durch lokale Änderungen blockiert. Committen, stashen oder verwerfen Sie die Änderungen vor der Synchronisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga está bloqueada por cambios locales. Confirme, guarde temporalmente o descarte los cambios antes de sincronizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset muutokset estävät pull-toiminnon. Tee muutoksista commit, siirrä ne stashiin tai hylkää ne ennen synkronointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération est bloquée par des modifications locales. Validez-les, remisez-les ou annulez-les avant la synchronisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשיכה חסומה עקב שינויים מקומיים. יש לבצע קומיט, לשמור בצד או לבטל את השינויים לפני הסנכרון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल बदलावों के कारण पुल अवरुद्ध है। सिंक करने से पहले बदलावों को कमिट, स्टैश या रद्द करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltést helyi módosítások akadályozzák. Szinkronizálás előtt commitolja, tegye félre vagy vesse el a módosításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penarikan terhalang oleh perubahan lokal. Commit, simpan sementara, atau buang perubahan sebelum menyinkronkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pull è bloccato da modifiche locali. Esegui commit o stash, oppure scarta le modifiche prima della sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの変更によりプルできません。同期する前に、変更をコミット、スタッシュ、または破棄してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 변경 사항 때문에 풀할 수 없습니다. 동기화하기 전에 변경 사항을 커밋하거나 스태시하거나 폐기해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull er blokkert av lokale endringer. Commit, stash eller forkast endringene før synkronisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullen is geblokkeerd door lokale wijzigingen. Commit, stash of verwerp de wijzigingen voordat u synchroniseert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja pull jest zablokowana przez lokalne zmiany. Przed synchronizacją wykonaj commit lub stash albo odrzuć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pull foi bloqueado por alterações locais. Faça commit, stash ou descarte as alterações antes de sincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция pull заблокирована локальными изменениями. Перед синхронизацией выполните commit или stash либо отмените изменения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull blockeras av lokala ändringar. Kör commit eller stash, eller släng ändringarna före synkronisering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ pull ถูกขัดขวางโดยการเปลี่ยนแปลงในเครื่อง โปรด commit, stash หรือละทิ้งการเปลี่ยนแปลงก่อนซิงค์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull işlemi yerel değişiklikler nedeniyle engellendi. Eşzamanlamadan önce değişiklikleri commit edin, stash'e alın veya atın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull заблоковано локальними змінами. Перед синхронізацією виконайте commit, stash або відкиньте зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull bị chặn do có thay đổi cục bộ. Hãy commit, stash hoặc hủy các thay đổi trước khi đồng bộ hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地更改阻止了拉取。请在同步前提交、贮藏或丢弃更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機變更阻止了提取。請在同步前提交、暫存或捨棄變更。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Pull blocked to protect local edits. Commit, stash, or discard local changes first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حظر السحب لحماية التعديلات المحلية. قم بتنفيذ التغييرات المحلية أو تخزينها أو تجاهلها أولاً.\nفشل سحب"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk blokeret for at beskytte lokale redigeringer. Begræns, gem eller kasser lokale ændringer først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull blockiert, um lokale Änderungen zu schützen. Lokale Änderungen zuerst festschreiben, speichern oder verwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull bloqueado para proteger las ediciones locales. Confirme, guarde o descarte los cambios locales primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä estää paikallisia muokkauksia. Toimita, piilota tai hylkää paikalliset muutokset ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer bloqué pour protéger les modifications locales. Commit, stash ou rejettent les modifications locales en premier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הפעלת Pull מונעת כדי להגן על השינויים המקומיים – יש לבצע קודם את ה-Commit, ה-stash או ה-discard של השינויים המקומיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्थानीय संपादनों की रक्षा के लिए 'Pull' गेट क्रैश हो जाएगा। पहले 'Commit', 'stash' या 'discard' विकल्प का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": a helyi módosítások védelmére a Pull parancs blokkolása érdekében – először végezze el a helyi módosítások beállítását (commit), tárolását (stash) vagy eltávolítását (discard)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull diblokir untuk melindungi edisi lokal. Lakukan commit, stash, atau discard perubahan lokal terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Il comando 'Pull' è bloccato per proteggere le modifiche locali. Si raccomanda di effettuare prima un commit, uno stash o una discarica delle modifiche locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカル編集を保護するため、プルがブロックされています。まず、コミット、ステ stash、またはディスカインドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬 편집을 보호하기 위해 Pull이 차단됩니다. 먼저 로컬 변경 사항을 커밋, 스타시 또는 드리스하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": «Pull» er blokkert for å beskytte lokale redigeringer. Før du utfører «Commit», «Stash» eller «Discard» av lokale endringer, må du gjøre dette først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De functie 'Pull' is geblokkeerd om lokale wijzigingen te beschermen. Voer eerst een commit-, stash- of discard-opdracht uit voor de lokale wijzigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": „Pull\" jest blokowany w celu ochrony lokalnych modyfikacji. Najpierw zapisz, skryj lub usunьте lokalne zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": A operação de pull está bloqueada para proteger as edições locais. Primeiro, execute um commit, um stash ou um discard das alterações locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": операция pull блокируется для защиты локальных изменений. Сначала выполните коммит, stash или discard локальных изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Pull är blockerat för att skydda lokala redigeringar. Försök först att kommitera, stasha eller avkasta de lokala ändringarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": Pull ถูกบล็อกเพื่อป้องกันการแก้ไขในระดับท้องถิ่น — ควรดำเนินการ Commit, stash หรือ discard การเปลี่ยนแปลงในระดับท้องถิ่นก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel değişiklikleri korumak için çekme işlemi engellenebilir. İlk olarak yerel değişiklikleri onaylayın, saklayın veya atlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": «Pull» заблоковано для захисту локальних змін. Спочатку виконайте дію «Commit», «stash» або «discard» локальних змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác Pull bị chặn để bảo vệ các chỉnh sửa cục bộ. Hãy thực hiện Commit, stash hoặc discard các thay đổi cục bộ trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：拉取操作已受阻，以保护本地编辑。请先提交、暂存或丢弃本地更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：拉取操作已受阻，以保護本地編輯。請先提交、暫存或丟棄本地更改。"
          }
        }
      }
    },
