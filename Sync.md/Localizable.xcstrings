    "No runs yet. iOS will give GitSync.md time soon; opening the app also catches up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا عمليات بعد. سيمنح iOS تطبيق GitSync.md وقتًا قريبًا؛ وفتح التطبيق يلحق بالتحديثات أيضًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kørsler endnu. iOS giver snart GitSync.md tid; når du åbner appen, indhenter den også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Läufe. iOS gibt GitSync.md bald Zeit; auch das Öffnen der App holt alles nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ejecuciones. iOS dará tiempo a GitSync.md pronto; abrir la app también lo pone al día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä ajoja. iOS antaa GitSync.md:lle pian aikaa; sovelluksen avaaminen myös kuroo eron kiinni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune exécution pour l’instant. iOS accordera bientôt du temps à GitSync.md ; ouvrir l’app permet aussi de rattraper le retard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין הרצות. ‏iOS ייתן ל-GitSync.md זמן בקרוב; גם פתיחת היישום משלימה את הפער."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई रन नहीं। iOS जल्द ही GitSync.md को समय देगा; ऐप खोलने से भी सब अपडेट हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek futások. Az iOS hamarosan időt ad a GitSync.md-nek; az app megnyitása is pótolja a lemaradást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada proses. iOS akan segera memberi GitSync.md waktu; membuka app juga mengejar ketertinggalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna esecuzione. iOS darà presto tempo a GitSync.md; anche aprire l'app recupera il ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ実行されていません。iOS がまもなく GitSync.md に時間を割り当てます。アプリを開いても追いつきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 실행 내역이 없습니다. iOS가 곧 GitSync.md에 시간을 할당합니다. 앱을 열어도 따라잡습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kjøringer ennå. iOS gir GitSync.md tid snart; å åpne appen tar også igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen runs. iOS geeft GitSync.md binnenkort tijd; de app openen haalt ook alles in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak uruchomień. iOS wkrótce da GitSync.md czas; otwarcie aplikacji też nadrabia zaległości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma execução ainda. O iOS dará tempo ao GitSync.md em breve; abrir o app também atualiza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запусков пока нет. Скоро iOS выделит GitSync.md время; открытие приложения тоже наверстает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga körningar än. iOS ger snart GitSync.md tid; att öppna appen gör också att den kommer ikapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการทำงาน iOS จะให้เวลา GitSync.md เร็วๆ นี้ การเปิดแอปก็ช่วยตามให้ทันเช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çalıştırma yok. iOS yakında GitSync.md'ye zaman verecek; uygulamayı açmak da eksikleri kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запусків поки немає. Невдовзі iOS виділить GitSync.md час; відкриття застосунку теж надолужує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lượt chạy. iOS sẽ sớm dành thời gian cho GitSync.md; mở ứng dụng cũng giúp bắt kịp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有运行记录。iOS 很快会给 GitSync.md 分配时间；打开 App 也会补上进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有執行記錄。iOS 很快會給 GitSync.md 分配時間；打開 App 也會補上進度。"
          }
        }
      }
    },
