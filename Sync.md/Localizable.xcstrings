    "Open Obsidian in the morning and everything is already there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Obsidian في الصباح وستجد كل شيء جاهزًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Obsidian om morgenen, og alt er der allerede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie morgens Obsidian, und alles ist schon da."
          }
        },
