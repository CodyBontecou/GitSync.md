    "Reconnect the original folder to use this repository. Its saved commit and settings have been preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد ربط المجلد الأصلي لاستخدام هذا المستودع. تم الاحتفاظ بالـ commit المحفوظ والإعدادات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genopret forbindelsen til den oprindelige mappe for at bruge dette repository. Dets gemte commit og indstillinger er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie den ursprünglichen Ordner erneut, um dieses Repository zu verwenden. Gespeicherter Commit und Einstellungen wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectar la carpeta original para usar este repositorio. Su commit guardado y sus ajustes se han conservado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä alkuperäinen kansio uudelleen käyttääksesi tätä tietovarastoa. Sen tallennettu commit ja asetukset on säilytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez le dossier d’origine pour utiliser ce dépôt. Son commit enregistré et ses réglages ont été conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חברו מחדש את התיקייה המקורית כדי להשתמש במאגר הזה. ה-commit השמור וההגדרות שלו נשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिपॉज़िटरी का उपयोग करने के लिए मूल फ़ोल्डर फिर से कनेक्ट करें। इसका सहेजा गया commit और सेटिंग्स सुरक्षित रखी गई हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tároló használatához csatlakoztassa újra az eredeti mappát. A mentett commitját és beállításait megőriztük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan ulang folder asli untuk menggunakan repositori ini. Commit dan pengaturan tersimpannya telah dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricollega la cartella originale per usare questo repository. Il commit salvato e le impostazioni sono stati conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリを使うには、元のフォルダを再接続してください。保存済みのコミットと設定は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소를 사용하려면 원래 폴더를 다시 연결하십시오. 저장된 커밋과 설정은 보존되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til den opprinnelige mappen på nytt for å bruke dette repositoriet. Den lagrede commiten og innstillingene er bevart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind de oorspronkelijke map opnieuw om deze repository te gebruiken. De bewaarde commit en instellingen zijn behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz ponownie oryginalny folder, aby używać tego repozytorium. Jego zapisany commit i ustawienia zostały zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte a pasta original para usar este repositório. O commit salvo e os ajustes foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите исходную папку заново, чтобы использовать этот репозиторий. Его сохранённый commit и настройки сохранены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut originalmappen igen för att använda det här arkivet. Dess sparade commit och inställningar har bevarats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อโฟลเดอร์ต้นฉบับใหม่เพื่อใช้ที่เก็บนี้ commit และการตั้งค่าที่บันทึกไว้ได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depoyu kullanmak için özgün klasörü yeniden bağlayın. Kaydedilen commit'i ve ayarları korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть початкову папку знову, щоб використовувати цей репозиторій. Його збережений commit і налаштування збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối lại thư mục gốc để dùng kho lưu trữ này. Commit đã lưu và cài đặt của nó vẫn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接原始文件夹以使用此仓库。其已保存的提交和设置已被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連接原始資料夾以使用此儲存庫。其已儲存的提交和設定已保留。"
          }
        }
      }
    },
