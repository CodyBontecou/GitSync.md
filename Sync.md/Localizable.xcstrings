          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Az írónév nem tartalmazhat sorvágásokat vagy szögletes zárójeleket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama Penulis tidak boleh mengandung pemisah baris atau kurung sudut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il nome dell'autore non può contenere salti di riga o tag angular.\nIl campo \""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：著者名には改行や角括弧が含まれてはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성자 이름에는 줄바꿈이나 괄호가 포함될 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfatternavn kan ikke inneholde linjeskift eller vinkelsymboer.\n«"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De naam van de auteur mag geen lijnuitbrekingen of hoekcursieveken bevatten.\nDe naam van de auteur ("
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa autora nie może zawierać przejrzewów linii ani znaków < i >.\nW polu „"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O nome do autor não pode conter quebras de linha ou marcações de ângulo."
          }
        },
        "ru": {
          "stringUnit": {
