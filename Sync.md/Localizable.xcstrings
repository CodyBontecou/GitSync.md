            "state": "translated",
            "value": "किसी वर्शन को चिह्नित करने के लिए commit टैग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címkézzen meg egy commitot egy verzió megjelöléséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tag pada commit untuk menandai versi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagga un commit per segnare una versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットにタグを付けてバージョンを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋에 태그를 달아 버전을 표시하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagg en commit for å markere en versjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag een commit om een versie te markeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otaguj commit, aby oznaczyć wersję."
          }
        },
        "pt-BR": {
