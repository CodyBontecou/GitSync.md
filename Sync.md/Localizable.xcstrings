            "value": "Repozytorium uszkodzone: %@. Spróbuj usunąć i sklonować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório corrompido: %@. Tente remover e clonar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий повреждён: %@. Попробуйте удалить и клонировать заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förrådet är skadat: %@. Försök ta bort och klona på nytt."
          }
        },
        "th": {
