    "Repository '%@' is not cloned yet — open GitSync.md and clone it first": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@لم يتم استنساخه بعد-افتح GitSync.md وقم باستنساخه أولاً"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "lager &#39;%@&#39; er ikke klonet endnu - åbent GitSync.md og klon først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository&#39;%@&#39; ist noch nicht geklont-offen GitSync.md und klonen Sie es zuerst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "&#39;%@&#39;aún no está clonado-abierto GitSync.md y clonar primero"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "versio &#39;%@&#39; ei ole vielä kloonattu - avaa GitSync.md ja kloonaa se ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Référentiel&#39;%@&#39;n&#39;est pas encore cloné-ouvert GitSync.md et le cloner d&#39;abord"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רפוזית%@לא נקלד עדיין – פתחו GitSync.md – הכנסו אותו ויצרו את הקлон שלו קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉजिटरी%@अभी तक क्लोन नहीं किया गया है — खुलें GitSync.md को पहले निकालें और फिर उसका क्लोन बनाएं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "adatmagazin%@még nem klonálva – nyitja GitSync.md – először klonálja!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@belum dikloning — buka GitSync.md dan kloningnya terlebih dahulu.\nRepository"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository%@non è ancora clonato — apri GitSync.md e clona innanzitutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリ%@はまだクローン化されていません — オープン GitSync.md を取得し、まずそのクローンを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소%@는 아직 복제되지 않았습니다 — 열기 GitSync.md 를 먼저 가져와 클론화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "-repositoriet%@er ikke klonert ennå – åpne GitSync.md og kloner det først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "-repository%@is nog niet gekloneerd – open GitSync.md en kloon dit eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositorium%@nie został jeszcze klonowany – otwórz GitSync.md – najpierw klonuj go."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório%@ainda não foi clonado — abrir GitSync.md e clone-o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ещё не клонирован — открыто GitSync.md — сначала клонируйте его.\nРепозиторий"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "-Repository%@är ännu inte klonat – öppna GitSync.md och klona det först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโพซิทอรี่%@ยังไม่ได้ถูกโคลน — เปิด GitSync.md และทำการโคลนก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo%@henüz klonlanmadı — açın GitSync.md 'yi ilk olarak bulun ve klonlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "репозиторій%@ще не клонований — відкрито GitSync.md і спочатку клонуйте його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository%@chưa được clone — mở GitSync.md và hãy sao chép nó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储库%@未被克隆——请打开 GitSync.md ，先进行克隆"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存儲庫%@未被剋隆——請打開 GitSync.md ，先進行剋隆"
          }
