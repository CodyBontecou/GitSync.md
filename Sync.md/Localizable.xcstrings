    "The .git folder in %@ will be removed. Its history is saved in %@.\n\nYour notes and files stay in place. The GitHub repository is not touched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة مجلد .git في %@. سجله محفوظ في %@.\n\nتبقى ملاحظاتك وملفاتك في مكانها. لا يتم المساس بمستودع GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".git-mappen i %@ fjernes. Dens historik er gemt i %@.\n\nDine noter og filer bliver, hvor de er. GitHub-repositoryet røres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der .git-Ordner in %@ wird entfernt. Sein Verlauf ist in %@ gespeichert.\n\nIhre Notizen und Dateien bleiben, wo sie sind. Das GitHub-Repository wird nicht angetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará la carpeta .git de %@. Su historial está guardado en %@.\n\nTus notas y archivos se quedan donde están. El repositorio de GitHub no se toca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion %@ .git-kansio poistetaan. Sen historia on tallennettu tiedostoon %@.\n\nMuistiinpanosi ja tiedostosi pysyvät paikallaan. GitHub-tietovarastoon ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier .git dans %@ sera supprimé. Son historique est enregistré dans %@.\n\nVos notes et fichiers restent en place. Le dépôt GitHub n’est pas modifié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיית ה-.git ב-%@ תוסר. ההיסטוריה שלה שמורה ב-%@.\n\nהפתקים והקבצים שלכם נשארים במקומם. המאגר ב-GitHub לא מושפע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का .git फ़ोल्डर हटा दिया जाएगा। इसका इतिहास %@ में सहेजा गया है।\n\nआपके नोट्स और फ़ाइलें अपनी जगह रहती हैं। GitHub रिपॉज़िटरी को छुआ नहीं जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ .git mappája eltávolításra kerül. Az előzményei ide mentve: %@.\n\nA jegyzetei és fájljai a helyükön maradnak. A GitHub-tároló érintetlen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder .git di %@ akan dihapus. Riwayatnya disimpan di %@.\n\nCatatan dan file Anda tetap di tempatnya. Repositori GitHub tidak disentuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella .git in %@ verrà rimossa. La sua cronologia è salvata in %@.\n\nLe tue note e i tuoi file restano dove sono. Il repository GitHub non viene toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の .git フォルダが削除されます。履歴は %@ に保存されます。\n\nノートとファイルはそのまま残ります。GitHub リポジトリには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 .git 폴더가 제거됩니다. 기록은 %@에 저장됩니다.\n\n노트와 파일은 그대로 유지됩니다. GitHub 저장소는 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ".git-mappen i %@ blir fjernet. Historikken er lagret i %@.\n\nNotatene og filene dine blir der de er. GitHub-repositoriet berøres ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De .git-map in %@ wordt verwijderd. De geschiedenis is bewaard in %@.\n\nUw notities en bestanden blijven staan. De GitHub-repository wordt niet aangeraakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder .git w %@ zostanie usunięty. Jego historia jest zapisana w %@.\n\nTwoje notatki i pliki zostają na miejscu. Repozytorium GitHub pozostaje nietknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta .git em %@ será removida. O histórico está salvo em %@.\n\nSuas notas e arquivos ficam no lugar. O repositório no GitHub não é alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка .git в %@ будет удалена. Её история сохранена в %@.\n\nВаши заметки и файлы остаются на месте. Репозиторий GitHub не затрагивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ".git-mappen i %@ tas bort. Dess historik sparas i %@.\n\nDina anteckningar och filer ligger kvar. GitHub-arkivet påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์ .git ใน %@ จะถูกลบ ประวัติถูกบันทึกไว้ใน %@\n\nโน้ตและไฟล์ของคุณยังอยู่ที่เดิม ที่เก็บบน GitHub จะไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki .git klasörü kaldırılacak. Geçmişi %@ içinde kayıtlı.\n\nNotlarınız ve dosyalarınız yerinde kalır. GitHub deposuna dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку .git у %@ буде видалено. Її історію збережено в %@.\n\nВаші нотатки й файли залишаються на місці. Репозиторій GitHub не зачіпається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục .git trong %@ sẽ bị gỡ. Lịch sử của nó được lưu trong %@.\n\nGhi chú và tệp của bạn vẫn ở nguyên chỗ. Kho lưu trữ GitHub không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的 .git 文件夹将被移除。其历史记录已保存在 %@ 中。\n\n你的笔记和文件保持原位。GitHub 仓库不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的 .git 資料夾將被移除。其歷史記錄已儲存在 %@ 中。\n\n你的筆記和檔案會保持原位。GitHub 儲存庫不受影響。"
          }
        }
      }
    },
