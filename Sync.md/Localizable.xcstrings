    "Merge has conflicts — tap a conflicted file to resolve": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدمج به تعارضات - اضغط على الملف المتعارض لحله"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge har konflikter - tryk på en konfliktfil for at løse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge hat Konflikte – tippen Sie auf eine Konfliktdatei, um sie zu lösen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinación tiene conflictos: toque un archivo en conflicto para resolverlo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistämällä on ristiriidat - napsauta ristiriitainen tiedosto ratkaistaksesi ristiriitaisen tiedoston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner a des conflits-appuyez sur un fichier conflictuel pour résoudre"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge מציג מתחיades – לחץ על קובץ עם מתחיades כדי לפתור את המ issue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge में संघर्ष है — समाधान के लिए संघर्षग्रस्त फ़ाइल पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Merge\" funkcióban konfliktusok vannak – oldjuk meg ezeket egy konfliktus fájlra kattintás útján."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge mengalami konflik — longgarkan pada file yang terkonflik untuk menyelesaikannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge presenta conflitti — tocca un file con conflitto per risolverlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Merge」機能で衝突が発生しました — 冲突しているファイルをタップして解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge에서 충돌이 발생했습니다 — 충돌된 파일을 선택하여 해결할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Merge» har konflikter – trykk på en konfliktvoll fil for å løse problemet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge heeft conflicten – tik op een conflicteerde bestand om het probleem op te lossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": funkcja „Merge\" wykazuje konflikty – naciśnij plik z konfliktem, aby go rozwiązać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O merge apresenta conflitos — toque no arquivo com conflito para resolvê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": операция объединения столкнулась с конфликтами — нажмите на конфликтующий файл для их устранения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge-funktionen har konflikter – tryck på en konfliktig fil för att lösa problemet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge มีความขัดแย้ง — แตะไฟล์ที่มีความขัดแย้งเพื่อแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge işlemide çakıntılar mevcuttur — çakıntılı dosyaya dokunarak sorunu çözebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": функція «Merge» має конфлікти — натисніть на конфліктований файл для вирішення проблеми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác hợp nhất gặp xung đột — hãy chạm vào tệp có xung đột để giải quyết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“合并”操作存在冲突——请点击冲突文件进行解决"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“閤併”操作存在衝突——請點擊衝突文件進行解決"
          }
        }
      }
    },
