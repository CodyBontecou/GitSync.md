    "HTTPS, SSH, git:// or owner/repo. Self-hosted? Tap the key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS أو SSH أو git:// أو owner/repo. استضافة ذاتية؟ اضغط المفتاح."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// eller owner/repo. Selvhostet? Tryk på nøglen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// oder owner/repo. Selbst gehostet? Tippen Sie auf den Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// u owner/repo. ¿Autoalojado? Toca la llave."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// tai owner/repo. Oma palvelin? Napauta avainta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// ou owner/repo. Auto-hébergé ? Touchez la clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// או owner/repo. אירוח עצמי? הקישו על המפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// या owner/repo। सेल्फ़-होस्टेड? की पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// vagy owner/repo. Saját kiszolgáló? Koppintson a kulcsra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// atau owner/repo. Self-hosted? Ketuk ikon kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// o owner/repo. Self-hosted? Tocca la chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS、SSH、git://、または owner/repo。セルフホストの場合は鍵をタップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// 또는 owner/repo. 자체 호스팅이라면 키를 탭하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// eller eier/repo. Egen server? Trykk på nøkkelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// of owner/repo. Zelf gehost? Tik op de sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// lub owner/repo. Własny serwer? Stuknij klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// ou owner/repo. Servidor próprio? Toque na chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// или owner/repo. Свой сервер? Нажмите на ключ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// eller ägare/arkiv. Egen värd? Tryck på nyckeln."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// หรือ owner/repo โฮสต์เอง? แตะที่กุญแจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// veya owner/repo. Kendi sunucunuz mu? Anahtara dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// або owner/repo. Власний сервер? Торкніться ключа."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS, SSH, git:// hoặc owner/repo. Tự lưu trữ? Chạm vào chìa khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
