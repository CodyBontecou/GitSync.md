            "value": ": ได้รับคำขอจากระยะไกล %1$@แต่ถูกบันทึกแล้ว %2$@ : ข้อมูลบัญชีไม่เข้ากันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uzaktan iste işlemi gerçekleştirildi. %1$@, ancak kaydedilmiştır. %2$@ kimlik bilgileri uyumludur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "– вимагається дистанційне зв'язок %1$@, але збережене\nДані кріденталі %2$@ не є сумісними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yêu cầu từ xa %1$@, nhưng đã được lưu %2$@ : Tài khoản đăng nhập không tương thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程请求 %1$@，但已保存 %2$@ 凭据不兼容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠程請求 %1$@，但已保存 %2$@ 憑據不兼容。"
          }
        }
      }
    },
    "The remote requested HTTPS credentials, but no token or password is saved for this repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": تم طلب بيانات اعتماد HTTPS عن بُعد، لكن لا يوجد أي رمز أو كلمة مرور محفوظ لمستودع هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernansigende funktion har forespurt HTTPS-krav, men der er ingen token eller adgangskode gemt for dette repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ": Die Remote-Verbindung hat HTTPS-Zugangsdaten angefordert, jedoch sind für dieses Repository kein Token noch kein Passwort gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ": Se solicitaron credenciales HTTPS desde la distancia, pero no se ha guardado ningún token ni contraseña para este repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote -palvelu pyytää HTTPS-tilaustietoja, mutta tässä tallennusjärjestelmässä ei ole tallennettu lainkaan tokenia tai salasanaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Le système a demandé des identifiants HTTPS depuis un terminal distant, mais aucun jeton ou mot de passe n'est enregistré pour ce dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הבקשה לאפשרויות HTTPS מרחוק, אך אין שומרת טוקן או סיסמה עבור המאגר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट ने HTTPS के लिए प्राधान्य आवश्यकताएँ मांगी हैं, लेकिन इस रिपॉजिटरी के लिए कोई टोकन या पासवर्ड सहेजा नहीं गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A távvezérlés kéri az HTTPS-azonosítókat, de ez a tároló számára nincs token vagy jelszó rögzítve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote meminta kredensial HTTPS, tetapi tidak ada token maupun kata sandi yang disimpan untuk repositori ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il client remoto ha richiesto le credenziali HTTPS, ma non è stato salvato alcun token né password per questo repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモートからHTTPS認証情報を要求しましたが、このリポジトリに対してトークンまたはパスワードが保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 원격 시스템이 HTTPS 인증 정보를 요청했으나, 해당 저장소에 토큰 또는 비밀번호가 저장되어 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernenheten har foreslått HTTPS-kredensialer, men det er ingen token eller passord lagret for dette lagringsmottakeret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De externe functie heeft HTTPS-gegevens verzocht, maar er is geen token of wachtwoord voor dit repository opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Zasób odległy żąda danych uwierzytelniających dla HTTPS, jednak nie jest zapisany żaden token ani hasło dla tego reposituarium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O remoto solicitou credenciais HTTPS, mas nenhum token ou senha foi salvo para este repositório."
          }
