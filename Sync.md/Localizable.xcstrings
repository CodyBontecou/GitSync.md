          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositoryet kunne ikke klones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository konnte nicht geklont werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo clonar el repositorio."
          }
        },
        "fi": {
