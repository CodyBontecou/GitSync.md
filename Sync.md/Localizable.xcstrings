        }
      }
    },
    "GitSync Assist keeps your repositories current with safe, pull-only automation. Optional subscription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist تحافظ على مستودكاتك الحالية بأمان ، pull-only التشغيل الآلي. اشتراك اختياري."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist שומר את המאגרים שלך עם בטוח, pull-only אוטומציה. מנוי אופציונלי."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Hæmmer, at dine repositories er opdaterede med sikkerhed, pull-only Automatisering. Valgfrit abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Hält Ihre Repositories mit sicherer Aktualisierung auf dem neuesten Stand. pull-only Automatisierung – optionales Abonnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Mantiene sus repositorios actualizados con seguridad, pull-only Automatización. Suscripción opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Tallentaa salattomat tallenteet päivityksissä, pull-only Automaatio. Valinnainen tilaus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Assure que vos dépôts sont toujours à jour et sécurisés, pull-only Automatisation. Abonnement optionnel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist आपके रिपॉजिटरीज़ को सुरक्षित तरीके से अद्यतन रखता है, pull-only स्वचालन। ऐच्छिक सदस्यता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Menteni az adatmagáztokat friss állapotban biztonságos módszerekkel, pull-only Automatizálás. Felvételi lehetőség."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Menjaga repositori Anda tetap mutakhir dengan cara yang aman, pull-only Otomatisasi. Langganan opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Mantiene i tuoi repository aggiornati con sicurezza, pull-only Automazione. Abbonamento facoltativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist リポジトリを安全に最新の状態に保ちます。 pull-only 自動化。オプションのサブスクリプション。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist 저장소를 안전하게 최신 상태로 유지합니다. pull-only 자동화. 선택적 구독."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Hosligger dina lagringssteder på daglig basis med sikkerhet, pull-only Automatisering – Valgfritt abonnement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Houdt uw repositories actueel met veilige methoden, pull-only Automatisering. Optionele abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Zajmuje się aktualizacją Twoich repositoriów w bezpieczny sposób, pull-only Automatyzacja. Dopuszczalna subskrypcja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Mantém seus repositórios atualizados com segurança, pull-only Automatização. Assinatura opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Обновляет ваши репозитории до актуального состояния с использованием безопасных методов. pull-only Автоматизация. Опциональная подписка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Håller dina repozitorier aktuella med säkerhet, pull-only Automatisering – valfritt prenumeration."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist ช่วยให้ repositorie ของคุณมีข้อมูลที่ทันสมัยและปลอดภัย pull-only ระบบอัตโนมัติ – บริการสมัครสมาชิกแบบเลือกใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Depolarınızı güvenli bir şekilde güncel tutar, pull-only Otomasyon. İsteğe bağlı abonelik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Дозволяє підтримувати ваші репозиторії актуальними за допомогою безпечної системи, pull-only Автоматизація. Додаткова підписка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Duy trì các kho lưu trữ của bạn luôn cập nhật với tính an toàn, pull-only Tự động hóa – Khuyến nghị đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist 确保您的代码库始终处于最新状态，且安全可靠， pull-only 自动化功能（可选订阅）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist 確保您的程式碼庫始終處於最新狀態，且安全可靠， pull-only 自動化功能（可選訂閱）。"
          }
        }
      }
    },
