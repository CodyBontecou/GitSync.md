    "No .git directory found in the selected folder.": {
      "comment": "Error when the chosen folder does not contain a git repository",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على مجلد .git في المجلد المحدد."
          }
        },
        "da": {
