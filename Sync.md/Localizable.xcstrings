    "Author Name is required before Git can create commits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المؤلف مطلوب قبل أن يتمكن Git من إنشاء الالتزامات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfatternavn er påkrævet, før Git kan oprette commits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name des Autors ist erforderlich, bevor Git Commits erstellen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere el nombre del autor antes de que Git pueda crear confirmaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekijän nimi vaaditaan ennen kuin Git voi luoda toimituksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom d&#39;auteur est requis avant Git peut créer des commits."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ", יש לציין את שם המחבר. Git יכול ליצור קומיטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'Author Name' के लिए पहले आवश्यक है। Git कमिट्स बना सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A „Author Name\" mező megadása kötelező. Git képes commitek létrehozására."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama Penulis wajib diisi sebelumnya. Git dapat membuat commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "– Nome dell'autore\" è obbligatorio prima di procedere. Git può creare commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：Author Nameは必須です。 Git はコミットを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 작성자 이름은 필수 입력 항목입니다. Git 는 커밋을 생성할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "»: Forfatternavn er obligatorisk før. Git kan opprette commitinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ") is verplicht. Git kan commits aanmaken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\" wymagane jest wprowadzenie nazwy autora. Git może tworzyć commity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O nome do autor é obrigatório antes. Git pode criar commits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "обязательно для заполнения. Git может создавать коммиты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Namn på författaren krävs innan. Git kan skapa commitningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ชื่อผู้เขียนเป็นข้อมูลที่จำเป็นก่อน Git สามารถสร้างการยืนยันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'Yazar Adı' bilgisi gerekli. Git , commitler oluşturabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": ім'я автора є обов'язковим перед цим. Git може створювати коміті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tên tác giả là trường bắt buộc trước khi lưu. Git có thể tạo commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
