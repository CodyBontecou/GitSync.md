          }
        }
      }
    },
    "Relay deletion is pending but its durable state could not be saved. Assist remains disabled; retry or contact support.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay الحذف معلق ولكن لا يمكن حفظ حالته الدائمة. لا تزال خدمة المساعدة معطلة؛ يُرجى إعادة المحاولة أو الاتصال بالدعم."
          }
        },
        "da": {
          "stringUnit": {
