          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите аккаунты GitHub, организации и репозитории, которые могут отправлять события Push Sync."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj de GitHub-konton, organisationer och arkiv som får skicka Push Sync-händelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกบัญชี GitHub องค์กร และที่เก็บที่สามารถส่งเหตุการณ์ Push Sync ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push Sync olayları gönderebilecek GitHub hesaplarını, kuruluşları ve depoları seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть облікові записи GitHub, організації й репозиторії, які можуть надсилати події Push Sync."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các tài khoản, tổ chức và kho lưu trữ GitHub có thể gửi sự kiện Push Sync."
          }
        },
        "zh-Hans": {
