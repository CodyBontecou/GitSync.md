          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：保存データの読み込みに失敗しました。 SSH キー。キーの形式およびパスフレーズを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
