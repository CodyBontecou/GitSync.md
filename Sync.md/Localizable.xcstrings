        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy iOS przydzieli czas na działanie w tle, operacje push w GitHub mogą dostarczać sygnały wybudzenia, a GitSync.md próbuje wykonać czystą operację pull bez otwierania aplikacji."
          }
