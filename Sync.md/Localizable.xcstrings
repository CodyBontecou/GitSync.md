    "%@ becomes a plain folder. Obsidian keeps working; GitSync.md stops syncing it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصبح %@ مجلدًا عاديًا. يظل Obsidian يعمل، ويتوقف GitSync.md عن مزامنته."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bliver en almindelig mappe. Obsidian virker stadig; GitSync.md holder op med at synkronisere den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird zu einem normalen Ordner. Obsidian funktioniert weiter; GitSync.md synchronisiert ihn nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pasa a ser una carpeta normal. Obsidian sigue funcionando; GitSync.md deja de sincronizarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muuttuu tavalliseksi kansioksi. Obsidian toimii edelleen; GitSync.md lopettaa sen synkronoinnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devient un dossier ordinaire. Obsidian continue de fonctionner ; GitSync.md arrête de le synchroniser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ יהפוך לתיקייה רגילה. Obsidian ימשיך לעבוד; GitSync.md יפסיק לסנכרן אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एक साधारण फ़ोल्डर बन जाएगा। Obsidian काम करता रहेगा; GitSync.md इसे सिंक करना बंद कर देगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ egyszerű mappává válik. Az Obsidian tovább működik; a GitSync.md leállítja a szinkronizálását."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menjadi folder biasa. Obsidian tetap berfungsi; GitSync.md berhenti menyinkronkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diventa una normale cartella. Obsidian continua a funzionare; GitSync.md smette di sincronizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は通常のフォルダになります。Obsidian はそのまま使えますが、GitSync.md による同期は停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 일반 폴더가 됩니다. Obsidian은 계속 작동하지만 GitSync.md는 더 이상 동기화하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blir en vanlig mappe. Obsidian fungerer fortsatt; GitSync.md slutter å synkronisere den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt een gewone map. Obsidian blijft werken; GitSync.md stopt met synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stanie się zwykłym folderem. Obsidian działa dalej; GitSync.md przestaje go synchronizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vira uma pasta comum. O Obsidian continua funcionando; o GitSync.md deixa de sincronizá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ станет обычной папкой. Obsidian продолжит работать; GitSync.md перестанет её синхронизировать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blir en vanlig mapp. Obsidian fortsätter att fungera; GitSync.md slutar synka den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะกลายเป็นโฟลเดอร์ธรรมดา Obsidian ยังใช้งานได้ตามปกติ แต่ GitSync.md จะหยุดซิงค์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sıradan bir klasöre dönüşür. Obsidian çalışmaya devam eder; GitSync.md onu eşzamanlamayı bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ стане звичайною папкою. Obsidian і далі працює; GitSync.md перестане її синхронізувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ trở thành thư mục thường. Obsidian vẫn hoạt động; GitSync.md ngừng đồng bộ thư mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将变成普通文件夹。Obsidian 照常可用；GitSync.md 将停止同步它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將變成一般資料夾。Obsidian 仍可照常使用；GitSync.md 將停止同步它。"
          }
        }
      }
    },
