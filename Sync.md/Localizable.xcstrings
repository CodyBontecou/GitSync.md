          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua repositori Git, SYNCED ke IPHONE Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi repository Git, SYNCED sul tuo IPHONE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のGitリポジトリ、SYNCED をあなたのIPHONEに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 Git 저장소든, SYNCED을 귀하의 IPHONE에 올려주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– enhver Git-repo, synkretert til ditt iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "– enige Git-repo, gesynchroniseerd met uw iPhone"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– dowolny repo Git, synchronizowany z Twoim iPhone'em"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer repositório do Git, SYNCED para o seu IPHONE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "任一 Git-репозиторий, SYNCED на ваш IPHONE"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– vilket git-repo som helst, synkroniserat med ditt iPhone"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุก repos Git, SYNCED ไปยัง IPHONE ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
