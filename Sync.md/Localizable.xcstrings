    "Local and remote have diverged (ahead %lld, behind %lld). Merge support is required to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تباعدت النسختان المحلية والبعيدة (المحلية متقدمة بمقدار %lld، ومتأخرة بمقدار %lld). يلزم دعم الدمج للمتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale og eksterne version har udviklet sig forskelligt (foran med %lld, bagud med %lld). Understøttelse af fletning er påkrævet for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale und entfernte Version sind auseinandergegangen (um %lld voraus, um %lld zurück). Zum Fortfahren ist Merge-Unterstützung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones local y remota han divergido (la local está %lld por delante y %lld por detrás). Se requiere compatibilidad con fusiones para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen ja etäversio ovat eriytyneet (edellä %lld, jäljessä %lld). Jatkaminen edellyttää yhdistämisen tukea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions locale et distante ont divergé (avance de %lld, retard de %lld). La prise en charge de la fusion est nécessaire pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגרסה המקומית והמרוחקת התפצלו (המקומית מקדימה ב־%lld ומאחור ב־%lld). כדי להמשיך נדרשת תמיכה במיזוג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल और रिमोट संस्करण अलग हो गए हैं (लोकल %lld आगे, %lld पीछे)। जारी रखने के लिए मर्ज सपोर्ट आवश्यक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi és a távoli verzió eltért egymástól (előny: %lld, lemaradás: %lld). A folytatáshoz egyesítési támogatás szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi lokal dan jarak jauh telah menyimpang (lebih maju %lld, tertinggal %lld). Dukungan penggabungan diperlukan untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository locale e quello remoto sono divergenti (avanti di %lld, indietro di %lld). Per continuare è necessario il supporto per il merge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルとリモートが分岐しています（%lld件先行、%lld件遅延）。続行するにはマージへの対応が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬과 원격이 분기되었습니다(로컬 %lld개 앞섬, %lld개 뒤처짐). 계속하려면 병합 기능이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal og ekstern versjon har avveket (foran med %lld, bak med %lld). Støtte for merge kreves for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale en externe versie zijn uiteengelopen (loopt %lld voor en %lld achter). Ondersteuning voor samenvoegen is vereist om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna i zdalna gałąź się rozeszły (do przodu: %lld, do tyłu: %lld). Aby kontynuować, wymagana jest obsługa merge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões local e remota divergiram (%lld à frente, %lld atrás). É necessário ter suporte a merge para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная и удалённая версии разошлись (впереди на %lld, позади на %lld). Для продолжения требуется поддержка merge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala och externa versionen har skiljts åt (%lld före, %lld efter). Stöd för merge krävs för att fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันในเครื่องและระยะไกลแยกออกจากกัน (นำอยู่ %lld, ตามอยู่ %lld) ต้องรองรับ merge จึงจะดำเนินการต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ve uzak dallar ayrıştı (ileride %lld, geride %lld). Devam etmek için merge desteği gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна й віддалена версії розійшлися (попереду: %lld, позаду: %lld). Для продовження потрібна підтримка merge."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản cục bộ và bản từ xa đã phân nhánh (trước %lld, sau %lld). Cần hỗ trợ merge để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地与远程已分叉（领先 %lld，落后 %lld）。需要支持合并才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機與遠端已分歧（領先 %lld，落後 %lld）。需要支援合併才能繼續。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Local and remote have diverged. Merge support is required to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تباعدت المسافة المحلية والبعيدة. مطلوب دعم الدمج للمتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalt og eksternt er adskilt. Der kræves flettesupport for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal und Remote sind auseinandergegangen. Zum Fortfahren ist Merge-Unterstützung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Local y remoto han divergido. Se requiere soporte de fusión para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset ja etäiset ovat erilaisia. Yhdistämistuki on jatkettava."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Local et distant ont divergé. Le support de fusion est nécessaire pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": בין ה-Local וה-Remote נוצרה הפרדה. יש צורך בתמיכהในการ שילוב כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'Local' और 'Remote' के बीच अंतर है। प्रक्रिया जारी रखने के लिए मर्ज सपोर्ट की आवश्यकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A helyi és távoli konfigurációk eltérnek. A folytatás érdekében a csatolás támogatása szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Konfigurasi lokal dan jarak jauh telah berbeda. Diperlukan dukungan penggabungan untuk melanjutkan proses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": i valori locali e remoti sono divergenti. È necessario il supporto per la fusione per proseguire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカルとリモートの状態が一致していません。継続するには、マージ機能が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬 및 원격 데이터가 서로 다릅니다. 계속 진행하려면 병합 지원이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokal og fjernfunksjoner er forskjellige. Samlingstilpassing er nødvendig for å kunne fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokale en externe instellingen zijn niet overeenkomend; ondersteuning voor samenvoeging is vereist om verder te kunnen werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": lokalny i odległy rejestry nie są zgodne. Do kontynuowania pracy wymagana jest funkcja połączenia (merge)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": os estados local e remoto divergiram. É necessário suporte de fusão para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": местные и удалённые данные расходятся. Для продолжения работы требуется функция объединения данных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokala och fjärranvärden har skiljt sig. Merg-support krävs för att fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": สถานะท้องถิ่นและระยะไกลไม่สอดคล้องกัน — จำเป็นต้องมีการรวมข้อมูลเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel ve uzaktaki veriler farklıdır. İşi devam ettirmek için birleştirme desteği gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": між локальним і дистанційним режимами виникли розбіжності. Для продовження роботи необхідна функція об'єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tính năng Local và Remote đã không còn trùng khớp nhau. Cần hỗ trợ hợp nhất để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：本地与远程数据已出现差异。需启用合并功能方可继续操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：本地與遠程數據已齣現差異。需啟用閤併功能方可繼續操作。"
          }
        }
      }
    },
    "Local and remote history diverged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تباين التاريخ المحلي والتاريخ البعيد."
