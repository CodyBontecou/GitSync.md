    "Finalize the merge with a commit and push": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنهاء عملية الدمج من خلال الالتزام والدفع"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut sammenfletningen med en commit og push"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die Zusammenführung mit einem Commit und einem Push ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalice la fusión con una confirmación y empuje"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeistele yhdistäminen ja työnnät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliser la fusion avec un commit et pousser"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": סופי את שילוב הנתונים באמצעות הפקת קומיט ופושינג"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": कमिट और पुश के माध्यम से मर्ज को अंतिम रूप दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A fusztelés véglegesítése egy commit és push mellett"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Menyelesaikan penggabungan dengan melakukan commit dan push"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Concludere la fusione con un commit e un push"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：コミットおよびプッシュを実行して、マージを完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 커밋과 푸시를 통해 병합을 완료합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Fullfør mengden ved å utføre en commit og push"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De samenvoeging afronden met een commit en push"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Zakończ połączenie poprzez commit i push"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalize a fusão com um commit e um push"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": завершите слияние с помощью коммита и пуша"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalisera fusionen med en commit och en push"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ดำเนินการรวมโค้ดโดยใช้คำสั่ง commit และ push"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bir commit ve push ile birleşimi tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Завершити об'єднання за допомогою комітингу та пушування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hoàn tất quá trình hợp nhất bằng cách thực hiện commit và push."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：通过提交和推送操作完成合并"
          }
        },
        "zh-Hant": {
