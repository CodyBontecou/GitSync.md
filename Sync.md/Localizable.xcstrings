    "Switching branches is blocked to protect local edits. Commit, stash, or discard changes first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حظر تبديل الفروع لحماية عمليات التحرير المحلية. تنفيذ التغييرات أو تخزينها أو تجاهلها أولاً."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiftende filialer er blokeret for at beskytte lokale redigeringer. Bekræft, gem eller kasser ændringer først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wechseln von Zweigen ist blockiert, um lokale Änderungen zu schützen. Änderungen zuerst festschreiben, speichern oder verwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio de ramas está bloqueado para proteger las ediciones locales. Confirme, guarde o descarte los cambios primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching haarat on estynyt paikallisten muokkausten suojaamiseksi. Tallenna, paketoi tai hylkää muutokset ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Le passage entre branches est bloqué pour protéger les modifications locales. Commencez par committer, stasher ou discarder les modifications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הפעלת החלקים של ZXQItem000080QXZ איננה אפשרית – כדי להגן על השינויים המקומיים; יש לבצע את ה-Commit, ה-Stash או ה-Discard של השינויים לפני כן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्विचिंग शाखाओं को स्थानीय संपादनों की सुरक्षा हेतु अवरुद्ध कर दिया गया है। पहले परिवर्तनों को कमिट करें, स्टेश करें या डिस्कार्ड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A váltó funkció blokkolva van, hogy a helyi módosításokat védelmezze. Először hajtsa végre a módosítások beállítását (commit), tárolását (stash) vagy elutasítását (discard)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Operasi pindah cabang terhalang untuk melindungi edisi lokal. Harap terlebih dahulu melakukan commit, stash, atau discard perubahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": L'operazione di commutazione delle rami è bloccata per proteggere le modifiche locali. Si raccomanda di effettuare prima un commit, un stash o una discarica delle modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカル編集を保護するため、ブランチの切り替えが不可です。まず、コミット、ステ stash、またはディスカインドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬 편집을 보호하기 위해 스위칭 분기 작업이 차단되었습니다. 먼저 변경 사항을 커밋, 스타시 또는 드리스드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Vending av grenser er blokkert for å beskytte lokale redigeringer. Før du kan bekrefte, lagre eller fjerne endringer, må du gjøre dette først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De schakeling van takken is geblokkeerd om lokale bewerkingen te beschermen. Bewerk eerst de wijzigingen, stel ze weg of verwijder ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Operacja przełączania gałęzi jest zablokowana w celu ochrony lokalnych edycji. Najpierw dokonaj commitowania, stashowania lub usunięcia zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": A operação de troca de ramos está bloqueada para proteger as edições locais. Primeiro, execute o commit, o stash ou a descarte das alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": операция переключения веток блокирована для защиты локальных изменений. Сначала выполните коммит, стэш или отмену изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Funktionen för att byta grenar är blockerad för att skydda lokala redigeringar. Försök först att bekräfta, förvara eller avboka ändringarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การสลับสาขาถูกปิดกั้นเพื่อปกป้องการแก้ไขในท้องถิ่น โปรดดำเนินการ Commit, stash หรือ discard รายการเปลี่ยนแปลงก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel düzenlemeleri korumak için ana hat değiştirmek engellendi. İlk olarak değişiklikleri commit, stash veya discard edininiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": операція «переключення відділків» заблокована для захисту локальних змін. Спочатку захочіть комітувати, сташити або відкинути зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác chuyển đổi nhánh bị chặn để bảo vệ các chỉnh sửa cục bộ. Vui lòng thực hiện commit, stash hoặc discard thay đổi trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：切换分支操作已受阻，以保护本地编辑内容。请先提交、暂存或丢弃更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：切換分支操作已受阻，以保護本地編輯內容。請先提交、暫存或丟棄更改。"
          }
        }
      }
    },
