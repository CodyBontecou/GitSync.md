    "Cannot delete the currently checked out branch '%@'.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حذف الفرع المسحوب حاليًا '%@'."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke slette den aktuelt tjekkede gren '%@'."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuell ausgecheckte Zweig „%@“ kann nicht gelöscht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar la rama actualmente desprotegida '%@'."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ei voi poistaa tällä hetkellä valittua haaraa &#39;%@'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer la branche actuellement récupérée&#39;%@'."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן למחוק את השנוי שנבחר כרגע '%@'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": वर्तमान में चेकआउट किए गए ब्रांच को हटाना असंभव है।%@'."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A jelenleg kihasznált szakasz törléséhez nem szükséges engedély.%@'."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghapus cabang yang sedang diperiksa '%@'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile eliminare il rami attualmente prenotato '%@'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：現在チェックアウト中のブランチ「」を削除できません。%@'."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 현재 체크아웃된 브랜치를 삭제할 수 없습니다.%@'."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kan ikke slette den nå aktuelt utleide grenen «'%@'."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": U kunt de momenteel gecheckte tak niet verwijderen.%@'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można usunąć obecnie wykorzystowanego gałęzi „\".%@'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível excluir o ramo atualmente em checkout '%@'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Не удаётся удалить текущий забронированный ветвь «»%@'."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kan inte radera den för närvarande utcheckade grenen '%@'."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ไม่สามารถลบสาขาที่กำลังถูกเช็คเอาต์ในขณะนี้ได้%@'."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Şu anda kontrol edilen şubeyi silinemez.%@'."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна видалити поточно заброньований відгалуження «%@'."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa nhánh đang được thuê ('%@'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：无法删除当前已借出的分支“”%@'."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：無法刪除當前已借齣的分支“”%@'."
          }
        }
      }
    },
    "Cannot push because these files are locked by another user: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الدفع لأن هذه الملفات مقفلة بواسطة مستخدم آخر: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke push, fordi disse filer er låst af en anden bruger: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht übertragen werden, da diese Dateien von einem anderen Benutzer gesperrt sind: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede enviar porque estos archivos están bloqueados por otro usuario: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voi painaa, koska nämä tiedostot on lukittu toisen käyttäjän: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de pousser car ces fichiers sont verrouillés par un autre utilisateur: %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשלב, מכיוון שקבצי אלו מוגבלים על ידי משתמש אחר: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": ये फ़ाइलें किसी अन्य उपयोगकर्ता द्वारा लॉक होने के कारण पुश नहीं किया जा सकता: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nem tudja előrejuttatni ezeket a fájlokat, mivel ezeket egy másik felhasználó zárja: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menekan karena file-file ini terkunci oleh pengguna lain: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile spostare i file perché sono bloccati da un altro utente: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：これらのファイルは他のユーザーによってロックされているため、プッシュできません： %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 해당 파일이 다른 사용자의 잠금 상태이므로 푸시할 수 없습니다. %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kan ikke presse disse filene, fordi de er låst av en annen bruker: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": U kunt de bestanden niet verplaatsen omdat deze door een andere gebruiker zijn beperkt: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przesłać plików, ponieważ są ony zamknięte przez inego użytkownika: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível empurrar porque esses arquivos estão bloqueados por outro usuário: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Не удаётся выполнить операцию «пуш» — эти файлы заблокированы другим пользователем: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kan inte pusha eftersom dessa filer är låsta av en annan användare: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบีบอัดได้ เนื่องจากไฟล์เหล่านี้ถูกล็อกโดยผู้ใช้คนอื่น: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu dosyalar başka bir kullanıcı tarafından kapalı olduğundan itiraz edilemez: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна завантажувати файли, оскільки вони заблоковані іншим користувачем: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đẩy vì các tệp này đang bị khóa bởi người dùng khác: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：无法推送，因为这些文件已被其他用户锁定： %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：無法推送，因爲這些文件已被其他用戶鎖定： %@."
          }
        }
      }
    },
