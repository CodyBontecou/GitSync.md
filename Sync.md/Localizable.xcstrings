    "Use a GitHub token, or continue without GitHub for SSH keys, HTTPS tokens, GitLab, Gitea, Codeberg or your own server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم رمز GitHub، أو تابع دون GitHub لمفاتيح SSH أو رموز HTTPS أو GitLab أو Gitea أو Codeberg أو خادمك الخاص."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug et GitHub-token, eller fortsæt uden GitHub for SSH-nøgler, HTTPS-tokens, GitLab, Gitea, Codeberg eller din egen server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie ein GitHub-Token oder fahren Sie ohne GitHub fort für SSH-Schlüssel, HTTPS-Tokens, GitLab, Gitea, Codeberg oder Ihren eigenen Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un token de GitHub o continúa sin GitHub para claves SSH, tokens HTTPS, GitLab, Gitea, Codeberg o tu propio servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä GitHub-tunnusta tai jatka ilman GitHubia SSH-avaimille, HTTPS-tunnuksille, GitLabille, Gitealle, Codebergille tai omalle palvelimellesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un jeton GitHub, ou continuez sans GitHub pour les clés SSH, jetons HTTPS, GitLab, Gitea, Codeberg ou votre propre serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו באסימון GitHub, או המשיכו בלי GitHub עבור מפתחות SSH, אסימוני HTTPS, ‏GitLab, ‏Gitea, ‏Codeberg או שרת משלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub टोकन का उपयोग करें, या SSH की, HTTPS टोकन, GitLab, Gitea, Codeberg या अपने सर्वर के लिए GitHub के बिना जारी रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon GitHub-tokent, vagy folytassa GitHub nélkül SSH-kulcsokhoz, HTTPS-tokenekhez, GitLabhez, Giteához, Codeberghez vagy saját kiszolgálóhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan token GitHub, atau lanjutkan tanpa GitHub untuk kunci SSH, token HTTPS, GitLab, Gitea, Codeberg, atau server Anda sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un token GitHub, oppure continua senza GitHub per chiavi SSH, token HTTPS, GitLab, Gitea, Codeberg o il tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub トークンを使用するか、SSH 鍵、HTTPS トークン、GitLab、Gitea、Codeberg、自分のサーバーの場合は GitHub なしで続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 토큰을 사용하거나, SSH 키, HTTPS 토큰, GitLab, Gitea, Codeberg 또는 자체 서버를 사용하려면 GitHub 없이 계속하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk et GitHub-token, eller fortsett uten GitHub for SSH-nøkler, HTTPS-tokener, GitLab, Gitea, Codeberg eller din egen server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een GitHub-token, of ga verder zonder GitHub voor SSH-sleutels, HTTPS-tokens, GitLab, Gitea, Codeberg of uw eigen server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tokenu GitHub lub kontynuuj bez GitHuba dla kluczy SSH, tokenów HTTPS, GitLab, Gitea, Codeberg lub własnego serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um token do GitHub ou continue sem GitHub para chaves SSH, tokens HTTPS, GitLab, Gitea, Codeberg ou seu próprio servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте токен GitHub или продолжите без GitHub для ключей SSH, HTTPS-токенов, GitLab, Gitea, Codeberg или своего сервера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd en GitHub-token, eller fortsätt utan GitHub för SSH-nycklar, HTTPS-tokens, GitLab, Gitea, Codeberg eller din egen server."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โทเคน GitHub หรือดำเนินการต่อโดยไม่ใช้ GitHub สำหรับกุญแจ SSH, โทเคน HTTPS, GitLab, Gitea, Codeberg หรือเซิร์ฟเวอร์ของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir GitHub token'ı kullanın veya SSH anahtarları, HTTPS token'ları, GitLab, Gitea, Codeberg ya da kendi sunucunuz için GitHub olmadan devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використайте токен GitHub або продовжте без GitHub для ключів SSH, HTTPS-токенів, GitLab, Gitea, Codeberg чи власного сервера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng token GitHub, hoặc tiếp tục không cần GitHub cho khóa SSH, token HTTPS, GitLab, Gitea, Codeberg hoặc máy chủ riêng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GitHub 令牌，或者不使用 GitHub 继续，以使用 SSH 密钥、HTTPS 令牌、GitLab、Gitea、Codeberg 或你自己的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GitHub 權杖，或不使用 GitHub 繼續，以使用 SSH 密鑰、HTTPS 權杖、GitLab、Gitea、Codeberg 或你自己的伺服器。"
          }
        }
      }
    },
