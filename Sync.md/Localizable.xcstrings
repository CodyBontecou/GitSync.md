    "Author Email must look like you@example.com.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يبدو البريد الإلكتروني للمؤلف مثل you@example.com."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfatter-e-mail skal ligne dig@example.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse des Autors muss wie folgt aussehen: you@example.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo electrónico del autor debe verse como you@example.com."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittaja Sähköposti tulee näyttää sinulta@example.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auteur Email doit ressembler à you@example.com."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": האימייל של המחבר חייב להראות כ follows: you@example.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": लेखक का ईमेल वैध रूप में you@example.com जैसा होना चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Az author e-mail címnek a formátumban kell lennie: you@example.com."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Email penulis harus berbentuk seperti Anda@example.com."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": L'indirizzo email dell'autore deve avere la forma you@example.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：著者メールアドレスは、you@example.comの形式でなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 작성자 이메일 주소는 'you@example.com'와 같은 형식이어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": E-postadresse for forfatteren må se slik ut: you@example.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De e-mailadres van de auteur moet eruitzien als you@example.com."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Adres e-mail autora musi mieć formę: you@example.com."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O e-mail do autor deve ter a seguinte forma: você@example.com."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Электронная почта автора должна иметь вид: you@example.com."
          }
        },
