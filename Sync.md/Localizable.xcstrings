        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने एक HTML त्रुटि पृष्ठ वापस किया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "szerver HTML-hibajelentést adott vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server mengembalikan halaman kesalahan HTML."
          }
        },
        "it": {
