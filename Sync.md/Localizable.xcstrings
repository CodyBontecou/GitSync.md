    "Revert is blocked to protect local edits. Commit, stash, or discard changes first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert لحماية التعديلات المحلية. تنفيذ التغييرات أو تخزينها أو تجاهلها أولاً."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert er blokeret for at beskytte lokale redigeringer. Bekræft, gem eller kasser ændringer først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zurücksetzen“ ist blockiert, um lokale Änderungen zu schützen. Änderungen zuerst festschreiben, speichern oder verwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reversión está bloqueada para proteger las ediciones locales. Confirme, guarde o descarte los cambios primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert on estynyt suojaamaan paikallisia muokkauksia. Tallenna, paketoi tai hylkää muutokset ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert est bloqué pour protéger les édits locaux. Commitez, mettez en cache ou annulez d’abord vos modifications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הפעולה 'Revert' מוסגרת כדי להגן על השינויים המקומיים – יש לבצע את ה-Commit, ה-stash או ה-discard של השינויים לפני כן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'Revert' को स्थानीय संपादनों की रक्षा के लिए अवरुद्ध किया गया है। पहले संशोधनों को 'Commit', 'Stash' या 'Discard' करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Revert\" gomb blokkolva van a helyi módosítások védelmére; először hajtsa végre az „Commit\", „stash\" vagy „discard\" parancsokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Operasi *Revert* diblokir untuk melindungi edisi lokal. Harap terlebih dahulu melakukan *Commit*, *stash*, atau *discard* perubahan tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": la funzione «Revert» è bloccata per proteggere le modifiche locali. Si consiglia di effettuare prima un commit, un stash o una discarica delle modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Revert」操作は、ローカル編集を保護するため、ブロックされています。まず、コミット、スタッシュ、またはディスカインドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'Revert' 작업은 로컬 편집을 보호하기 위해 차단되었습니다. 먼저 변경 사항을 'Commit', 'Stash', 또는 'Discard'하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Revert» er blokkert for å beskytte lokale redigeringer. Før du utfører «Commit», «Stash» eller «Discard», gjør først disse handlingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Revert' is geblokkeerd om lokale bewerkingen te beschermen. Bewerk eerst de wijzigingen met 'Commit', 'stash' of 'discard'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Operacja „Revert\" jest blokowana w celu ochrony lokalnych modyfikacji. Najpierw zapisz zmiany za pomocą „Commit\", „stash\" lub „discard\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": A opção \"Revert\" está bloqueada para proteger as edições locais. Primeiro, execute um commit, um stash ou um discard das alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "операция «Revert» заблокирована для защиты локальных изменений. Сначала выполните операцию «Commit», «stash» или «discard»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Funktionen „Revert\" är blockerad för att skydda lokala redigeringar. Försök först att bekräfta, förvara eller avskaffa ändringarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การยกเลิกการแก้ไขถูกปิดกั้นเพื่อปกป้องการแก้ไขในระบบ คุณควรดำเนินการ Commit, stash หรือ discard การเปลี่ยนแปลงก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Revert' işlemi, yerel düzenlemeleri korumak için engellendi. İlk olarak değişiklikleri commit etmek, stash etmek veya discard etmelisiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": операція «Revert» заблокована для захисту локальних змін. Спочатку виконайте операцію «Commit», «stash» або «discard»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác 'Revert' bị chặn nhằm bảo vệ các chỉnh sửa cục bộ – hãy thực hiện Commit, Stash hoặc Discard thay đổi trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“撤销”操作已被阻止，以保护本地编辑内容。请先提交、暂存或丢弃更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“撤銷”操作已被阻止，以保護本地編輯內容。請先提交、暫存或丟棄更改。"
          }
        }
      }
    },
