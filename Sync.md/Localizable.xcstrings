    "Git updated before cancellation completed. Verify the working tree before the next sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Git تم التحديث قبل اكتمال الإلغاء. تحقق من شجرة العمل قبل المزامنة التالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Git עודכן לפני ביטול הושלם. לאמת את עץ העבודה לפני הסינכרון הבא."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
