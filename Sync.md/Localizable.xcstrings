    "Stop preserves your files and saved progress. You can resume from Publish a Folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ الإيقاف بملفاتك وتقدمك المحفوظ. يمكنك الاستئناف من نشر مجلد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop bevarer dine filer og gemte fremskridt. Du kan genoptage fra Udgiv en mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen bewahrt Ihre Dateien und den gespeicherten Fortschritt. Sie können über „Ordner veröffentlichen“ fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener conserva tus archivos y el progreso guardado. Puedes reanudar desde Publicar una carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopettaminen säilyttää tiedostosi ja tallennetun edistymisen. Voit jatkaa kohdasta Julkaise kansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter conserve vos fichiers et la progression enregistrée. Vous pourrez reprendre depuis Publier un dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצירה שומרת את הקבצים וההתקדמות השמורה. אפשר להמשיך מפרסום תיקייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकने से आपकी फ़ाइलें और सहेजी गई प्रगति सुरक्षित रहती हैं। आप फ़ोल्डर प्रकाशित करें से फिर शुरू कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leállítás megőrzi a fájlokat és a mentett előrehaladást. A Mappa közzététele menüből folytathatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan akan mempertahankan file dan progres tersimpan Anda. Anda dapat melanjutkan dari Publikasikan Folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi conserva i tuoi file e l'avanzamento salvato. Puoi riprendere da Pubblica una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止してもファイルと保存された進捗は保持されます。「フォルダを公開」から再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지해도 파일과 저장된 진행 상황은 보존됩니다. 폴더 게시에서 재개할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp bevarer filene dine og den lagrede fremdriften. Du kan fortsette fra Publiser en mappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen behoudt uw bestanden en bewaarde voortgang. U kunt hervatten via Een map publiceren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymanie zachowuje pliki i zapisany postęp. Możesz wznowić z Opublikuj folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar preserva seus arquivos e o progresso salvo. Você pode retomar em Publicar uma Pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановка сохраняет файлы и сохранённый прогресс. Продолжить можно из «Опубликовать папку»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa bevarar dina filer och sparade förlopp. Du kan återuppta från Publicera en mapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การหยุดจะเก็บไฟล์และความคืบหน้าที่บันทึกไว้ คุณดำเนินการต่อได้จาก เผยแพร่โฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdurmak dosyalarınızı ve kaydedilen ilerlemeyi korur. Bir klasör yayımla'dan sürdürebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинка зберігає файли й збережений прогрес. Продовжити можна з «Опублікувати папку»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng sẽ giữ nguyên tệp và tiến trình đã lưu. Bạn có thể tiếp tục từ Xuất bản thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止会保留你的文件和已保存的进度。你可以从“发布文件夹”继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止會保留你的檔案和已儲存的進度。你可以從「發佈資料夾」繼續。"
          }
        }
      }
    },
