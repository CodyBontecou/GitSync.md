            "value": ": lokalne edycje blokują ten pobieranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Edições locais bloqueiam esta operação de pull."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": локальные редактирования блокируют эту операцию подтягивания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokala redigeringar blockerar denna hämtning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การแก้ไขท้องถิ่นได้ขัดขวางการดึงข้อมูลนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel düzenlemeler bu çekme işlemini engeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": місцеві зміни блокують цей запит."
          }
