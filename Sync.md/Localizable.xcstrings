            "value": "Dina filer ligger kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ของคุณยังอยู่ที่เดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınız hâlâ yerinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші файли на місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp của bạn vẫn ở nguyên chỗ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
