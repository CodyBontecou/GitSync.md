    "Moving keeps history and settings. Pick the folder the vault should live in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ النقل بالسجل والإعدادات. اختر المجلد الذي يجب أن توجد فيه الخزنة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytning bevarer historik og indstillinger. Vælg den mappe, din vault skal ligge i."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Verschieben bleiben Verlauf und Einstellungen erhalten. Wählen Sie den Ordner, in dem der Vault liegen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al mover se conservan el historial y los ajustes. Elige la carpeta donde debe estar la bóveda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirto säilyttää historian ja asetukset. Valitse kansio, jossa holvin pitäisi olla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déplacement conserve l’historique et les réglages. Choisissez le dossier où le coffre doit se trouver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההעברה שומרת על ההיסטוריה וההגדרות. בחרו את התיקייה שבה הכספת צריכה להיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ले जाने पर इतिहास और सेटिंग्स बनी रहती हैं। वह फ़ोल्डर चुनें जिसमें वॉल्ट रहना चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az áthelyezés megtartja az előzményeket és a beállításokat. Válassza ki a mappát, ahol a széfnek lennie kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindahkan tetap mempertahankan riwayat dan pengaturan. Pilih folder tempat vault berada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spostamento mantiene cronologia e impostazioni. Scegli la cartella in cui deve trovarsi il vault."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動しても履歴と設定は保持されます。保管庫を置くフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동해도 기록과 설정은 유지됩니다. 보관함을 둘 폴더를 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytting beholder historikk og innstillinger. Velg mappen hvelvet skal ligge i."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatsen behoudt geschiedenis en instellingen. Kies de map waarin de kluis moet staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeniesienie zachowuje historię i ustawienia. Wybierz folder, w którym ma się znaleźć sejf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover mantém o histórico e os ajustes. Escolha a pasta onde o cofre deve ficar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещение сохраняет историю и настройки. Выберите папку, в которой должно находиться хранилище."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt behåller historik och inställningar. Välj mappen valvet ska ligga i."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายจะเก็บประวัติและการตั้งค่าไว้ เลือกโฟลเดอร์ที่ vault ควรอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma geçmişi ve ayarları korur. Kasanın bulunacağı klasörü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщення зберігає історію й налаштування. Виберіть папку, де має бути сховище."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển vẫn giữ lịch sử và cài đặt. Hãy chọn thư mục nơi vault sẽ nằm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动会保留历史记录和设置。请选择库要存放的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動會保留歷史記錄和設定。請選擇保險庫要存放的資料夾。"
          }
        }
      }
    },
