          "stringUnit": {
            "state": "translated",
            "value": "Avaa Obsidian aamulla, ja kaikki on jo paikallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Obsidian le matin, et tout est déjà là."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Obsidian בבוקר והכול כבר שם."
