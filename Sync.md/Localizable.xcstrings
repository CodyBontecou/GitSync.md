          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Konflikte gelöst. Setzen Sie den Rebase fort oder brechen Sie ihn ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los conflictos resueltos. Continuar o cancelar la rebase."
          }
