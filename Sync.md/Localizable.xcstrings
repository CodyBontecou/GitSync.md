    "Could not securely save the relay deletion authorization. Background Sync remains disabled; retry or contact support.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ تفويض حذف المُرحِّل بأمان. يظل Background Sync معطّلًا؛ أعد المحاولة أو تواصل مع الدعم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelsen til sletning fra relæet kunne ikke gemmes sikkert. Background Sync er fortsat deaktiveret. Prøv igen, eller kontakt support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Autorisierung zum Löschen der Relay-Daten konnte nicht sicher gespeichert werden. Background Sync bleibt deaktiviert. Versuchen Sie es erneut oder wenden Sie sich an den Support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar de forma segura la autorización para eliminar el relé. Background Sync sigue desactivado; vuelva a intentarlo o póngase en contacto con soporte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välityspalvelun poiston valtuutusta ei voitu tallentaa turvallisesti. Background Sync pysyy poissa käytöstä. Yritä uudelleen tai ota yhteyttä tukeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer de façon sécurisée l’autorisation de suppression du relais. Background Sync reste désactivé ; réessayez ou contactez l’assistance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור באופן מאובטח את ההרשאה למחיקת הממסר. Background Sync נשאר מושבת; יש לנסות שוב או לפנות לתמיכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिले मिटाने का प्राधिकरण सुरक्षित रूप से सहेजा नहीं जा सका। Background Sync बंद रहेगा; फिर कोशिश करें या सहायता से संपर्क करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült biztonságosan menteni a továbbító törlésére vonatkozó engedélyt. A Background Sync kikapcsolva marad; próbálja újra, vagy forduljon az ügyfélszolgálathoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorisasi penghapusan relay tidak dapat disimpan dengan aman. Background Sync tetap dinonaktifkan; coba lagi atau hubungi dukungan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare in modo sicuro l’autorizzazione all’eliminazione del relay. Background Sync resta disattivato; riprovi o contatti l’assistenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "relay 削除の承認を安全に保存できませんでした。Background Sync は無効のままです。再試行するか、サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이 삭제 승인을 안전하게 저장할 수 없습니다. Background Sync는 비활성화된 상태로 유지됩니다. 다시 시도하거나 지원팀에 문의해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre godkjenningen for sletting fra releet på en sikker måte. Background Sync forblir deaktivert. Prøv på nytt eller kontakt kundestøtte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De autorisatie voor verwijdering uit de relay kon niet veilig worden opgeslagen. Background Sync blijft uitgeschakeld; probeer het opnieuw of neem contact op met support."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się bezpiecznie zapisać autoryzacji usunięcia danych usługi pośredniczącej. Background Sync pozostaje wyłączony; spróbuj ponownie lub skontaktuj się z pomocą techniczną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar com segurança a autorização para excluir o retransmissor. O Background Sync continua desativado; tente novamente ou entre em contato com o suporte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно сохранить авторизацию удаления данных ретранслятора. Background Sync остаётся выключенным; повторите попытку или обратитесь в службу поддержки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behörigheten att radera relädata kunde inte sparas säkert. Background Sync förblir avstängt; försök igen eller kontakta supporten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกการอนุญาตให้ลบรีเลย์อย่างปลอดภัยได้ Background Sync จะยังคงปิดใช้ โปรดลองอีกครั้งหรือติดต่อฝ่ายช่วยเหลือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarıcı silme yetkisi güvenli biçimde kaydedilemedi. Background Sync devre dışı kalır; yeniden deneyin veya destek ekibiyle iletişime geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося безпечно зберегти авторизацію на видалення з ретранслятора. Background Sync залишається вимкненим; повторіть спробу або зверніться до служби підтримки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu an toàn quyền xóa khỏi dịch vụ chuyển tiếp. Background Sync vẫn bị tắt; hãy thử lại hoặc liên hệ bộ phận hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存中继删除授权。Background Sync 仍处于停用状态；请重试或联系支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全儲存中繼刪除授權。Background Sync 仍處於停用狀態；請再試一次或聯絡支援人員。"
          }
        }
      }
    },
    "Could not stage all local file changes before push.": {},
    "Could not stage local file changes before push.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إجراء تغييرات على الملف المحلي قبل الدفع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke iscenesætte lokale filændringer før push."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Dateiänderungen konnten vor dem Push nicht bereitgestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar los cambios del archivo local antes de la inserción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallisia tiedostomuutoksia ei voitu esittää ennen paikkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre en scène les modifications de fichiers locaux avant de pousser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו להכין את השינויים בקובץ המקומי לפני הפעלת ה-\"push\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": पुश से पहले स्थानीय फ़ाइल में हुए परिवर्तनों को स्टेज नहीं किया जा सका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A lokal fájl-módosítások feltöltése előtt nem sikerült."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengatur perubahan file lokal sebelum proses penekanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile preparare i cambiamenti ai file locali prima della push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：プッシュ前に、ローカルファイルの変更をステージングできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 푸시 전 로컬 파일 변경 사항을 스테이지할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kunne ikke forberede lokale filendringer før push."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kan de wijzigingen in lokale bestanden niet voorbereiden voordat er wordt gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zmian w lokalnych plikach przed pushem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar as alterações nos arquivos locais antes do push."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить изменения локальных файлов перед пушем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte förbereda lokala filändringar innan push."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ไม่สามารถจัดเตรียมการเปลี่ยนแปลงไฟล์ท้องถิ่นก่อนการส่ง (push) ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yükleme işleminden önce yerel dosya değişikliklerini stage etemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зафіксувати зміни у локальних файлах перед пушем."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuẩn bị các thay đổi trên tệp cục bộ trước khi đẩy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：在推送前无法对本地文件变更进行暂存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：在推送前無法對本地文件變更進行暫存。"
          }
        }
      },
      "extractionState": "stale"
    },
