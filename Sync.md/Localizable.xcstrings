    "Repository corrupted: %@. Try removing and re-cloning.": {
      "comment": "Error when the local git repository is in a corrupted state. %@ is the detail.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستودع تالف: %@. حاول إزالته وإعادة استنساخه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository beskadiget: %@. Proev at fjerne og klone igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository beschädigt: %@. Versuche es zu entfernen und neu zu klonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository corrupted: %@. Try removing and re-cloning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositorio corrupto: %@. Intenta eliminarlo y clonarlo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietovarasto vioittunut: %@. Kokeile poistaa ja kloonata uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépôt corrompu : %@. Essayez de le supprimer et de le cloner à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאגר פגום: %@. נסה להסיר ולשכפל מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी दूषित: %@। हटाकर दोबारा क्लोन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tároló sérült: %@. Próbáld meg eltávolítani és újra klónozni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori rusak: %@. Coba hapus dan clone ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository corrotto: %@. Prova a rimuoverlo e clonarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリが破損しています: %@。削除して再クローンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소가 손상되었습니다: %@. 삭제 후 다시 복제하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositoriet er skadet: %@. Prøv å fjerne og klone på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository beschadigd: %@. Probeer te verwijderen en opnieuw te klonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium uszkodzone: %@. Spróbuj usunąć i sklonować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório corrompido: %@. Tente remover e clonar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий повреждён: %@. Попробуйте удалить и клонировать заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förrådet är skadat: %@. Försök ta bort och klona på nytt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository เสียหาย: %@ ลองลบแล้วโคลนใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo bozulmuş: %@. Kaldırıp yeniden klonlamayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторій пошкоджено: %@. Спробуйте видалити та клонувати повторно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ bị hỏng: %@. Hãy xóa và sao chép lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库已损坏：%@。请尝试移除后重新克隆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫已損毀：%@。請嘗試移除後重新複製。"
          }
        }
      }
    },
    "Repository not cloned yet. Clone it first.": {
      "comment": "Error when a git operation is attempted on a repository that has not been cloned",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم استنساخ المستودع بعد. قم باستنساخه أولاً."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository er ikke klonet endnu. Klon det foerst."
