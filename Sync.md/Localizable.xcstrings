    "Use GitHub sign-in, a token, an SSH key, or public access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تسجيل الدخول GitHub، أو الرمز المميز، أو مفتاح SSH، أو الوصول العام."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug GitHub-logon, et token, en SSH-nøgle eller offentlig adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Anmeldung GitHub, ein Token, einen Schlüssel SSH oder öffentlichen Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el inicio de sesión GitHub, un token, una clave SSH o acceso público."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "-käyttö GitHub sisäänkirjautuminen, SSH avain, tai yleinen pääsy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation GitHub connexion : un jeton, un\nClé SSH ou accès public."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– שימוש GitHub – כניסה, טוקן, אֶת\nקוד SSH או גישה ציבורית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": उपयोग GitHub साइन-इन, एक टोकन, एक SSH कुंजी या सार्वजनिक पहुँच।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használata GitHub bejelentkezéshez szükséges token: SSH kulcs vagy nyilvános hozzáférés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan GitHub login, token, sebuah\nKunci SSH atau akses publik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzo GitHub : accesso, un token, un\nChiave SSH o accesso pubblico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GitHub ：サインイン、トークン、および SSH キーまたは公開アクセス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 GitHub 로그인: 토큰, SSH 키 또는 공개 접근 권한입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk GitHub innskjema, et token, en SSH -sjekkkode, eller offentlig tilgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik GitHub : inloggen, een token, een SSH sleutel of open toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– Użycie GitHub : logowanie, token,\nKlucz SSH lub dostęp publiczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilização GitHub login, um token, um\nChave SSH ou acesso público."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Управление GitHub вход: токен,\nКлюч SSH или публичный доступ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användning GitHub inloggning, ett token, en SSH -säkerhetsnyckel eller offentlig åtkomst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้งาน GitHub : การเข้าสู่ระบบ, โทเคน, และอื่นๆ SSH คีย์ หรือการเข้าถึงสาธารณะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım GitHub giriş için bir token, bir SSH anahtarı veya kamu erişimi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "— Використання GitHub : вход до системи, токен,\nКлюч SSH або публічний доступ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Sử dụng GitHub : đăng nhập, mã xác thực, một\nChìa khóa SSH hoặc quyền truy cập công khai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用说明 GitHub 登录、令牌、 SSH 密钥或公共访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用説明 GitHub 登録、令牌、 SSH 密鑰或公共訪問權限。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Use HTTPS, SSH, git://, file://, or owner/repo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم HTTPS، SSH، git://, file://, أو المالك/الريبو."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug HTTPS, SSH, git://, file://, eller ejer/repo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie HTTPS, SSH, git://, file://, oder Besitzer/Repo."
          }
        },
        "es": {
