    "Remote branch '%@' was not found on origin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على الفرع البعيد '%@' في origin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerngren '%@' blev ikke fundet på origin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Zweig „%@“ wurde auf origin nicht gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la rama remota '%@' en origin."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etäosasto &#39;%@&#39; ei löytynyt osoitteesta origin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branche distante&#39;%@&#39;n&#39;a pas été trouvé sur origin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנוי מרוחק '%@לא נמצאה ב- origin."
          }
        },
        "hi": {
          "stringUnit": {
