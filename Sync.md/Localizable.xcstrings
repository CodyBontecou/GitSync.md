    "Access to the chosen clone location is unavailable. Reconnect it before cloning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى موقع الاستنساخ المحدد غير متاح. أعد الاتصال به قبل الاستنساخ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke adgang til den valgte klonplacering. Genopret forbindelsen, før du kloner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf den gewählten Klon-Speicherort. Verbinden Sie ihn vor dem Klonen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay acceso a la ubicación de clonación elegida. Vuelve a conectarla antes de clonar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittuun kloonaussijaintiin ei ole pääsyä. Yhdistä se uudelleen ennen kloonausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement de clonage choisi est inaccessible. Reconnectez-le avant de cloner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למיקום השכפול שנבחר אינה זמינה. חברו אותו מחדש לפני השכפול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए क्लोन स्थान तक एक्सेस उपलब्ध नहीं है। क्लोन करने से पहले इसे फिर से कनेक्ट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt klónozási hely nem érhető el. Csatlakoztassa újra a klónozás előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses ke lokasi clone yang dipilih tidak tersedia. Hubungkan ulang sebelum clone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione di clonazione scelta non è accessibile. Ricollegala prima di clonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したクローン先にアクセスできません。クローンする前に再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 클론 위치에 접근할 수 없습니다. 클론하기 전에 다시 연결하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang til valgt klonested er utilgjengelig. Koble til på nytt før kloning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de gekozen kloonlocatie. Verbind deze opnieuw voordat u kloont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do wybranej lokalizacji klonowania. Połącz ją ponownie przed klonowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao local de clonagem escolhido está indisponível. Reconecte-o antes de clonar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранное место для клонирования недоступно. Подключите его заново перед клонированием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till den valda klonplatsen är inte tillgänglig. Anslut den igen innan du klonar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงตำแหน่ง clone ที่เลือกไม่ได้ เชื่อมต่อใหม่ก่อน clone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klonlama konumuna erişilemiyor. Klonlamadan önce yeniden bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибране місце для клонування недоступне. Підключіть його знову перед клонуванням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập vị trí clone đã chọn. Hãy kết nối lại trước khi clone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问所选的克隆位置。请在克隆前重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取所選的複製位置。請在複製前重新連接。"
          }
        }
      }
    },
    "Access to the original folder is unavailable. Reconnect the folder to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى المجلد الأصلي غير متاح. أعد ربط المجلد للمتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke adgang til den oprindelige mappe. Genopret forbindelsen til mappen for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf den ursprünglichen Ordner. Verbinden Sie den Ordner erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay acceso a la carpeta original. Vuelve a conectar la carpeta para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäiseen kansioon ei ole pääsyä. Jatka yhdistämällä kansio uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier d’origine est inaccessible. Reconnectez le dossier pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה לתיקייה המקורית אינה זמינה. חברו מחדש את התיקייה כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ोल्डर तक एक्सेस उपलब्ध नहीं है। जारी रखने के लिए फ़ोल्डर को फिर से कनेक्ट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredeti mappa nem érhető el. A folytatáshoz csatlakoztassa újra a mappát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses ke folder asli tidak tersedia. Hubungkan ulang folder untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella originale non è accessibile. Ricollega la cartella per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のフォルダにアクセスできません。続行するにはフォルダを再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 폴더에 접근할 수 없습니다. 계속하려면 폴더를 다시 연결하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang til den opprinnelige mappen er utilgjengelig. Koble til mappen på nytt for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de oorspronkelijke map. Verbind de map opnieuw om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do oryginalnego folderu. Połącz folder ponownie, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à pasta original está indisponível. Reconecte a pasta para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная папка недоступна. Подключите папку заново, чтобы продолжить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till originalmappen är inte tillgänglig. Anslut mappen igen för att fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงโฟลเดอร์ต้นฉบับไม่ได้ เชื่อมต่อโฟลเดอร์ใหม่เพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün klasöre erişilemiyor. Devam etmek için klasörü yeniden bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
