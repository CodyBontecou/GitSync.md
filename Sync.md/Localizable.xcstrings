    "Remote updates arrived while local changes were being prepared.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت تحديثات remote أثناء إعداد التغييرات المحلية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kom opdateringer fra remoten, mens lokale ændringer blev forberedt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während lokale Änderungen vorbereitet wurden, sind Remote-Aktualisierungen eingetroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han llegado actualizaciones remotas mientras se preparaban los cambios locales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remoteen saapui päivityksiä paikallisia muutoksia valmisteltaessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mises à jour distantes sont arrivées pendant la préparation des modifications locales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכונים מה־remote הגיעו בזמן שהשינויים המקומיים הוכנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय बदलाव तैयार किए जा रहे थे तभी remote अपडेट आए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Távoli frissítések érkeztek, miközben a helyi módosításokat előkészítették."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan remote tiba saat perubahan lokal sedang disiapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono arrivati aggiornamenti remoti mentre venivano preparate le modifiche locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの変更を準備中にリモートの更新が届きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 변경 사항을 준비하는 동안 remote 업데이트가 도착했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-oppdateringer kom inn mens lokale endringer ble klargjort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn remote updates binnengekomen terwijl lokale wijzigingen werden voorbereid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas przygotowywania lokalnych zmian nadeszły aktualizacje zdalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações remotas chegaram enquanto as alterações locais eram preparadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые обновления поступили во время подготовки локальных изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjärruppdateringar kom medan lokala ändringar förbereddes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการอัปเดตจาก remote เข้ามาขณะที่กำลังเตรียมการเปลี่ยนแปลงในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel değişiklikler hazırlanırken uzak güncellemeler geldi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки готувалися локальні зміни, надійшли віддалені оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản cập nhật từ xa đến trong khi đang chuẩn bị thay đổi cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备本地更改时收到了远程更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備本機變更時收到了遠端更新。"
          }
        }
      }
    },
    "Remote updates must be pulled before pushing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب سحب تحديثات remote قبل إجراء push."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateringer fra remoten skal hentes, før der pushes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Aktualisierungen müssen vor dem Push gepullt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que hacer pull de las actualizaciones remotas antes de hacer push."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remoten päivitykset on pullattava ennen pushia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour distantes doivent être récupérées avant le push."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבצע pull של עדכונים מה־remote לפני push."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Push से पहले remote अपडेट को pull करना होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A távoli frissítéseket pullolni kell push előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan remote harus di-pull sebelum push."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario eseguire il pull degli aggiornamenti remoti prima del push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "push の前にリモートの更新を pull する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "push하기 전에 remote 업데이트를 pull해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-oppdateringer må hentes med pull før du pusher."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote updates moeten eerst worden gepulld voordat je pusht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed wykonaniem push trzeba pobrać aktualizacje zdalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário fazer pull das atualizações remotas antes do push."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед push необходимо получить удалённые обновления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjärruppdateringar måste hämtas före push."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้อง pull การอัปเดตจาก remote ก่อน push"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push’tan önce uzak değişiklikler pull edilmelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед push потрібно виконати pull віддалених змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần pull các thay đổi từ xa trước khi push."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须先 pull 远程更改，然后才能 push。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須先 pull 遠端變更，然後才能 push。"
          }
        }
      }
    },
