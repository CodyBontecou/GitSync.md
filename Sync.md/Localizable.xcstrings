            "value": "iCloud Drive, папки інших програм або будь-яке місце у Files"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive, thư mục của ứng dụng khác hoặc bất kỳ đâu trong Files"
          }
        },
        "zh-Hans": {
