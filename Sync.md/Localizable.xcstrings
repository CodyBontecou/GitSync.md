    "No repository matches “%@”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مستودع يطابق “%@”."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet repository matcher “%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Repository passt zu „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún repositorio coincide con “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään tietovarasto ei vastaa hakua “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dépôt ne correspond à “%@”."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מאגר שתואם ל-“%@”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” से कोई रिपॉज़िटरी मेल नहीं खाती।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy tároló sem egyezik ezzel: „%@”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada repositori yang cocok dengan “%@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun repository corrisponde a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致するリポジトリはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”과(와) 일치하는 저장소가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen repositorier samsvarer med «%@»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen repository komt overeen met “%@”."
          }
        },
        "pl": {
