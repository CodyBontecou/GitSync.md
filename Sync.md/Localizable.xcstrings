    "Removing a repository from GitSync.md now keeps the files on your device, so folders shared with other apps stay safe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤدي إزالة مستودع من GitSync.md الآن إلى الاحتفاظ بالملفات الموجودة على جهازك، وبالتالي تظل المجلدات المشتركة مع التطبيقات الأخرى آمنة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernelse af et lager fra GitSync.md bevarer nu filerne på din enhed, så mapper, der deles med andre apps, forbliver sikre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Entfernen eines Repositorys aus GitSync.md bleiben die Dateien jetzt auf Ihrem Gerät, sodass mit anderen Apps geteilte Ordner sicher bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar un repositorio de GitSync.md ahora se mantienen los archivos en su dispositivo, por lo que las carpetas compartidas con otras aplicaciones permanecen seguras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "poistetaan arkistosta GitSync.md säilyttää nyt tiedostot laitteellesi, joten muiden sovellusten kanssa jaetut kansiot pysyvät turvallisina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un référentiel de GitSync.md conserve désormais les fichiers sur votre appareil, afin que les dossiers partagés avec d&#39;autres applications restent en sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ":取りout של מאגר מ- GitSync.md מחזיק את הקבצים על המכשיר שלך, ולכן תיקי קובץ ש공유ים עם אפליקציות אחרות נשארים בטוחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिपॉजिटरी को हटाना GitSync.md अब आपके डिवाइस पर फ़ाइलों को संग्रहित करता है, जिससे अन्य ऐप्स के साथ साझा की गई फ़ोल्डर्स सुरक्षित रहती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": az adatmagazin eltávolítása\nA GitSync.md jelenleg a fájlokat az Ön eszközén tárolja, így más alkalmazásokkal együtt használt mappák biztonságban maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus repositori dari GitSync.md kini menyimpan file di perangkat Anda, sehingga folder yang dibagikan dengan aplikasi lain tetap aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimozione di un repository da GitSync.md conserva ora i file sul tuo dispositivo, in modo che le cartelle condivise con altre app rimangano al sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リポジトリの削除 GitSync.md は現在、ファイルを端末上に保存するため、他のアプリと共有されたフォルダも安全に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 저장소 제거 GitSync.md 는 이제 파일을 사용자의 기기에 저장하므로, 다른 앱과 공유된 폴더들도 안전하게 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Fjerning av et lagringsmottak fra GitSync.md beholder filene på ditt enhet, så mappen som dels med andre applikasjoner, forblir trygg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Het verwijderen van een repository uit GitSync.md bewaart de bestanden nu op uw apparaat, zodat mappen die met andere apps worden gedeeld, veilig blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie repositoriума z GitSync.md przechowuje pliki na Twoim urządzeniu, dzięki czemu katalogi udostępnione innych aplikacji pozostają bezpieczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remoção de um repositório de\nO GitSync.md agora mantém os arquivos no seu dispositivo, garantindo que as pastas compartilhadas com outros aplicativos permaneçam seguras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Удаление репозитория из GitSync.md теперь сохраняет файлы на вашем устройстве, поэтому папки, общие с другими приложениями, остаются безопасными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ta bort ett lagringsplats från GitSync.md behåller filerna på ditt enhet, så mappar delade med andra applikationer förblir säkra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การลบคลังข้อมูลออกจาก GitSync.md ปัจจุบันจะเก็บไฟล์ไว้บนอุปกรณ์ของคุณ ทำให้โฟลเดอร์ที่แชร์กับแอปอื่นยังคงปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Depoyu kaldırma GitSync.md artık dosyaları cihazınızda saklar; bu nedenle diğer uygulamalarla paylaşılan klasörler güvenli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Видалення репозиторію з GitSync.md зараз зберігає файли на вашому пристрої, тому папки, спільно використовувані з іншими додатками, залишаються безпекними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Xóa kho lưu trữ khỏi GitSync.md hiện lưu trữ các tệp tin trên thiết bị của bạn, nhờ đó các thư mục được chia sẻ với các ứng dụng khác vẫn được bảo vệ an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：从...中移除存储库 GitSync.md 现在会将文件保存于您的设备上，因此与其它应用共享的文件夹将保持安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：從...中移除存儲庫 GitSync.md 現在會將文件保存於您的設備上，因此與其它應用共享的文件夾將保持安全。"
          }
        }
      }
    },
