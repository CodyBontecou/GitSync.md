    "Ed25519, ECDSA, and RSA private keys are supported for clone, pull, and push.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519 وECDSA وRSA للاستنساخ والسحب والدفع.\nتحرير"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA og RSA private nøgler understøttes til kloning, pull og push."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA und RSA werden zum Klonen, Ziehen und Pushen unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves privadas Ed25519, ECDSA y RSA se admiten para clonación, extracción e inserción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, ja RSA yksityiset avaimet tuetaan kloonausta, vetää ja push."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, et\nLes clés privées RSA sont prises en charge pour cloner, tirer et pousser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, ו- RSA : מפתחות פרטיים מותקנים עבור Clone, Pull ו-Push."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, तथा RSA के लिए क्लोन, पुल और पुश के लिए निजी कुंजियों का समर्थन किया गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, és\nA RSA esetében a privát kulcsok támogatásra kerülnek a clone-, pull- és push-előfuttatási operációkhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, dan RSA : kunci privat didukung untuk operasi clone, pull, dan push."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, e RSA : le chiavi private sono supportate per i comandi clone, pull e push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA、および RSA ：クローン、プル、およびプッシュ操作において、私有鍵がサポートされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, 및 RSA : 클론, 풀, 푸시 작업에 대해 개인 키를 지원합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, og RSA : Privat nøkler støttes for klonering, pull og push."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, en RSA : privé sleutels worden ondersteund voor clone, pull en push."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, oraz RSA : klucze prywatne są obsługiwane dla operacji klonowania, pobierania i przesyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, e\nAs chaves privadas RSA são suportadas para clonagem, pull e push."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, и RSA : для операций клонирования, pull и push поддерживаются приватные ключи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, och RSA : Privata nycklar stöds för klonering, pull och push."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSAและ RSA : รองรับกุญแจส่วนตัวสำหรับการโคลน การดึง และการปั๊ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSAve RSA , klonlama, çekme ve yayma işlemlerinde özel anahtarları destekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, та RSA : приватні ключі підтримуються для клонування, «pull» та «push»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA, và RSA : Chìa khóa riêng được hỗ trợ cho các thao tác clone, pull và push."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA，以及 RSA ：支持在克隆、拉取和推送操作中使用私钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, ECDSA，以及 RSA ：支持在剋隆、拉取和推送操作中使用俬鑰。"
          }
        }
      }
    },
