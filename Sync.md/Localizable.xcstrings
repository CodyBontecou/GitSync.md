    "Fetch and apply remote changes": {
      "comment": "Subtitle for the pull action in the Git control sheet",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلب وتطبيق التغييرات البعيدة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent og anvend fjernændringer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Änderungen abrufen und anwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch and apply remote changes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener y aplicar cambios remotos"
          }
        },
        "fi": {
          "stringUnit": {
