    "This hides the repository from the previously cloned list. It won't delete local files or revoke GitHub access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إخفاء المستودع من القائمة المستنسخة مسبقًا. لن يقوم بحذف الملفات المحلية أو إلغاء الوصول إلى GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette skjuler depotet fra den tidligere klonede liste. Det vil ikke slette lokale filer eller tilbagekalde GitHub adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Repository aus der zuvor geklonten Liste ausgeblendet. Es werden weder lokale Dateien gelöscht noch der GitHub-Zugriff widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto oculta el repositorio de la lista previamente clonada. No eliminará archivos locales ni revocará el acceso a GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä piilottaa arkiston aiemmasta kloonatusta luettelosta. Se ei poista paikallisia tiedostoja tai peruu GitHub pääsy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Cette option cache le dépôt dans la liste précédemment clonée ; elle n'efface pas les fichiers locaux ni ne révoque ces droits. GitHub accès."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– מוסיפה סתרון למאגר מהרשימה שהוקלנה בעבר; לא ימחק קבצים מקומיים ולא יסגר את המאגר. GitHub גישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह रिपॉजिटरी को पहले क्लोन किए गए सूची से छिपाता है। यह स्थानीय फ़ाइलों को डिलीट नहीं करेगा या उनकी अधिकारता वापस नहीं लेगा। GitHub एक्सेस।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ez elrejti a tárolót az előző klonálás eredményeiből álló lista alól; nem törli a helyi fájlokat, sem leállítja az őket. GitHub hozzáférés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Fitur ini menyembunyikan repositori dari daftar yang sebelumnya telah dikloning; fitur ini tidak menghapus file lokal maupun membatalkan hak akses terhadapnya.\nAkses GitHub ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo comando nasconde il repository dalla lista precedentemente clonata; non elimina i file locali né revoca tali file. GitHub accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：このオプションは、以前にクローンされたリストからリポジトリを非表示にします。ローカルファイルの削除や権限の取り消しは行われません。 GitHub アクセス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이 옵션은 기존에 클로닝된 목록에서 저장소를 은폐합니다. 로컬 파일을 삭제하거나 권한을 철회하지 않습니다. GitHub 액세스."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "skjuler lagringsplatsen fra den tidligere klonede listen. Den sletter ikke lokale filer eller avviser rettigheter. GitHub tilgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "verbergt het repository van de eerdere gekloneerde lijst; het verwijdert geen lokale bestanden en ontzegt deze niet. GitHub -toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ten element ukrywa repositorium z poprzedniego listu klonowanych plików; nie usuwa lokalnych plików ani odwołuje uprawnienia. GitHub dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Este comando oculta o repositório da lista anteriormente clonada; não exclui arquivos locais nem revoga as permissões.\nAcesso a GitHub ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Этот параметр скрывает репозиторий из предыдущего списка клонов; он не удаляет локальные файлы и не аннулирует их права доступа.\nДоступ к GitHub ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "döljer lagringsplatsen från den tidigare klonade lista. Den raderar inte lokala filer eller avkrynger dem. GitHub tillgång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ฟังก์ชันนี้จะปิดการแสดง repositorie ในรายการที่เคย clon ไว้ ก่อนหน้านี้ โดยจะไม่ลบไฟล์ในระบบ local หรือยกเลิกสิทธิ์ใดๆ GitHub access"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu işlem, depoyu daha önce klonlanmış listeden gizler; yerel dosyaları silmez veya onları geri almaz. GitHub erişimi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": це приховує репозиторій з попереднього списку клонуваних репозиторіїв; він не видаляє локальні файли і не скасовує доступ до них. GitHub доступ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tính năng này sẽ ẩn kho dữ liệu khỏi danh sách các bản clon trước đó; tính năng này không xóa các tệp cục bộ cũng như không hủy bỏ quyền truy cập. GitHub access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：此选项可将存储库从先前克隆的列表中隐藏，但不会删除本地文件或撤销该操作。 GitHub 访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：此選項可將存儲庫從先前剋隆的列錶中隱藏，但不會刪除本地文件或撤銷該操作。 GitHub 訪問權限。"
          }
        }
      }
    },
