            "value": "O Background Sync não conseguiu vincular esta compra à instalação atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Sync не удалось связать эту покупку с текущей установкой."
          }
        },
        "sv": {
