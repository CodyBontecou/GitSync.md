    "Git LFS SSH host key for %@:%@ changed. Expected %@, got %@. This may indicate a man-in-the-middle attack.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Git LFS SSH host key for %1$@:%2$@ changed. Expected %3$@, got %4$@. This may indicate a man-in-the-middle attack."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH : مفتاح المضيف الخاص بـ\nتم تغيير %1$@:%2$@ ، والنتيجة متوقعة. %3$@، تم استلامه. %4$@– قد يشير هذا إلى هجوم «الرجل في الوسط»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH -host-s nøgle for %1$@:%2$@ ændret. Forventet. %3$@, fået %4$@– dette kan tyde på en man-in-the-middle-angreb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH -Host-Schlüssel für %1$@:%2$@ geändert. Erwartet. %3$@, erhalten %4$@– Dies könnte auf einen Man-in-the-Middle-Angriff hindeuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH clave del host para %1$@:%2$@ cambiado. Esperado. %3$@, obtenido %4$@. Esto podría indicar un ataque de tipo «man in the middle»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH -hostin avain %1$@:%2$@ muutettiin. Odotettu. %3$@, saatu %4$@– tämä voi viittaavan man-in-the-middle-ahdistukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH clé d'hôte pour %1$@:%2$@ a été modifié. Attendu. %3$@, obtenu %4$@. Cela peut indiquer un attaque par homme en entre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH – מפתח המארח עבור %1$@:%2$@ שונה – צפוי. %3$@, נמצאה %4$@– זה עשוי להצביע על התקפה מסוג \"man-in-the-middle\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH के लिए होस्ट कुंजी %1$@:%2$@ में परिवर्तन हुआ। अपेक्षित। %3$@, प्राप्त हुआ। %4$@— यह 'मैन-इन-द-मिडल' हमले का संकेत दे सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH : a host kulcs %1$@:%2$@ módosítva – várható eredmény %3$@– kapott %4$@– ez egyes esetekben egy „man-in-the-middle\" támadásnak számíthat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH kunci host untuk %1$@:%2$@ telah diubah. Sesuai harapan. %3$@, diperoleh %4$@. Hal ini dapat menunjukkan serangan *man-in-the-middle*."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH chiave host per %1$@:%2$@ modificato. Aspettative: %3$@, ottenuto %4$@. Questo potrebbe indicare un attacco man-in-the-middle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
