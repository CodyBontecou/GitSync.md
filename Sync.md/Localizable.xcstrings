    "Your files live in the Files app. Edit with any text editor, then come back to commit and push your changes upstream.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفاتك موجودة في تطبيق الملفات. قم بالتحرير باستخدام أي محرر نصوص، ثم عد للالتزام ودفع التغييرات إلى أعلى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine filer live i appen Filer. Rediger med en hvilken som helst teksteditor, og kom derefter tilbage for at forpligte og skubbe dine ændringer opstrøms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Dateien befinden sich in der Dateien-App. Bearbeiten Sie die Änderungen mit einem beliebigen Texteditor und übertragen Sie Ihre Änderungen anschließend erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus archivos se encuentran en la aplicación Archivos. Edite con cualquier editor de texto, luego regrese para confirmar e impulsar sus cambios en sentido ascendente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostosi elää tiedostossa. Muokkaa mitä tahansa tekstieditori, sitten palaa toimittamaan ja työnnä muutoksia ylösvirtaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers se trouvent dans l'application « Files ». Modifiez-les avec n'importe quel éditeur de texte, puis revenez pour effectuer le commit et le push de vos modifications vers la branche principale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הקבצים שלך נמצאים בaplication Files.ערוך אותם באמצעות כל מעריך טקסט, ואז戔回 כדי להשלים והשלוח את השינויים אל הרצף הראשי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": आपके फ़ाइलें 'Files' ऐप में संग्रहीत हैं। किसी भी टेक्स्ट एडिटर का उपयोग करके फ़ाइलों को संपादित करें, फिर अपने परिवर्तनों को कमिट करने और पुश करने के लिए वापस लौटें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Az állományokat az „Files\" alkalmazásban találhatók. Átformázza az állományt bármely szövegszerkesztővel, majd visszatérjen a „commit\" és a „push\" funkcióhoz, hogy átalakított változatait küldje az összeadott csatornára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas Anda berada di aplikasi Files. Edit menggunakan editor teks apa pun, kemudian kembali untuk melakukan komit dan push perubahan Anda ke repositori induk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I vostri file si trovano nell'app Files. Modificate con qualsiasi editor di testo, quindi tornate per confermare e pushare i vostri cambiamenti verso l'upstream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：あなたのファイルは「Files」アプリ内に保存されています。任意のテキストエディタで編集後、変更をコミットし、プッシュします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 귀하의 파일은 Files 앱에 저장되어 있습니다. 어떤 텍스트 편집기로도 파일을 수정한 후, 다시 돌아와 변경 내용을 커밋하고 푸시하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine filer finnes i Files-appen. Rediger filene med en hvilken som helst tekstrediger, og gå deretter tilbake for å bekrefte og pushe endringene dine oppover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bestanden bevinden zich in de Files-app. Bewerk ze met een teksteditor, en ga daarna terug om uw wijzigingen te bevestigen en naar de upstream toe te pushen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pliki znajdują się w aplikacji „Files\". Edytuj je za pomocą dowolnego edytora tekstu, a następnie wróć do procesu commitowania i pushingu zmian do źródła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos estão no aplicativo Files. Edite-os com qualquer editor de texto e depois retorne para realizar o commit e o push das suas alterações no fluxo principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": ваши файлы находятся в приложении «Files». Редактируйте их с помощью любого текстового редактора, затем вернитесь, чтобы выполнить коммит и推送 ваших изменений в центральный репозиторий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina filer finns i Filappen. Redigera filerna med vilken textredigerare som helst, och gå sedan tillbaka för att bekräfta och pusha dina ändringar uppströms."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ของคุณอยู่ในแอป Files ให้แก้ไขไฟล์ด้วยโปรแกรมแก้ไขข้อความใดๆ จากนั้นกลับมาดำเนินการ commit และ push การเปลี่ยนแปลงของคุณไปยัง upstream"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınız Files uygulamasında bulunur. Herhangi bir metin düzenleyicisiyle düzenleme yapın, ardından değişikliklerinizi kaydetmek ve push etmek için geri dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші файли розташовані в додатку «Files». Змініть їх за допомогою будь-якого текстового редактора, а потім поверніться до цього додатка, щоб зафіксувати та пушити ваші зміни у головний репозиторій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các tệp của bạn nằm trong ứng dụng Files. Hãy chỉnh sửa bằng bất kỳ trình soạn thảo văn bản nào, sau đó quay lại để thực hiện commit và push các thay đổi này lên nguồn gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：您的文件存储于“Files”应用中。您可以使用任何文本编辑器进行编辑，然后返回提交并将更改推送到上游仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：您的文件存儲於“Files”應用中。您可以使用任何文本編輯器進行編輯，然後返迴提交併將更改推送到上遊倉庫。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Your files stay in their original folder. Keep the app open during the first upload.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملفاتك في مجلدها الأصلي. أبقِ التطبيق مفتوحًا أثناء الرفع الأول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine filer bliver i deres oprindelige mappe. Hold appen åben under den første upload."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Dateien bleiben in ihrem ursprünglichen Ordner. Lassen Sie die App während des ersten Uploads geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos se quedan en su carpeta original. Mantén la app abierta durante la primera subida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostosi pysyvät alkuperäisessä kansiossaan. Pidä sovellus auki ensimmäisen latauksen ajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers restent dans leur dossier d’origine. Gardez l’app ouverte pendant le premier envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים שלכם נשארים בתיקייה המקורית. השאירו את היישום פתוח במהלך ההעלאה הראשונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ाइलें अपने मूल फ़ोल्डर में रहती हैं। पहले अपलोड के दौरान ऐप खुला रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájljai az eredeti mappában maradnak. Az első feltöltés alatt tartsa nyitva az appot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File Anda tetap di folder aslinya. Biarkan app tetap terbuka selama unggahan pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file restano nella cartella originale. Tieni aperta l'app durante il primo caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは元のフォルダに残ります。最初のアップロード中はアプリを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 원래 폴더에 남아 있습니다. 첫 업로드 중에는 앱을 열어 두십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filene dine blir i den opprinnelige mappen. Hold appen åpen under den første opplastingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bestanden blijven in hun oorspronkelijke map. Houd de app open tijdens de eerste upload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pliki zostają w oryginalnym folderze. Nie zamykaj aplikacji podczas pierwszego wysyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos ficam na pasta original. Mantenha o app aberto durante o primeiro envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши файлы остаются в исходной папке. Не закрывайте приложение во время первой загрузки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina filer stannar i sin ursprungliga mapp. Håll appen öppen under den första uppladdningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ของคุณอยู่ในโฟลเดอร์เดิม เปิดแอปไว้ระหว่างการอัปโหลดครั้งแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınız özgün klasörlerinde kalır. İlk yükleme sırasında uygulamayı açık tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші файли залишаються в початковій папці. Не закривайте застосунок під час першого завантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp của bạn vẫn ở thư mục gốc. Hãy giữ ứng dụng mở trong lần tải lên đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的文件保留在原始文件夹中。首次上传期间请保持 App 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的檔案會保留在原始資料夾中。首次上傳期間請保持 App 開啟。"
          }
        }
      }
    },
    "Your folder and saved progress are preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بمجلدك وتقدمك المحفوظ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mappe og dine gemte fremskridt er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Ordner und der gespeicherte Fortschritt bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu carpeta y el progreso guardado se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiosi ja tallennettu edistyminen on säilytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dossier et la progression enregistrée sont conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיקייה וההתקדמות השמורה שלכם נשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोल्डर और सहेजी गई प्रगति सुरक्षित है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mappáját és a mentett előrehaladást megőriztük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder dan progres tersimpan Anda dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cartella e l'avanzamento salvato sono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダと保存された進捗は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더와 저장된 진행 상황은 보존되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen din og den lagrede fremdriften er bevart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw map en bewaarde voortgang blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój folder i zapisany postęp zostały zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua pasta e o progresso salvo foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша папка и сохранённый прогресс сохранены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mapp och ditt sparade förlopp har bevarats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์และความคืบหน้าที่บันทึกไว้ได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörünüz ve kaydedilen ilerleme korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашу папку й збережений прогрес збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục và tiến trình đã lưu của bạn vẫn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的文件夹和已保存的进度已被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資料夾和已儲存的進度已保留。"
          }
        }
      }
    },
