    "Unknown SSH hosts show a fingerprint prompt, and changed host keys are blocked until you review them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض مضيفات SSH غير المعروفة مطالبة ببصمة الإصبع، ويتم حظر مفاتيح المضيف التي تم تغييرها حتى تقوم بمراجعتها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukendt SSH-værter viser en fingeraftryksprompt, og ændrede værtsnøgler blokeres, indtil du gennemgår dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte SSH-Hosts zeigen eine Fingerabdruck-Eingabeaufforderung an und geänderte Hostschlüssel werden blockiert, bis Sie sie überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hosts SSH desconocidos muestran un mensaje de huella digital y las claves de host modificadas se bloquean hasta que las revise."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuntematon SSH - isännät näyttävät sormenjälkikäsittelyn, ja muutettu isännän avaimet on estetty kunnes tarkistaa ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Inconnu\nLes hôtes SSH affichent un message de demande de signature, et les clés d'hôte modifiées sont bloquées jusqu'à ce que vous les examiniez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ידוע\nב- SSH מופיע דף הבקשה לấnוח, והключаות של המארח שנ改变了 מוסתרות עד שבדוק אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": अज्ञात SSH होस्ट्स में फिंगरप्रिंट प्रोम्प्ट दिखाई देता है, तथा बदले हुए होस्ट कीज़ को आप उनकी समीक्षा करने तक अवरुद्ध रखा जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ismertetetlen\nA SSH hostoknál egy fingerprím-kérelem megjelenik, és a módosított host kulcsokat csak akkor engedhetik meg, ha ezeket átnézik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak Diketahui SSH menampilkan tampilan pesan fingerprint, dan kunci host yang telah diubah akan dilarang sampai Anda meninjaunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Sconosciuto\nI host SSH mostrano un prompt di impronta digitale e le chiavi degli host modificate vengono bloccate fino a quando non le esamini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：不明 SSH ホストでは、フィンガープリント認証のポップアップが表示され、変更されたホストキーは、確認するまでブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 미지 SSH 호스트에서는 지문 인증 프롬프트가 표시되며, 변경된 호스트 키는 확인할 때까지 차단됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukjent SSH -hostene viser et fingeravtrykkspørsmål, og endrede host-nytter er blokkert til du vurderer dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbekend\nDe SSH -hosts tonen een aanvraag voor een vingerafdruk, en gewijzigde host-sleutels worden geblokkeerd totdat u deze beoordeelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieznane\nW przypadku SSH serwerzy pokazują okno z prośbą o podanie ścieżki, a zmienione klucze serwerów są blokowane, aż nie przeanalizujesz ich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconhecido\nOs hosts SSH exibem um aviso de impressão digital, e as chaves de host alteradas são bloqueadas até que você as revise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Неизвестно\nНа хостах SSH появляется запрос подтверждения отпечатка пальца; изменённые ключи хостов блокируются до тех пор, пока вы не ознакомитесь с ними."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Okänd SSH -hoster visar en fingeravtrycksprompt, och förändrade hosternycklar är blockerade tills du granskar dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ไม่ทราบ SSH แสดงข้อความแจ้งเตือน &#039;Fingerprint Prompt&#039; และจะปิดกั้นการใช้คีย์โฮสต์ที่เปลี่ยนไป จนกว่าคุณจะตรวจสอบข้อมูลเหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bilinmiyor SSH sunucularında parmak izi uyarısı gösterilir ve değiştirilen sunucu anahtarları, bu anahtarları incelemenizde kadar bloke edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "– невідомо\nУ SSH веб-сервери відображають попередження про «fingerprint», а змінені ключі хостів блокуються до того часу, поки ви не перевірите їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Không xác định SSH sẽ hiển thị thông báo yêu cầu xác nhận dấu vân tay, và các khóa máy chủ đã được thay đổi sẽ bị chặn cho đến khi bạn xem xét lại chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：未知 SSH 主机会显示指纹提示，且已修改的主机密钥将被阻止，直至您进行审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：未知 SSH 主機會顯示指紋提示，且已修改的主機密鑰將被阻止，直至您進行審覈。"
          }
        }
      }
    },
