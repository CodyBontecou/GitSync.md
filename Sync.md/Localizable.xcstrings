    "Internal error: rebase requested for a fast-forward pull": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ داخلي: تم طلب إعادة الأساس لعملية سحب سريعة للأمام"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intern fejl: rebase anmodet om et hurtigt frem-træk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interner Fehler: Rebase für einen schnellen Vorlauf angefordert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error interno: se solicitó rebase para un avance rápido"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "sisäinen virhe: pyydetään uudelleenperustamista nopean etenemisen hankinnassa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur interne: rebase demandée pour un pull rapide"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שגיאה פנימית: מבקש إعادة התחזוקה עבור pulling מהירה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": आंतरिक त्रुटि: 'fast-forward pull' के लिए 'rebase' का अनुरोध किया गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "belső hiba: gyors előrejutási kivitelhez rebase-kérést kapott"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eror internal: permintaan rebase untuk pull fast-forward"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore interno: è stata richiesta una rebase per un pull con fast-forward"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部エラー：ファストフォワードプルに対してリベースが要求されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 오류: Fast-forward pull 시 rebase 요청됨"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Intern feil: Rebase er foreslått for en «fast-forward pull»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interne fout: 'rebase' is gevraagd voor een fast-forward pull"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błąd wewnętrzny: żądane jest wykonanie operacji rebase dla operacji pull z funkcją „fast-forward\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro interno: requisição de rebase para um pull de fast-forward"
          }
        },
        "ru": {
          "stringUnit": {
