          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Xóa các bản sao kho lưu trữ cũ trên thiết bị trực tiếp từ ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：直接从应用中移除旧的设备端存储库副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：直接從應用中移除舊的設備端存儲庫副本。"
          }
        }
      }
    },
