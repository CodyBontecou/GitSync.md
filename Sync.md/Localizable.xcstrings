    "Only you and people you grant access can see this repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن رؤية هذا المستودع إلا لك وللأشخاص الذين تمنحهم الوصول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun du og personer, du giver adgang, kan se dette repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Sie und Personen, denen Sie Zugriff gewähren, können dieses Repository sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú y las personas a las que des acceso pueden ver este repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sinä ja ihmiset, joille annat käyttöoikeuden, näkevät tämän tietovaraston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls vous et les personnes à qui vous donnez accès pouvez voir ce dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק אתם ואנשים שתעניקו להם גישה יכולים לראות את המאגר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आप और वे लोग जिन्हें आप एक्सेस देते हैं, इस रिपॉज़िटरी को देख सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a tárolót csak Ön és azok láthatják, akiknek hozzáférést ad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya Anda dan orang yang Anda beri akses yang dapat melihat repositori ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu e le persone a cui concedi l'accesso potete vedere questo repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリは、あなたとアクセスを許可したユーザーのみが閲覧できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인과 접근 권한을 부여한 사람만 이 저장소를 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare du og personer du gir tilgang kan se dette repositoriet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen u en mensen aan wie u toegang geeft, kunnen deze repository zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To repozytorium widzisz tylko Ty i osoby, którym przyznasz dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente você e as pessoas a quem der acesso podem ver este repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот репозиторий видите только вы и люди, которым вы дали доступ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast du och personer du ger åtkomst kan se det här arkivet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคุณและผู้ที่คุณให้สิทธิ์เท่านั้นที่ดูที่เก็บนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depoyu yalnızca siz ve erişim verdiğiniz kişiler görebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей репозиторій бачите лише ви й люди, яким ви надали доступ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bạn và những người bạn cấp quyền mới xem được kho lưu trữ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你和你授予访问权限的人可以查看此仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你和你授予存取權的人可以查看此儲存庫。"
          }
        }
      }
    },
