    "Off. Manual Git, Shortcuts, callbacks, and local repository features are unchanged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف. دليل Git، الاختصارات ، الاسترجاعات ، وميزات المستودع المحلي لم تتغير."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Manuelt GitShortcuts, callbacks og funktioner for lokalt repository er uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Manuell GitShortcuts, Callbacks sowie Funktionen des lokalen Repositorys bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual de uso GitLos atajos, los callbacks y las funciones del repositorio local permanecen sin cambios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Manuaalinen käyttö GitShortcuts-, callbacks- ja paikallisen varaston ominaisuudet pysyvät muuttumattomina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "hors ligne – Manuel GitLes raccourcis, les appels de rappel et les fonctionnalités du dépôt local restent inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़-लाइन मैनुअल GitShortcuts, callbacks तथा स्थानीय रिपॉजिटरी सुविधाएँ अपरिवर्तित हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelölés – Manuális működtetés GitA rövid utakra, callback-khez és helyi portfólió funkciók nem változtak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Manual GitFitur Shortcuts, callbacks, dan repositori lokal tetap tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufficio – Manuale GitLe scorciatoie, i callback e le funzionalità del repository locale rimangono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ・手動 Gitショートカット、カーボック、およびローカルリポジトリ機能は変更ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프-맨UAL GitShortcuts, callbacks 및 로컬 저장소 기능은 변경되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenfor – Manuell brukerveiledning GitShortcuts, callbacks og funksjoner for lokalt lagringsbutikk er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Handmatig GitShortcuts, callbacks en functies voor lokale repositories zijn ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zewnętrzny manuel GitSkróty, funkcje callback oraz funkcje lokalnego reponентu pozostają niezmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Manual GitOs atalhos, os callbacks e as funcionalidades do repositório local permanecem inalterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение: Руководство по эксплуатации GitФункции «Короткие пути», «Кallbackы» и «Локальный репозиторий» остаются неизменными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Manuell användning GitKortlänkar, callbacks och funktioner för lokala lagringsplattformar förblir oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบแมนนวล Gitฟีเจอร์ Shortcuts, callbacks และ Local Repository ยังคงไม่มีการเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofis. Elişli GitShortcuts, callbacks ve yerel depo özellikleri değişmeden kalmıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикладна програма (ручна версія) GitФункції «Shortcuts», «callbacks» та «локального репозиторію» залишаються незмінними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ qua – Hướng dẫn thủ công GitCác tính năng Shortcuts, callbacks và kho lưu trữ cục bộ vẫn không thay đổi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי. מדריך Git, קיצורי דרך, callbacks ומאפייני המאגר המקומי ללא שינוי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动操作手册 Git快捷键、回调函数及本地仓库功能保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動操作手冊 Git快捷鍵、回撥函式及本地倉庫功能保持不變。"
          }
        }
      }
    },
