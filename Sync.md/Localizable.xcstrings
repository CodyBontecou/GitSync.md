            "state": "translated",
            "value": "reposlar, doğru hesaba bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозиторії відповідають правому обліковому запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các tài khoản repo đều thuộc tài khoản hợp lệ."
          }
        },
        "zh-Hans": {
