        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": ה-\"Rebase\" ייצר מתחים שדורשים פתרון ידני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीबेसिंग के परिणामस्वरूप संघर्ष उत्पन्न हुए हैं, जिनका मैन्युअल समाधान आवश्यक है।"
