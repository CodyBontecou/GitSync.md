          }
        }
      }
    },
    "Git tracking is being removed. Wait for the backup to finish before cloning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجري إزالة تتبع Git. انتظر انتهاء النسخ الاحتياطي قبل الاستنساخ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-sporing fjernes. Vent på, at backuppen bliver færdig, før du kloner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-Tracking wird entfernt. Warten Sie, bis das Backup abgeschlossen ist, bevor Sie klonen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está eliminando el seguimiento de Git. Espera a que termine la copia de seguridad antes de clonar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-seurantaa poistetaan. Odota varmuuskopion valmistumista ennen kloonausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi Git est en cours de suppression. Attendez la fin de la sauvegarde avant de cloner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב Git מוסר. המתינו לסיום הגיבוי לפני השכפול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git ट्रैकिंग हटाई जा रही है। क्लोन करने से पहले बैकअप पूरा होने की प्रतीक्षा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git-követés eltávolítása folyamatban. Klónozás előtt várja meg a mentés végét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelacakan Git sedang dihapus. Tunggu hingga pencadangan selesai sebelum clone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tracciamento Git è in fase di rimozione. Attendi la fine del backup prima di clonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git の追跡を解除しています。クローンする前にバックアップの完了を待ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 추적을 제거하는 중입니다. 클론하기 전에 백업이 끝날 때까지 기다리십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-sporing fjernes. Vent til sikkerhetskopien er ferdig før du kloner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-tracking wordt verwijderd. Wacht tot de back-up klaar is voordat u kloont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa usuwanie śledzenia Git. Poczekaj na zakończenie kopii zapasowej przed klonowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
