    "Deleted on one side, edited on the other.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذف في جانب، وعُدّل في الآخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettet på den ene side, redigeret på den anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einer Seite gelöscht, auf der anderen bearbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado en un lado, editado en el otro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistettu toisella puolella, muokattu toisella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé d’un côté, modifié de l’autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמחק בצד אחד, נערך בצד השני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक तरफ़ हटाया गया, दूसरी तरफ़ संपादित किया गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyik oldalon törölve, a másikon szerkesztve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihapus di satu sisi, diedit di sisi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminato da una parte, modificato dall'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一方で削除され、もう一方で編集されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한쪽에서는 삭제되고 다른 쪽에서는 편집되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettet på én side, redigert på den andre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan de ene kant verwijderd, aan de andere bewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto po jednej stronie, zmieniono po drugiej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluído de um lado, editado do outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено на одной стороне, изменено на другой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderad på ena sidan, redigerad på den andra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกลบที่ฝั่งหนึ่ง ถูกแก้ไขที่อีกฝั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tarafta silindi, diğerinde düzenlendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалено з одного боку, змінено з іншого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bị xóa ở một phía, được sửa ở phía kia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一方删除了此文件，另一方编辑了它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一方刪除了此檔案，另一方編輯了它。"
          }
        }
      }
    },
    "Deletes the tag on this iPhone only.": {
      "localizations": {
        "ar": {
