        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीबेसिंग के परिणामस्वरूप संघर्ष उत्पन्न हुए हैं, जिनका मैन्युअल समाधान आवश्यक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase eljárása konfliktusokat eredményezett, amelyek manuális megoldásra szorulnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
