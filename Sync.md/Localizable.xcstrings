    "Scan GitSync.md storage or any folder you grant access to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص تخزين GitSync.md أو أي مجلد تمنح الوصول إليه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan GitSync.md-lageret eller en mappe, du giver adgang til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md-Speicher oder einen freigegebenen Ordner scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el almacenamiento de GitSync.md o cualquier carpeta a la que des acceso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
