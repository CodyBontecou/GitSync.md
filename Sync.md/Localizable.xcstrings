    "Get safe pulls and separately opt in to automatic commits and pushes when iOS allows. Optional subscription.": {
      "extractionState": "stale"
    },
    "Get safe, pull-only updates in the background whenever iOS allows. Optional subscription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على تحديثات آمنة واردة فقط في الخلفية عندما يسمح iOS بذلك. اشتراك اختياري."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få sikre opdateringer, der kun hentes ned, i baggrunden, når iOS tillader det. Valgfrit abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade sichere Updates im Hintergrund ausschließlich herunter, wenn iOS es zulässt. Optionales Abonnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe actualizaciones seguras, sin enviar cambios, en segundo plano siempre que iOS lo permita. Suscripción opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaanota turvallisesti vain saapuvia päivityksiä taustalla, kun iOS sallii sen. Valinnainen tilaus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez en toute sécurité uniquement les mises à jour entrantes en arrière-plan lorsque iOS l’autorise. Abonnement facultatif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלו בבטחה עדכונים נכנסים בלבד ברקע, כאשר iOS מאפשר זאת. מינוי אופציונלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी iOS अनुमति दे, बैकग्राउंड में सुरक्षित रूप से केवल आने वाले अपडेट पाएँ। वैकल्पिक सदस्यता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fogadjon biztonságosan kizárólag bejövő frissítéseket a háttérben, amikor az iOS engedélyezi. Opcionális előfizetés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan pembaruan secara aman hanya dengan mengunduhnya di latar belakang saat diizinkan oleh iOS. Langganan opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi in sicurezza solo gli aggiornamenti in entrata in background quando iOS lo consente. Abbonamento facoltativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSで許可されているときに、変更を送信せず、バックグラウンドで安全にアップデートを取得できます。オプションのサブスクリプションです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 허용할 때 변경 사항을 전송하지 않고 백그라운드에서 안전하게 업데이트를 받을 수 있습니다. 구독은 선택 사항입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få trygge oppdateringer som bare lastes ned, i bakgrunnen når iOS tillater det. Valgfritt abonnement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang veilige updates op de achtergrond zonder wijzigingen te verzenden, wanneer iOS dit toestaat. Optioneel abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpiecznie pobieraj aktualizacje w tle, bez wysyłania zmian, gdy zezwala na to iOS. Opcjonalna subskrypcja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba atualizações com segurança, sem enviar alterações, em segundo plano quando o iOS permitir. Assinatura opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасно загружайте обновления в фоновом режиме без отправки изменений, когда это разрешает iOS. Подписка по желанию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta uppdateringar säkert i bakgrunden utan att skicka ändringar när iOS tillåter det. Valfri prenumeration."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการอัปเดตอย่างปลอดภัยในเบื้องหลังโดยไม่ส่งการเปลี่ยนแปลง เมื่อ iOS อนุญาต การสมัครสมาชิกเป็นตัวเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS izin verdiğinde değişiklikleri göndermeden arka planda güvenli güncellemeler alın. İsteğe bağlı abonelik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безпечно отримуйте оновлення у фоновому режимі без надсилання змін, коли це дозволяє iOS. Необов’язкова підписка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận bản cập nhật an toàn trong nền mà không gửi thay đổi lên khi iOS cho phép. Gói đăng ký không bắt buộc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 允许时，在后台安全接收更新，而不上传更改。可选订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 允許時，於背景安全接收更新，而不上傳變更。訂閱為選用項目。"
          }
        }
      },
      "extractionState": "stale"
    },
