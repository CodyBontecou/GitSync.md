          "stringUnit": {
            "state": "translated",
            "value": "TOUT REPO GIT, SYNCED À VOTRE IPHONE"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מאגר GIT, שמאוזן ל-IPhone שלך"
