          "stringUnit": {
            "state": "translated",
            "value": ": レバス再実行後、HEADを解決できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 재기반화를 계속 진행한 후에도 HEAD를 해결할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kunne ikke løse HEAD etter at rebase ble fortsettet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kon HEAD niet oplossen na het voortzetten van de rebase"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się rozwiązać HEAD po kontynuowaniu operacji rebase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível resolver o HEAD após a continuação do rebase."
          }
        },
        "ru": {
