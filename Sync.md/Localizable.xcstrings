          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositoriet er skadet: %@. Prøv å fjerne og klone på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository beschadigd: %@. Probeer te verwijderen en opnieuw te klonen."
          }
        },
        "pl": {
