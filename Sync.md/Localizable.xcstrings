          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– הוראות ה-REPOS מתייחסות לחשבון הנכון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोज़ीटर्स सही खाते का पालन करते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": a reposok az előírt számla alapján működnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repos mengikuti akun yang benar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": I repository seguono il conto corretto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：レポーズは正しいアカウントに属します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리포스는 올바른 계정을 따른다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repos følger riktig konto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repos volgen de juiste rekening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": repozytoria odpowiadają za odpowiedni konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Os repos seguem a conta correta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозитории следуют за правильным счётом"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Reposer följer rätt konto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": บัญชี repos จะตามติดบัญชีที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "reposlar, doğru hesaba bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозиторії відповідають правому обліковому запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các tài khoản repo đều thuộc tài khoản hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存货科目应归属至正确账户"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存貨科目應歸屬至正確賬戶"
          }
        }
      }
    },
    "Repos stay where they are. GitSync.md only remembers the folder, so Obsidian keeps working as before.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المستودعات في مكانها. يتذكر GitSync.md المجلد فقط، لذا يستمر Obsidian في العمل كما كان."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repos bliver, hvor de er. GitSync.md husker kun mappen, så Obsidian virker som før."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repos bleiben, wo sie sind. GitSync.md merkt sich nur den Ordner, sodass Obsidian wie gewohnt funktioniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los repos se quedan donde están. GitSync.md solo recuerda la carpeta, así que Obsidian sigue funcionando como antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Repot pysyvät paikallaan. GitSync.md muistaa vain kansion, joten Obsidian toimii kuten ennenkin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépôts restent où ils sont. GitSync.md se souvient seulement du dossier, donc Obsidian fonctionne comme avant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאגרים נשארים במקומם. GitSync.md רק זוכר את התיקייה, כך ש-Obsidian ממשיך לעבוד כמו קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपो जहाँ हैं वहीं रहती हैं। GitSync.md केवल फ़ोल्डर याद रखता है, इसलिए Obsidian पहले की तरह काम करता रहता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tárolók a helyükön maradnak. A GitSync.md csak a mappát jegyzi meg, így az Obsidian ugyanúgy működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo tetap di tempatnya. GitSync.md hanya mengingat foldernya, jadi Obsidian tetap berfungsi seperti biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I repo restano dove sono. GitSync.md ricorda solo la cartella, quindi Obsidian continua a funzionare come prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリはその場所のままです。GitSync.md はフォルダを記憶するだけなので、Obsidian は今までどおり使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소는 제자리에 있습니다. GitSync.md는 폴더만 기억하므로 Obsidian은 이전처럼 작동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Repoer blir der de er. GitSync.md husker bare mappen, så Obsidian fungerer som før."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo's blijven waar ze zijn. GitSync.md onthoudt alleen de map, dus Obsidian blijft werken zoals voorheen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytoria zostają na miejscu. GitSync.md zapamiętuje tylko folder, więc Obsidian działa jak dotąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os repos ficam onde estão. O GitSync.md só lembra a pasta, então o Obsidian continua funcionando como antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозитории остаются на месте. GitSync.md только запоминает папку, так что Obsidian работает как прежде."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiven ligger kvar där de är. GitSync.md kommer bara ihåg mappen, så Obsidian fungerar som tidigare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโปยังอยู่ที่เดิม GitSync.md จำแค่โฟลเดอร์ Obsidian จึงทำงานได้เหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depolar oldukları yerde kalır. GitSync.md yalnızca klasörü hatırlar, böylece Obsidian eskisi gibi çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторії залишаються на місці. GitSync.md лише запам’ятовує папку, тож Obsidian працює як раніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ vẫn ở nguyên chỗ. GitSync.md chỉ ghi nhớ thư mục, nên Obsidian vẫn hoạt động như trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库保持原位。GitSync.md 只记住文件夹，因此 Obsidian 照常工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫保持原位。GitSync.md 只會記住資料夾，因此 Obsidian 照常運作。"
          }
        }
      }
    },
