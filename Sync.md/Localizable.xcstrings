            "state": "translated",
            "value": ": E-postadressen för författaren måste se ut som you@example.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": อีเมลของผู้เขียนต้องมีรูปแบบเป็น you@example.com"
          }
