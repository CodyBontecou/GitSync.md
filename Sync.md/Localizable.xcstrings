    "Git LFS SSH authentication could not determine the repository path.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH تحديد مسار المستودع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH-godkendelse kunne ikke bestemme lagerstien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH Authentifizierung konnte den Repository-Pfad nicht ermitteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH la autenticación no pudo determinar la ruta del repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH -varmennus ei voitu määrittää versiovarastoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH n&#39;a pas pu déterminer le chemin du référentiel.\nL&#39;authentification"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH לא הצלחה לאמתת קביעת 경ทาง של המאגר.\nאימות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH के लिए प्रमाणीकरण रिपॉजिटरी पथ को निर्धारित नहीं कर पाया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH authentikáció nem sikerült meghatározni a tároló útvonalát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH : proses autentikasi tidak dapat menentukan jalur repositori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH non è riuscita a determinare il percorso del repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH 認証では、リポジトリのパスを特定できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH 인증 시 저장소 경로를 확인할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH -autentiseringen kunne ikke bestemme lagringsmappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH kon de repositorypad niet bepalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH nie udało się określić ścieżki repositoria.\nAutentycyzacja"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH não conseguiu determinar o caminho do repositório.\nA autenticação de"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH не удалось определить путь к репозиторию.\nАвторизация"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH -autentiseringen kunde inte bestämma lagringsmappen."
          }
