    "This file was renamed differently on each side. Choose which name to keep — the other will be removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة تسمية هذا الملف بشكل مختلف على كل جانب. اختر الاسم الذي تريد الاحتفاظ به — ستتم إزالة الاسم الآخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fil blev omdøbt forskelligt på hver side. Vælg hvilket navn du vil beholde - det andet vil blive fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde auf jeder Seite unterschiedlich umbenannt. Wählen Sie den Namen aus, den Sie behalten möchten – der andere wird entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambió el nombre de este archivo de manera diferente en cada lado. Elija qué nombre conservar; el otro se eliminará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tiedosto nimettiin eri puolilla. Valitse nimi säilytettävä - toinen poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ce fichier a été renommé différemment sur chaque côté. Choisissez le nom à conserver — l'autre sera supprimé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": קובץ זה שימש את השם בצורה שונה בכל צד. בחרו את השם שיתקיין – השם השני יידלק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": इस फ़ाइल का नाम प्रत्येक पक्ष पर अलग-अलग रूप से बदल दिया गया है। आप यह चुन सकते हैं कि कौन सा नाम बनाए रखें — अन्य नाम हटा दिया जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ez a fájl minden oldalon különböző nevvel lett átnevezve. Válassza meg, mely nevet tartja meg – az egyiket eltávolítják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nama berkas ini diubah secara berbeda pada masing-masing sisi. Pilih nama mana yang akan dipertahankan — nama lainnya akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo file è stato rinominato in modo diverso su ciascun lato. Selezionare quale nome mantenere — l'altro verrà eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：このファイルは両側で異なる名前に変更されています。どの名前を保持するかを選択してください——もう一方の名前は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이 파일은 각 측에서 서로 다른 이름으로 재명명되었습니다. 어떤 이름을 유지할지 선택하십시오 — 다른 이름은 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Denne filen ble omdøpt på hver side med forskjellige navn. Vennligst velg hvilket navn du vil beholde – det andre vil bli fjernet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Deze bestand is op elke zijde met een andere naam gewijzigd. Kies welke naam u wilt behouden — de andere wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ten plik został zmieniony nazwą na inny sposób na obu stronach. Wybierz, jaką nazwę zachować – druga zostanie usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Este arquivo foi renomeado de forma diferente em cada lado. Escolha qual nome manter — o outro será removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Имя этого файла было изменено по-разному на каждой стороне. Выберите имя, которое следует сохранить — другое будет удалено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Denna fil ändrade namn på varje sida. Välj vilket namn du vill behålla – det andra kommer att tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ได้รับการเปลี่ยนชื่อแตกต่างกันไปในแต่ละฝั่ง กรุณาเลือกชื่อที่ต้องการคงไว้ — ชื่ออีกชื่อหนึ่งจะถูกลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dosyası her tarafda farklı bir adla yeniden adlandırıldı. Hangi adı korumaya devam edileceğini seçin — diğer ad silinecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": цей файл був перейменований іншим способом на кожному боку. Виберіть, яке ім'я залишити — інше буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tệp này đã được đổi tên khác nhau trên mỗi phía. Vui lòng chọn tên nào để giữ lại — tên còn lại sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：该文件在两侧的重命名方式有所不同。请选择保留哪个名称——另一个名称将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：該文件在兩側的重命名方式有所不衕。請選擇保留哪個名稱——另一個名稱將被刪除。"
          }
        }
      }
    },
    "This hides the repository from the previously cloned list. It won't delete local files or revoke GitHub access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إخفاء المستودع من القائمة المستنسخة مسبقًا. لن يقوم بحذف الملفات المحلية أو إلغاء الوصول إلى GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette skjuler depotet fra den tidligere klonede liste. Det vil ikke slette lokale filer eller tilbagekalde GitHub adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Repository aus der zuvor geklonten Liste ausgeblendet. Es werden weder lokale Dateien gelöscht noch der GitHub-Zugriff widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto oculta el repositorio de la lista previamente clonada. No eliminará archivos locales ni revocará el acceso a GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä piilottaa arkiston aiemmasta kloonatusta luettelosta. Se ei poista paikallisia tiedostoja tai peruu GitHub pääsy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Cette option cache le dépôt dans la liste précédemment clonée ; elle n'efface pas les fichiers locaux ni ne révoque ces droits. GitHub accès."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– מוסיפה סתרון למאגר מהרשימה שהוקלנה בעבר; לא ימחק קבצים מקומיים ולא יסגר את המאגר. GitHub גישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह रिपॉजिटरी को पहले क्लोन किए गए सूची से छिपाता है। यह स्थानीय फ़ाइलों को डिलीट नहीं करेगा या उनकी अधिकारता वापस नहीं लेगा। GitHub एक्सेस।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ez elrejti a tárolót az előző klonálás eredményeiből álló lista alól; nem törli a helyi fájlokat, sem leállítja az őket. GitHub hozzáférés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Fitur ini menyembunyikan repositori dari daftar yang sebelumnya telah dikloning; fitur ini tidak menghapus file lokal maupun membatalkan hak akses terhadapnya.\nAkses GitHub ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo comando nasconde il repository dalla lista precedentemente clonata; non elimina i file locali né revoca tali file. GitHub accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：このオプションは、以前にクローンされたリストからリポジトリを非表示にします。ローカルファイルの削除や権限の取り消しは行われません。 GitHub アクセス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이 옵션은 기존에 클로닝된 목록에서 저장소를 은폐합니다. 로컬 파일을 삭제하거나 권한을 철회하지 않습니다. GitHub 액세스."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "skjuler lagringsplatsen fra den tidligere klonede listen. Den sletter ikke lokale filer eller avviser rettigheter. GitHub tilgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "verbergt het repository van de eerdere gekloneerde lijst; het verwijdert geen lokale bestanden en ontzegt deze niet. GitHub -toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ten element ukrywa repositorium z poprzedniego listu klonowanych plików; nie usuwa lokalnych plików ani odwołuje uprawnienia. GitHub dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Este comando oculta o repositório da lista anteriormente clonada; não exclui arquivos locais nem revoga as permissões.\nAcesso a GitHub ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Этот параметр скрывает репозиторий из предыдущего списка клонов; он не удаляет локальные файлы и не аннулирует их права доступа.\nДоступ к GitHub ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "döljer lagringsplatsen från den tidigare klonade lista. Den raderar inte lokala filer eller avkrynger dem. GitHub tillgång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ฟังก์ชันนี้จะปิดการแสดง repositorie ในรายการที่เคย clon ไว้ ก่อนหน้านี้ โดยจะไม่ลบไฟล์ในระบบ local หรือยกเลิกสิทธิ์ใดๆ GitHub access"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu işlem, depoyu daha önce klonlanmış listeden gizler; yerel dosyaları silmez veya onları geri almaz. GitHub erişimi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": це приховує репозиторій з попереднього списку клонуваних репозиторіїв; він не видаляє локальні файли і не скасовує доступ до них. GitHub доступ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tính năng này sẽ ẩn kho dữ liệu khỏi danh sách các bản clon trước đó; tính năng này không xóa các tệp cục bộ cũng như không hủy bỏ quyền truy cập. GitHub access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：此选项可将存储库从先前克隆的列表中隐藏，但不会删除本地文件或撤销该操作。 GitHub 访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：此選項可將存儲庫從先前剋隆的列錶中隱藏，但不會刪除本地文件或撤銷該操作。 GitHub 訪問權限。"
          }
        }
      }
    },
    "This installation's Background Sync relay identity was permanently retired. Contact support to use Background Sync again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنهيت هوية مُرحِّل Background Sync لهذا التثبيت نهائيًا. تواصل مع الدعم لاستخدام Background Sync مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne installations Background Sync-relæidentitet blev nedlagt permanent. Kontakt support for at bruge Background Sync igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Background Sync-Relay-Identität dieser Installation wurde dauerhaft außer Betrieb gesetzt. Wenden Sie sich an den Support, um Background Sync erneut zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad del relé de Background Sync de esta instalación se ha retirado permanentemente. Póngase en contacto con soporte para volver a usar Background Sync."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän asennuksen Background Sync -välityspalvelun identiteetti lakkautettiin pysyvästi. Ota yhteyttä tukeen käyttääksesi Background Sync -toimintoa uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité du relais Background Sync de cette installation a été retirée définitivement. Contactez l’assistance pour réutiliser Background Sync."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהות הממסר של Background Sync בהתקנה זו הוצאה משימוש לצמיתות. יש לפנות לתמיכה כדי להשתמש שוב ב-Background Sync."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इंस्टॉलेशन की Background Sync रिले पहचान स्थायी रूप से निष्क्रिय कर दी गई। Background Sync दोबारा इस्तेमाल करने के लिए सहायता से संपर्क करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepítés Background Sync-továbbítóazonosítója véglegesen megszűnt. A Background Sync ismételt használatához forduljon az ügyfélszolgálathoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitas relay Background Sync instalasi ini telah dihentikan secara permanen. Hubungi dukungan untuk menggunakan Background Sync lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identità relay di Background Sync di questa installazione è stata ritirata definitivamente. Contatti l’assistenza per usare nuovamente Background Sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインストールの Background Sync relay ID は完全に廃止されました。Background Sync を再び使用するには、サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치의 Background Sync 릴레이 ID가 영구적으로 폐기되었습니다. Background Sync를 다시 사용하려면 지원팀에 문의해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Sync-releidentiteten til denne installasjonen ble permanent avviklet. Kontakt kundestøtte for å bruke Background Sync igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Background Sync-relayidentiteit van deze installatie is permanent buiten gebruik gesteld. Neem contact op met support om Background Sync opnieuw te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tożsamość tej instalacji w usłudze pośredniczącej Background Sync została trwale wycofana. Aby ponownie użyć Background Sync, skontaktuj się z pomocą techniczną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade do retransmissor do Background Sync desta instalação foi desativada permanentemente. Entre em contato com o suporte para usar o Background Sync novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор ретранслятора Background Sync для этой установки безвозвратно деактивирован. Чтобы снова использовать Background Sync, обратитесь в службу поддержки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här installationens reläidentitet för Background Sync har avvecklats permanent. Kontakta supporten för att använda Background Sync igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลประจำตัวรีเลย์ของ Background Sync สำหรับการติดตั้งนี้ถูกปลดระวางอย่างถาวรแล้ว โปรดติดต่อฝ่ายช่วยเหลือเพื่อใช้ Background Sync อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumun Background Sync aktarıcı kimliği kalıcı olarak kullanım dışı bırakıldı. Background Sync özelliğini yeniden kullanmak için destek ekibiyle iletişime geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентичність ретранслятора Background Sync цієї інсталяції остаточно виведено з експлуатації. Щоб знову використовувати Background Sync, зверніться до служби підтримки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh tính chuyển tiếp Background Sync của bản cài đặt này đã ngừng hoạt động vĩnh viễn. Hãy liên hệ bộ phận hỗ trợ để sử dụng lại Background Sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此安装的 Background Sync 中继身份已永久停用。如需再次使用 Background Sync，请联系支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此安裝項目的 Background Sync 中繼身分已永久停用。如需再次使用 Background Sync，請聯絡支援人員。"
          }
        }
      }
    },
    "This permanently retires this installation's Background Sync relay identity and removes its device registration and repository enrollments. Background Sync cannot be enabled again for this installation without support. It does not delete local repositories or cancel the Apple subscription. To stop background syncing without deleting relay data, turn off Enable Background Sync instead.": {},
    "This permanently retires this installation's Background Sync relay identity and removes its device registration and repository enrollments. Background Sync cannot be enabled again for this installation without support. It does not delete local repositories or cancel the Apple subscription. To stop background syncing without deleting relay data, turn off Sync all repositories in the background instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إنهاء هوية مُرحِّل Background Sync لهذا التثبيت نهائيًا وإزالة تسجيل جهازه وعمليات تسجيل مستودعاته. لا يمكن تمكين Background Sync مجددًا لهذا التثبيت من دون الدعم. لا يحذف ذلك المستودعات المحلية ولا يلغي اشتراك Apple. لإيقاف المزامنة في الخلفية من دون حذف بيانات المُرحِّل، عطّل خيار مزامنة جميع المستودعات في الخلفية بدلًا من ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette nedlægger permanent denne installations Background Sync-relæidentitet og fjerner dens enhedsregistrering og arkivtilmeldinger. Background Sync kan ikke aktiveres igen for denne installation uden hjælp fra support. Det sletter ikke lokale arkiver eller opsiger Apple-abonnementet. Hvis du vil stoppe synkronisering i baggrunden uden at slette relædata, skal du i stedet slå Synkroniser alle arkiver i baggrunden fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Background Sync-Relay-Identität dieser Installation dauerhaft außer Betrieb gesetzt und ihre Geräteregistrierung sowie ihre Repository-Registrierungen werden entfernt. Background Sync kann für diese Installation ohne den Support nicht erneut aktiviert werden. Lokale Repositorys werden dadurch nicht gelöscht und das Apple-Abonnement wird nicht gekündigt. Wenn Sie die Hintergrundsynchronisierung beenden möchten, ohne Relay-Daten zu löschen, deaktivieren Sie stattdessen Alle Repositorys im Hintergrund synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto retira permanentemente la identidad del relé de Background Sync de esta instalación y elimina el registro del dispositivo y las inscripciones de los repositorios. Background Sync no se podrá volver a activar en esta instalación sin ayuda de soporte. No elimina los repositorios locales ni cancela la suscripción de Apple. Para detener la sincronización en segundo plano sin eliminar los datos del relé, desactive Sincronizar todos los repositorios en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lakkauttaa pysyvästi asennuksen Background Sync -välityspalvelun identiteetin sekä poistaa laitteen rekisteröinnin ja tietovarastojen rekisteröinnit. Background Sync -toimintoa ei voi ottaa uudelleen käyttöön tässä asennuksessa ilman tuen apua. Tämä ei poista paikallisia tietovarastoja eikä peruuta Apple-tilausta. Jos haluat lopettaa taustasynkronoinnin poistamatta välityspalvelun tietoja, poista sen sijaan Synkronoi kaikki tietovarastot taustalla käytöstä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération retire définitivement l’identité du relais Background Sync de cette installation et supprime l’enregistrement de son appareil et les inscriptions de ses dépôts. Background Sync ne pourra pas être réactivé pour cette installation sans l’aide de l’assistance. Elle ne supprime pas les dépôts locaux et ne résilie pas l’abonnement Apple. Pour arrêter la synchronisation en arrière-plan sans supprimer les données du relais, désactivez plutôt Synchroniser tous les dépôts en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוציאה לצמיתות משימוש את זהות הממסר של Background Sync בהתקנה זו ומסירה את רישום המכשיר ואת שיוכי המאגרים שלה. לא ניתן להפעיל שוב את Background Sync בהתקנה זו ללא תמיכה. הפעולה אינה מוחקת מאגרים מקומיים ואינה מבטלת את המינוי של Apple. כדי להפסיק את הסנכרון ברקע בלי למחוק נתוני ממסר, יש לכבות במקום זאת את „סנכרון כל המאגרים ברקע”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस इंस्टॉलेशन की Background Sync रिले पहचान स्थायी रूप से निष्क्रिय हो जाती है और इसका डिवाइस पंजीकरण तथा रिपॉज़िटरी नामांकन हट जाते हैं। सहायता के बिना इस इंस्टॉलेशन के लिए Background Sync फिर चालू नहीं किया जा सकता। इससे स्थानीय रिपॉज़िटरी नहीं मिटतीं और Apple सदस्यता रद्द नहीं होती। रिले डेटा मिटाए बिना बैकग्राउंड सिंकिंग रोकने के लिए इसके बजाय सभी रिपॉज़िटरी को बैकग्राउंड में सिंक करें को बंद करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen megszünteti a telepítés Background Sync-továbbítóazonosítóját, valamint eltávolítja az eszközregisztrációját és a tárolók társításait. A Background Sync az ügyfélszolgálat segítsége nélkül nem kapcsolható be újra ennél a telepítésnél. A helyi tárolók nem törlődnek, és az Apple-előfizetés sem szűnik meg. Ha a továbbítóadatok törlése nélkül szeretné leállítani a háttérbeli szinkronizálást, inkább kapcsolja ki a Minden tároló szinkronizálása a háttérben beállítást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini menghentikan secara permanen identitas relay Background Sync instalasi ini serta menghapus pendaftaran perangkat dan penyertaan repositorinya. Background Sync tidak dapat diaktifkan lagi untuk instalasi ini tanpa bantuan dukungan. Tindakan ini tidak menghapus repositori lokal atau membatalkan langganan Apple. Untuk menghentikan sinkronisasi latar belakang tanpa menghapus data relay, nonaktifkan Sinkronkan semua repositori di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione ritira definitivamente l’identità relay di Background Sync di questa installazione e ne rimuove la registrazione del dispositivo e le adesioni dei repository. Background Sync non potrà essere riattivato per questa installazione senza assistenza. Non elimina i repository locali né annulla l’abbonamento Apple. Per interrompere la sincronizzazione in background senza eliminare i dati relay, disattivi invece Sincronizza tutti i repository in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、このインストールの Background Sync relay ID が完全に廃止され、デバイス登録とリポジトリ登録が削除されます。サポートの対応なしに、このインストールで Background Sync を再び有効にすることはできません。ローカルリポジトリの削除や Apple サブスクリプションの解約は行われません。relay データを削除せずにバックグラウンド同期を停止するには、代わりに「すべてのリポジトリをバックグラウンドで同期」をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 이 설치의 Background Sync 릴레이 ID를 영구적으로 폐기하고 기기 등록 및 저장소 등록 정보를 제거합니다. 지원팀의 도움 없이는 이 설치에서 Background Sync를 다시 활성화할 수 없습니다. 로컬 저장소를 삭제하거나 Apple 구독을 취소하지는 않습니다. 릴레이 데이터를 삭제하지 않고 백그라운드 동기화만 중단하려면 대신 백그라운드에서 모든 저장소 동기화를 끄세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette avvikler Background Sync-releidentiteten til denne installasjonen permanent og fjerner enhetsregistreringen og repositorietilknytningene. Background Sync kan ikke aktiveres igjen for denne installasjonen uten hjelp fra kundestøtte. Det sletter ikke lokale repositorier eller sier opp Apple-abonnementet. Hvis du vil stoppe bakgrunnssynkronisering uten å slette reledata, slår du av Synkroniser alle repositorier i bakgrunnen i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de Background Sync-relayidentiteit van deze installatie permanent buiten gebruik gesteld en worden de apparaatregistratie en repository-inschrijvingen verwijderd. Background Sync kan zonder support niet opnieuw worden ingeschakeld voor deze installatie. Lokale repository's worden niet verwijderd en het Apple-abonnement wordt niet opgezegd. Als u achtergrondsynchronisatie wilt stoppen zonder relaygegevens te verwijderen, schakelt u in plaats daarvan Alle repository's op de achtergrond synchroniseren uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe wycofanie tożsamości tej instalacji w usłudze pośredniczącej Background Sync oraz usunięcie rejestracji urządzenia i powiązań repozytoriów. Bez pomocy technicznej nie będzie można ponownie włączyć Background Sync w tej instalacji. Lokalne repozytoria nie zostaną usunięte, a subskrypcja Apple nie zostanie anulowana. Aby zatrzymać synchronizację w tle bez usuwania danych usługi pośredniczącej, wyłącz opcję Synchronizuj wszystkie repozytoria w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso desativa permanentemente a identidade do retransmissor do Background Sync desta instalação e remove o registro do dispositivo e as inscrições dos repositórios. Não será possível ativar o Background Sync novamente nesta instalação sem a ajuda do suporte. Isso não exclui repositórios locais nem cancela a assinatura da Apple. Para interromper a sincronização em segundo plano sem excluir os dados do retransmissor, desative Sincronizar todos os repositórios em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это безвозвратно деактивирует идентификатор ретранслятора Background Sync для этой установки и удалит регистрацию устройства и подключения репозиториев. Без помощи службы поддержки Background Sync нельзя будет снова включить в этой установке. Локальные репозитории при этом не удаляются, а подписка Apple не отменяется. Чтобы остановить фоновую синхронизацию без удаления данных ретранслятора, вместо этого выключите параметр «Синхронизировать все репозитории в фоне»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här avvecklar permanent den här installationens reläidentitet för Background Sync och tar bort dess enhetsregistrering och arkivregistreringar. Background Sync kan inte aktiveras igen för den här installationen utan hjälp från supporten. Lokala arkiv raderas inte och Apple-prenumerationen sägs inte upp. Om du vill stoppa bakgrundssynkroniseringen utan att radera relädata stänger du i stället av Synkronisera alla arkiv i bakgrunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะปลดระวางข้อมูลประจำตัวรีเลย์ของ Background Sync สำหรับการติดตั้งนี้อย่างถาวร พร้อมนำการลงทะเบียนอุปกรณ์และการลงทะเบียนคลังออก Background Sync จะเปิดใช้อีกครั้งสำหรับการติดตั้งนี้ไม่ได้หากไม่มีฝ่ายช่วยเหลือ การดำเนินการนี้จะไม่ลบคลังในเครื่องหรือยกเลิกการสมัครใช้ Apple หากต้องการหยุดการซิงค์ในเบื้องหลังโดยไม่ลบข้อมูลรีเลย์ โปรดปิดซิงค์คลังทั้งหมดในเบื้องหลังแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bu kurulumun Background Sync aktarıcı kimliğini kalıcı olarak kullanım dışı bırakır ve cihaz kaydıyla depo kayıtlarını kaldırır. Destek olmadan Background Sync bu kurulum için yeniden etkinleştirilemez. Yerel depoları silmez veya Apple aboneliğini iptal etmez. Aktarıcı verilerini silmeden arka planda eşzamanlamayı durdurmak için bunun yerine Tüm depoları arka planda eşzamanla seçeneğini kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія назавжди виводить з експлуатації ідентичність ретранслятора Background Sync цієї інсталяції та видаляє реєстрацію пристрою й підключення репозиторіїв. Без допомоги служби підтримки Background Sync не можна буде знову ввімкнути для цієї інсталяції. Локальні репозиторії не видаляються, а підписка Apple не скасовується. Щоб припинити фонову синхронізацію без видалення даних ретранслятора, натомість вимкніть «Синхронізувати всі репозиторії у фоновому режимі»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ ngừng vĩnh viễn danh tính chuyển tiếp Background Sync của bản cài đặt này, đồng thời xóa thông tin đăng ký thiết bị và đăng ký tham gia của các kho lưu trữ. Bạn không thể bật lại Background Sync cho bản cài đặt này nếu không có sự hỗ trợ. Thao tác này không xóa kho lưu trữ cục bộ hoặc hủy gói đăng ký Apple. Để dừng đồng bộ trong nền mà không xóa dữ liệu chuyển tiếp, hãy tắt tùy chọn Đồng bộ mọi kho lưu trữ trong nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久停用此安装的 Background Sync 中继身份，并移除其设备注册和仓库登记。没有支持人员协助，此安装将无法再次启用 Background Sync。此操作不会删除本地仓库，也不会取消 Apple 订阅。若要停止后台同步但不删除中继数据，请改为关闭“在后台同步所有仓库”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久停用此安裝項目的 Background Sync 中繼身分，並移除其裝置註冊和儲存庫登記。沒有支援人員協助，此安裝項目將無法再次啟用 Background Sync。此操作不會刪除本機儲存庫，也不會取消 Apple 訂閱。若要停止背景同步但不刪除中繼資料，請改為關閉「在背景同步所有儲存庫」。"
          }
        }
      },
      "extractionState": "stale"
    },
    "This removes the repository from GitSync.md only. Files will remain at:\n%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة المستودع من GitSync.md فقط. ستبقى الملفات في: \n%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner kun lageret fra GitSync.md. Filerne forbliver på:\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Repository nur aus GitSync.md entfernt. Die Dateien verbleiben unter:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el repositorio de GitSync.md únicamente. Los archivos permanecerán en:\n%@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa arkiston arkistosta GitSync.md . Tiedostot pysyvät osoitteessa:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": cela supprime le dépôt de GitSync.md uniquement. Les fichiers resteront à :\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– מחקת את המאגר מה- GitSync.md בלבד – הקבצים יישארו בכתובת הבאה:\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह रिपॉजिटरी को [स्रोत से] हटाता है। GitSync.md के लिए ही। फ़ाइलें निम्न स्थान पर रहेंगी:\n%@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– ez az adatmagaznát eltávolítja. GitSync.md -re vonatkozik. A fájlok a következő helyen maradnak:\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hal ini menghapus repositori dari GitSync.md hanya. Berkas akan tetap berada di:\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "rimuove il repository da GitSync.md esclusivamente. I file rimarranno in:\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リポジトリを削除します。 GitSync.md 専用。ファイルは以下の場所に保持されます：\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 리포지토리를 제거합니다. GitSync.md 에만 적용됩니다. 파일은 다음 경로에 유지됩니다:\n%@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fjerner lagringsplatsen fra GitSync.md kun. Filene vil forbli på følgende adresse:\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Dit verwijdert het repository van GitSync.md enkel. Bestanden blijven op:\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– usuwa repositorium z GitSync.md wyłącznie. Pliki pozostaną w następującym katalogu:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remove o repositório de GitSync.md apenas. Os arquivos permanecerão em:\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": это удаляет репозиторий из GitSync.md только. Файлы останутся в следующем пути:\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "tar bort lagringsplatsen från GitSync.md endast. Filerna kommer att förbliva på följande adress:\n%@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ทำให้ถอนคลังข้อมูลออกจาก GitSync.md เท่านั้น ไฟล์จะคงอยู่ที่:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu işlem depoyu kaldırır. GitSync.md için yalnızca; dosyalar şu yere kalacaktır:\n%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": це видаляє репозиторій з GitSync.md — лише для цього варіанту. Файли залишаться наступному шляху:\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hành động này sẽ loại bỏ kho dữ liệu khỏi GitSync.md chỉ áp dụng cho trường hợp này. Các tệp sẽ được lưu tại:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作将从...中移除存储库。 GitSync.md 仅限此用途。文件将保留在以下路径：\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作將從...中移除存儲庫。 GitSync.md 僅限此用途。文件將保留在以下路徑：\n%@"
          }
        }
      }
    },
    "This repository hasn't been cloned yet.\nTap below to download it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم استنساخ هذا المستودع بعد.\nانقر أدناه لتنزيله."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette lager er ikke blevet klonet endnu.\nTryk nedenfor for at downloade det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository wurde noch nicht geklont.\nTippen Sie unten, um es herunterzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio aún no ha sido clonado.\nToque a continuación para descargarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä versiota ei ole vielä kloonattu.\nNapauta alla ladataksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ce dépôt n'a pas encore été cloné.\n: Cliquez ci-dessous pour le télécharger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": המאגר הזה לא נקלד עדיין.\n– לחיצה מתחת לרשום כדי להוריד אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह रिपॉजिटरी अभी तक क्लोन नहीं की गई है।\n: इसे डाउनलोड करने के लिए नीचे टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ez a repository még nem klóndítottak meg.\n: alá nyomás útján letölthető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini belum dikloning.\nTekan di bawah untuk mengunduhnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo repository non è ancora stato clonato.\n: tocca qui sotto per scaricarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：このリポジトリはまだクローンされていません。\n：下部をタップしてダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이 저장소는 아직 클로닝되지 않았습니다.\n: 아래에서 다운로드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette repotretnetet er ikke klonet ennå.\n: Trykk nedenfor for å laste ned det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit repository is nog niet gekloneerd.\n: Tik hieronder om het te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten repositoriom nie został jeszcze klonowany.\n– naciśnij poniżej, aby go pobrać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositório ainda não foi clonado.\n: Clique abaixo para baixá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот репозиторий ещё не клонирован.\n— нажмите ниже, чтобы скачать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna repotrepo har ännu inte klonats.\n– Tryck nedan för att ladda ner det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโพซิทอรี่นี้ยังไม่ได้ถูกคลอนแล้ว\nแตะที่ด้านล่างเพื่อดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "depolama alanına henüz klonlama yapılmamıştır.\n: Dosyayı indirmek için aşağıya tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей репозиторій ще не клонований.\n— натисніть нижче, щоб завантажити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repository này chưa được clone.\n: Vui lòng nhấn dưới đây để tải xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该仓库尚未被克隆。\n：点击下方即可下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該倉庫尚未被剋隆。\n：點擊下方即可下載。"
          }
        }
      }
    },
    "This will be reflected in git status as a deletion.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينعكس هذا في حالة git كحذف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil blive afspejlet i git-status som en sletning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wird im Git-Status als Löschung angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se reflejará en el estado de git como una eliminación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä heijastuu git- tilassa poistona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": cela se reflétera dans `git status` sous la forme d'une suppression."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– תופתע זה ב-git-status כמחיקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "— यह Git Status में 'deletion' के रूप में प्रतिबिंबित होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ez a Git állapotban törölésként jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal ini akan tercermin dalam status Git sebagai penghapusan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo si rifletterà nel `git status` come una eliminazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "は、git statusで削除として反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "는 Git Status에서 삭제로 반영될 것입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Dette vil reflekteres i Git-status som en sletting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal in de Git-status worden weergegeven als verwijdering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– to będzie oddane w `git status` jako usunięcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Isso será refletido no `git status` como uma exclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это отразится в `git status` как удаление."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Detta kommer att reflekteras i Git-status som en radering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนี้จะสะท้อนใน `git status` ในลักษณะของการลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", git durumu içinde silme işlemi olarak yansıtılacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відображатиметься у `git status` як видалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Điều này sẽ được phản ánh trong git status dưới dạng xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，这将在 Git 状态中体现为删除操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，這將在 Git 狀態中體現爲刪除操作。"
          }
        }
      }
    },
    "This will permanently delete:\n%@\n\nThis cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف نهائيًا:\n%@\n\nلا يمكن التراجع عن هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil permanent slette:\n%@\n\nDette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird dauerhaft gelöscht:\n%@\n\nDies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente:\n%@\n\nEsto no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi:\n%@\n\nTätä ei voi peruuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": cela supprimera définitivement :\n%@\n\n: Cela ne peut pas être annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– זה ימחק באופן קבוע:\n%@\n\n– לא ניתן להסיר את ה결ס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह स्थायी रूप से निष्क्रिय करेगा:\n%@\n\n: इसे रद्द नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– ezzel mindig eltávolítják:\n%@\n\n– Ez nem ismételhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hal ini akan menghapus secara permanen:\n%@\n\nTindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo comando eliminerà permanentemente:\n%@\n\nQuesto non può essere annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：以下の内容を永続的に削除します：\n%@\n\n：取り消すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 다음 항목을 영구 삭제합니다:\n%@\n\n: 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Dette fjerne permanent:\n%@\n\n– Dette kan ikke reverseres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Dit verwijdert permanent:\n%@\n\nDit kan niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– poniższe elementy zostaną na zawsze usunięte:\n%@\n\nNie można tego odwrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando excluirá permanentemente:\n%@\n\nEsta operação não pode ser revertida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": это будет выполнять постоянное удаление:\n%@\n\n: Это действие не может быть отменено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Detta kommer permanent att radera:\n%@\n\n– Det här kan inte återställas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": สิ่งนี้จะลบอย่างถาวร:\n%@\n\nข้อมูลนี้ไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu işlem aşağıdaki öğeleri kalıcı olarak siler:\n%@\n\n: Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": це буде постійно видалення:\n%@\n\nЦього неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Thao tác này sẽ xóa vĩnh viễn:\n%@\n\n: Không thể khôi phục thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作将永久删除：\n%@\n\n此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作將永久刪除：\n%@\n\n此操作不可撤銷。"
          }
        }
      }
    },
    "This will sign out @%@. Repositories for this account will be hidden until you sign back in, and local files will stay on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى تسجيل الخروج @%@. سيتم إخفاء مستودعات هذا الحساب حتى تقوم بتسجيل الدخول مرة أخرى، وستبقى الملفات المحلية على جهازك.\nرمز"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil logge ud @%@. Lagre for denne konto vil være skjult, indtil du logger ind igen, og lokale filer forbliver på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird @%@ abgemeldet. Repositorys für dieses Konto werden ausgeblendet, bis Sie sich erneut anmelden, und lokale Dateien bleiben auf Ihrem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cerrará sesión en @%@. Los repositorios de esta cuenta estarán ocultos hasta que vuelva a iniciar sesión y los archivos locales permanecerán en su dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tämän tilin versiot piilotetaan kunnes kirjaudut takaisin sisään, ja paikalliset tiedostot pysyvät laitteessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Cela permettra de se déconnecter @%@: Les référentiels associés à ce compte seront masqués jusqu'à votre prochain redémarrage, et les fichiers locaux resteront sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– זה יסגר את החשבון של @%@– המאגרים של חשבון זה יישארו скрыtiים עד שתקבלו חתימה מחדש, והקובץ המקומיים יישארו על המכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह @ को साइन आउट करेगा।%@– इस खाते के लिए रिपॉजिटरी तब तक छिपे रहेंगे जब तक आप पुनः साइन इन न करेंगे, और स्थानीय फ़ाइलें आपके डिवाइस पर बनी रहेंगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az @-ot kilépésre vonzza.%@: Ez a számítógépre vonatkozó adatmagazinok csak újra bejelentkezés előtt rejtett maradnak, a helyi fájlok pedig az eszközeleteden maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan melakukan penutupan akun @%@. Repositori untuk akun ini akan disembunyikan sampai Anda masuk kembali, dan file lokal akan tetap tersimpan di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Questo effettuerà la disconnessione @%@: I repository per questo account saranno nascosti fino a quando non effettuerai nuovamente l&#039;accesso; i file locali rimarranno sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：サインアウトします。%@：このアカウントのリポジトリは、再度サインインするまで非表示となり、ローカルファイルは端末上に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이로 인해 로그아웃됩니다.%@: 해당 계정의 저장소는 다시 로그인할 때까지 숨겨지며, 로컬 파일은 기기에 계속 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil avslutte logginnstatusen @%@– Lagringsplattformer for dette kontoen vil bli skjult til du logger inn igjen, og lokale filer vil forbli på enheten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal de aanmelding beëindigen @%@: De opslagplaatsen voor dit account worden verborgen totdat u opnieuw inlogt, en de lokale bestanden blijven op uw apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– Zakończenie sesji @%@– Magazyny danych dla tego konta będą ukrywane aż do ponownego zalogowania się, a lokalne pliki pozostaną na Twoim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando realiza a saída de sessão @%@– Os repositórios para esta conta serão ocultados até você se autenticar novamente, e os arquivos locais permanecerão no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Это отменит вход @%@: репозитории для данного аккаунта будут скрыты до тех пор, пока вы не войдёте в систему повторно, а локальные файлы останутся на вашем устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Detta avslutar inloggningen @%@– Reposter för denna konto kommer att vara skymdat tills du loggar in igen, och lokala filer kommer att behållas på din enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": จะทำการออกจากระบบ @%@: คลังข้อมูลสำหรับบัญชีนี้จะถูกซ่อนจนกว่าคุณจะเข้าสู่ระบบอีกครั้ง และไฟล์ท้องถิ่นจะยังคงอยู่บนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu işlem @'i çıkış yapar.%@: Bu hesabın depoları yeniden giriş yapmak üzere gizlenir ve yerel dosyalar cihazınızda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це призведе до виходу з системи @%@. Репозиторії для цього облікового запису будуть прихованими до моменту повторного входу, а локальні файли залишатимуться на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hành động này sẽ thoát đăng nhập @%@: Các kho dữ liệu cho tài khoản này sẽ bị ẩn cho đến khi bạn đăng nhập lại, và các tệp cục bộ sẽ vẫn được lưu trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将执行登出操作@%@：该账户的存储库将暂时隐藏，直至您重新登录；本地文件则会保留在您的设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將執行登齣操作@%@：該賬戶的存儲庫將暫時隱藏，直至您重新登録；本地文件則會保留在您的設備上。"
          }
        }
      }
    },
