        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此遠端不支援 Git LFS 鎖定。"
          }
        }
      }
    },
    "This removes Push Sync routing for @%@ on this device. It does not uninstall the GitHub App. Use Manage on GitHub if you want GitHub to stop sending events.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا توجيه Push Sync لـ @%@ على هذا الجهاز. لا يلغي تثبيت GitHub App. استخدم الإدارة على GitHub إذا أردت أن يتوقف GitHub عن إرسال الأحداث."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner Push Sync-routing for @%@ på denne enhed. GitHub App afinstalleres ikke. Brug Administrer på GitHub, hvis du vil have GitHub til at stoppe med at sende hændelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt das Push Sync-Routing für @%@ auf diesem Gerät. Die GitHub App wird nicht deinstalliert. Verwenden Sie „Auf GitHub verwalten“, wenn GitHub keine Ereignisse mehr senden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto quita el enrutamiento de Push Sync para @%@ en este dispositivo. No desinstala la GitHub App. Usa Gestionar en GitHub si quieres que GitHub deje de enviar eventos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa tilin @%@ Push Sync -reitityksen tästä laitteesta. Se ei poista GitHub Appia. Käytä kohtaa Hallitse GitHubissa, jos haluat GitHubin lopettavan tapahtumien lähettämisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le routage Push Sync pour @%@ sur cet appareil. La GitHub App n’est pas désinstallée. Utilisez Gérer sur GitHub si vous voulez que GitHub cesse d’envoyer des événements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה את ניתוב Push Sync עבור @%@ במכשיר זה. היא לא מסירה את התקנת ה-GitHub App. השתמשו בניהול ב-GitHub אם ברצונכם ש-GitHub יפסיק לשלוח אירועים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस पर @%@ के लिए Push Sync रूटिंग हटाता है। यह GitHub App अनइंस्टॉल नहीं करता। अगर आप चाहते हैं कि GitHub इवेंट भेजना बंद करे, तो GitHub पर प्रबंधित करें का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez eltávolítja a Push Sync útválasztását @%@ számára ezen az eszközön. A GitHub Appot nem távolítja el. Ha azt szeretné, hogy a GitHub ne küldjön több eseményt, használja a Kezelés a GitHubon lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus perutean Push Sync untuk @%@ di perangkat ini. GitHub App tidak dicopot. Gunakan Kelola di GitHub jika Anda ingin GitHub berhenti mengirim peristiwa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove l'instradamento Push Sync per @%@ su questo dispositivo. Non disinstalla la GitHub App. Usa Gestisci su GitHub se vuoi che GitHub smetta di inviare eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでの @%@ の Push Sync ルーティングを削除します。GitHub App はアンインストールされません。GitHub からのイベント送信を止めたい場合は、GitHub の「管理」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 @%@의 Push Sync 라우팅을 제거합니다. GitHub App은 제거되지 않습니다. GitHub가 이벤트 전송을 중지하게 하려면 GitHub의 관리를 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner Push Sync-ruting for @%@ på denne enheten. GitHub App avinstalleres ikke. Bruk Administrer på GitHub hvis du vil at GitHub skal slutte å sende hendelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert de Push Sync-routering voor @%@ op dit apparaat. De GitHub App wordt niet verwijderd. Gebruik Beheren op GitHub als u wilt dat GitHub stopt met het sturen van gebeurtenissen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa routing Push Sync dla @%@ na tym urządzeniu. Nie odinstalowuje GitHub App. Użyj Zarządzaj na GitHubie, jeśli chcesz, aby GitHub przestał wysyłać zdarzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o roteamento do Push Sync de @%@ neste dispositivo. Não desinstala o GitHub App. Use Gerenciar no GitHub se quiser que o GitHub pare de enviar eventos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит маршрутизацию Push Sync для @%@ на этом устройстве. GitHub App не будет удалён. Используйте «Управлять на GitHub», если хотите, чтобы GitHub перестал отправлять события."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort Push Sync-routning för @%@ på den här enheten. GitHub App avinstalleras inte. Använd Hantera på GitHub om du vill att GitHub ska sluta skicka händelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบการกำหนดเส้นทาง Push Sync สำหรับ @%@ บนอุปกรณ์นี้ แต่ไม่ถอนการติดตั้ง GitHub App ใช้ จัดการ บน GitHub หากต้องการให้ GitHub หยุดส่งเหตุการณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu cihazda @%@ için Push Sync yönlendirmesini kaldırır. GitHub App'i kaldırmaz. GitHub'ın olay göndermeyi bırakmasını istiyorsanız GitHub'da Yönet'i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вилучить маршрутизацію Push Sync для @%@ на цьому пристрої. GitHub App не буде видалено. Використайте «Керувати на GitHub», якщо хочете, щоб GitHub перестав надсилати події."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này gỡ định tuyến Push Sync cho @%@ trên thiết bị này. Nó không gỡ cài đặt GitHub App. Hãy dùng Quản lý trên GitHub nếu bạn muốn GitHub ngừng gửi sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将移除此设备上 @%@ 的 Push Sync 路由。它不会卸载 GitHub App。如果你希望 GitHub 停止发送事件，请使用 GitHub 上的“管理”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除此裝置上 @%@ 的 Push Sync 路由。它不會解除安裝 GitHub App。若你想讓 GitHub 停止傳送事件，請使用 GitHub 上的「管理」。"
          }
        }
      }
    },
    "This removes the repository from GitSync.md only. Files will remain at:\n%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة المستودع من GitSync.md فقط. ستبقى الملفات في: \n%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner kun lageret fra GitSync.md. Filerne forbliver på:\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Repository nur aus GitSync.md entfernt. Die Dateien verbleiben unter:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el repositorio de GitSync.md únicamente. Los archivos permanecerán en:\n%@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa arkiston arkistosta GitSync.md . Tiedostot pysyvät osoitteessa:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": cela supprime le dépôt de GitSync.md uniquement. Les fichiers resteront à :\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– מחקת את המאגר מה- GitSync.md בלבד – הקבצים יישארו בכתובת הבאה:\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह रिपॉजिटरी को [स्रोत से] हटाता है। GitSync.md के लिए ही। फ़ाइलें निम्न स्थान पर रहेंगी:\n%@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– ez az adatmagaznát eltávolítja. GitSync.md -re vonatkozik. A fájlok a következő helyen maradnak:\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hal ini menghapus repositori dari GitSync.md hanya. Berkas akan tetap berada di:\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "rimuove il repository da GitSync.md esclusivamente. I file rimarranno in:\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リポジトリを削除します。 GitSync.md 専用。ファイルは以下の場所に保持されます：\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 리포지토리를 제거합니다. GitSync.md 에만 적용됩니다. 파일은 다음 경로에 유지됩니다:\n%@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fjerner lagringsplatsen fra GitSync.md kun. Filene vil forbli på følgende adresse:\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Dit verwijdert het repository van GitSync.md enkel. Bestanden blijven op:\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– usuwa repositorium z GitSync.md wyłącznie. Pliki pozostaną w następującym katalogu:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remove o repositório de GitSync.md apenas. Os arquivos permanecerão em:\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": это удаляет репозиторий из GitSync.md только. Файлы останутся в следующем пути:\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "tar bort lagringsplatsen från GitSync.md endast. Filerna kommer att förbliva på följande adress:\n%@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ทำให้ถอนคลังข้อมูลออกจาก GitSync.md เท่านั้น ไฟล์จะคงอยู่ที่:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu işlem depoyu kaldırır. GitSync.md için yalnızca; dosyalar şu yere kalacaktır:\n%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": це видаляє репозиторій з GitSync.md — лише для цього варіанту. Файли залишаться наступному шляху:\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hành động này sẽ loại bỏ kho dữ liệu khỏi GitSync.md chỉ áp dụng cho trường hợp này. Các tệp sẽ được lưu tại:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作将从...中移除存储库。 GitSync.md 仅限此用途。文件将保留在以下路径：\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作將從...中移除存儲庫。 GitSync.md 僅限此用途。文件將保留在以下路徑：\n%@"
          }
        }
      }
    },
    "This repository connection was removed. Add it again before cloning. Your files have been preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إزالة اتصال هذا المستودع. أضفه مرة أخرى قبل الاستنساخ. تم الاحتفاظ بملفاتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne repository-forbindelse blev fjernet. Tilføj den igen før kloning. Dine filer er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Repository-Verbindung wurde entfernt. Fügen Sie sie vor dem Klonen erneut hinzu. Ihre Dateien wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitó esta conexión de repositorio. Vuelve a añadirla antes de clonar. Tus archivos se han conservado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tietovarastoyhteys poistettiin. Lisää se uudelleen ennen kloonausta. Tiedostosi on säilytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion au dépôt a été supprimée. Ajoutez-la à nouveau avant de cloner. Vos fichiers ont été conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור למאגר זה הוסר. הוסיפו אותו שוב לפני השכפול. הקבצים שלכם נשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिपॉज़िटरी का कनेक्शन हटा दिया गया। क्लोन करने से पहले इसे फिर से जोड़ें। आपकी फ़ाइलें सुरक्षित रखी गई हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a tárolókapcsolatot eltávolították. Klónozás előtt adja hozzá újra. A fájljait megőriztük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi repositori ini telah dihapus. Tambahkan lagi sebelum clone. File Anda telah dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo collegamento al repository è stato rimosso. Aggiungilo di nuovo prima di clonare. I tuoi file sono stati conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリ接続は削除されました。クローンする前にもう一度追加してください。ファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소 연결이 제거되었습니다. 클론하기 전에 다시 추가하십시오. 파일은 보존되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne repositorietilkoblingen ble fjernet. Legg den til igjen før kloning. Filene dine er bevart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze repositoryverbinding is verwijderd. Voeg hem opnieuw toe voordat u kloont. Uw bestanden zijn behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To połączenie z repozytorium zostało usunięte. Dodaj je ponownie przed klonowaniem. Twoje pliki zostały zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão deste repositório foi removida. Adicione-o novamente antes de clonar. Seus arquivos foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это подключение к репозиторию удалено. Добавьте его снова перед клонированием. Ваши файлы сохранены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här arkivanslutningen har tagits bort. Lägg till den igen innan du klonar. Dina filer har bevarats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อที่เก็บนี้ถูกลบแล้ว เพิ่มอีกครั้งก่อน clone ไฟล์ของคุณได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo bağlantısı kaldırıldı. Klonlamadan önce yeniden ekleyin. Dosyalarınız korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це підключення до репозиторію вилучено. Додайте його знову перед клонуванням. Ваші файли збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối kho lưu trữ này đã bị gỡ. Hãy thêm lại trước khi clone. Tệp của bạn vẫn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库连接已被移除。克隆前请重新添加。你的文件已被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存庫連接已被移除。複製前請重新加入。你的檔案已保留。"
          }
        }
      }
    },
    "This repository hasn't been cloned yet.\nTap below to download it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم استنساخ هذا المستودع بعد.\nانقر أدناه لتنزيله."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette lager er ikke blevet klonet endnu.\nTryk nedenfor for at downloade det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository wurde noch nicht geklont.\nTippen Sie unten, um es herunterzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio aún no ha sido clonado.\nToque a continuación para descargarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä versiota ei ole vielä kloonattu.\nNapauta alla ladataksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ce dépôt n'a pas encore été cloné.\n: Cliquez ci-dessous pour le télécharger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": המאגר הזה לא נקלד עדיין.\n– לחיצה מתחת לרשום כדי להוריד אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह रिपॉजिटरी अभी तक क्लोन नहीं की गई है।\n: इसे डाउनलोड करने के लिए नीचे टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ez a repository még nem klóndítottak meg.\n: alá nyomás útján letölthető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini belum dikloning.\nTekan di bawah untuk mengunduhnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo repository non è ancora stato clonato.\n: tocca qui sotto per scaricarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：このリポジトリはまだクローンされていません。\n：下部をタップしてダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이 저장소는 아직 클로닝되지 않았습니다.\n: 아래에서 다운로드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette repotretnetet er ikke klonet ennå.\n: Trykk nedenfor for å laste ned det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit repository is nog niet gekloneerd.\n: Tik hieronder om het te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten repositoriom nie został jeszcze klonowany.\n– naciśnij poniżej, aby go pobrać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositório ainda não foi clonado.\n: Clique abaixo para baixá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот репозиторий ещё не клонирован.\n— нажмите ниже, чтобы скачать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna repotrepo har ännu inte klonats.\n– Tryck nedan för att ladda ner det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโพซิทอรี่นี้ยังไม่ได้ถูกคลอนแล้ว\nแตะที่ด้านล่างเพื่อดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "depolama alanına henüz klonlama yapılmamıştır.\n: Dosyayı indirmek için aşağıya tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей репозиторій ще не клонований.\n— натисніть нижче, щоб завантажити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repository này chưa được clone.\n: Vui lòng nhấn dưới đây để tải xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该仓库尚未被克隆。\n：点击下方即可下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該倉庫尚未被剋隆。\n：點擊下方即可下載。"
          }
        }
      }
    },
    "This uploads the saved commit to a new private GitHub repository. Later edits to your files are not included in this upload.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفع هذا الـ commit المحفوظ إلى مستودع GitHub خاص جديد. التعديلات اللاحقة على ملفاتك غير مضمّنة في هذا الرفع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette uploader det gemte commit til et nyt privat GitHub-repository. Senere ændringer i dine filer er ikke med i denne upload."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies lädt den gespeicherten Commit in ein neues privates GitHub-Repository hoch. Spätere Änderungen an Ihren Dateien sind in diesem Upload nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sube el commit guardado a un repositorio privado nuevo de GitHub. Los cambios posteriores en tus archivos no se incluyen en esta subida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lataa tallennetun commitin uuteen yksityiseen GitHub-tietovarastoon. Tiedostoihisi myöhemmin tehdyt muokkaukset eivät sisälly tähän lataukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela envoie le commit enregistré vers un nouveau dépôt GitHub privé. Les modifications ultérieures de vos fichiers ne sont pas incluses dans cet envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מעלה את ה-commit השמור למאגר GitHub פרטי חדש. עריכות מאוחרות יותר בקבצים שלכם לא נכללות בהעלאה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सहेजे गए commit को एक नई निजी GitHub रिपॉज़िटरी में अपलोड करता है। आपकी फ़ाइलों में बाद के संपादन इस अपलोड में शामिल नहीं हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett commit egy új privát GitHub-tárolóba töltődik fel. A fájlok későbbi módosításai nem részei ennek a feltöltésnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengunggah commit tersimpan ke repositori GitHub privat baru. Editan berikutnya pada file Anda tidak termasuk dalam unggahan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo carica il commit salvato in un nuovo repository GitHub privato. Le modifiche successive ai tuoi file non sono incluse in questo caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのコミットを新しい非公開の GitHub リポジトリにアップロードします。以降のファイルの編集はこのアップロードに含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 커밋을 새 비공개 GitHub 저장소에 업로드합니다. 이후의 파일 편집은 이 업로드에 포함되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette laster opp den lagrede commiten til et nytt privat GitHub-repositorium. Senere endringer i filene dine er ikke med i denne opplastingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit uploadt de bewaarde commit naar een nieuwe privé-GitHub-repository. Latere wijzigingen in uw bestanden zitten niet in deze upload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wysyła zapisany commit do nowego prywatnego repozytorium GitHub. Późniejsze zmiany w plikach nie są uwzględnione w tym wysłaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso envia o commit salvo para um novo repositório privado no GitHub. Edições posteriores nos seus arquivos não são incluídas neste envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый commit будет загружен в новый приватный репозиторий GitHub. Последующие правки файлов в эту загрузку не входят."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här laddar upp den sparade commit till ett nytt privat GitHub-arkiv. Senare ändringar i dina filer ingår inte i uppladdningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะอัปโหลด commit ที่บันทึกไว้ไปยังที่เก็บ GitHub ส่วนตัวใหม่ การแก้ไขไฟล์ภายหลังจะไม่รวมในการอัปโหลดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kaydedilen commit'i yeni bir özel GitHub deposuna yükler. Dosyalarınızdaki sonraki düzenlemeler bu yüklemeye dahil değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережений commit буде завантажено в новий приватний репозиторій GitHub. Пізніші правки файлів у це завантаження не входять."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này tải commit đã lưu lên một kho lưu trữ GitHub riêng tư mới. Các chỉnh sửa tệp sau này không được bao gồm trong lần tải lên này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将已保存的提交上传到一个新的 GitHub 私有仓库。之后对文件的编辑不包含在此次上传中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會將已儲存的提交上傳到新的 GitHub 私人儲存庫。之後對檔案的編輯不包含在此次上傳中。"
          }
        }
      }
    },
    "This uploads the saved commit to a new public GitHub repository. Anyone can see its files. Later edits to your files are not included in this upload.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفع هذا الـ commit المحفوظ إلى مستودع GitHub عام جديد. يمكن لأي شخص رؤية ملفاته. التعديلات اللاحقة على ملفاتك غير مضمّنة في هذا الرفع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette uploader det gemte commit til et nyt offentligt GitHub-repository. Alle kan se dets filer. Senere ændringer i dine filer er ikke med i denne upload."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies lädt den gespeicherten Commit in ein neues öffentliches GitHub-Repository hoch. Jeder kann seine Dateien sehen. Spätere Änderungen an Ihren Dateien sind in diesem Upload nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sube el commit guardado a un repositorio público nuevo de GitHub. Cualquiera puede ver sus archivos. Los cambios posteriores en tus archivos no se incluyen en esta subida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lataa tallennetun commitin uuteen julkiseen GitHub-tietovarastoon. Kuka tahansa voi nähdä sen tiedostot. Tiedostoihisi myöhemmin tehdyt muokkaukset eivät sisälly tähän lataukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela envoie le commit enregistré vers un nouveau dépôt GitHub public. Tout le monde peut voir ses fichiers. Les modifications ultérieures de vos fichiers ne sont pas incluses dans cet envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מעלה את ה-commit השמור למאגר GitHub ציבורי חדש. כל אחד יכול לראות את הקבצים שלו. עריכות מאוחרות יותר בקבצים שלכם לא נכללות בהעלאה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सहेजे गए commit को एक नई सार्वजनिक GitHub रिपॉज़िटरी में अपलोड करता है। कोई भी इसकी फ़ाइलें देख सकता है। आपकी फ़ाइलों में बाद के संपादन इस अपलोड में शामिल नहीं हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett commit egy új nyilvános GitHub-tárolóba töltődik fel. A fájljait bárki láthatja. A fájlok későbbi módosításai nem részei ennek a feltöltésnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengunggah commit tersimpan ke repositori GitHub publik baru. Siapa pun dapat melihat file-nya. Editan berikutnya pada file Anda tidak termasuk dalam unggahan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo carica il commit salvato in un nuovo repository GitHub pubblico. Chiunque può vederne i file. Le modifiche successive ai tuoi file non sono incluse in questo caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのコミットを新しい公開の GitHub リポジトリにアップロードします。ファイルは誰でも閲覧できます。以降のファイルの編集はこのアップロードに含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 커밋을 새 공개 GitHub 저장소에 업로드합니다. 누구나 파일을 볼 수 있습니다. 이후의 파일 편집은 이 업로드에 포함되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette laster opp den lagrede commiten til et nytt offentlig GitHub-repositorium. Alle kan se filene. Senere endringer i filene dine er ikke med i denne opplastingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit uploadt de bewaarde commit naar een nieuwe openbare GitHub-repository. Iedereen kan de bestanden zien. Latere wijzigingen in uw bestanden zitten niet in deze upload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wysyła zapisany commit do nowego publicznego repozytorium GitHub. Każdy może zobaczyć jego pliki. Późniejsze zmiany w plikach nie są uwzględnione w tym wysłaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso envia o commit salvo para um novo repositório público no GitHub. Qualquer pessoa pode ver os arquivos. Edições posteriores nos seus arquivos não são incluídas neste envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый commit будет загружен в новый публичный репозиторий GitHub. Его файлы сможет увидеть любой. Последующие правки файлов в эту загрузку не входят."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här laddar upp den sparade commit till ett nytt publikt GitHub-arkiv. Vem som helst kan se dess filer. Senare ändringar i dina filer ingår inte i uppladdningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะอัปโหลด commit ที่บันทึกไว้ไปยังที่เก็บ GitHub สาธารณะใหม่ ทุกคนดูไฟล์ได้ การแก้ไขไฟล์ภายหลังจะไม่รวมในการอัปโหลดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kaydedilen commit'i yeni bir herkese açık GitHub deposuna yükler. Dosyalarını herkes görebilir. Dosyalarınızdaki sonraki düzenlemeler bu yüklemeye dahil değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережений commit буде завантажено в новий публічний репозиторій GitHub. Його файли зможе побачити будь-хто. Пізніші правки файлів у це завантаження не входять."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này tải commit đã lưu lên một kho lưu trữ GitHub công khai mới. Bất kỳ ai cũng có thể xem tệp của nó. Các chỉnh sửa tệp sau này không được bao gồm trong lần tải lên này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将已保存的提交上传到一个新的 GitHub 公开仓库。任何人都可以查看其文件。之后对文件的编辑不包含在此次上传中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會將已儲存的提交上傳到新的 GitHub 公開儲存庫。任何人都能查看其檔案。之後對檔案的編輯不包含在此次上傳中。"
          }
        }
      }
    },
