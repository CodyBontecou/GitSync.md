    "Pull one cloned GitSync.md repository, then commit and push local changes — without opening the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب مستودع GitSync.md مستنسخًا واحدًا، ثم التزم بالتغييرات المحلية وادفعها — من دون فتح التطبيق."
          }
        },
        "da": {
