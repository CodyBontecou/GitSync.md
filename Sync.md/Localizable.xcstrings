          "stringUnit": {
            "state": "translated",
            "value": "作者姓名中不得包含換行符或角括號。"
          }
        }
      }
    },
    "Author Name is required before Git can create commits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المؤلف مطلوب قبل أن يتمكن Git من إنشاء الالتزامات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
