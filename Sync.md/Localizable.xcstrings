    "The remote requested HTTPS credentials, but no token or password is saved for this repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": تم طلب بيانات اعتماد HTTPS عن بُعد، لكن لا يوجد أي رمز أو كلمة مرور محفوظ لمستودع هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernansigende funktion har forespurt HTTPS-krav, men der er ingen token eller adgangskode gemt for dette repository."
