    "Unlock unlimited repositories with a one-time purchase.": {
      "comment": "Subtitle encouraging the user to unlock unlimited repositories",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مستودعات غير محدودة بعملية شراء واحدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Laaas ubegraensede repositories op med et engangskob."
          }
        },
