    "just now": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "lige nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gerade eben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "hace un momento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "juuri nyt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tout juste"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– כרגע"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "– अभी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– mostanra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "baru saja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "appena"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "— 최근"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "nettopp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "nu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– chwilowo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "agora mesmo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "— только что"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "just nu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่งได้รับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "– şu anda"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "— зараз"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ngay lúc này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，刚刚"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，剛剛"
          }
        }
      }
    },
    "leave blank if none": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغًا في حالة عدم وجوده"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "efterlad tom, hvis ingen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "leer lassen, wenn keines vorhanden ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "dejar en blanco si no hay ninguno"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "jättää tyhjäksi, jos ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": laisser vide si aucun n'est présent"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– שמרו ריק אם לא קיים כל ערך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यदि कोई नहीं है तो खाली रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": ha nincs érték, üres mezőben hagyja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "boleh dikosongkan jika tidak ada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": lasciare vuoto se non presente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：項目が存在しない場合は空白に留めること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 값이 없을 경우 빈칸으로 입력하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": La være tom hvis ingenting er tilstede"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "laat leeg als er geen is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– puste pole w przypadku braku wartości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "deixe em branco se nenhuma existir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "— оставьте пустым, если таких данных нет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Låt vara tomt om inget finns."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ให้ทิ้งว่างหากไม่มีข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hiçbir değer yoksa boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "– залиште порожнім, якщо таких варіантів немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Để trống nếu không có dữ liệu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：若无值，请留空"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：若無值，請留空"
          }
        }
      }
    },
