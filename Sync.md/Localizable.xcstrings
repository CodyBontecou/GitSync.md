            "value": "GitHub Hata"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Помилка"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Lỗi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub שגיאה"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 错误"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 錯誤"
          }
        }
      }
    },
    "GitHub event wakes use only opaque identifiers — never repository names, contents, paths, or credentials. Everything manual stays included with the app you already own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub يستخدم مستيقظ الأحداث معرفات معتم فقط-لا يستخدم أبدًا أسماء مستودع أو محتويات أو مسارات أو بيانات اعتماد. كل شيء يقام يدويًا متضمنة في التطبيق الذي لديك بالفعل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub מתעורר האירוע משתמש רק מזהה עמום-אף פעם לא מאגר שמות, תוכן, נתיבים, או אישורים. כל מדריך נשאר כלול עם האפליקציה שכבר בבעלותך."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake-brugere bruger kun opaque identificatorer – aldrig repository-navne, indhold, sti eller adgangsoplysninger. Alt manuelt indhold er fortsat inkluderet i den app, som du allerede besidder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event-Wakes verwenden ausschließlich opake Identifikatoren – niemals Repository-Namen, Inhalte, Pfade oder Anmeldeinformationen. Alle manuellen Elemente bleiben in der App, die Sie bereits besitzen, enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Los eventos de activación utilizan únicamente identificadores opacos; nunca se emplean nombres de repositorio, contenido, rutas ni credenciales. Todo lo que requiera intervención manual se incluye junto con la aplicación que ya posees."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake -työkalu käyttää ainoastaan epäkuvallisia tunnisteita – ei koskaan tallennuslaitteiden nimiä, sisältöjä, polkuja tai kirjautumistietoja. Kaikki manuaaliset asennukset jäävät yhtenäisiksi jo olemassa olevan sovelluksen kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Les événements « Wakes » utilisent uniquement des identifiants opaques — jamais des noms de dépôt, du contenu, de chemins ou de données d'identification. Tout ce qui nécessite une intervention manuelle reste inclus dans l'application que vous possédez déjà."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub EventWakes केवल अपारदर्शी पहचानकर्ताओं का उपयोग करता है — कभी भी रिपॉजिटरी के नामों, सामग्री, पथों या प्रमाणपत्रों का उपयोग नहीं किया जाता। सभी मैनुअल तत्व उस ऐप के साथ शामिल रहते हैं जो आप पहले से ही रखते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Az Event Wake-kor csak opacitású azonosítókat használnak – sosem a tárolóneveket, tartalmait, utakat vagy hitelesítő adatokat. Minden manuális funkció továbbra is azon a alkalmazásban található, amelyet már rendelkezésre állítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake hanya menggunakan identifikator opak — tidak pernah menggunakan nama repositori, konten, jalur, atau kredensial. Semua fitur manual tetap disertakan dalam aplikasi yang sudah Anda miliki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Gli eventi «Wakes» utilizzano esclusivamente identificatori opachi — mai nomi di repository, contenuti, percorsi o credenziali. Tutte le funzionalità manuali rimangono incluse nell'app che già possiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wakesでは、不透明な識別子のみを使用します。リポジトリ名、コンテンツ、パス、または認証情報は一切使用しません。すべての手動操作は、既にご所有のアプリ内に含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wakes는 오직 불투명 식별자만을 사용합니다 — 저장소 이름, 내용, 경로 또는 인증 정보는 절대 사용하지 않습니다. 모든 수동 설정은 이미 사용 중인 앱과 함께 제공됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake-tiltak bruker kun opak identifikatorer – aldri repozitorienavn, innhold, stier eller autentiseringsopplysninger. Alt manuelt innhold er fortsatt inkludert iappen du allerede eier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake's gebruiken uitsluitend ondoorzichtige identificatoren — nooit repositorynamen, inhoud, paden of toegangsgegevens. Alle handmatige functies blijven bij de app die u al bezit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Zdarzenia w Wake korzystają wyłącznie z nieprzepuszczalnych identyfikatorów — nigdy nie używają nazw repositoriów, treści, ścieżek ani danych uwierzytelniających. Wszystkie funkcje manuale pozostają wbudowane w aplikację, którą już posiadasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Os Event Wakes utilizam apenas identificadores opacos — nunca nomes de repositórios, conteúdos, caminhos ou credenciais. Tudo o que for feito manualmente permanece incluído no aplicativo que você já possui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub В событиях используются только неопасные идентификаторы — ни названия репозиториев, ни содержимое, ни пути, ни учетные данные. Все ручные операции остаются встроеными в приложение, которое вы уже имеете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake använder endast opak identifierare – aldrig repozitorienamn, innehåll, sökvägar eller autentiseringsuppgifter. Allt manuellt behövs fortfarande med appen som du redan äger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub EventWakes ใช้เพียงตัวระบุแบบไม่โปร่งใสเท่านั้น — ไม่ใช้ชื่อคลังข้อมูล เนื้อหา เส้นทาง หรือข้อมูลการเข้าสู่ระบบแต่อย่างใด ทุกสิ่งที่ต้องดำเนินการด้วยตนเองยังคงรวมอยู่ในแอปพลิเคชันที่คุณมีอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake yalnızca tıslı tanımlayıcıları kullanır — hiçbir zaman depo isimleri, içeriği, yollar veya yetkilendirme bilgileri kullanılmaz. Tüm el ile gerçekleştirilen işlemler, zaten sahip olduğunuz uygulamayla birlikte kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Події використовують лише непрозорі ідентифікатори — ніколи не імена репозиторіїв, вміст, шляхи чи дані автентифікації. Усі ручні налаштування залишаються в тому додатку, який ви вже маєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Các sự kiện Wake chỉ sử dụng các định danh không trong suốt — không bao giờ sử dụng tên kho lưu trữ, nội dung, đường dẫn hay thông tin xác thực. Mọi thao tác thủ công đều được tích hợp sẵn trong ứng dụng mà bạn đã sở hữu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 事件唤醒功能仅支持使用不透明标识符——绝不使用仓库名称、内容、路径或凭据。所有手动操作均可直接在您已拥有的应用程序中完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 事件喚醒功能僅支援使用不透明識別符號——絕不使用倉庫名稱、內容、路徑或憑據。所有手動操作均可直接在您已擁有的應用程式中完成。"
          }
        }
      }
    },
