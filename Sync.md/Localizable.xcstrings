    "Stops if GitHub moved first": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف إذا تغيّر GitHub أولًا"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper, hvis GitHub flyttede sig først"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt, wenn GitHub zuerst weiter war"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detiene si GitHub avanzó antes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysähtyy, jos GitHub ehti ensin"
