          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": सभी संघर्ष सुलझाए गए हैं। रीबेस को जारी रखें या रोकें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Minden konfliktus megoldott. Folytassa vagy leállítsa a rebase-előkészítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua konflik telah diselesaikan. Lanjutkan atau batalkan proses rebase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i conflitti sono stati risolti. Continua o annulla la rebase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：すべてのコンフリクトが解決されました。再ベースアップを継続または中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 모든 충돌이 해결되었습니다. 재기반화를 계속하거나 중단하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle konflikter er løst. Fortsett eller avbryt omsetningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Alle conflicten zijn opgelost. Voer de herbasisering door of stoppt u met deze?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": wszystkie konflikty rozwiązano. Następnie można kontynuować lub anuluje operację rebase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Todos os conflitos foram resolvidos. Continuar ou abortar a rebase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все конфликты устранены. Продолжить или отменить переустановку основания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla konflikter lösta. Fortsätt eller avbryt omvändningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ความขัดแย้งทั้งหมดได้รับการแก้ไขแล้ว โปรดดำเนินการต่อหรือยกเลิกการปรับฐานข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tüm çakıllar çözüldü. Yeniden temelleme işlemi devam ettirin veya sonlandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі конфлікти вирішені. Продовжити або припинити переузгодження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tất cả xung đột đã được giải quyết. Tiếp tục hoặc hủy thao tác tái căn cứ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：所有冲突已解决。可继续或中止重新合并操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：所有衝突已解決。可繼續或中止重新閤併操作。"
          }
        }
      }
    },
    "All debug log entries will be permanently deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف كافة إدخالات سجل التصحيح نهائيًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle fejlretningslogposter vil blive slettet permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Debug-Protokolleinträge werden dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las entradas del registro de depuración se eliminarán permanentemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki vianetsintäkirjat poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les entrées du journal de débogage seront définitivement supprimées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": כל תכניות במאגרי דג'ב יוסלקו באופן קבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": सभी डिबग लॉग प्रविष्टियों को स्थायी रूप से हटा दिया जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Minden debugnaplóbejegyzés fennsítsül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Semua entri log debug akan dihapus secara permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tutte le righe dei log di debug verranno eliminate permanentemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：すべてのデバッグログエントリは、永続的に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 모든 디버그 로그 항목은 영구적으로 삭제됩니다."
          }
        },
        "nb": {
