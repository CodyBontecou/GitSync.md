          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ قدم هذا SSH مفتاح المضيف (%@):\n\n%@\n\nثق به فقط إذا كانت هذه البصمة مطابقة لبصمتك Forgejo/Git الخادم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Presenterede dette. SSH Hovednøgle (%@):\n\n%@\n\nTiltræd kun, hvis denne fingeraftryk stemmer overens med din. Forgejo/Git Server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Dies wurde vorgestellt. SSH Host-Schlüssel (%@):\n\n%@\n\nVertrauen Sie dem nur, wenn dieser Fingerabdruck mit Ihrem übereinstimmt. Forgejo/Git Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Presentó esto. SSH Clave de host (%@):\n\n%@\n\nConfíe en ello solo si esta huella digital coincide con la suya. Forgejo/Git Servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Esitettiin tämä SSH Host-avain (%@):\n\n%@\n\nUskota se vain, jos tämä sormenjälki vastaa omasta jälimestäsi. Forgejo/Git Palvelin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ A présenté cela. SSH Clé hôte (%@):\n\n%@\n\nN'acceptez cela que si cette empreinte digitale correspond à la vôtre. Forgejo/Git Serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ इसे प्रस्तुत किया गया। SSH होस्ट कुंजी (%@):\n\n%@\n\nइसे केवल तभी विश्वास करें जब यह फिंगरप्रिंट आपके फिंगरप्रिंट से मेल खाता हो। Forgejo/Git सर्वर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Ezt bemutatták. SSH Értékelő kulcs (%@):\n\n%@\n\nCsak ha ez a kézi nyomás összhangban van Önével, beszerezze azt. Forgejo/Git Szerver."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Menyajikan ini SSH Kunci host (%@):\n\n%@\n\nHanya percayalah jika sidik jari ini sesuai dengan sidik jari Anda. Forgejo/Git Server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Ha presentato questo. SSH Chiave ospitante (%@):\n\n%@\n\nConfida in esso solo se l'impronta digitale corrisponde alla tua. Forgejo/Git Server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ これを提示しました。 SSH ホストキー（%@):\n\n%@\n\nこの指紋が自分のものと一致する場合のみ、信頼してください。 Forgejo/Git サーバー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 이를 제시했습니다. SSH 호스트 키 (%@):\n\n%@\n\n이 지문이 귀하의 지문과 일치하는 경우에만 신뢰하십시오. Forgejo/Git 서버."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Presenterte dette SSH Hovednøkkel (%@):\n\n%@\n\nStol kun på dette dersom fingeravtrykket samsvarer med ditt. Forgejo/Git Server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Dit is gepresenteerd. SSH Host-sleutel (%@):\n\n%@\n\nVertrouw er alleen op als deze vingerafdruk overeenkomt met jouw vingerafdruk. Forgejo/Git Server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Przedstawiłem to. SSH Klucz hosta (%@):\n\n%@\n\nWierz w to tylko wtedy, gdy to odcisk palca jest zgodny z Twoim. Forgejo/Git Serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Apresentou isso. SSH Chave de hospedagem (%@):\n\n%@\n\nApenas confie nela se essa impressão digital corresponder à sua. Forgejo/Git Servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Представлено это. SSH Хост-ключ (%@):\n\n%@\n\nУверяйтесь в этом только в том случае, если этот отпечаток пальца соответствует вашему. Forgejo/Git Сервер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Presenterade detta SSH Huvudnyckel (%@):\n\n%@\n\nLita endast på det om denna fingeravtryck matchar ditt. Forgejo/Git Server."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ นำเสนอสิ่งนี้ SSH กุญแจโฮสต์ (%@):\n\n%@\n\nเชื่อถือได้เฉพาะเมื่อลายนิ้วมือนี้ตรงกับลายนิ้วมือของคุณเท่านั้น Forgejo/Git เซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Bunu sundu. SSH Konaklayıcı Anahtar (%@):\n\n%@\n\nSadece bu parmak izi sizinkine uysa güvenin. Forgejo/Git Sunucu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Представили це. SSH Головний ключ (%@):\n\n%@\n\nВірте у це лише тоді, коли цей відбиток пальця відповідає вашому. Forgejo/Git Сервер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Đã trình bày nội dung này. SSH Chìa khóa chủ (%@):\n\n%@\n\nChỉ tin tưởng nếu dấu vân tay này trùng khớp với dấu vân tay của bạn. Forgejo/Git Máy chủ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ הציג זאת SSH מפתח מארח (%@):\n\n%@\n\nתסמוך על זה רק אם טביעת האצבע הזו תואמת את שלך Forgejo/Git שרת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 已展示此内容 SSH 主机密钥 (%@):\n\n%@\n\n仅当此指纹与您的指纹匹配时，请信任该信息。 Forgejo/Git 服务器."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 已展示此內容 SSH 主機金鑰 (%@):\n\n%@\n\n僅當此指紋與您的指紋匹配時，請信任該資訊。 Forgejo/Git 伺服器."
          }
        }
      }
    },
