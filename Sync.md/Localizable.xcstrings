            "state": "translated",
            "value": "Crie uma tag em um commit para marcar uma versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте тег на commit, чтобы отметить версию."
          }
        },
        "sv": {
          "stringUnit": {
