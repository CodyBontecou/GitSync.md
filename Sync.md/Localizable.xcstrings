        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह Obsidian खोलें और सब कुछ पहले से वहाँ है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg reggel az Obsidiant, és már minden ott van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Obsidian di pagi hari dan semuanya sudah ada."
          }
        },
