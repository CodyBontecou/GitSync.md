            "state": "translated",
            "value": "無法存取原始資料夾。請重新連接資料夾以繼續。"
          }
        }
      }
    },
    "Access to this folder expired. Scan it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الوصول إلى هذا المجلد. افحصه مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangen til denne mappe er udløbet. Scan den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf diesen Ordner ist abgelaufen. Scannen Sie ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a esta carpeta caducó. Escanéala de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääsy tähän kansioon vanheni. Skannaa se uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à ce dossier a expiré. Analysez-le à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף הגישה לתיקייה זו פג. סרקו אותה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर का एक्सेस समाप्त हो गया। इसे फिर से स्कैन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mappához való hozzáférés lejárt. Vizsgálja át újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses ke folder ini kedaluwarsa. Pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a questa cartella è scaduto. Scansionala di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダへのアクセスが期限切れです。もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 대한 접근 권한이 만료되었습니다. 다시 스캔하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgangen til denne mappen er utløpt. Skann den på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toegang tot deze map is verlopen. Scan hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do tego folderu wygasł. Przeskanuj go ponownie."
          }
