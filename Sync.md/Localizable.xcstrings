    "Remove from Previously Cloned?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من النسخة المستنسخة مسبقًا؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern fra tidligere klonet?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus zuvor geklonten Dateien entfernen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar de clonado previamente?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista aiemmin kloonatusta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer de précédemment cloné?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– להסיר מה cloned בעבר?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": पहले क्लोन किए गए सामग्री से हटाएँ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Elvégezni a korábban clone alakított elem eltávolítását?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus dari yang sebelumnya dikloning?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere da quello precedentemente clonato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：以前にクローンされたものから削除するか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이전에 클로닝된 항목 제거 여부?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerne fra tidligere klonet versjon?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Verwijderen uit eerder geklonde gegevens?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– Usunąć z wcześniejszego klonowania?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover do que foi clonado anteriormente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Удалить из ранее клонированного набора?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort från tidigare klonade objekt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ลบจากข้อมูลที่เคยโคลนไว้หรือไม่?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Daha önce klonlanmış öğeyi kaldırmak mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Видалити з попередньо клонованих?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Xóa khỏi bản sao trước đây?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：从先前克隆项中移除？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：從先前剋隆項中移除？"
          }
        }
      }
    },
