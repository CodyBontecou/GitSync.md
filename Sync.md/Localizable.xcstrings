          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Falha na atualização origin remoto: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Не удалось обновить данные origin (удалённый режим): %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uppdatering misslyckades origin fjärrkontroll: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
