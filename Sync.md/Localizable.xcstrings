          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Var döpt bort av en annan operation; föråldrade ändringar återställdes inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังข้อมูล %@ ถูกลบออกโดยการดำเนินการอื่น; การเปลี่ยนแปลงที่ล้าสมัยไม่ได้ถูกกู้คืน"
