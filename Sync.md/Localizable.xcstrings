    "Remove old on-device repository copies directly from the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإزالة نسخ المستودع القديمة الموجودة على الجهاز مباشرة من التطبيق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern gamle arkivkopier på enheden direkte fra appen."
          }
        },
