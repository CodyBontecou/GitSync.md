    "It needs a merge. Open it to finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى merge. افتحه لإكمال العملية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den skal merges. Åbn den for at gøre det færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Merge ist nötig. Öffnen, um abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita una fusión. Ábrelo para terminar."
          }
        },
        "fi": {
