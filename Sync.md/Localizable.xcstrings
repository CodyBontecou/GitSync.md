    "You're offline. Changes will push when you're back online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. سيتم push للتغييرات عند عودة الاتصال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Ændringer pushes, når du er online igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind offline. Änderungen werden gepusht, sobald Sie wieder online sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Los cambios se enviarán cuando vuelvas a estar en línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Muutokset lähetetään, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les modifications seront envoyées dès votre retour en ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם לא מחוברים. השינויים יידחפו ב-push כשתחזרו לרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। ऑनलाइन होने पर बदलाव push होंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön offline. A módosítások pusholása megtörténik, amikor újra online lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda offline. Perubahan akan di-push saat Anda kembali online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Le modifiche verranno inviate quando tornerai online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。オンラインに戻ると変更がプッシュされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 다시 온라인이 되면 변경 사항이 푸시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er frakoblet. Endringer pushes når du er på nett igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U bent offline. Wijzigingen worden gepusht zodra u weer online bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Push zmian nastąpi po powrocie online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. As alterações serão enviadas quando você voltar a ficar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Изменения будут отправлены, когда вы снова будете онлайн."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Ändringar pushas när du är online igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ การเปลี่ยนแปลงจะถูก push เมื่อคุณกลับมาออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. Tekrar çevrimiçi olduğunuzda değişiklikler push edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви офлайн. Зміни буде надіслано, коли ви знову будете онлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Thay đổi sẽ được push khi bạn trực tuyến lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。恢复联网后将推送更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已離線。恢復連線後將推送變更。"
          }
        }
      }
    },
