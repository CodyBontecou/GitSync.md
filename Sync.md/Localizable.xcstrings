    "Continue with the saved commit and the repository shown above. A retry checks the destination before uploading.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع باستخدام الـ commit المحفوظ والمستودع المعروض أعلاه. تتحقق إعادة المحاولة من الوجهة قبل الرفع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt med det gemte commit og repositoryet vist ovenfor. Et nyt forsøg tjekker destinationen før upload."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahren Sie mit dem gespeicherten Commit und dem oben gezeigten Repository fort. Ein erneuter Versuch prüft das Ziel vor dem Hochladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa con el commit guardado y el repositorio mostrado arriba. Un reintento comprueba el destino antes de subir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka tallennetulla commitilla ja yllä näkyvällä tietovarastolla. Uusi yritys tarkistaa kohteen ennen latausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez avec le commit enregistré et le dépôt affiché ci-dessus. Une nouvelle tentative vérifie la destination avant l’envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשיכו עם ה-commit השמור והמאגר שמוצג למעלה. ניסיון חוזר בודק את היעד לפני ההעלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए commit और ऊपर दिखाई गई रिपॉज़िटरी के साथ जारी रखें। दोबारा प्रयास अपलोड से पहले गंतव्य की जाँच करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytatás a mentett committal és a fent látható tárolóval. Az újrapróbálás feltöltés előtt ellenőrzi a célt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan dengan commit tersimpan dan repositori yang ditampilkan di atas. Percobaan ulang memeriksa tujuan sebelum mengunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua con il commit salvato e il repository mostrato sopra. Un nuovo tentativo controlla la destinazione prima del caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのコミットと上記のリポジトリで続行します。再試行時は、アップロード前に送信先を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 커밋과 위의 저장소로 계속합니다. 재시도 시 업로드 전에 대상을 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett med den lagrede commiten og repositoriet vist ovenfor. Et nytt forsøk sjekker målet før opplasting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga verder met de bewaarde commit en de repository hierboven. Een nieuwe poging controleert de bestemming vóór het uploaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj z zapisanym commitem i repozytorium pokazanym powyżej. Ponowna próba sprawdza miejsce docelowe przed wysłaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue com o commit salvo e o repositório mostrado acima. Uma nova tentativa verifica o destino antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить с сохранённым commit и репозиторием, показанным выше. Повторная попытка проверяет место назначения перед загрузкой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt med den sparade commit och arkivet som visas ovan. Ett nytt försök kontrollerar målet innan uppladdning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการต่อด้วย commit ที่บันทึกไว้และที่เก็บที่แสดงด้านบน การลองใหม่จะตรวจสอบปลายทางก่อนอัปโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen commit ve yukarıda gösterilen depoyla devam edin. Yeniden deneme, yüklemeden önce hedefi denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжити зі збереженим commit і репозиторієм, показаним вище. Повторна спроба перевіряє місце призначення перед завантаженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục với commit đã lưu và kho lưu trữ ở trên. Lần thử lại sẽ kiểm tra đích trước khi tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已保存的提交和上方显示的仓库继续。重试时会在上传前检查目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已儲存的提交和上方顯示的儲存庫繼續。重試時會在上傳前檢查目的地。"
          }
        }
      }
    },
