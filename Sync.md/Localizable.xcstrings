    "No files to commit. Git does not preserve empty folders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ملفات لتنفيذ commit. لا يحتفظ Git بالمجلدات الفارغة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen filer at committe. Git bevarer ikke tomme mapper."
