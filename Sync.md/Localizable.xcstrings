    "Use Pull All Repositories in Apple Shortcuts. Add a Personal Automation → App → GitSync.md is opened to auto-pull on launch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم سحب كافة المستودعات في Apple Shortcuts. إضافة أتمتة شخصية → التطبيق → GitSync.md مفتوح للسحب التلقائي عند التشغيل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Pull All Repositories i Apple Shortcuts. Tilføj en personlig automatisering → App → GitSync.md åbnes for auto-pull ved lancering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Pull All Repositories in Apple Shortcuts. Eine persönliche Automatisierung hinzufügen → App → GitSync.md wird zum automatischen Pullen beim Start geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice Extraer todos los repositorios en Apple Shortcuts. Agregar una automatización personal → Aplicación → GitSync.md se abre para extracción automática al iniciarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kaikki versiot Apple Shortcuts. Lisää henkilökohtainen automaatio → App → GitSync.md on avattu automaattiselle vetämiselle käynnistettäessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Utiliser « Pull All Repositories » dans Apple Shortcuts. Ajouter « Personal Automation » → « App » GitSync.md est configuré pour un tir automatique lors du lancement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": שימוש בפונקציית \"Pull All Repositories\" Apple Shortcuts– הוסף Personal Automation → App → GitSync.md מופק למשתנה של pulling אוטומטי ב시יבוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'Pull All Repositories in' का उपयोग करें। Apple Shortcuts– 'Personal Automation' → 'App' में एक नया आइटम जोड़ें। GitSync.md को लॉन्च पर स्वचालित-पुल के लिए खोला गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Használja az összes adathordozót Apple Shortcuts: Hozzáadás: „Személyes automatizálás\" → „Alkalmazás\" →\nA GitSync.md beállításai az indításakor automatikus kivitelhez szólítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Pull All Repositories di Apple Shortcuts. Tambahkan Personal Automation → App → GitSync.md dibuka untuk mengaktifkan fitur *auto-pull* saat dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza tutti i repository Apple Shortcuts. Aggiungi Personal Automation → App → GitSync.md è configurato per il rilevamento automatico al lancio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：すべてのリポジトリを取得する Apple Shortcuts：Personal Automation → Appに追加してください。 GitSync.md は、起動時に自動引き抜き機能が有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": Pull All Repositories 기능 사용 Apple Shortcuts. 개인 자동화 → 앱 →에 항목을 추가하세요. GitSync.md 는 실행 시 자동으로 가져오기 기능을 활성화합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk «Hent alle reserver» i Apple Shortcuts. Legg til «Personal Automation» → «App» GitSync.md er åpnet for automatisk trådning ved oppstart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": gebruik 'Alle repositories selecteren' Apple Shortcuts. Voeg een Personal Automation → App toe → GitSync.md is geconfigureerd voor automatische ophaalfunctie bij start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Wykorzystaj wszystkie repositoriały w Apple Shortcuts. Dodaj „Personal Automation\" → „App\" GitSync.md jest skonfigurowany do automatycznego pobierania przy uruchamianiu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Pull All Repositories em Apple Shortcuts. Adicione uma Automação Pessoal → Aplicativo →\nO GitSync.md é configurado para ativar o funcionamento de auto-puxamento ao iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Использование функции «Получить все репозитории» Apple Shortcuts. Добавить «Личная автоматизация» → «Приложение» GitSync.md открыта в режиме автоматического подтягивания при запуске."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd pull-all repositoryer i Apple Shortcuts. Lägg till Personal Automation → App → GitSync.md är öppen för automatisk dragning vid start."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ใช้ Pull All Repositories ใน Apple Shortcuts. เพิ่ม Personal Automation → App → GitSync.md ถูกตั้งค่าให้เปิดใช้งานการดึงอัตโนมัติเมื่อเริ่มทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tüm depoları kullanın Apple Shortcuts: 'Personal Automation' → 'App' → alanına bir öğe ekleme GitSync.md , başlatıldığında otomatik çekme режимine açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Використовувати всі репозиторії в Apple Shortcuts. Додати «Personal Automation» → «App» GitSync.md відкритий для автоматичного завантаження під час запуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng tính năng Pull All Repositories trong Apple Shortcuts. Thêm mục Tự động hóa Cá nhân → Ứng dụng → GitSync.md được thiết lập để tự động kéo khi khởi chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：使用“拉取所有仓库”功能 Apple Shortcuts：添加“个人自动化”→“应用” GitSync.md 在启动时已设置为自动拉取模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：使用“拉取所有倉庫”功能 Apple Shortcuts：添加“個人自動化”→“應用” GitSync.md 在啟動時已設置爲自動拉取模式。"
          }
        }
      }
    },
