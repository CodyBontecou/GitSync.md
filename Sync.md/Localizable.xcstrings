        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une abonnement actif est requis pour activer la synchronisation automatique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित सिंकरेशन को सक्षम करने के लिए एक सक्रिय सदस्यता आवश्यक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus szinkronizálás bekapcsolásához aktív előfizetés szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan aktif diperlukan untuk mengaktifkan sinkronisasi otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario disporre di un abbonamento attivo per attivare la sincronizzazione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期を有効にするには、有効なサブスクリプションが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 동기화를 사용하려면 활성화된 구독이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En aktiv abonnement er nødvendig for å aktivere automatisk synkronisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een actieve abonnement is vereist om automatische synchronisatie mogelijk te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby włączyć automatyczną synchronizację, konieczne jest aktywne subskrypcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária uma assinatura ativa para ativar a sincronização automática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для включения автоматической синхронизации требуется активная подписка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett aktivt prenumeration krävs för att möjliggöra automatisk synkronisering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นต้องมีการสมัครสมาชิกแบบมีส่วนร่วมเพื่อเปิดใช้งานการซิงค์อัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik senkronizasyonu etkinleştirmek için aktif bir abonelik gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для відкриття функції автоматичної синхронізації необхідна активна підписка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có gói đăng ký đang hoạt động để kích hoạt tính năng đồng bộ hóa tự động."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוי פעיל נדרש כדי לאפשר סינכרון אוטומטי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需开通有效订阅方可启用自动同步功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需開通有效訂閱方可啟用自動同步功能。"
          }
        }
      }
    },
    "An optional subscription that keeps every repository current automatically. One installation-level opt-in covers all current and future repositories; exclude any repository anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراك اختياري يحافظ على تيار كل مستودع تلقائيًا. يغطي اشتراك مستوى تثبيت واحد جميع المستودعات الحالية والمستقبلية ؛ استبعاد أي مستودع في أي وقت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוי אופציונלי אשר שומר על כל זרם המאגר באופן אוטומטי. התקנה אחת ברמת opt-in מכסה את כל המאגרים הנוכחיים והעתידיים; לכלול כל מאגר בכל עת."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En valgfri abonnementstjeneste, der automatisk holder alle repositoryer opdaterede. Én installationsbaseret opt-in-detalje dækker alle nuværende og fremtidige repositoryer; ekskludér enhver repository når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein optionales Abonnement, mit dem jedes Repository automatisch auf dem neuesten Stand gehalten wird. Eine einmalige Einrichtung umfasst alle aktuellen sowie künftigen Repositories; jedes Repository kann jederzeit ausgeschlossen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción opcional que mantiene automáticamente todos los repositorios actualizados. Una opción de instalación permite activarla para todos los repositorios actuales y futuros; puede excluir cualquier repositorio en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vapaa valinnainen tilaus, joka pitää kaikki varastot automaattisesti päivityksissä. Yksi asennusvaiheen valintapaneeli kattaa kaikki nykyiset ja tulevat varastot; poista minkä tahansa varaston listalta mihin aikaan haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une abonnement optionnel qui met automatiquement chaque répertoire à jour. Un mode d'activation à niveau d'installation s'applique à tous les répertoires actuels et futurs ; vous pouvez exclure n'importe quel répertoire à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऐसा ऐच्छिक सदस्यता विकल्प जो प्रत्येक रिपॉजिटरी को स्वचालित रूप से अद्यतित रखता है। एक ही इंस्टॉलेशन-स्तरीय 'opt-in' सेवा सभी वर्तमान तथा भविष्य की रिपॉजिटरीज़ को कवर करती है; किसी भी समय किसी भी रिपॉजिटरी को बाहर रखा जा सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy opcionális előfizetés, amely automatikusan frissíti minden tárolót. Egy egyetlen telepítési szintű beiratkozás minden jelenlegi és jövőbeli tárolót érinti; bármikor kizárható bármely tárolót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan opsional yang memastikan setiap repositori tetap mutakhir secara otomatis. Fitur opt-in pada tingkat instalasi mencakup semua repositori saat ini maupun di masa depan; Anda dapat mengecualikan repositori apa pun kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento opzionale che mantiene automaticamente tutti i repository aggiornati. Un'opzione di installazione unica copre tutti i repository attuali e futuri; è possibile escludere qualsiasi repository in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのリポジトリを自動的に最新の状態に保つオプションサブスクリプションです。1回のインストールで有効化する方式により、現在および将来のすべてのリポジトリを対象とします。任意のリポジトリをいつでも除外できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 저장소를 자동으로 최신 상태로 유지하는 선택적 구독 서비스입니다. 한 번의 설치만으로 모든 현재 및 향후 생성되는 저장소에 적용할 수 있으며, 원하는 저장소는 언제든지 제외할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En valgfri abonnement som automatisk holder alle repozitorier oppdaterte. Én installasjonsbasert aktivasjon dekker alle nåværende og fremtidige repozitorier; ekskludér hvilken som helst repozitorie når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een optionele abonnement die elke repository automatisch bij het actuele stand houdt. Een installatiegebaseerd opt-in-beleid beschermt alle huidige en toekomstige repositories; u kunt elke repository wanneer u wilt uitsluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopuszczalna subskrypcja, która automatycznie utrzymuje wszystkie repositoria aktualnymi. Jedna opcjonalna konfiguracja podczas instalacji obejmuje wszystkie obecne oraz przyszłe repositoria; można w dowolnym momencie wykluczyć dowolny repositoriom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura opcional que mantém todos os repositórios atualizados automaticamente. Um recurso de instalação permite ativar essa funcionalidade para todos os repositórios atuais e futuros; exclua qualquer repositório a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опциональная подписка, которая автоматически поддерживает актуальность всех репозиториев. Один способ активации на уровне установки охватывает все текущие и будущие репозитории; вы можете исключить любой репозиторий в любой момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett valfritt prenumerationssystem som automatiskt håller alla lagringsplatser uppdaterade. En inställning för prenumeration gäller alla nuvarande och framtida lagringsplatser; utesluta vilken lagringsplats som helst när som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการสมัครสมาชิกแบบเลือกใช้ที่ช่วยอัปเดตข้อมูลในทุก repositorie อย่างอัตโนมัติ — การตั้งค่าแบบเลือกใช้ในระดับการติดตั้งนี้ครอบคลุม repositorie ทั้งในปัจจุบันและในอนาคต; คุณสามารถยกเว้น repositorie ใดๆ ได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her depo'yu otomatik olarak güncel tutan seçkin bir abonelik. Tek bir kurulum düzeyindeki kaydırmaya dayalı bu çözüm, mevcut ve gelecekteki tüm depoları kapsar; herhangi bir depoyu her an dışlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатковий підписка, яка автоматично підтримує всі репозиторії в актуальному стані. Один налаштуваний на рівні інсталяції підписка відповідає для всіх поточних та майбутніх репозиторіїв; будь-який репозиторій можна виключити в будь-який момент."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một gói đăng ký tùy chọn giúp tự động cập nhật mọi kho lưu trữ. Khả năng kích hoạt theo cấp độ cài đặt này áp dụng cho tất cả các kho lưu trữ hiện tại và tương lai; bạn có thể loại trừ bất kỳ kho lưu trữ nào vào bất kỳ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项可选订阅服务，可自动保持所有存储库的版本同步。该订阅采用单次安装式订阅模式，适用于所有当前及未来的存储库；您可随时将任意存储库从订阅中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一項可選訂閱服務，可自動保持所有儲存庫的版本同步。該訂閱採用單次安裝式訂閱模式，適用於所有當前及未來的儲存庫；您可隨時將任意儲存庫從訂閱中移除。"
          }
        }
      }
    },
