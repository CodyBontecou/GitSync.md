    },
    "This folder overlaps unfinished publication progress. Finish that publication before removing Git tracking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتداخل هذا المجلد مع تقدم نشر غير مكتمل. أكمل ذلك النشر قبل إزالة تتبع Git."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe overlapper en ufærdig udgivelse. Færdiggør den udgivelse, før du fjerner Git-sporing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner überschneidet sich mit einem unvollendeten Veröffentlichungsfortschritt. Schließen Sie diese Veröffentlichung ab, bevor Sie das Git-Tracking entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta se solapa con una publicación sin terminar. Termina esa publicación antes de quitar el seguimiento de Git."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kansio on päällekkäin keskeneräisen julkaisun kanssa. Viimeistele julkaisu ennen Git-seurannan poistamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier chevauche une publication inachevée. Terminez cette publication avant de supprimer le suivi Git."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיקייה הזו חופפת להתקדמות פרסום שלא הושלמה. סיימו את הפרסום הזה לפני הסרת מעקב Git."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोल्डर अधूरी प्रकाशन प्रगति से ओवरलैप करता है। Git ट्रैकिंग हटाने से पहले वह प्रकाशन पूरा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mappa átfedésben van egy befejezetlen közzététellel. A Git-követés eltávolítása előtt fejezze be azt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini tumpang tindih dengan progres publikasi yang belum selesai. Selesaikan publikasi itu sebelum menghapus pelacakan Git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella si sovrappone a una pubblicazione incompleta. Completa quella pubblicazione prima di rimuovere il tracciamento Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは未完了の公開の進捗と重なっています。Git の追跡を解除する前にその公開を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 완료되지 않은 게시 진행 상황과 겹칩니다. Git 추적을 제거하기 전에 해당 게시를 완료하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen overlapper uferdig publiseringsfremdrift. Fullfør den publiseringen før du fjerner Git-sporing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map overlapt met een onvoltooide publicatie. Rond die publicatie af voordat u Git-tracking verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder pokrywa się z niedokończoną publikacją. Dokończ ją, zanim usuniesz śledzenie Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta se sobrepõe a um progresso de publicação inacabado. Conclua essa publicação antes de remover o rastreamento Git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка пересекается с незавершённой публикацией. Завершите её, прежде чем удалять отслеживание Git."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen överlappar ett oavslutat publiceringsförlopp. Slutför den publiceringen innan du tar bort Git-spårning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้ทับซ้อนกับความคืบหน้าการเผยแพร่ที่ยังไม่เสร็จ ทำการเผยแพร่นั้นให้เสร็จก่อนลบการติดตาม Git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör tamamlanmamış bir yayımlamayla çakışıyor. Git takibini kaldırmadan önce o yayımlamayı tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка перетинається з незавершеною публікацією. Завершіть її, перш ніж вилучати відстеження Git."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này chồng lấn với tiến trình xuất bản chưa hoàn tất. Hãy hoàn tất lượt xuất bản đó trước khi gỡ theo dõi Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹与未完成的发布进度重叠。请先完成该发布，再移除 Git 跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料夾與未完成的發佈進度重疊。請先完成該發佈，再移除 Git 追蹤。"
          }
        }
      }
    },
