    "All local changes to this file will be permanently discarded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تجاهل كافة التغييرات المحلية التي تم إجراؤها على هذا الملف نهائيًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lokale ændringer af denne fil vil blive kasseret permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lokalen Änderungen an dieser Datei werden dauerhaft verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los cambios locales realizados en este archivo se descartarán permanentemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki paikalliset muutokset tähän tiedostoon hylätään pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les modifications locales apportées à ce fichier seront définitivement supprimées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": כל שינויים מקומיים בקובץ זה ייפוצלו באופן קבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": इस फ़ाइल में किए गए सभी स्थानीय परिवर्तन स्थायी रूप से खारिज कर दिए जाएंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ez a fájlra vonatkozó minden helyi módosítás mindig eltűnik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Semua perubahan lokal pada file ini akan dihapus secara permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tutti i cambiamenti locali apportati a questo file verranno permanentemente eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：このファイルに対するすべてのローカル変更は、永続的に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이 파일에 대한 모든 지역 변경 사항은 영구적으로 무효화됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Alle lokale endringer i denne filen vil permanent bli slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Alle lokale wijzigingen in deze bestand worden permanent verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": wszystkie lokalne zmiany w tym pliku zostaną na zawsze usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Todas as alterações locais neste arquivo serão permanentemente descartadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Все локальные изменения в этом файле будут навсегда утеряны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla lokala ändringar i denna fil kommer permanent att avskiljas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงทั้งหมดในไฟล์นี้จะถูกละทิ้งอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu dosyaya ilişkin tüm yerel değişiklikler sonsuza kadar silinecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Усі локальні зміни в цьому файлі будуть під час виконання постійно видалені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tất cả thay đổi cục bộ đối với tệp này sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：对本文件的所有本地修改都将永久丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：對本文件的所有本地修改都將永久丟失。"
          }
        }
      }
    },
