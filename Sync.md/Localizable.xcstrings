          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "origin 远程仓库在 push 前发生了变化。发布已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "origin 遠端儲存庫在 push 前發生了變更。發佈已停止。"
          }
        }
      }
    },
    "The prepared snapshot is locked. Resume the saved publication.": {
      "localizations": {
