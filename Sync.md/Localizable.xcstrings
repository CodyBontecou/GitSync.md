    "Clean fast-forward only; unsafe state stops for attention.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمليات fast-forward نظيفة فقط؛ وتتوقف الحالة غير الآمنة للمراجعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun rene fast-forward-handlinger; usikker tilstand stopper for gennemgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur saubere Fast-Forwards; unsichere Zustände stoppen zur Überprüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo fast-forward limpios; los estados no seguros se detienen para su revisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain puhtaat fast-forwardit; vaarallinen tila pysäyttää toiminnon tarkistusta varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast-forward propre uniquement ; tout état non sûr arrête l’opération pour vérification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "fast-forward נקי בלבד; מצב לא בטוח עוצר לבדיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल साफ़ fast-forward; असुरक्षित स्थिति पर समीक्षा के लिए रुक जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak tiszta fast-forward; a nem biztonságos állapot leállítja a műveletet felülvizsgálatra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya fast-forward bersih; keadaan yang tidak aman menghentikan operasi untuk ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo fast-forward puliti; uno stato non sicuro arresta l’operazione per consentire una verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンな fast-forward のみ。安全でない状態では停止して確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗한 fast-forward만 수행하며 안전하지 않은 상태에서는 중단하고 확인을 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare rene fast-forward-operasjoner; en utrygg tilstand stopper operasjonen for gjennomgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen schone fast-forwards; een onveilige toestand stopt de bewerking voor controle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko czysty fast-forward; niebezpieczny stan powoduje zatrzymanie i wymaga uwagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente fast-forward limpo; um estado inseguro interrompe a operação e exige atenção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только чистый fast-forward; небезопасное состояние остановит операцию и потребует внимания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast ren fast-forward; ett osäkert tillstånd stoppar och kräver åtgärd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะ fast-forward ที่สะอาด สถานะที่ไม่ปลอดภัยจะทำให้หยุดเพื่อรอตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca temiz fast-forward; güvenli olmayan durum inceleme için durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише чистий fast-forward; небезпечний стан зупиняє операцію для перевірки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ fast-forward sạch; trạng thái không an toàn sẽ dừng để kiểm tra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限干净的 fast-forward；不安全状态会停止以供处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限乾淨的 fast-forward；不安全狀態會停止以供處理。"
          }
        }
      },
      "extractionState": "stale"
    },
