        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik został usunięty na tym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo foi excluído neste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл удалён на этом iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här filen raderades på den här iPhonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ถูกลบบน iPhone เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bu iPhone'da silindi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл видалено на цьому iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này đã bị xóa trên iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件已在此 iPhone 上被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案已在此 iPhone 上被刪除。"
          }
        }
      }
    },
    "This file was renamed differently on each side. Choose which name to keep — the other will be removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة تسمية هذا الملف بشكل مختلف على كل جانب. اختر الاسم الذي تريد الاحتفاظ به — ستتم إزالة الاسم الآخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fil blev omdøbt forskelligt på hver side. Vælg hvilket navn du vil beholde - det andet vil blive fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde auf jeder Seite unterschiedlich umbenannt. Wählen Sie den Namen aus, den Sie behalten möchten – der andere wird entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambió el nombre de este archivo de manera diferente en cada lado. Elija qué nombre conservar; el otro se eliminará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tiedosto nimettiin eri puolilla. Valitse nimi säilytettävä - toinen poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ce fichier a été renommé différemment sur chaque côté. Choisissez le nom à conserver — l'autre sera supprimé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": קובץ זה שימש את השם בצורה שונה בכל צד. בחרו את השם שיתקיין – השם השני יידלק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": इस फ़ाइल का नाम प्रत्येक पक्ष पर अलग-अलग रूप से बदल दिया गया है। आप यह चुन सकते हैं कि कौन सा नाम बनाए रखें — अन्य नाम हटा दिया जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ez a fájl minden oldalon különböző nevvel lett átnevezve. Válassza meg, mely nevet tartja meg – az egyiket eltávolítják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nama berkas ini diubah secara berbeda pada masing-masing sisi. Pilih nama mana yang akan dipertahankan — nama lainnya akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo file è stato rinominato in modo diverso su ciascun lato. Selezionare quale nome mantenere — l'altro verrà eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：このファイルは両側で異なる名前に変更されています。どの名前を保持するかを選択してください——もう一方の名前は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이 파일은 각 측에서 서로 다른 이름으로 재명명되었습니다. 어떤 이름을 유지할지 선택하십시오 — 다른 이름은 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Denne filen ble omdøpt på hver side med forskjellige navn. Vennligst velg hvilket navn du vil beholde – det andre vil bli fjernet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Deze bestand is op elke zijde met een andere naam gewijzigd. Kies welke naam u wilt behouden — de andere wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ten plik został zmieniony nazwą na inny sposób na obu stronach. Wybierz, jaką nazwę zachować – druga zostanie usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Este arquivo foi renomeado de forma diferente em cada lado. Escolha qual nome manter — o outro será removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Имя этого файла было изменено по-разному на каждой стороне. Выберите имя, которое следует сохранить — другое будет удалено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Denna fil ändrade namn på varje sida. Välj vilket namn du vill behålla – det andra kommer att tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ได้รับการเปลี่ยนชื่อแตกต่างกันไปในแต่ละฝั่ง กรุณาเลือกชื่อที่ต้องการคงไว้ — ชื่ออีกชื่อหนึ่งจะถูกลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dosyası her tarafda farklı bir adla yeniden adlandırıldı. Hangi adı korumaya devam edileceğini seçin — diğer ad silinecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": цей файл був перейменований іншим способом на кожному боку. Виберіть, яке ім'я залишити — інше буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tệp này đã được đổi tên khác nhau trên mỗi phía. Vui lòng chọn tên nào để giữ lại — tên còn lại sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：该文件在两侧的重命名方式有所不同。请选择保留哪个名称——另一个名称将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：該文件在兩側的重命名方式有所不衕。請選擇保留哪個名稱——另一個名稱將被刪除。"
          }
        }
      }
    },
    "This folder already has a pending publication. Resume it instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى هذا المجلد نشر معلّق بالفعل. استأنفه بدلًا من ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe har allerede en afventende udgivelse. Genoptag den i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Ordner gibt es bereits eine ausstehende Veröffentlichung. Setzen Sie stattdessen diese fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta ya tiene una publicación pendiente. Reanúdala en su lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä kansiolla on jo odottava julkaisu. Jatka sitä sen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier a déjà une publication en attente. Reprenez-la plutôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לתיקייה זו כבר יש פרסום ממתין. המשיכו אותו במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर का एक प्रकाशन पहले से लंबित है। इसके बजाय उसे फिर से शुरू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a mappának már van függő közzététele. Inkább azt folytassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini sudah memiliki publikasi tertunda. Lanjutkan publikasi itu saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella ha già una pubblicazione in sospeso. Riprendi quella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダには保留中の公開があります。代わりにそれを再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에는 이미 대기 중인 게시가 있습니다. 대신 그것을 재개하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen har allerede en ventende publisering. Fortsett den i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map heeft al een openstaande publicatie. Hervat die in plaats daarvan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder ma już oczekującą publikację. Wznów ją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta já tem uma publicação pendente. Retome-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой папки уже есть ожидающая публикация. Продолжите её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen har redan en väntande publicering. Återuppta den i stället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้มีการเผยแพร่ที่รอดำเนินการอยู่แล้ว ดำเนินการต่อแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörün bekleyen bir yayımlaması var. Onu sürdürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка вже має очікувану публікацію. Продовжте її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này đã có một lượt xuất bản đang chờ. Hãy tiếp tục lượt đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹已有待处理的发布。请改为继续该发布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料夾已有待處理的發佈。請改為繼續該發佈。"
          }
        }
      }
    },
    "This folder has unfinished publication progress. Resume it from Publish a Folder before adding it as a repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى هذا المجلد تقدم نشر غير مكتمل. استأنفه من نشر مجلد قبل إضافته كمستودع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe har en ufærdig udgivelse. Genoptag den fra Udgiv en mappe, før du tilføjer den som et repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner hat einen unvollendeten Veröffentlichungsfortschritt. Setzen Sie ihn über „Ordner veröffentlichen“ fort, bevor Sie ihn als Repository hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta tiene una publicación sin terminar. Reanúdala desde Publicar una carpeta antes de añadirla como repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä kansiolla on keskeneräistä julkaisun edistymistä. Jatka sitä kohdasta Julkaise kansio ennen kuin lisäät sen tietovarastoksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier a une publication inachevée. Reprenez-la depuis Publier un dossier avant de l’ajouter comme dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לתיקייה זו יש התקדמות פרסום שלא הושלמה. המשיכו אותה מפרסום תיקייה לפני שתוסיפו אותה כמאגר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर की प्रकाशन प्रगति अधूरी है। इसे रिपॉज़िटरी के रूप में जोड़ने से पहले फ़ोल्डर प्रकाशित करें से फिर शुरू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a mappának befejezetlen közzététele van. Mielőtt tárolóként hozzáadja, folytassa a Mappa közzététele menüből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini memiliki progres publikasi yang belum selesai. Lanjutkan dari Publikasikan Folder sebelum menambahkannya sebagai repositori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella ha una pubblicazione incompleta. Riprendila da Pubblica una cartella prima di aggiungerla come repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダには未完了の公開の進捗があります。リポジトリとして追加する前に「フォルダを公開」から再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에는 완료되지 않은 게시 진행 상황이 있습니다. 저장소로 추가하기 전에 폴더 게시에서 재개하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen har uferdig publiseringsfremdrift. Fortsett den fra Publiser en mappe før du legger den til som repositorium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map heeft een onvoltooide publicatie. Hervat die via Een map publiceren voordat u hem als repository toevoegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder ma niedokończoną publikację. Wznów ją z Opublikuj folder, zanim dodasz go jako repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta tem um progresso de publicação inacabado. Retome-o em Publicar uma Pasta antes de adicioná-la como repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой папки есть незавершённая публикация. Продолжите её из «Опубликовать папку», прежде чем добавлять как репозиторий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen har ett oavslutat publiceringsförlopp. Återuppta det från Publicera en mapp innan du lägger till den som arkiv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้มีความคืบหน้าการเผยแพร่ที่ยังไม่เสร็จ ดำเนินการต่อจาก เผยแพร่โฟลเดอร์ ก่อนเพิ่มเป็นที่เก็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörün tamamlanmamış yayımlama ilerlemesi var. Depo olarak eklemeden önce Bir klasör yayımla'dan sürdürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка має незавершену публікацію. Продовжте її з «Опублікувати папку», перш ніж додавати як репозиторій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này có tiến trình xuất bản chưa hoàn tất. Hãy tiếp tục từ Xuất bản thư mục trước khi thêm nó làm kho lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹有未完成的发布进度。请先从“发布文件夹”继续，再将其添加为仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料夾有未完成的發佈進度。請先從「發佈資料夾」繼續，再將其加入為儲存庫。"
          }
        }
      }
    },
    "This folder is already registered. Its existing settings have been preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المجلد مسجّل بالفعل. تم الاحتفاظ بإعداداته الحالية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe er allerede registreret. Dens eksisterende indstillinger er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist bereits registriert. Seine vorhandenen Einstellungen wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta ya está registrada. Sus ajustes existentes se han conservado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kansio on jo rekisteröity. Sen nykyiset asetukset on säilytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est déjà enregistré. Ses réglages existants ont été conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיקייה הזו כבר רשומה. ההגדרות הקיימות שלה נשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोल्डर पहले से पंजीकृत है। इसकी मौजूदा सेटिंग्स सुरक्षित रखी गई हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mappa már regisztrálva van. A meglévő beállításait megőriztük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini sudah terdaftar. Pengaturan yang ada telah dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella è già registrata. Le sue impostazioni esistenti sono state conservate."
          }
        },
        "ja": {
