    "Author Name cannot contain line breaks or angle brackets.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يحتوي اسم المؤلف على فواصل أسطر أو أقواس زاوية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfatternavn må ikke indeholde linjeskift eller vinkelparenteser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Autorenname darf keine Zeilenumbrüche oder spitzen Klammern enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del autor no puede contener saltos de línea ni corchetes angulares."
          }
