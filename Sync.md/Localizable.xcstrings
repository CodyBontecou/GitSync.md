    "Rebase produced conflicts that require manual resolution.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنتجت Rebase تعارضات تتطلب حلاً يدويًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase producerede konflikter, der kræver manuel løsning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase erzeugte Konflikte, die eine manuelle Lösung erfordern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase produjo conflictos que requieren resolución manual."
          }
        },
        "fi": {
