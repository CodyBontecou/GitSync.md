    "An empty sync rail waiting for its first vault": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار مزامنة فارغ ينتظر خزنته الأولى"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tom synkroniseringsskinne, der venter på sin første vault"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine leere Sync-Leiste, die auf ihren ersten Vault wartet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un carril de sincronización vacío esperando su primera bóveda"
          }
        },
        "fi": {
