        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रकाशन के लिए चुने गए GitHub खाते में साइन इन करें। इसे किसी दूसरे खाते में नहीं भेजा जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be a közzétételhez kiválasztott GitHub-fiókba. Nem kerül másik fiókba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke akun GitHub yang dipilih untuk publikasi ini. Publikasi tidak akan dikirim ke akun lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi all'account GitHub selezionato per questa pubblicazione. Non verrà inviata a un altro account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この公開用に選択した GitHub アカウントにサインインしてください。別のアカウントに送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게시에 선택된 GitHub 계정으로 로그인하십시오. 다른 계정으로 전송되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på GitHub-kontoen som er valgt for denne publiseringen. Den sendes ikke til en annen konto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij het GitHub-account dat voor deze publicatie is gekozen. Het wordt niet naar een ander account gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na konto GitHub wybrane dla tej publikacji. Nie zostanie wysłana na inne konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na conta do GitHub selecionada para esta publicação. Ela não será enviada para outra conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в аккаунт GitHub, выбранный для этой публикации. Она не будет отправлена в другой аккаунт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på GitHub-kontot som valts för den här publiceringen. Den skickas inte till ett annat konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าบัญชี GitHub ที่เลือกไว้สำหรับการเผยแพร่นี้ จะไม่ถูกส่งไปยังบัญชีอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yayımlama için seçilen GitHub hesabında oturum açın. Farklı bir hesaba gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть в обліковий запис GitHub, вибраний для цієї публікації. Її не буде надіслано в інший обліковий запис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập vào tài khoản GitHub đã chọn cho lượt xuất bản này. Nó sẽ không được gửi tới tài khoản khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录为此次发布选择的 GitHub 账户。它不会被发送到其他账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入為此發佈選擇的 GitHub 帳號。它不會被傳送到其他帳號。"
          }
        }
      }
    },
