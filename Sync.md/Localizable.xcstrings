            "state": "translated",
            "value": "Questa pubblicazione ha già un commit salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この公開にはすでに保存済みのコミットがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게시에는 이미 저장된 커밋이 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne publiseringen har allerede en lagret commit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze publicatie heeft al een bewaarde commit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta publikacja ma już zapisany commit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta publicação já tem um commit salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой публикации уже есть сохранённый commit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här publiceringen har redan en sparad commit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเผยแพร่นี้มี commit ที่บันทึกไว้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yayımlamanın zaten kaydedilmiş bir commit'i var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця публікація вже має збережений commit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt xuất bản này đã có commit đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次发布已有已保存的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此發佈已有已儲存的提交。"
          }
        }
      }
    },
    "This remote doesn't support Git LFS locking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم هذا الـ remote قفل Git LFS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne remote understøtter ikke Git LFS-låsning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Remote unterstützt keine Git LFS-Sperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este remoto no admite bloqueos de Git LFS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä etäpalvelin ei tue Git LFS -lukitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce distant ne prend pas en charge le verrouillage Git LFS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-remote הזה לא תומך בנעילת Git LFS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह remote Git LFS लॉकिंग का समर्थन नहीं करता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a távoli nem támogatja a Git LFS-zárolást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote ini tidak mendukung penguncian Git LFS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo remoto non supporta il blocco di Git LFS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリモートは Git LFS のロックに対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 원격은 Git LFS 잠금을 지원하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne remoten støtter ikke Git LFS-låsing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze remote ondersteunt geen Git LFS-vergrendeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdalne repozytorium nie obsługuje blokad Git LFS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este remoto não suporta bloqueio do Git LFS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот удалённый репозиторий не поддерживает блокировки Git LFS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här remote stöder inte Git LFS-låsning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "remote นี้ไม่รองรับการล็อก Git LFS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uzak depo Git LFS kilitlemeyi desteklemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей віддалений репозиторій не підтримує блокування Git LFS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote này không hỗ trợ khóa Git LFS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此远程不支持 Git LFS 锁定。"
          }
