        }
      }
    },
    "Only .git directly inside the selected folder is removed. Local On My iPhone folders only.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال فقط مجلد .git الموجود مباشرة داخل المجلد المحدد. مجلدات «على الـ iPhone» المحلية فقط."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun .git direkte i den valgte mappe fjernes. Kun lokale På min iPhone-mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur .git direkt im ausgewählten Ordner wird entfernt. Nur lokale „Auf meinem iPhone“-Ordner."
          }
        },
        "es": {
          "stringUnit": {
