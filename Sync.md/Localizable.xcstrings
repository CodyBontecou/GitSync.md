    "Search looks at vault names, repos and branches.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل البحث أسماء الخزائن والمستودعات والفروع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgningen omfatter vaultnavne, repositories og grene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche umfasst Vault-Namen, Repositorys und Branches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda incluye nombres de bóvedas, repositorios y ramas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haku kattaa holvien nimet, tietovarastot ja haarat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche porte sur les noms des coffres, les dépôts et les branches."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיפוש כולל שמות כספות, מאגרים וענפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज में वॉल्ट के नाम, रिपॉज़िटरी और ब्रांच शामिल हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keresés a széfek nevére, a tárolókra és az ágakra terjed ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian mencakup nama vault, repositori, dan cabang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca include nomi dei vault, repository e branch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫名、リポジトリ、ブランチを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 이름, 저장소 및 브랜치를 검색합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søket omfatter hvelvnavn, repositorier og grener."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zoekopdracht doorzoekt kluisnamen, repositories en branches."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie obejmuje nazwy sejfów, repozytoria i gałęzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca inclui nomes de cofres, repositórios e branches."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск учитывает названия хранилищ, репозитории и ветки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökningen omfattar valvnamn, förråd och grenar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาจากชื่อ Vault รีโพซิทอรี และบรานช์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama; kasa adlarını, depoları ve dalları kapsar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук охоплює назви сховищ, репозиторії та гілки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm theo tên Vault, kho lưu trữ và nhánh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索范围包括库名称、仓库和分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋範圍包括保險庫名稱、儲存庫和分支。"
          }
        }
      }
    },
