    "%lld commits%@ pulled in the background. Tap to see what changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تنفيذ pull لـ %lld commit%@ في الخلفية. اضغط لرؤية ما تغيّر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ hentet i baggrunden. Tryk for at se, hvad der er ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Commits%@ im Hintergrund gepullt. Tippen Sie, um die Änderungen zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ recibidos en segundo plano. Toca para ver qué cambió."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld committia%@ haettiin taustalla. Katso muutokset napauttamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ récupérés en arrière-plan. Touchez pour voir les changements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ נמשכו ב-pull ברקע. הקישו כדי לראות מה השתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड में %lld commit%@ pull किए गए। क्या बदला, देखने के लिए टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commit%@ érkezett a háttérben. Koppintson a változások megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commit%@ di-pull di latar belakang. Ketuk untuk melihat perubahannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commit%@ ricevuti in background. Tocca per vedere cosa è cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のコミットをバックグラウンドでプルしました%@。タップして変更内容を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋 %lld개를%@ 백그라운드에서 풀했습니다. 탭하여 변경 사항을 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ pullet i bakgrunnen. Trykk for å se hva som er endret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ op de achtergrond gepulld. Tik om te zien wat er is gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commity pobrane w tle (%lld)%@. Stuknij, aby zobaczyć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ recebidos em segundo plano. Toque para ver o que mudou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit, полученные в фоне: %lld%@. Нажмите, чтобы посмотреть изменения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commits%@ hämtades i bakgrunden. Tryck för att se vad som ändrats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pull %lld commit%@ ในเบื้องหลังแล้ว แตะเพื่อดูว่ามีอะไรเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda %lld commit%@ çekildi. Neyin değiştiğini görmek için dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit, отримані у фоні: %lld%@. Торкніться, щоб побачити зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã pull %lld commit%@ trong nền. Chạm để xem những gì đã thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在后台拉取 %lld 个提交%@。轻点查看更改内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在背景拉取 %lld 個提交%@。點一下以查看變更內容。"
          }
        }
      }
    },
