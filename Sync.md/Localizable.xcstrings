        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่ได้ตั้งค่า repository จะบันทึกที่\nไฟล์ › บน iPhone ของฉัน › GitSync.md"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan belirlenmezse depolar şu konuma kaydedilir:\nDosyalar › iPhone'umda › GitSync.md"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без налаштування репозиторії зберігатимуться в\nФайли › На моєму iPhone › GitSync.md"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không chọn, kho sẽ lưu vào\nTệp › Trên iPhone › GitSync.md"
          }
        },
        "zh-Hans": {
          "stringUnit": {
