    "Making sure GitSync.md can sync this repo before anything is downloaded.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتحقق من قدرة GitSync.md على مزامنة هذا المستودع قبل تنزيل أي شيء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerer, at GitSync.md kan synkronisere dette repository, før noget downloades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird geprüft, ob GitSync.md dieses Repository synchronisieren kann, bevor etwas heruntergeladen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando que GitSync.md puede sincronizar este repositorio antes de descargar nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmistetaan ennen lataamista, että GitSync.md voi synkronoida tämän tietovaraston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification que GitSync.md peut synchroniser ce dépôt avant tout téléchargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוודאים ש-GitSync.md יכול לסנכרן את המאגר הזה לפני הורדת תוכן כלשהו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी डाउनलोड करने से पहले जाँच रहे हैं कि GitSync.md इस रिपॉज़िटरी को सिंक कर सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Annak ellenőrzése, hogy a GitSync.md képes-e szinkronizálni ezt a tárolót, mielőtt bármit letöltene."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memastikan GitSync.md dapat menyinkronkan repositori ini sebelum mengunduh apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che GitSync.md possa sincronizzare questo repository prima di scaricare qualsiasi contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かをダウンロードする前に、GitSync.md がこのリポジトリを同期できるか確認しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하기 전에 GitSync.md에서 이 저장소를 동기화할 수 있는지 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerer at GitSync.md kan synkronisere dette repositoriet før noe lastes ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleren of GitSync.md deze repository kan synchroniseren voordat er iets wordt gedownload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie, czy GitSync.md może synchronizować to repozytorium, zanim cokolwiek zostanie pobrane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando se o GitSync.md pode sincronizar este repositório antes de baixar qualquer conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяем, может ли GitSync.md синхронизировать этот репозиторий, прежде чем что-либо скачивать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar att GitSync.md kan synkronisera detta förråd innan något hämtas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบว่า GitSync.md ซิงค์รีโพซิทอรีนี้ได้ก่อนดาวน์โหลดสิ่งใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir şey indirmeden önce GitSync.md uygulamasının bu depoyu eşzamanlayabildiği kontrol ediliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряємо, чи може GitSync.md синхронізувати цей репозиторій, перш ніж щось завантажувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo GitSync.md có thể đồng bộ kho lưu trữ này trước khi tải xuống bất cứ nội dung nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认 GitSync.md 能够同步此仓库，然后才会下载任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認 GitSync.md 能夠同步此儲存庫，然後才會下載任何內容。"
          }
        }
      }
    },
