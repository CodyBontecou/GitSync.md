            "value": "távoli részleg „\n„%@\" nem található azon helyen. origin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabang Jarak Jauh '%@tidak ditemukan pada origin."
          }
        },
