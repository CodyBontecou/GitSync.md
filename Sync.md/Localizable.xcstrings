    "Choose the folder containing the .git folder you want to remove. For a vault inside a larger repository, choose the parent repository folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المجلد الذي يحتوي على مجلد .git الذي تريد إزالته. للخزنة الموجودة داخل مستودع أكبر، اختر مجلد المستودع الأصلي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg mappen med den .git-mappe, du vil fjerne. For en vault inde i et større repository skal du vælge mappen for det overordnede repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Ordner mit dem .git-Ordner, den Sie entfernen möchten. Bei einem Vault in einem größeren Repository wählen Sie den übergeordneten Repository-Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la carpeta que contiene la carpeta .git que quieres eliminar. Para una bóveda dentro de un repositorio más grande, elige la carpeta del repositorio principal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kansio, joka sisältää poistettavan .git-kansion. Jos holvi on suuremman tietovaraston sisällä, valitse ylätason tietovaraston kansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier contenant le dossier .git à supprimer. Pour un coffre situé dans un dépôt plus grand, choisissez le dossier du dépôt parent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את התיקייה שמכילה את תיקיית ה-.git שברצונכם להסיר. עבור כספת בתוך מאגר גדול יותר, בחרו את תיקיית מאגר האב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह फ़ोल्डर चुनें जिसमें वह .git फ़ोल्डर है जिसे आप हटाना चाहते हैं। किसी बड़ी रिपॉज़िटरी के अंदर के वॉल्ट के लिए, पैरेंट रिपॉज़िटरी फ़ोल्डर चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki az eltávolítandó .git mappát tartalmazó mappát. Nagyobb tárolón belüli széfnél a szülőtároló mappáját válassza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder berisi folder .git yang ingin dihapus. Untuk vault di dalam repositori yang lebih besar, pilih folder repositori induknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella che contiene la cartella .git da rimuovere. Per un vault dentro un repository più grande, scegli la cartella del repository principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したい .git フォルダを含むフォルダを選択してください。大きなリポジトリ内の保管庫の場合は、親リポジトリのフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거할 .git 폴더가 있는 폴더를 선택하십시오. 더 큰 저장소 안에 있는 보관함이라면 상위 저장소 폴더를 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg mappen som inneholder .git-mappen du vil fjerne. For et hvelv inne i et større repositorium velger du den overordnede repositoriemappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de map met de .git-map die u wilt verwijderen. Kies voor een kluis binnen een grotere repository de bovenliggende repositorymap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder zawierający folder .git, który chcesz usunąć. Dla sejfu w większym repozytorium wybierz folder repozytorium nadrzędnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta que contém a pasta .git que você quer remover. Para um cofre dentro de um repositório maior, escolha a pasta do repositório pai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку, содержащую папку .git, которую нужно удалить. Для хранилища внутри большего репозитория выберите папку родительского репозитория."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj mappen som innehåller .git-mappen du vill ta bort. För ett valv i ett större arkiv väljer du det överordnade arkivets mapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์ที่มีโฟลเดอร์ .git ที่คุณต้องการลบ สำหรับ vault ที่อยู่ในที่เก็บขนาดใหญ่ ให้เลือกโฟลเดอร์ที่เก็บหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırmak istediğiniz .git klasörünü içeren klasörü seçin. Daha büyük bir depo içindeki kasa için üst depo klasörünü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку, що містить папку .git, яку потрібно видалити. Для сховища всередині більшого репозиторію виберіть папку батьківського репозиторію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục chứa thư mục .git bạn muốn gỡ. Với vault nằm trong một kho lưu trữ lớn hơn, hãy chọn thư mục kho lưu trữ cha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择包含要移除的 .git 文件夹的文件夹。如果库位于更大的仓库中，请选择父仓库文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇包含要移除之 .git 資料夾的資料夾。若保險庫位於較大的儲存庫中，請選擇上層儲存庫資料夾。"
          }
        }
      }
    },
