          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取操作需要合并，因为本地与远程版本已出现差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取操作需要閤併，因爲本地與遠程版本已齣現差異。"
          }
        }
      }
    },
