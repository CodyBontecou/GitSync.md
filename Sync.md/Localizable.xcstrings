            "state": "translated",
            "value": "Deze map is al geregistreerd. De bestaande instellingen zijn behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder jest już zarejestrowany. Jego istniejące ustawienia zostały zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta já está registrada. Os ajustes existentes foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка уже зарегистрирована. Её существующие настройки сохранены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen är redan registrerad. Dess befintliga inställningar har bevarats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้ลงทะเบียนแล้ว การตั้งค่าที่มีอยู่ได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör zaten kayıtlı. Mevcut ayarları korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю папку вже зареєстровано. Її наявні налаштування збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này đã được đăng ký. Cài đặt hiện có vẫn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
