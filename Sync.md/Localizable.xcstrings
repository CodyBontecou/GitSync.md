    "Binary content can't be merged in-app. Use the Conflict Center to pick Ours or Theirs at the file level.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن دمج المحتوى الثنائي داخل التطبيق. استخدم مركز النزاعات لاختيار ملكنا أو ملكهم على مستوى الملف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Binært indhold kan ikke flettes i appen. Brug konfliktcenteret til at vælge vores eller deres på filniveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Binärinhalte können nicht in der App zusammengeführt werden. Verwenden Sie das Konfliktcenter, um auf Dateiebene „Unsere“ oder „Ihre“ auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido binario no se puede combinar en la aplicación. Utilice el Centro de conflictos para elegir el nuestro o el de ellos a nivel de archivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Binaarinen sisältö ei voi yhdistää app-app. Käytä Conflict Centeriä valitsemaan meidän tai heidän tiedoston tasolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu binaire ne peut pas être fusionné dans l&#39;application. Utilisez le Centre de conflit pour choisir le nôtre ou le leur au niveau du fichier.\nFichier binaire"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": תוכן בינרי לא ניתן לשלב בתוך האפליקציה – השתמש ב-Central של Konflikטים כדי לבחור בין \"ours\" או \"theirs\" ברמת הקובץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "की बाइनरी सामग्री को एकीकृत नहीं किया जा सकता। फ़ाइल स्तर पर 'हमारी' या 'उनकी' चयन करने के लिए Conflict Center का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A bináris tartalomot az alkalmazásban nem lehet összevonni. Használja a Konfliktusközpontot, hogy a fájl szinténen „Mélyünk\" vagy „Többé\" választását tartsa meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Konten biner tidak dapat digabungkan dalam aplikasi. Gunakan Conflict Center untuk memilih 'Ours' atau 'Theirs' pada tingkat berkas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Il contenuto binario non può essere combinato all'interno dell'applicazione. Utilizzare il Centro dei conflitti per selezionare «Nostro» o «Di loro» a livello di file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：バイナリコンテンツはアプリ内での統合ができません。コンフリクトセンターを使用して、ファイルレベルで「私たちの」または「彼らの」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이진 파일 내용을 앱 내에서 병합할 수 없습니다. '충돌 센터'를 사용하여 파일 수준에서 '당사의' 또는 '타사의'를 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Binær innhold kan ikke bli kombinert innenfor appen. Bruk Konfliktcenteret for å velge «Vår» eller «Deres» på filnivå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Binair content kan niet binnen de app worden gecombineerd. Gebruik het Conflict Center om op bestandsniveau te kiezen voor 'Onze' of 'Hun'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Binaryny zawartość nie może być połączone wewnątrz aplikacji. Wykorzystaj Centrum Konfliktów, aby wybranie „Na nasze\" lub „Na ich\" na poziomie pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O conteúdo binário não pode ser combinado dentro do aplicativo. Utilize o Centro de Conflitos para selecionar \"Nós\" ou \"Eles\" ao nível do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": бинарный контент не может быть объединён внутри приложения. Используйте Центр конфликтов, чтобы выбрать «Наш» или «Их» на уровне файла."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Binärt innehåll kan inte sammanslutas inom appen. Använd Konfliktcentret för att välja mellan \"Vår\" eller \"Deras\" på filnivå."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": เนื้อหาไบนารีไม่สามารถรวมกันภายในแอปได้ โปรดใช้ Conflict Center เพื่อเลือก 'Ours' หรือ 'Theirs' ที่ระดับไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": İkili içeriği uygulamada birleştirilemiyor. Dosya düzeyinde 'Biz'in veya 'Onların' seçmek için Çakıntı Merkezi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": бінарний контент не може бути об'єднаний усередині додатка. Використовуйте Центр конфліктів, щоб вибрати «Наш» або «Їхній» на рівні файлу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nội dung nhị phân không thể hợp nhất trong ứng dụng. Vui lòng sử dụng Trung tâm Xung đột để chọn 'Chúng tôi' hoặc 'Của họ' ở cấp độ tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：二进制内容无法在应用内合并。请使用冲突中心在文件级别选择“我们的”或“他们的”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：二進製內容無法在應用內閤併。請使用衝突中心在文件級彆選擇“我們的”或“他們的”。"
          }
        }
      }
    },
