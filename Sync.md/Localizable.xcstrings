    "Stops safely when attention is needed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف بأمان عند الحاجة إلى الانتباه"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper sikkert, når noget kræver opmærksomhed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt sicher, wenn Aufmerksamkeit erforderlich ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detiene de forma segura cuando requiere atención"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysähtyy turvallisesti, kun huomiota tarvitaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’arrête en toute sécurité lorsque votre attention est requise"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעצר בבטחה כשנדרשת תשומת לב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्यान आवश्यक होने पर सुरक्षित रूप से रुकता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztonságosan leáll, ha beavatkozás szükséges"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti dengan aman saat perhatian diperlukan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si interrompe in sicurezza quando serve attenzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要な場合は安全に停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요하면 안전하게 중단"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper trygt når tilsyn er nødvendig"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt veilig wanneer aandacht nodig is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpiecznie zatrzymuje się, gdy potrzebna jest uwaga"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para com segurança quando é necessário intervir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасно останавливается, когда требуется внимание"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppar säkert när något kräver uppmärksamhet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดอย่างปลอดภัยเมื่อต้องได้รับการตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlgi gerektiğinde güvenle durur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безпечна зупинка, коли потрібна увага"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng an toàn khi cần bạn chú ý"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要处理时安全停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要處理時安全停止"
          }
        }
      }
    },
