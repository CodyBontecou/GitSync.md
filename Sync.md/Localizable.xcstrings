    "Long-press Clone to pick a branch, sign-in method or folder first.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على «استنساخ» لاختيار فرع أو طريقة تسجيل دخول أو مجلد أولًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Klon nede for først at vælge en gren, en loginmetode eller en mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Klonen gedrückt, um zuerst einen Branch, eine Anmeldemethode oder einen Ordner auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado Clonar para elegir primero una rama, un método de inicio de sesión o una carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Kloonaa-painiketta painettuna, jos haluat ensin valita haaran, kirjautumistavan tai kansion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur Cloner pour choisir d’abord une branche, une méthode de connexion ou un dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו לחיצה ממושכת על שכפול כדי לבחור תחילה ענף, שיטת כניסה או תיקייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले ब्रांच, साइन-इन का तरीका या फ़ोल्डर चुनने के लिए क्लोन करें को देर तक दबाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa nyomva a Klónozás gombot, ha előbb ágat, bejelentkezési módot vagy mappát szeretne választani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama Clone untuk memilih cabang, metode masuk, atau folder terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Clona per scegliere prima un branch, un metodo di accesso o una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にブランチ、サインイン方法、フォルダを選ぶには、「クローン」を長押ししてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브랜치, 로그인 방식 또는 폴더를 먼저 선택하려면 클론을 길게 누르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og hold på Klon for først å velge en gren, påloggingsmetode eller mappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd Klonen ingedrukt om eerst een branch, aanmeldmethode of map te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj Klonuj, aby najpierw wybrać gałąź, sposób logowania lub folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha Clonar pressionado para escolher primeiro um branch, uma forma de login ou uma pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте «Клонировать», чтобы сначала выбрать ветку, способ входа или папку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll på Klona för att först välja en gren, inloggningsmetod eller mapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด Clone ค้างไว้เพื่อเลือกบรานช์ วิธีลงชื่อเข้าใช้ หรือโฟลเดอร์ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir dal, oturum açma yöntemi veya klasör seçmek için Klonla düğmesini basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте «Клонувати», щоб спочатку вибрати гілку, спосіб входу або папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ Sao chép để chọn nhánh, phương thức đăng nhập hoặc thư mục trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按“克隆”可先选择分支、登录方式或文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按「複製」可先選擇分支、登入方式或檔案夾。"
          }
        }
      }
    },
    "Long-press a vault and choose Pin to top.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على خزنة واختر التثبيت في الأعلى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk længe på en vault, og vælg Fastgør øverst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie lange auf einen Vault und wählen Sie „Oben anheften“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una bóveda y elige Fijar arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina holvia pitkään ja valitse Kiinnitä ylös."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un coffre et choisissez Épingler en haut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו לחיצה ארוכה על כספת ובחרו הצמדה למעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी वॉल्ट को देर तक दबाएँ और सबसे ऊपर पिन करें चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartson lenyomva egy széfet, és válassza a Kitűzés felülre lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama vault dan pilih Sematkan di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un vault e scegli Fissa in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫を長押しして「トップに固定」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함을 길게 누르고 맨 위에 고정을 선택하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold inne på et hvelv og velg Fest øverst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een kluis ingedrukt en kies Bovenaan vastzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj sejf i wybierz Przypnij na górze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um cofre pressionado e escolha Fixar no topo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте хранилище и выберите «Закрепить сверху»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck länge på ett valv och välj Fäst överst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างที่ vault แล้วเลือก ปักหมุดไว้ด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kasaya uzun basın ve En üste sabitle'yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте сховище та виберіть «Закріпити вгорі»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ một vault và chọn Ghim lên đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按一个库并选择“置顶”。"
          }
        },
        "zh-Hant": {
