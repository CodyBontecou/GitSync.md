    "Local and remote have diverged. Merge support is required to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تباعدت المسافة المحلية والبعيدة. مطلوب دعم الدمج للمتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalt og eksternt er adskilt. Der kræves flettesupport for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal und Remote sind auseinandergegangen. Zum Fortfahren ist Merge-Unterstützung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Local y remoto han divergido. Se requiere soporte de fusión para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset ja etäiset ovat erilaisia. Yhdistämistuki on jatkettava."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Local et distant ont divergé. Le support de fusion est nécessaire pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": בין ה-Local וה-Remote נוצרה הפרדה. יש צורך בתמיכהในการ שילוב כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'Local' और 'Remote' के बीच अंतर है। प्रक्रिया जारी रखने के लिए मर्ज सपोर्ट की आवश्यकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A helyi és távoli konfigurációk eltérnek. A folytatás érdekében a csatolás támogatása szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Konfigurasi lokal dan jarak jauh telah berbeda. Diperlukan dukungan penggabungan untuk melanjutkan proses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": i valori locali e remoti sono divergenti. È necessario il supporto per la fusione per proseguire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカルとリモートの状態が一致していません。継続するには、マージ機能が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬 및 원격 데이터가 서로 다릅니다. 계속 진행하려면 병합 지원이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokal og fjernfunksjoner er forskjellige. Samlingstilpassing er nødvendig for å kunne fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokale en externe instellingen zijn niet overeenkomend; ondersteuning voor samenvoeging is vereist om verder te kunnen werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": lokalny i odległy rejestry nie są zgodne. Do kontynuowania pracy wymagana jest funkcja połączenia (merge)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": os estados local e remoto divergiram. É necessário suporte de fusão para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": местные и удалённые данные расходятся. Для продолжения работы требуется функция объединения данных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokala och fjärranvärden har skiljt sig. Merg-support krävs för att fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": สถานะท้องถิ่นและระยะไกลไม่สอดคล้องกัน — จำเป็นต้องมีการรวมข้อมูลเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel ve uzaktaki veriler farklıdır. İşi devam ettirmek için birleştirme desteği gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": між локальним і дистанційним режимами виникли розбіжності. Для продовження роботи необхідна функція об'єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tính năng Local và Remote đã không còn trùng khớp nhau. Cần hỗ trợ hợp nhất để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：本地与远程数据已出现差异。需启用合并功能方可继续操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：本地與遠程數據已齣現差異。需啟用閤併功能方可繼續操作。"
          }
        }
      }
    },
    "Local branch has commits ready to push": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفرع المحلي لديه التزامات جاهزة للدفع"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal filial har commits klar til at skubbe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Zweig verfügt über Commits, die zum Pushen bereit sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sucursal local tiene confirmaciones listas para enviar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen haara on sitoutunut työntämään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche locale s&#39;est engage prêt à pousser"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": המחלקה המקומית יש קומיטים מוכנים להדחס"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्थानीय शाखा में पुश के लिए तैयार कमिट्स हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "helyi osztályban olyan commitok vannak, amelyeket elhajthatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabang lokal memiliki commit yang siap ditarik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": la filiale locale ha commit pronti per il push"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカルブランチにはプッシュ準備済みのコミットがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 지점에는 푸시할 준비된 커밋이 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Lokalavdelingen har commits som er klar for å pushe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De lokale filiaal heeft commits die kunnen worden pushen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": lokalna oddziałowa jednostka ma commity gotowe do wypychania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": A filial local tem commits prontos para push."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": локальный филиал имеет коммиты, готовые к пушу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Lokalavdelningen har commits som är redo att pushas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาขาท้องถิ่นมีการคอมมิตที่พร้อมจะส่งต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yerel şubeye gönderilebilecek commitler mevcuttur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": місцева філія має коміті, готові до пушування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Chi nhánh địa phương có các commit đã sẵn sàng để đẩy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地分支有待推送的提交记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地分支有待推送的提交記録"
          }
