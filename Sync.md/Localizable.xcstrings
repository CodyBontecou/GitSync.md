    "Unsupported SSH private key format for Git LFS. Use an OpenSSH Ed25519 or RSA private key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق المفتاح الخاص SSH غير مدعوم لـ Git LFS. استخدم المفتاح الخاص OpenSSH Ed25519 أو RSA."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke-understøttet SSH privat nøgleformat for Git LFS. Brug en OpenSSH Ed25519 eller RSA privat nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstütztes privates Schlüsselformat SSH für Git LFS. Verwenden Sie einen privaten Schlüssel OpenSSH Ed25519 oder RSA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de clave privada SSH no compatible para Git LFS. Utilice una clave privada OpenSSH Ed25519 o RSA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ei tuettu SSH yksityinen avainmuodossa Git LFS. Käytä on OpenSSH Ed25519 tai RSA yksityinen avain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": non pris en charge SSH : format de clé privée pour Git LFS. Utilisez un OpenSSH Ed25519 ou RSA : clé privée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– לא נתמך SSH – צורת מפתח פרטי עבור Git LFS– השתמשו ב- OpenSSH Ed25519 או RSA – מפתח פרטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "– समर्थित नहीं है SSH : निजी कुंजी प्रारूप Git LFS– एक का उपयोग करें। OpenSSH Ed25519 या RSA – निजी कुंजी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– támogatatlan SSH : privát kulcs formátuma Git LFS– használja egyet OpenSSH Ed25519 vagy RSA magánkulcs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tidak didukung SSH format kunci privat untuk Git LFS. Gunakan sebuah OpenSSH Ed25519 atau RSA kunci privat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": non supportato SSH : formato della chiave privata per Git LFS. Utilizzare un OpenSSH Ed25519 o RSA : chiave privata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：対応されていません SSH ：プライベートキーの形式 Git LFS：使用してください。 OpenSSH Ed25519 または RSA 私鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 지원되지 않음 SSH : 사용자 개인 키 형식 Git LFS. 사용하세요. OpenSSH Ed25519 또는 RSA 개인 키."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ikke støttet SSH – privat nøkkelformat for Git LFS. Bruk en OpenSSH Ed25519 eller RSA privat nøkkel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "niet ondersteund SSH : formaat voor de privékey voor Git LFS. Gebruik een OpenSSH Ed25519 of RSA : privékey."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– nie wspierane SSH – format klucza prywatnego dla Git LFS– Użyj OpenSSH Ed25519 lub RSA – prywatny klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": não suportado SSH : formato da chave privada para Git LFS. Use um OpenSSH Ed25519 ou RSA chave privada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "— не поддерживается SSH — формат приватного ключа для Git LFS. Используйте OpenSSH Ed25519 или RSA — приватный ключ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Oämnat SSH – privat nyckelformat för Git LFS. Använd en OpenSSH Ed25519 eller RSA privat nyckel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ไม่รองรับ SSH : รูปแบบของกุญแจส่วนตัวสำหรับ Git LFS– ใช้ OpenSSH Ed25519 หรือ RSA : คีย์ส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": desteklenmiyor SSH için özel anahtar formatı Git LFS. Birini kullanın OpenSSH Ed25519 veya RSA özel anahtar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "– не підтримується SSH – формат приватного ключа для Git LFS. Використовуйте OpenSSH Ed25519 або RSA – приватний ключ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Không được hỗ trợ SSH : định dạng khóa riêng cho Git LFS. Sử dụng một OpenSSH Ed25519 hoặc RSA – khóa riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：不支持 SSH 私钥格式 Git LFS。请使用 OpenSSH Ed25519 或 RSA 私钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：不支持 SSH 俬鑰格式 Git LFS。請使用 OpenSSH Ed25519 或 RSA 俬鑰。"
          }
        }
      }
    },
