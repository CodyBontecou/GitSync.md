          "stringUnit": {
            "state": "translated",
            "value": ": Rebase-funksjonen opplever flere konflikter – løs dem før du fortsetter med rebase."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De rebase-behandeling vertoont meer conflicten – lost deze op en voer vervolgens de rebase-procedure door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": operacja rebase wykazuje więcej konfliktów – rozwiąż je, a następnie kontynuuj proces rebase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O processo de rebase apresenta mais conflitos — resolva-os primeiro e depois continue o rebase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": при выполнении операции rebase возникло больше конфликтов — их необходимо устранить, после чего можно продолжить процесс rebase."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rebase-förloppet innehåller fler konflikter – lösa dessa och fortsätt sedan med rebase-processen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": กระบวนการ rebase มีความขัดแย้งเพิ่มเติม — แก้ไขความขัดแย้งเหล่านี้ก่อน จากนั้นจึงดำเนินการ rebase ต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase işlemi daha fazla çatışma içeriyor — bu çatışmaları çözün ve ardından rebase işlemine devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": команда rebase містить більше конфліктів — вирішіть їх, а потім продовжте процес rebase."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác rebase phát sinh thêm các xung đột — hãy giải quyết chúng trước, sau đó tiếp tục thao tác rebase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重基操作存在更多冲突——请先解决这些冲突，再继续执行重基操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重基操作存在更多衝突——請先解決這些衝突，再繼續執行重基操作"
          }
        }
      }
    },
    "Rebase produced conflicts that require manual resolution.": {
      "localizations": {
        "ar": {
