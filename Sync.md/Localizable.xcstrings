    "Result text could not be encoded as UTF-8.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن ترميز نص النتيجة كـ UTF-8."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatteksten kunne ikke kodes som UTF-8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnistext konnte nicht als UTF-8 codiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del resultado no se pudo codificar como UTF-8."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostotekstiä ei voitu koodata UTF-8:ksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte du résultat n&#39;a pas pu être codé comme UTF-8."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הטקסט של התוצאה לא יכול להפוך ל-UTF-8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": परिणाम पाठ को UTF-8 में एनकोड नहीं किया जा सका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A eredményszöveg nem alkalmazható UTF-8 kódolással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Teks hasil tidak dapat dikodekan menjadi UTF-8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il testo del risultato non è stato possibile codificare come UTF-8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：結果テキストをUTF-8でエンコードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 결과 텍스트를 UTF-8 형식으로 인코딩할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Resultatteksten kunne ikke kodes som UTF-8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Het resultaattekst kon niet worden gecodeerd als UTF-8."
          }
        },
        "pl": {
