    "Choose a folder on this device and review the files. Nothing is uploaded until you tap Create & push, which makes a public or private repository in your personal GitHub account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا على هذا الجهاز وراجع الملفات. لا يُرفع شيء حتى تضغط إنشاء وpush، الذي ينشئ مستودعًا عامًا أو خاصًا في حساب GitHub الشخصي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe på denne enhed, og gennemgå filerne. Intet uploades, før du trykker på Opret og push, som laver et offentligt eller privat repository på din personlige GitHub-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Ordner auf diesem Gerät und prüfen Sie die Dateien. Nichts wird hochgeladen, bis Sie auf „Erstellen & pushen“ tippen – dadurch entsteht ein öffentliches oder privates Repository in Ihrem persönlichen GitHub-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta de este dispositivo y revisa los archivos. No se sube nada hasta que toques Crear y hacer push, que crea un repositorio público o privado en tu cuenta personal de GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kansio tästä laitteesta ja tarkista tiedostot. Mitään ei ladata ennen kuin napautat Luo ja lähetä, joka luo julkisen tai yksityisen tietovaraston henkilökohtaiselle GitHub-tilillesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier sur cet appareil et vérifiez les fichiers. Rien n’est envoyé avant que vous touchiez Créer et push, qui crée un dépôt public ou privé dans votre compte GitHub personnel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו תיקייה במכשיר זה ועברו על הקבצים. שום דבר לא מועלה עד שתקישו על יצירה ו-push, שיוצר מאגר ציבורי או פרטי בחשבון GitHub האישי שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर कोई फ़ोल्डर चुनें और फ़ाइलों की समीक्षा करें। जब तक आप बनाएँ और push पर टैप नहीं करते, कुछ भी अपलोड नहीं होता; यह आपके निजी GitHub खाते में सार्वजनिक या निजी रिपॉज़िटरी बनाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon egy mappát ezen az eszközön, és nézze át a fájlokat. Semmi sem töltődik fel, amíg nem koppint a Létrehozás és push gombra, amely nyilvános vagy privát tárolót hoz létre a személyes GitHub-fiókjában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder di perangkat ini dan tinjau file-nya. Tidak ada yang diunggah sampai Anda mengetuk Buat & push, yang membuat repositori publik atau privat di akun GitHub pribadi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella su questo dispositivo e controlla i file. Non viene caricato nulla finché non tocchi Crea e push, che crea un repository pubblico o privato nel tuo account GitHub personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上のフォルダを選んでファイルを確認します。「作成＆プッシュ」をタップするまで何もアップロードされません。タップすると、個人の GitHub アカウントに公開または非公開のリポジトリが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 폴더를 선택하고 파일을 검토하십시오. 생성 및 푸시를 탭하기 전에는 아무것도 업로드되지 않으며, 탭하면 개인 GitHub 계정에 공개 또는 비공개 저장소가 만들어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en mappe på denne enheten og gå gjennom filene. Ingenting lastes opp før du trykker Opprett og push, som lager et offentlig eller privat repositorium på din personlige GitHub-konto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map op dit apparaat en controleer de bestanden. Er wordt niets geüpload tot u op Aanmaken en pushen tikt; dat maakt een openbare of privérepository in uw persoonlijke GitHub-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder na tym urządzeniu i przejrzyj pliki. Nic nie zostanie wysłane, dopóki nie stukniesz Utwórz i push, co utworzy publiczne lub prywatne repozytorium na Twoim osobistym koncie GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta neste dispositivo e revise os arquivos. Nada é enviado até você tocar em Criar e fazer push, que cria um repositório público ou privado na sua conta pessoal do GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку на этом устройстве и просмотрите файлы. Ничего не загружается, пока вы не нажмёте «Создать и push» — это создаст публичный или приватный репозиторий в вашем личном аккаунте GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en mapp på den här enheten och granska filerna. Inget laddas upp förrän du trycker på Skapa och pusha, som skapar ett publikt eller privat arkiv på ditt personliga GitHub-konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์บนอุปกรณ์นี้และตรวจสอบไฟล์ จะไม่มีการอัปโหลดใดๆ จนกว่าคุณจะแตะ สร้างและ push ซึ่งจะสร้างที่เก็บสาธารณะหรือส่วนตัวในบัญชี GitHub ส่วนตัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda bir klasör seçin ve dosyaları gözden geçirin. Oluştur ve push et'e dokunana kadar hiçbir şey yüklenmez; bu, kişisel GitHub hesabınızda herkese açık veya özel bir depo oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку на цьому пристрої й перегляньте файли. Нічого не завантажується, доки ви не торкнетеся «Створити й push» — це створить публічний або приватний репозиторій у вашому особистому обліковому записі GitHub."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục trên thiết bị này và xem lại các tệp. Không có gì được tải lên cho đến khi bạn chạm Tạo & push, thao tác này tạo kho lưu trữ công khai hoặc riêng tư trong tài khoản GitHub cá nhân của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上选择一个文件夹并检查文件。在你轻点“创建并推送”之前不会上传任何内容；轻点后将在你的个人 GitHub 账户中创建公开或私有仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此裝置上選擇一個資料夾並檢視檔案。在你點一下「建立並推送」之前不會上傳任何內容；點一下後會在你的個人 GitHub 帳號中建立公開或私人儲存庫。"
          }
        }
      }
    },
    "Choose all or selected repositories through the GitSync.md GitHub App—no webhook setup. Push alerts request best-effort background reconciliation, and tapping always performs a pull-only check.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر جميع المستودعات أو مستودعات محددة عبر GitHub App الخاص بـ GitSync.md — دون إعداد webhook. تطلب تنبيهات push مطابقة في الخلفية قدر الإمكان، والضغط عليها ينفّذ دائمًا فحص pull فقط."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg alle eller udvalgte repositories via GitSync.md GitHub App – ingen webhook-opsætning. Push-beskeder anmoder om afstemning i baggrunden efter bedste evne, og et tryk udfører altid et tjek, der kun puller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie über die GitSync.md GitHub App alle oder ausgewählte Repositorys – ohne Webhook-Einrichtung. Push-Hinweise fordern einen Best-Effort-Abgleich im Hintergrund an, und Tippen führt immer eine reine Pull-Prüfung aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige todos los repositorios o algunos mediante la GitHub App de GitSync.md, sin configurar webhooks. Las alertas push solicitan una reconciliación en segundo plano sin garantías, y al tocar siempre se hace una comprobación solo de pull."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kaikki tai tietyt tietovarastot GitSync.md GitHub Appin kautta – webhookeja ei tarvitse määrittää. Push-ilmoitukset pyytävät taustasovitusta parhaan kyvyn mukaan, ja napautus tekee aina pelkän haun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez tous les dépôts ou une sélection via la GitHub App GitSync.md — sans configurer de webhook. Les alertes push demandent une réconciliation en arrière-plan au mieux, et un toucher effectue toujours une vérification en pull uniquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את כל המאגרים או מאגרים נבחרים דרך GitHub App של GitSync.md — ללא הגדרת webhook. התראות push מבקשות סנכרון ברקע במידת האפשר, והקשה עליהן תמיד מבצעת בדיקת pull בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md GitHub App के ज़रिए सभी या चुनी हुई रिपॉज़िटरी चुनें—कोई webhook सेटअप नहीं। push अलर्ट यथासंभव बैकग्राउंड मिलान का अनुरोध करते हैं, और टैप करने पर हमेशा केवल-pull जाँच होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki az összes vagy csak bizonyos tárolókat a GitSync.md GitHub Appon keresztül – webhook beállítása nélkül. A push-értesítések lehetőség szerinti háttérbeli egyeztetést kérnek, a koppintás pedig mindig csak pull típusú ellenőrzést végez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih semua repositori atau repositori tertentu melalui GitHub App GitSync.md—tanpa pengaturan webhook. Peringatan push meminta rekonsiliasi latar belakang sebisanya, dan mengetuknya selalu menjalankan pemeriksaan pull saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tutti i repository o solo alcuni tramite la GitHub App di GitSync.md, senza configurare webhook. Gli avvisi push richiedono una riconciliazione in background senza garanzie, e toccandoli si esegue sempre un controllo solo pull."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md GitHub App を通じて、すべてまたは選択したリポジトリを選べます。Webhook の設定は不要です。プッシュ通知はベストエフォートのバックグラウンド同期を要求し、タップすると常にプルのみのチェックが行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md GitHub App을 통해 모든 저장소 또는 선택한 저장소를 고를 수 있으며, 웹훅 설정은 필요 없습니다. 푸시 알림은 최선의 노력으로 백그라운드 동기화를 요청하며, 탭하면 항상 풀 전용 확인이 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg alle eller utvalgte repositorier via GitSync.md GitHub App – uten webhook-oppsett. Push-varsler ber om avstemming i bakgrunnen etter beste evne, og et trykk utfører alltid en ren pull-sjekk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies alle of geselecteerde repository's via de GitSync.md GitHub App, zonder webhook in te stellen. Pushmeldingen vragen een best-effort afstemming op de achtergrond aan, en tikken voert altijd een controle uit met alleen pull."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wszystkie lub wybrane repozytoria przez GitHub App GitSync.md — bez konfigurowania webhooków. Powiadomienia o push proszą o uzgodnienie w tle w miarę możliwości, a stuknięcie zawsze wykonuje sprawdzenie tylko przez pull."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha todos os repositórios ou apenas alguns pelo GitHub App do GitSync.md — sem configurar webhook. Os alertas de push solicitam uma reconciliação em segundo plano na medida do possível, e tocar sempre executa uma verificação somente de pull."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите все или отдельные репозитории через GitHub App GitSync.md — без настройки webhook. Уведомления о push запрашивают фоновое согласование по мере возможности, а нажатие всегда выполняет проверку только через pull."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj alla eller utvalda arkiv via GitSync.md GitHub App – ingen webhook behövs. Push-aviseringar begär avstämning i bakgrunden efter bästa förmåga, och ett tryck gör alltid en kontroll med enbart pull."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกที่เก็บทั้งหมดหรือเฉพาะที่เลือกผ่าน GitHub App ของ GitSync.md โดยไม่ต้องตั้งค่า webhook การแจ้งเตือน push จะขอการกระทบยอดในเบื้องหลังเท่าที่ทำได้ และการแตะจะตรวจสอบแบบ pull อย่างเดียวเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md GitHub App üzerinden tüm depoları veya seçili depoları seçin; webhook kurulumu gerekmez. Push uyarıları en iyi çabayla arka plan uzlaştırması ister ve dokunmak her zaman yalnızca pull denetimi yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть усі або окремі репозиторії через GitHub App GitSync.md — без налаштування webhook. Сповіщення про push запитують фонове узгодження за можливості, а торкання завжди виконує перевірку лише через pull."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tất cả hoặc một số kho lưu trữ qua GitSync.md GitHub App—không cần thiết lập webhook. Thông báo đẩy yêu cầu đồng bộ nền theo khả năng tốt nhất, và chạm vào luôn thực hiện kiểm tra chỉ pull."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 GitSync.md GitHub App 选择全部或部分仓库，无需设置 webhook。推送通知会尽力请求后台同步，轻点通知则始终执行仅拉取的检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 GitSync.md GitHub App 選擇全部或部分儲存庫，不需設定 webhook。推播通知會盡力要求背景同步，點一下通知則一律執行僅拉取的檢查。"
          }
        }
      }
    },
