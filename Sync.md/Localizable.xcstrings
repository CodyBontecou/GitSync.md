    "Stash at index %lld was not found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على المخبأ في الفهرس %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash ved indeks %lld blev ikke fundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash am Index %lld wurde nicht gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el almacenamiento en el índice %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilasto indeksissä. %lld ei löytynyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage à l'index %lld n'a pas été trouvé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– מאגר בindeks %lld לא נמצאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": इंडेक्स पर स्टैश %lld नहीं पाया गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": az indekben tárolt adat\nA %lld nem található."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash pada indeks %lld tidak ditemukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "– Archivio all'indice %lld non è stato trovato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックス内のストア %lld は見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인덱스 내 저장소 %lld 를 찾을 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
