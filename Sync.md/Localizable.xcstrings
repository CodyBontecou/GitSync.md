    "Your commit is on GitHub. Finish adding this folder to GitSync.md to enable normal repository controls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الـ commit الخاص بك على GitHub. أكمل إضافة هذا المجلد إلى GitSync.md لتفعيل عناصر التحكم العادية في المستودع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit commit er på GitHub. Færdiggør tilføjelsen af denne mappe til GitSync.md for at få de normale repository-funktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Commit ist auf GitHub. Schließen Sie das Hinzufügen dieses Ordners zu GitSync.md ab, um die normale Repository-Steuerung zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu commit está en GitHub. Termina de añadir esta carpeta a GitSync.md para activar los controles normales del repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitisi on GitHubissa. Lisää tämä kansio GitSync.md:hen loppuun asti, niin saat tavalliset tietovaraston säätimet käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre commit est sur GitHub. Terminez l’ajout de ce dossier à GitSync.md pour activer les commandes habituelles du dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-commit שלכם נמצא ב-GitHub. סיימו להוסיף את התיקייה הזו ל-GitSync.md כדי להפעיל את פקדי המאגר הרגילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका commit GitHub पर है। सामान्य रिपॉज़िटरी नियंत्रण चालू करने के लिए इस फ़ोल्डर को GitSync.md में जोड़ना पूरा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A commitja a GitHubon van. A szokásos tárolóvezérlők engedélyezéséhez fejezze be a mappa hozzáadását a GitSync.md-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit Anda ada di GitHub. Selesaikan penambahan folder ini ke GitSync.md untuk mengaktifkan kontrol repositori biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo commit è su GitHub. Completa l'aggiunta di questa cartella a GitSync.md per attivare i normali controlli del repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットは GitHub にあります。通常のリポジトリ操作を有効にするには、このフォルダの GitSync.md への追加を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋이 GitHub에 있습니다. 일반 저장소 컨트롤을 사용하려면 이 폴더를 GitSync.md에 추가하는 작업을 완료하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Commiten din er på GitHub. Fullfør å legge til denne mappen i GitSync.md for å få vanlige repositoriekontroller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw commit staat op GitHub. Voeg deze map volledig toe aan GitSync.md om de normale repositorybediening in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój commit jest na GitHubie. Dokończ dodawanie tego folderu do GitSync.md, aby włączyć zwykłe kontrolki repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu commit está no GitHub. Conclua a adição desta pasta ao GitSync.md para ativar os controles normais do repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш commit на GitHub. Завершите добавление этой папки в GitSync.md, чтобы включить обычное управление репозиторием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din commit finns på GitHub. Slutför tillägget av den här mappen i GitSync.md för att aktivera vanliga arkivkontroller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ของคุณอยู่บน GitHub แล้ว เพิ่มโฟลเดอร์นี้ไปยัง GitSync.md ให้เสร็จเพื่อเปิดใช้ตัวควบคุมที่เก็บตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit'iniz GitHub'da. Normal depo denetimlerini etkinleştirmek için bu klasörü GitSync.md'ye eklemeyi tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш commit на GitHub. Завершіть додавання цієї папки до GitSync.md, щоб увімкнути звичайне керування репозиторієм."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit của bạn đã có trên GitHub. Hãy hoàn tất việc thêm thư mục này vào GitSync.md để bật các điều khiển kho lưu trữ thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的提交已在 GitHub 上。完成将此文件夹添加到 GitSync.md，即可启用常规仓库控件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的提交已在 GitHub 上。完成將此資料夾加入 GitSync.md，即可啟用一般儲存庫控制項。"
          }
        }
      }
    },
