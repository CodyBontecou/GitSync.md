    "Your files live in the Files app. Edit with any text editor, then come back to commit and push your changes upstream.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفاتك موجودة في تطبيق الملفات. قم بالتحرير باستخدام أي محرر نصوص، ثم عد للالتزام ودفع التغييرات إلى أعلى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine filer live i appen Filer. Rediger med en hvilken som helst teksteditor, og kom derefter tilbage for at forpligte og skubbe dine ændringer opstrøms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Dateien befinden sich in der Dateien-App. Bearbeiten Sie die Änderungen mit einem beliebigen Texteditor und übertragen Sie Ihre Änderungen anschließend erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus archivos se encuentran en la aplicación Archivos. Edite con cualquier editor de texto, luego regrese para confirmar e impulsar sus cambios en sentido ascendente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostosi elää tiedostossa. Muokkaa mitä tahansa tekstieditori, sitten palaa toimittamaan ja työnnä muutoksia ylösvirtaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers se trouvent dans l'application « Files ». Modifiez-les avec n'importe quel éditeur de texte, puis revenez pour effectuer le commit et le push de vos modifications vers la branche principale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הקבצים שלך נמצאים בaplication Files.ערוך אותם באמצעות כל מעריך טקסט, ואז戔回 כדי להשלים והשלוח את השינויים אל הרצף הראשי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": आपके फ़ाइलें 'Files' ऐप में संग्रहीत हैं। किसी भी टेक्स्ट एडिटर का उपयोग करके फ़ाइलों को संपादित करें, फिर अपने परिवर्तनों को कमिट करने और पुश करने के लिए वापस लौटें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Az állományokat az „Files\" alkalmazásban találhatók. Átformázza az állományt bármely szövegszerkesztővel, majd visszatérjen a „commit\" és a „push\" funkcióhoz, hogy átalakított változatait küldje az összeadott csatornára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas Anda berada di aplikasi Files. Edit menggunakan editor teks apa pun, kemudian kembali untuk melakukan komit dan push perubahan Anda ke repositori induk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I vostri file si trovano nell'app Files. Modificate con qualsiasi editor di testo, quindi tornate per confermare e pushare i vostri cambiamenti verso l'upstream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：あなたのファイルは「Files」アプリ内に保存されています。任意のテキストエディタで編集後、変更をコミットし、プッシュします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 귀하의 파일은 Files 앱에 저장되어 있습니다. 어떤 텍스트 편집기로도 파일을 수정한 후, 다시 돌아와 변경 내용을 커밋하고 푸시하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine filer finnes i Files-appen. Rediger filene med en hvilken som helst tekstrediger, og gå deretter tilbake for å bekrefte og pushe endringene dine oppover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bestanden bevinden zich in de Files-app. Bewerk ze met een teksteditor, en ga daarna terug om uw wijzigingen te bevestigen en naar de upstream toe te pushen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pliki znajdują się w aplikacji „Files\". Edytuj je za pomocą dowolnego edytora tekstu, a następnie wróć do procesu commitowania i pushingu zmian do źródła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos estão no aplicativo Files. Edite-os com qualquer editor de texto e depois retorne para realizar o commit e o push das suas alterações no fluxo principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": ваши файлы находятся в приложении «Files». Редактируйте их с помощью любого текстового редактора, затем вернитесь, чтобы выполнить коммит и推送 ваших изменений в центральный репозиторий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina filer finns i Filappen. Redigera filerna med vilken textredigerare som helst, och gå sedan tillbaka för att bekräfta och pusha dina ändringar uppströms."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ของคุณอยู่ในแอป Files ให้แก้ไขไฟล์ด้วยโปรแกรมแก้ไขข้อความใดๆ จากนั้นกลับมาดำเนินการ commit และ push การเปลี่ยนแปลงของคุณไปยัง upstream"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınız Files uygulamasında bulunur. Herhangi bir metin düzenleyicisiyle düzenleme yapın, ardından değişikliklerinizi kaydetmek ve push etmek için geri dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші файли розташовані в додатку «Files». Змініть їх за допомогою будь-якого текстового редактора, а потім поверніться до цього додатка, щоб зафіксувати та пушити ваші зміни у головний репозиторій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các tệp của bạn nằm trong ứng dụng Files. Hãy chỉnh sửa bằng bất kỳ trình soạn thảo văn bản nào, sau đó quay lại để thực hiện commit và push các thay đổi này lên nguồn gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：您的文件存储于“Files”应用中。您可以使用任何文本编辑器进行编辑，然后返回提交并将更改推送到上游仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：您的文件存儲於“Files”應用中。您可以使用任何文本編輯器進行編輯，然後返迴提交併將更改推送到上遊倉庫。"
          }
        }
      }
    },
