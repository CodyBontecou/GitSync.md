        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saubere Aktualisierungen ausschließlich per pull — niemals commit oder push"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones limpias solo mediante pull — nunca crea commit ni hace push"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhtaat vain pull-toimintoja käyttävät päivitykset — ei koskaan commit- tai push-toimintoja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour propres uniquement par pull — aucun commit ni push"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכוני pull נקיים בלבד — ללא commit או push לעולם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल साफ़ pull अपडेट — कभी commit या push नहीं"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiszta, csak pull típusú frissítések — soha nincs commit vagy push"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan bersih khusus pull — tidak pernah melakukan commit atau push"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamenti puliti di solo pull — mai commit o push"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンな pull 専用更新 — commit も push も行いません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗한 pull 전용 업데이트 — commit 또는 push를 절대 수행하지 않음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rene oppdateringer kun med pull — aldri commit eller push"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schone updates uitsluitend via pull — nooit commit of push"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyste aktualizacje wyłącznie przez pull — bez commit i push"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações limpas somente por pull — nunca faz commit nem push"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистые обновления только через pull — без commit и push"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rena uppdateringar enbart med pull — aldrig commit eller push"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตด้วย pull ที่ไม่มีข้อขัดแย้งเท่านั้น — ไม่ทำ commit หรือ push"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca temiz pull güncellemeleri — asla commit veya push yapmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чисті оновлення лише через pull — жодних commit або push"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật sạch chỉ bằng pull — không bao giờ commit hoặc push"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无冲突的仅 pull 更新 — 绝不 commit 或 push"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無衝突的僅 pull 更新 — 絕不 commit 或 push"
          }
        }
      },
      "extractionState": "stale"
    },
