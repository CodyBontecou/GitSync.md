        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप खोले बिना एक वॉल्ट में सब कुछ stage, commit और push करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindent stage-el, commitol és pushol egy széfben az app megnyitása nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage semuanya, commit, dan push satu vault tanpa membuka app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara tutto, fai commit e push di un vault senza aprire l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開かずに、1つの保管庫のすべてをステージしてコミットし、プッシュします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열지 않고 보관함 하나의 모든 항목을 스테이징, 커밋, 푸시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage alt, commit og push ett hvelv uten å åpne appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles stagen, committen en één kluis pushen zonder de app te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wszystko do indeksu, wykonaj commit i push jednego sejfu bez otwierania aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona tudo ao índice, faz commit e push de um cofre sem abrir o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индексировать всё, выполнить commit и push одного хранилища, не открывая приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till allt i stage, gör commit och pusha ett valv utan att öppna appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage ทุกอย่าง commit และ push vault หนึ่งโดยไม่ต้องเปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açmadan bir kasada her şeyi hazırla, commit ve push et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індексувати все, виконати commit і push одного сховища, не відкриваючи застосунок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage mọi thứ, commit và push một vault mà không cần mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开 App，即可暂存一个库的全部内容、提交并推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需打開 App，即可暫存一個保險庫的所有內容、提交並推送。"
          }
        }
      }
    },
