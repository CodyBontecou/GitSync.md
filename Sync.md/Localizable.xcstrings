    "Please enter a valid Git remote URL.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء إدخال عنوان URL صالح عن بعد لـ Git."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast venligst en gyldig Git-fjern-URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte geben Sie eine gültige Git-Remote-URL ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese una URL remota de Git válida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna kelvollinen Git- etäosoite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez entrer un Git URL à distance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא הזן תקף Git – URL מרוחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": कृपया एक वैध मान दर्ज करें। Git रिमोट URL।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, adjon meg egy érvényes értéket Git távvezérlési URL-cím."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan masukkan data yang valid Git URL jarak jauh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserire un valore valido\nURL remoto Git ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：有効な値を入力してください。 Git レモートURL。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 유효한 값을 입력해 주십시오. Git 원격 URL."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennligst oppgi et gyldig verdi Git fjernkobling-URL."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een geldige waarde in Git afstandsserver-URL."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę wpisać poprawny dane\nURL odległego interfejsu Git ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, insira um valor válido\nURL remoto Git ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, введите корректное значение Git — удалённый URL-адрес."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänligen ange ett giltigt värd. Git fjärranslutnings-URL."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาป้อนข้อมูลที่ถูกต้อง Git URL สำหรับการเชื่อมต่อระยะไกล"
          }
        },
        "tr": {
