    "Invalid or expired token. Sign out and sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز مميز غير صالح أو منتهي الصلاحية. قم بتسجيل الخروج وتسجيل الدخول مرة أخرى."
          }
        },
