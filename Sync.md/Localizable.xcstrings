            "state": "translated",
            "value": "Débloquez les dépôts illimités avec un achat unique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שחרור מאגרים ללא הגבלה ברכישה חד-פעמית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की खरीदारी से असीमित रिपॉज़िटरीज़ अनलॉक करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Korlátlan tárolók feloldása egyszeri vásárlással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka repositori tanpa batas dengan pembelian satu kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca repository illimitati con un acquisto singolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りでリポジトリを無制限にアンロックしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 구매로 무제한 저장소를 이용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp ubegrensede repositorier med et engangskjøp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel onbeperkte repository's met een eenmalige aankoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj nieograniczoną liczbę repozytoriów jednorazowym zakupem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie repositórios ilimitados com uma compra única."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте безлимитные репозитории одной покупкой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp obegränsat antal förråd med ett engångsköp."
          }
