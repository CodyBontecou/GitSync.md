            "state": "translated",
            "value": "サーバーからHTMLエラーページが返されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 HTML 오류 페이지를 반환했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "-serveren returnerte en HTML-feilside."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "-server heeft een HTML-foutpagina geretourneerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "serwer zwraca stronę błędu w formacie HTML."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O servidor retornou uma página de erro HTML."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": сервер вернул HTML-страницу с ошибкой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "-servern har returnerat en HTML-fejlpage."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ได้ส่งหน้าข้อผิดพลาด HTML"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu, bir HTML hata sayfası döndürdü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "сервер відповів сторінкою з помилкою HTML."
          }
        },
        "vi": {
