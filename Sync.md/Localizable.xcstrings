    "The remote rejected the default system credentials.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": أعاد النظام الرجعي رفض بيانات المصادقة الافتراضية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote-en har afvist de standard-systembrugerkredencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ": Der Remote-Client hat die Standard-Systemanmeldedaten abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ": El dispositivo remoto rechazó las credenciales predeterminadas del sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote-laitteisto hylkäsi oletusjärjestelmän tunnistepalveluiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Le système distant a rejeté les identifiants par défaut du système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": ה-remote דחה את פרטי ההתחברות mặcומרים של המערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट ने डिफ़ॉल्ट सिस्टम क्रेडेंशियल्स को अस्वीकार कर दिया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A távvezérlő elutasította a rendszer alapértelmezett bejelentkezési adatát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote telah menolak kredensial sistem default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il dispositivo remoto ha respinto le credenziali predefinite del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモート側がデフォルトのシステム認証情報を拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 원격 시스템이 기본 시스템 자격 정보를 거부했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernenhetenen avviste de standard-systemautentiseringsopplysningene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De externe systeem heeft de standaardsysteemgegevens geweigerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote system odmawia domyślnych uprawnień logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O dispositivo remoto rejeitou as credenciais padrão do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": удалённый сервер отклонил стандартные системные учетные данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjärranslutningen avvissade de standardsystemautentiseringsuppgifterna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ระบบระยะไกลปฏิเสธข้อมูลเข้าสู่ระบบเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uzaktan sisteme girmek için standart sistem kimlik bilgileri reddedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Дистанційний пристрій відхилив за замовчуванням системні дані авторизації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thiết bị từ xa đã từ chối thông tin xác thực mặc định của hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：远程端拒绝了默认系统凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：遠程端拒絶了默認繫統憑據。"
          }
        }
      }
    },
    "The remote rejected the saved SSH key. Check that the key has access to this repository and that the passphrase is correct.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": أعاد النظام البعيد رفض المحتوى المحفوظ.\nالключа SSH : تحقق من أن هذه الكلمة المفتاحية تمتلك صلاحية الوصول إلى هذا المستودع، وكذلك من أن كلمة التأمين صحيحة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernmodul har afvist de gemte data. SSH nøgle. Kontrolér, at nølen har adgang til dette repository og at passordet er korrekt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ": Der Remote-Bereich hat das gespeicherte Dokument abgelehnt. SSH -Schlüssel. Überprüfen Sie, ob der Schlüssel Zugriff auf dieses Repository hat und ob das Passphrase korrekt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ": El sistema remoto rechazó el archivo guardado.\nClave SSH . Verifique que la clave tenga acceso a este repositorio y que la frase de contraseña sea correcta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Etätilaus hylkäsi tallennetun tiedon. SSH -avain. Tarkista, että avain on pääsyssä tähän tallennukseen ja että salasanan on oikea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Le système distant a rejeté les données sauvegardées.\nClé SSH : vérifiez que la clé a accès à ce dépôt et que le mot de passe est correct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": ה-remote דחה את הנתונים שהוגדרו.\nchlיפת SSH – בדקו אם הchlיפת קולטת גישה למאגר זה וесודת שהchlיפת הסיסמולוגית נכונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट द्वारा सहेजे गए आइटम को अस्वीकृत कर दिया गया है। SSH कुंजी। यह सत्यापित करें कि कुंजी को इस रिपॉजिटरी में पहुँच है तथा पासवर्ड सही है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A távvezérlés elutasította a mentett adatot. SSH kulcs: ellenőrizze, hogy a kulcshoz az adott tárolóhoz jutás van, és hogy a passzphrasz helyes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote menolak data yang telah disimpan.\nKunci SSH . Periksa apakah kunci ini memiliki akses ke repositori ini dan apakah kata sandi (passphrase) sudah benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il sistema remoto ha respinto l'elemento salvato.\nChiave SSH . Verificare che la chiave abbia accesso a questo repository e che la frase di crittografia sia corretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモート端末が保存済みデータを拒否しました。 SSH キーについて、このリポジトリへのアクセス権が付与されているか、およびパスフレーズが正しいかを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 원격 시스템이 저장된 데이터를 거부했습니다. SSH 키입니다. 해당 키가 이 저장소에 접근할 수 있는지, 그리고 패스프레시가 올바른지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": fjernsystemet avviste det lagrede materialet. SSH nøkkel. Sjekk at nøkkelen har tilgang til dette lagringsmottaket og at passordet er korrekt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De externe systeem heeft het opgeslagen gegeven geweigerd. SSH -sleutel. Controleer of de sleutel toegang heeft tot deze repository en of de passphrase correct is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Odległy system odrzucił zapisane dane.\nKlucz SSH . Sprawdź, czy klucz ma dostęp do tego reposituarium oraz czy hasło jest poprawne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O sistema remoto rejeitou o conteúdo salvo.\nChave SSH . Verifique se a chave tem acesso a este repositório e se a frase de senha está correta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": удалённый сервер отклонил сохранённые данные.\nКлюч SSH . Проверьте, что у ключа есть доступ к этому репозиторию и что фраза пароля корректна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Värdet har avvissats från sparad data. SSH nyckel. Kontrollera att nyckeln har tillgång till denna repostiro och att passphrasen är korrekt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ระบบระยะไกลปฏิเสธข้อมูลที่บันทึกไว้\nคีย์ SSH : ตรวจสอบว่าคีย์นี้สามารถเข้าถึงรีโพซิทอรี่นี้ได้ และรหัสผ่านที่ใช้ถูกต้องหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uzaktan sistem, kaydedilen veriyi reddetmiştir. SSH anahtarı. Anahtarın bu depolama alanına erişim sağladığını ve şifreleme parolasının doğru olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": віддалений сервер відхилив збережене дані.\nКлюч SSH . Перевірте, чи у ключа є доступ до цього репозиторію та чи фраза-пароль правильна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bộ điều khiển từ xa đã từ chối dữ liệu đã lưu.\nChìa khóa SSH . Hãy kiểm tra xem chìa khóa này có quyền truy cập vào kho lưu trữ này và mật khẩu xác thực có chính xác hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程端拒绝了已保存的内容 SSH 密钥。请检查该密钥是否可访问此存储库，且密码短语是否正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠程端拒絶了已保存的內容 SSH 密鑰。請檢查該密鑰是否可訪問此存儲庫，且密碼短語是否正確。"
          }
        }
      }
    },
    "The remote rejected the saved token/password. Check that it has access to this repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": أعاد النظام البعيد رفض الرمز أو كلمة المرور المحفوظة؛ يُرجى التحقق من أن النظام له صلاحية الوصول إلى هذا المستودع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote-en har afvist det gemte token eller adgangskode. Undersøg, om den har adgang til dette repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ": Der Remote-Bereich hat das gespeicherte Token bzw. Passwort abgelehnt. Überprüfen Sie, ob er Zugriff auf dieses Repository hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ": El sistema remoto rechazó el token o contraseña guardado. Verifique que tenga acceso a este repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote-pohjainen ohjelma hylkäsi tallennetun tokenin/tunnuspalon. Tarkista, että se on käytössä tähän repositorioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Le serveur distant a rejeté le jeton/le mot de passe enregistré. Vérifiez que celui-ci dispose d'un accès à ce dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": ה-remote דחה את הטוקן/הסיסמה שהוגדרה; בדקו אם הוא יכול לגשת למאגר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट द्वारा सहेजे गए टोकन/पासवर्ड को अस्वीकृत कर दिया गया है। यह सुनिश्चित करें कि इसमें इस रिपॉजिटरी तक पहुँच है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A távvezérlő elutasította a mentett tokenet vagy jelszót. Ellenőrizze, hogy az adott számítógép hozzáférhet ehhez a tárolóhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote telah menolak token/password yang disimpan. Pastikan remote tersebut memiliki akses ke repositori ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il sistema remoto ha respinto il token/password salvato. Verificare che abbia accesso a questo repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモート側が保存済みのトークン／パスワードを拒否しました。このリポジトリへのアクセス権限があることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 원격 시스템이 저장된 토큰 또는 비밀번호를 거부했습니다. 해당 시스템이 이 저장소에 접근할 수 있는지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernenheten har avvist det lagrede tokenet eller passordet. Sjekk at den har tilgang til dette repotretsystemet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De externe systeem heeft het opgeslagen token of wachtwoord geweigerd. Controleer of het toegang heeft tot dit repository."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote system odrzucił zapisany token lub hasło. Sprawdź, czy posiada dostęp do tego reposituarium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O sistema remoto rejeitou o token/senha salvo. Verifique se ele tem acesso a este repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": удалённый сервер отклонил сохранённый токен или пароль. Проверьте, имеет ли он доступ к этому репозиторию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote-en har avvissat det sparade token eller lösenordet. Kontrollera att den har tillgång till denna repotre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ระบบระยะไกลปฏิเสธโทเคนหรือรหัสผ่านที่บันทึกไว้ โปรดตรวจสอบว่าระบบสามารถเข้าถึงรีโพซิทอรีนี้ได้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uzaktan sistem, kaydedilmiş token/parolaı reddetmiştir. Bu depoya erişim hakkı sahip olup olmadığını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
