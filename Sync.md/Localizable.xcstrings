          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset Omassa iPhonessa -kansiot ja tavalliset tiedostot enintään 10 MiB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossiers locaux Sur mon iPhone et fichiers ordinaires jusqu’à 10 Mio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיות מקומיות ב-iPhone שלי וקבצים רגילים עד 10 MiB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे iPhone पर के स्थानीय फ़ोल्डर और 10 MiB तक की सामान्य फ़ाइलें।"
          }
        },
        "hu": {
