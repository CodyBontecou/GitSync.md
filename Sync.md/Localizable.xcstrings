    "Failed to update ref — remote may have advanced. Pull and retry. (%@)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحديث المرجع-قد يكون الطرف البعيد قد تقدم في التسلسل. اسحب وأعد المحاولة.%@)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mislykkedes at opdatere ref - fjernbetjening kan have avanceret. Træk og prøv igen.%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ref-remote wurde möglicher weise nicht aktualisiert. Ziehen und wiederholen. (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al actualizar ref-remoto puede haber avanzado. Tire y reinténtelo. ()\nFiltro%@)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitys Ref epäonnistui - etä on saattanut olla edistynyt. Vedä ja yritä uudestaan.%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la mise à jour ref-la télécommande peut avoir avancé. Tirez et réessayez. (%@)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": לא הצלחנו לעדכן את ה-Ref — ייתכן שה-Remote قد עברה שלב מתקדם. אסוף ונסו שוב.%@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'ref' अपडेट करने में विफलता हुई — रिमोट संस्करण अद्यतन हो सकता है। पुल करें और पुनः प्रयास करें।%@)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": a referencia frissítése nem sikerült – a távvezérlés előrehaladhatott; kérjük, felgyűjtse az adatokat és újra próbálja.%@)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memperbarui referensi — remote mungkin telah maju. Lakukan pull dan coba lagi.%@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": non è stato possibile aggiornare il ref — il repository remoto potrebbe essere stato aggiornato; eseguire il pull e tentare nuovamente.%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ": refの更新に失敗しました — レモート側で進捗が進行している可能性があります。Pullし、再試行してください。（%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": ref 업데이트에 실패했습니다 — 원격 시스템이 이미 최신 상태일 수 있습니다. pull을 수행한 후 재시도하십시오.%@)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Trekk ikke oppdateringen av referanse – fjernverktøyet kan ha blitt oppdatert. Trekk igjen og forsøk på nytt.%@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bij het bijwerken van de referentie is er een fout opgetreden — de externe bron kan zijn verder gevorderd; pull en probeer opnieuw.%@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udalo się aktualizować referencji — odległy serwer może być zaktualizowany. Wykonaj pull i ponownie spróbuj.%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Falha na atualização do referencial — o remoto pode ter avançado; execute o pull e tente novamente.%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить ссылку — удалённый сервер может быть обновлён; выполните pull и повторите попытку.%@)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uppdatering av referens misslyckades – fjärrsystemet kan ha förbättrats. Ta ut och försök igen.%@)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปเดต ref ได้ — อาจเป็นเพราะ remote มีการปรับปรุงล่าสุดแล้ว โปรดใช้คำสั่ง pull และลองอีกครั้ง (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Referansı güncelleme başarısız oldu — uzaktan işlem daha ilerli olabilir. Pull et ve yeniden deneyin.%@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": не вдалося оновити ref — на дистанції можливо, що стан був підвищений. Виконайте команду «Pull» і спробуйте знову.%@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Không thể cập nhật ref — máy chủ từ xa có thể đã tiến bộ; hãy thực hiện pull và thử lại.%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新引用失败——远程环境可能已更新。请执行拉取操作并重试。（%@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新引用失敗——遠程環境可能已更新。請執行拉取操作併重試。（%@)"
          }
        }
      }
    },
    "Fast-forward only. Anything unusual waits for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "fast-forward فقط. أي شيء غير عادي ينتظرك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun fast-forward. Alt usædvanligt venter på dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Fast-Forward. Alles Ungewöhnliche wartet auf Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo fast-forward. Lo inusual te espera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain pikakelaus. Kaikki poikkeava odottaa sinua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast-forward uniquement. Tout ce qui est inhabituel vous attend."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "fast-forward בלבד. כל דבר חריג ממתין לכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल fast-forward। कुछ भी असामान्य आपकी प्रतीक्षा करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak fast-forward. Minden szokatlan Önre vár."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya fast-forward. Hal yang tidak biasa menunggu Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo fast-forward. Tutto ciò che è insolito ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fast-forward のみ。いつもと違うことがあれば、あなたを待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fast-forward만 수행합니다. 평소와 다른 일이 생기면 사용자를 기다립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun fast-forward. Alt uvanlig venter på deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen fast-forward. Alles wat ongewoon is, wacht op u."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko fast-forward. Wszystko nietypowe czeka na Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas fast-forward. Qualquer coisa incomum aguarda você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только fast-forward. Всё необычное ждёт вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast fast-forward. Allt ovanligt väntar på dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "fast-forward เท่านั้น สิ่งผิดปกติจะรอคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca fast-forward. Olağan dışı her şey sizi bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише fast-forward. Усе незвичне чекає на вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ fast-forward. Mọi điều bất thường sẽ chờ bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅快进。遇到异常情况会等你处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅快轉。遇到異常情況會等你處理。"
          }
        }
      }
    },
