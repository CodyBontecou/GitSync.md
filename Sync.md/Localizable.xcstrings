          "stringUnit": {
            "state": "translated",
            "value": "원격 요청됨 %1$@이지만, 저장된 상태입니다. %2$@ 인증 정보는 호환되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– fjernanmodus er foreslått %1$@, men de lagrede verdiene %2$@ -kredensialer er ikke kompatible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De afstandsverzoek is verzonden. %1$@, maar het is opgeslagen\nDe %2$@ -credentiaal zijn niet compatibel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– żądanie odległego %1$@, ale zapisane\nKredencje %2$@ nie są kompatybilne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "– Pedido remoto solicitado %1$@, mas o salvo\nAs credenciais de %2$@ não são compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": удалённый запрос %1$@, но сохранено\nЛогин и пароль %2$@ не совместимы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– fjärransökan är begärad %1$@, men det sparade %2$@ -kreditorer är inte kompatibla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ได้รับคำขอจากระยะไกล %1$@แต่ถูกบันทึกแล้ว %2$@ : ข้อมูลบัญชีไม่เข้ากันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uzaktan iste işlemi gerçekleştirildi. %1$@, ancak kaydedilmiştır. %2$@ kimlik bilgileri uyumludur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "– вимагається дистанційне зв'язок %1$@, але збережене\nДані кріденталі %2$@ не є сумісними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yêu cầu từ xa %1$@, nhưng đã được lưu %2$@ : Tài khoản đăng nhập không tương thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程请求 %1$@，但已保存 %2$@ 凭据不兼容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠程請求 %1$@，但已保存 %2$@ 憑據不兼容。"
          }
        }
      }
    },
    "The remote requested HTTPS credentials, but no token or password is saved for this repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": تم طلب بيانات اعتماد HTTPS عن بُعد، لكن لا يوجد أي رمز أو كلمة مرور محفوظ لمستودع هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernansigende funktion har forespurt HTTPS-krav, men der er ingen token eller adgangskode gemt for dette repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ": Die Remote-Verbindung hat HTTPS-Zugangsdaten angefordert, jedoch sind für dieses Repository kein Token noch kein Passwort gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ": Se solicitaron credenciales HTTPS desde la distancia, pero no se ha guardado ningún token ni contraseña para este repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote -palvelu pyytää HTTPS-tilaustietoja, mutta tässä tallennusjärjestelmässä ei ole tallennettu lainkaan tokenia tai salasanaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Le système a demandé des identifiants HTTPS depuis un terminal distant, mais aucun jeton ou mot de passe n'est enregistré pour ce dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הבקשה לאפשרויות HTTPS מרחוק, אך אין שומרת טוקן או סיסמה עבור המאגר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट ने HTTPS के लिए प्राधान्य आवश्यकताएँ मांगी हैं, लेकिन इस रिपॉजिटरी के लिए कोई टोकन या पासवर्ड सहेजा नहीं गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
