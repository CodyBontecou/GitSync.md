    "Your notes are safe on this iPhone. Nothing was lost. %lld vaults are waiting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظاتك آمنة على هذا الـ iPhone. لم يضع شيء. %lld خزائن في الانتظار."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine noter er i sikkerhed på denne iPhone. Intet gik tabt. %lld vaults venter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Notizen sind auf diesem iPhone sicher. Nichts ging verloren. %lld Vaults warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas están a salvo en este iPhone. No se perdió nada. %lld bóvedas están esperando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanosi ovat turvassa tässä iPhonessa. Mitään ei menetetty. %lld holvia odottaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes sont en sécurité sur cet iPhone. Rien n’a été perdu. %lld coffres sont en attente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפתקים שלכם בטוחים ב-iPhone הזה. שום דבר לא אבד. %lld כספות ממתינות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके नोट्स इस iPhone पर सुरक्षित हैं। कुछ भी नहीं खोया। %lld वॉल्ट प्रतीक्षा में हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetei biztonságban vannak ezen az iPhone-on. Semmi sem veszett el. %lld széf várakozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan Anda aman di iPhone ini. Tidak ada yang hilang. %lld vault sedang menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue note sono al sicuro su questo iPhone. Non è andato perso nulla. %lld vault sono in attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートはこの iPhone に安全に残っています。何も失われていません。%lld 個の保管庫が待機中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트는 이 iPhone에 안전하게 있습니다. 잃은 것은 없습니다. 보관함 %lld개가 대기 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatene dine er trygge på denne iPhonen. Ingenting gikk tapt. %lld hvelv venter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw notities zijn veilig op deze iPhone. Er is niets verloren. %lld kluizen wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki są bezpieczne na tym iPhonie. Nic nie zostało utracone. Czekające sejfy: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas notas estão seguras neste iPhone. Nada foi perdido. %lld cofres estão aguardando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши заметки в безопасности на этом iPhone. Ничего не потеряно. Хранилищ в ожидании: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina anteckningar är säkra på den här iPhonen. Inget gick förlorat. %lld valv väntar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตของคุณปลอดภัยบน iPhone เครื่องนี้ ไม่มีอะไรสูญหาย มี %lld vault รออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlarınız bu iPhone'da güvende. Hiçbir şey kaybolmadı. %lld kasa bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші нотатки в безпеці на цьому iPhone. Нічого не втрачено. Сховищ в очікуванні: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú của bạn an toàn trên iPhone này. Không có gì bị mất. %lld vault đang chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的笔记安全地保存在此 iPhone 上。没有任何丢失。%lld 个库正在等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的筆記安全地保存在此 iPhone 上。沒有任何遺失。%lld 個保險庫正在等待。"
          }
        }
      }
    },
