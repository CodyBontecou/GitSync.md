    "The repository was published, but local settings could not be saved. Resume to finish adding it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نشر المستودع، لكن تعذّر حفظ الإعدادات المحلية. استأنف لإكمال إضافته."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositoryet blev udgivet, men de lokale indstillinger kunne ikke gemmes. Genoptag for at færdiggøre tilføjelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository wurde veröffentlicht, aber lokale Einstellungen konnten nicht gespeichert werden. Setzen Sie fort, um das Hinzufügen abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio se publicó, pero no se pudieron guardar los ajustes locales. Reanuda para terminar de añadirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietovarasto julkaistiin, mutta paikallisia asetuksia ei voitu tallentaa. Viimeistele lisäys jatkamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt a été publié, mais les réglages locaux n’ont pas pu être enregistrés. Reprenez pour terminer son ajout."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאגר פורסם, אך לא ניתן היה לשמור את ההגדרות המקומיות. המשיכו כדי לסיים להוסיף אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी प्रकाशित हुई, लेकिन स्थानीय सेटिंग्स सहेजी नहीं जा सकीं। इसे जोड़ना पूरा करने के लिए फिर से शुरू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tároló közzétéve, de a helyi beállításokat nem sikerült menteni. A hozzáadás befejezéséhez folytassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori sudah dipublikasikan, tetapi pengaturan lokal tidak dapat disimpan. Lanjutkan untuk menyelesaikan penambahannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository è stato pubblicato, ma non è stato possibile salvare le impostazioni locali. Riprendi per completarne l'aggiunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリは公開されましたが、ローカル設定を保存できませんでした。再開して追加を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소가 게시되었지만 로컬 설정을 저장할 수 없습니다. 재개하여 추가를 완료하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositoriet ble publisert, men lokale innstillinger kunne ikke lagres. Fortsett for å fullføre å legge det til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De repository is gepubliceerd, maar lokale instellingen konden niet worden bewaard. Hervat om het toevoegen af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium zostało opublikowane, ale nie udało się zapisać ustawień lokalnych. Wznów, aby dokończyć dodawanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório foi publicado, mas não foi possível salvar os ajustes locais. Retome para concluir a adição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий опубликован, но локальные настройки не удалось сохранить. Продолжите, чтобы завершить добавление."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivet publicerades, men lokala inställningar kunde inte sparas. Återuppta för att slutföra tillägget."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เผยแพร่ที่เก็บแล้ว แต่บันทึกการตั้งค่าในเครื่องไม่ได้ ดำเนินการต่อเพื่อเพิ่มให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo yayımlandı ancak yerel ayarlar kaydedilemedi. Eklemeyi tamamlamak için sürdürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторій опубліковано, але локальні налаштування не вдалося зберегти. Продовжте, щоб завершити додавання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ đã được xuất bản, nhưng không thể lưu cài đặt cục bộ. Hãy tiếp tục để hoàn tất việc thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库已发布，但无法保存本地设置。请继续以完成添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫已發佈，但無法儲存本機設定。請繼續以完成加入。"
          }
        }
      }
    },
    "The stashed changes are deleted.": {
