    "The remote requested authentication (%@), but no credentials are configured for this repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب التحقق من الهوية عن بُعد (%@)، ولكن لا توجد بيانات اعتماد مُهيأة لهذا المخزن."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "– Den fjernfordelte autentificering, der er foreslået (%@), men der er ingen adgangsoplysninger konfigureret for dette repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fernanforderung einer Authentifizierung (%@), aber für dieses Repository sind keine Authentifizierungsdaten konfiguriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación solicitada desde el extremo remoto (%@), pero no se han configurado credenciales para este repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etätilausun kohdalla pyydetty tunnistus (%@), mutta tässä tallennusjärjestelmässä ei ole määritelty mitään tunnistepaikkoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": L'authentification demandée depuis le terminal distant (%@), mais aucune identité n'est configurée pour ce dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– אימות מבקש מאזור ה远方 (%@), אך לא קיימות תעודות אימות configured למאגר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट से अनुरोधित प्रमाणीकरण (%@), लेकिन इस रिपॉजिटरी के लिए कोई प्रमाणन सेटअप नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "távvezérelt bejelentett autentikáció (%@), de ez a repozitórium számára nincs beállított hitelesítő adat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan autentikasi dari remote (%@), tetapi tidak ada kredensial yang dikonfigurasi untuk repositori ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Autenticazione richiesta da remoto (%@), ma non sono configurate credenziali per questo repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモートから認証要求（%@）では、このリポジトリに対して認証情報が設定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 시스템이 요청한 인증(%@), 하지만 이 저장소에 대한 인증 정보가 설정되어 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– fjernbehandlet autentisering (%@), men det er ingen autentiseringsopplysninger konfigurert for dette lagringsmøtet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De externe verzoek om authenticatie (%@), maar er zijn geen authenticatiegegevens voor dit repository geconfigureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– żądany odległy proces autentycyzacji (%@), ale nie są skonfigurowane żadne dane logowania dla tego reposituaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação solicitada remotamente (%@), mas nenhuma credencial foi configurada para este repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": удалённый запрос аутентификации (%@), но для данного репозитория не настроены учетные данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– fjärransökt autentisering (%@), men inga autentiseringsuppgifter är konfigurerade för detta lagringsplats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การขอการพิสูจน์ตัวตนจากปลายทาง (%@), แต่ไม่มีข้อมูลบัญชีผู้ใช้ที่กำหนดสำหรับรีโพซิทอรีนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan istenen kimlik doğrulaması (%@), ancak bu depolama deposu için hiçbir kimlik bilgisi yapılandırılmamıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Поточується запит на автентифікацію з віддаленого джерела (%@), але для цього репозиторію не налаштовані авторизаційні дані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yêu cầu xác thực từ xa (%@), nhưng không có tài khoản hay thông tin xác thực nào được cấu hình cho kho lưu trữ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程请求的身份验证（%@），但该存储库尚未配置凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠程請求的認証（%@），但該存儲庫尚未配置憑據。"
          }
        }
      }
    },
