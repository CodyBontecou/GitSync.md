    "This file was renamed differently on each side. Choose which name to keep — the other will be removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة تسمية هذا الملف بشكل مختلف على كل جانب. اختر الاسم الذي تريد الاحتفاظ به — ستتم إزالة الاسم الآخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fil blev omdøbt forskelligt på hver side. Vælg hvilket navn du vil beholde - det andet vil blive fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde auf jeder Seite unterschiedlich umbenannt. Wählen Sie den Namen aus, den Sie behalten möchten – der andere wird entfernt."
