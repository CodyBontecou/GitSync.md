    "Merge has conflicts — tap a conflicted file to resolve": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدمج به تعارضات - اضغط على الملف المتعارض لحله"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge har konflikter - tryk på en konfliktfil for at løse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge hat Konflikte – tippen Sie auf eine Konfliktdatei, um sie zu lösen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinación tiene conflictos: toque un archivo en conflicto para resolverlo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistämällä on ristiriidat - napsauta ristiriitainen tiedosto ratkaistaksesi ristiriitaisen tiedoston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner a des conflits-appuyez sur un fichier conflictuel pour résoudre"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge מציג מתחיades – לחץ על קובץ עם מתחיades כדי לפתור את המ issue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge में संघर्ष है — समाधान के लिए संघर्षग्रस्त फ़ाइल पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Merge\" funkcióban konfliktusok vannak – oldjuk meg ezeket egy konfliktus fájlra kattintás útján."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge mengalami konflik — longgarkan pada file yang terkonflik untuk menyelesaikannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge presenta conflitti — tocca un file con conflitto per risolverlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Merge」機能で衝突が発生しました — 冲突しているファイルをタップして解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge에서 충돌이 발생했습니다 — 충돌된 파일을 선택하여 해결할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Merge» har konflikter – trykk på en konfliktvoll fil for å løse problemet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge heeft conflicten – tik op een conflicteerde bestand om het probleem op te lossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": funkcja „Merge\" wykazuje konflikty – naciśnij plik z konfliktem, aby go rozwiązać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O merge apresenta conflitos — toque no arquivo com conflito para resolvê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": операция объединения столкнулась с конфликтами — нажмите на конфликтующий файл для их устранения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Merge-funktionen har konflikter – tryck på en konfliktig fil för att lösa problemet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge มีความขัดแย้ง — แตะไฟล์ที่มีความขัดแย้งเพื่อแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge işlemide çakıntılar mevcuttur — çakıntılı dosyaya dokunarak sorunu çözebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": функція «Merge» має конфлікти — натисніть на конфліктований файл для вирішення проблеми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác hợp nhất gặp xung đột — hãy chạm vào tệp có xung đột để giải quyết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“合并”操作存在冲突——请点击冲突文件进行解决"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“閤併”操作存在衝突——請點擊衝突文件進行解決"
          }
        }
      }
    },
    "Merge is blocked to protect local edits. Commit, stash, or discard changes first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حظر الدمج لحماية عمليات التحرير المحلية. تنفيذ التغييرات أو تخزينها أو تجاهلها أولاً."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge er blokeret for at beskytte lokale redigeringer. Bekræft, gem eller kasser ændringer først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge ist blockiert, um lokale Änderungen zu schützen. Änderungen zuerst festschreiben, speichern oder verwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinación está bloqueada para proteger las ediciones locales. Confirme, guarde o descarte los cambios primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "yhdistäminen on estynyt paikallisten muokkausten suojaamiseksi. Toimita, piilota tai hylätä muutokset ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusion est bloquée pour protéger les édits locaux. Commit, stash ou rejettent les modifications en premier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אומת כדי להגן על השינויים המקומיים – יש לבצע את ה-Commit, ה-Stash או ה-Discard של השינויים לפני כן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge को स्थानीय संपादनों की रक्षा के लिए अवरुद्ध किया गया है। पहले परिवर्तनों को कमिट करें, स्टैश करें या डिस्कार्ड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge\" parancs blokkolva van a helyi módosítások védelmére; először alkalmazza az „Commit\", „stash\" vagy „discard\" parancsokat.\nA"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge* diblokir untuk melindungi edisi lokal. Harap terlebih dahulu melakukan *Commit*, *Stash*, atau *Discard* perubahan tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "è bloccato per proteggere le modifiche locali. Si raccomanda di effettuare prima un commit, uno stash o la cancellazione delle modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge操作は、ローカル編集を保護するため、ブロックされています。まず、変更をコミット、スタッシュ、またはディスカインドください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge 작업은 로컬 편집을 보호하기 위해 차단되었습니다. 먼저 변경 사항을 커밋, 스타시 또는 드이스드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Merge» er blokkert for å beskytte lokale redigeringer. Før du utfører «Commit», «Stash» eller «Discard», gjør først disse handlingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge' is geblokkeerd om lokale bewerkingen te beschermen. Bewerk eerst de wijzigingen met commit, stash of discard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "jest zablokowana w celu ochrony lokalnych modyfikacji. Najpierw wykonaj commit, stash lub discard zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "está bloqueada para proteger as edições locais. Primeiro, execute o commit, o stash ou a descarte das alterações.\nA operação de fusão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge» блокируется для защиты локальных изменений. Сначала выполните операцию Commit, stash или discard изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge är blockerad för att skydda lokala redigeringar. Försök först att bekräfta, förvara eller avstå från ändringarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge ถูกปิดกั้นเพื่อปกป้องการแก้ไขในท้องถิ่น — ควรดำเนินการ Commit, stash หรือ discard การเปลี่ยนแปลงก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge işlemi, yerel düzenlemeleri korumak için engellendi. İlk olarak değişiklikleri commit etmek, stash etmek veya discard etmelisiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge» заблокована для захисту локальних змін. Спочатку виконайте операцію Commit, stash або discard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác hợp nhất bị chặn nhằm bảo vệ các chỉnh sửa cục bộ. Vui lòng thực hiện commit, stash hoặc discard thay đổi trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“合并”操作已被阻止，以保护本地编辑内容。请先提交、暂存或丢弃更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“閤併”操作已被阻止，以保護本地編輯內容。請先提交、暫存或丟棄更改。"
          }
        }
      }
    },
    "Merge produced conflicts that require manual resolution.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دمج التعارضات الناتجة التي تتطلب حلاً يدويًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge producerede konflikter, der kræver manuel løsning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge führte zu Konflikten, die eine manuelle Lösung erforderten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinación produjo conflictos que requieren resolución manual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistänyt ristiriidat, jotka vaativat manuaalista ratkaisua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusion a produit des conflits nécessitant une résolution manuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": ה-merge ייצר מתחים שדורשים פתרון ידני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge द्वारा ऐसे संघर्ष उत्पन्न हुए हैं जिनके लिए मैन्युअल समाधान की आवश्यकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Merge\" eljárás konfliktusokat eredményezett, amelyek manuális megoldásra szorulnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge menghasilkan konflik yang memerlukan penyelesaian manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": la funzione Merge ha generato conflitti che richiedono una risoluzione manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "の「Merge」処理により、手動での解決が必要なコンフリクトが発生しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge 과정에서 수동 해결이 필요한 충돌이 발생했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge har produsert konflikter som krever manuell løsning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De merge heeft conflicten gegenereerd die handmatige oplossing vereisen."
          }
