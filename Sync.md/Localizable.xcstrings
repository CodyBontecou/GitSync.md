          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thiết bị từ xa đã yêu cầu một thứ gì đó.\nChìa khóa SSH đã được tạo, nhưng không có khóa riêng nào được lưu cho kho dữ liệu này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
