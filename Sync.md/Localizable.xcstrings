    "Repository %@ was deleted by another operation; stale changes were not restored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستودع %@ تم حذفه بواسطة عملية أخرى ؛ لم تتم استعادة التغييرات التي لا معنى لها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאגר %@ נמחק על ידי פעולה אחרת; שינויים מעוקלים לא שוחזרו."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Var slettet ved en anden operation; forældede ændringer blev ikke genoprettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Wurde durch eine andere Operation gelöscht; veraltete Änderungen wurden nicht wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositorio %@ Fue eliminado mediante otra operación; los cambios obsoletos no se restauraron."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietokanta %@ Tiedosto poistettiin toisen operaation tuloksena; vanhentuneet muutokset eivät ole palautettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répertoire %@ A été supprimé par une autre opération ; les modifications obsolètes n'ont pas été restaurées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉजिटरी %@ यह किसी अन्य ऑपरेशन द्वारा हटा दिया गया था; पुराने परिवर्तनों को पुनर्स्थापित नहीं किया गया था।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adatmagázt %@ Ezt egy másik művelet törölte; a korábban már érvénytelenített módosításokat nem helyreállították."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori %@ Dihapus oleh operasi lain; perubahan yang sudah usang tidak dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riservorio %@ È stato eliminato da un'altra operazione; i cambiamenti obsoleti non sono stati ripristinati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリ %@ 別の操作によって削除されました。古い変更内容は復元されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 %@ 다른 작업으로 인해 삭제되었으며, 오래된 변경 사항은 복원되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lager %@ Var slettet av en annen operasjon; forårsaket endringer ble ikke gjenopprettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Is verwijderd door een andere operatie; verouderde wijzigingen zijn niet geresumeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium %@ Użytej operacji usunięto; nie przywrócono starych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório %@ Foi excluído por outra operação; as alterações obsoletas não foram restauradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий %@ Данные были удалены в результате другой операции; неактуальные изменения не восстановлены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Var döpt bort av en annan operation; föråldrade ändringar återställdes inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังข้อมูล %@ ถูกลบออกโดยการดำเนินการอื่น; การเปลี่ยนแปลงที่ล้าสมัยไม่ได้ถูกกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo %@ Başka bir operasyonla silindi; eski değişiklikler geri getirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторій %@ Дане дане було видалено під час іншої операції; застарілі зміни не відновлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báu kho dữ liệu %@ Được xóa bởi một thao tác khác; các thay đổi lỗi không được khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码仓库 %@ 该操作已被另一项操作删除；过时的更改未被恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式碼倉庫 %@ 該操作已被另一項操作刪除；過時的更改未被恢復。"
          }
        }
      }
    },
    "Repository '%@' is not cloned yet — open GitSync.md and clone it first": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@لم يتم استنساخه بعد-افتح GitSync.md وقم باستنساخه أولاً"
          }
        },
        "da": {
          "stringUnit": {
