    "That commit is already on the remote, so it can't be undone here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ commit موجود بالفعل على remote، لذا لا يمكن التراجع عنه هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det commit er allerede på remote, så det kan ikke fortrydes her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Commit ist bereits auf dem Remote und kann hier nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese commit ya está en el remoto, así que no se puede deshacer aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit on jo etäpalvelimella, joten sitä ei voi kumota täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce commit est déjà sur le distant, il ne peut donc pas être annulé ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-commit הזה כבר נמצא ב-remote, ולכן אי אפשר לבטל אותו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह commit पहले से remote पर है, इसलिए उसे यहाँ पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a commit már a távolin van, ezért itt nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit itu sudah ada di remote, jadi tidak dapat dibatalkan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel commit è già sul remoto, quindi non può essere annullato qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのコミットはすでにリモートにあるため、ここでは取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 커밋은 이미 원격에 있으므로 여기서 취소할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den commiten er allerede på remote, så den kan ikke angres her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die commit staat al op de remote en kan hier dus niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten commit jest już na zdalnym repozytorium, więc nie można go tu cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse commit já está no remoto, então não pode ser desfeito aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот commit уже на удалённом репозитории, поэтому здесь его не отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den commit finns redan på remote, så den kan inte ångras här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit นั้นอยู่บน remote แล้ว จึงเลิกทำที่นี่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O commit zaten uzakta olduğu için burada geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей commit уже у віддаленому репозиторії, тож тут його не скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit đó đã có trên remote nên không thể hoàn tác ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该提交已在远程上，因此无法在此撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該提交已在遠端上，因此無法在此復原。"
          }
        }
      }
    },
    "That doesn't look like an email address.": {
      "localizations": {
