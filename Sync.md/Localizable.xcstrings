          "stringUnit": {
            "state": "translated",
            "value": "रिपॉजिटरी सिंक्ड नहीं है। कृपया पहले 'pull' या 're-clone' करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "repository nem sincronizálódott. Kérjük, először lekérje vagy újra klonálja a repositoryt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori belum sinkronisasi. Silakan jalankan `pull` atau `re-clone` terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il repository non è stato sincronizzato. Si prega di eseguire prima un pull o un clone nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリは同期されていません。まず、pullまたはre-cloneしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소가 동기화되지 않았습니다. 먼저 pull 또는 re-clone을 수행해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "-repositoriet er ikke synkronisert. Vennligst hent eller klon først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": repository niet gesynchroniseerd. Pull of clone eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repositoriom nie jest synchronizowane. Proszę najpierw wykonać operację pull lub ponowne klonowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O repositório não foi sincronizado. Por favor, execute primeiro o comando `pull` ou `re-clone`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозиторий не синхронизирован. Пожалуйста, выполните операцию pull или повторное клонирование."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repotreget är inte synkroniserat. Var snarare att hämta eller återklona det först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": คลังข้อมูลยังไม่ได้ซิงค์ — กรุณาดึงหรือคลอนใหม่ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "depolama alanı sinkronize edilemedi. Lütfen önce pull veya yeniden klonlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозиторій не синхронізувався. Будь ласка, спочатку виконайте команду «pull» або «re-clone»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Cúp lưu dữ liệu chưa được đồng bộ hóa. Vui lòng thực hiện lệnh `pull` hoặc `re-clone` trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库未同步。请先执行拉取或重新克隆操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倉庫未衕步。請先執行拉取或重新剋隆操作。"
          }
        }
      }
    },
