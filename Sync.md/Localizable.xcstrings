    "Stash a copy first, just in case": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ نسخة في stash أولًا، احتياطًا"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash en kopi først for en sikkerheds skyld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Sicherheit zuerst eine Kopie stashen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda antes una copia en el stash, por si acaso"
          }
        },
