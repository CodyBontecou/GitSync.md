    "iCloud Drive, other apps' folders, or anywhere in Files": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive، أو مجلدات التطبيقات الأخرى، أو أي مكان في Files"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive, mapper fra andre apps eller hvor som helst i Files"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive, Ordner anderer Apps oder beliebige Speicherorte in Files"
          }
