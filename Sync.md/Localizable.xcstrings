    "Add the public key to your host once. Private keys never leave this iPhone's Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف المفتاح العام إلى المضيف مرة واحدة. لا تغادر المفاتيح الخاصة سلسلة مفاتيح هذا الـ iPhone أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj den offentlige nøgle til din vært én gang. Private nøgler forlader aldrig denne iPhones nøglering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den öffentlichen Schlüssel einmal bei Ihrem Host hinzu. Private Schlüssel verlassen nie den Schlüsselbund dieses iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la clave pública a tu host una sola vez. Las claves privadas nunca salen del llavero de este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää julkinen avain palvelimellesi kerran. Yksityiset avaimet eivät koskaan poistu tämän iPhonen Avainnipusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une fois la clé publique à votre hôte. Les clés privées ne quittent jamais le trousseau de cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את המפתח הציבורי למארח פעם אחת. מפתחות פרטיים לעולם לא עוזבים את מחזיק המפתחות של ה-iPhone הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पब्लिक की को अपने होस्ट में एक बार जोड़ें। प्राइवेट की कभी भी इस iPhone के कीचेन से बाहर नहीं जातीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja hozzá egyszer a nyilvános kulcsot a kiszolgálóhoz. A privát kulcsok sosem hagyják el ennek az iPhone-nak a Kulcskarikáját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kunci publik ke host Anda sekali saja. Kunci privat tidak pernah meninggalkan Rantai Kunci iPhone ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una volta la chiave pubblica al tuo host. Le chiavi private non lasciano mai il Portachiavi di questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開鍵をホストに一度追加してください。秘密鍵がこの iPhone のキーチェーンから出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 키를 호스트에 한 번만 추가하십시오. 개인 키는 이 iPhone의 키체인을 벗어나지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til den offentlige nøkkelen hos verten én gang. Private nøkler forlater aldri nøkkelringen på denne iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de publieke sleutel één keer toe aan uw host. Privésleutels verlaten nooit de sleutelhanger van deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj klucz publiczny do hosta raz. Klucze prywatne nigdy nie opuszczają pęku kluczy tego iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a chave pública ao seu host uma vez. Chaves privadas nunca saem das Chaves deste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте открытый ключ на хост один раз. Закрытые ключи никогда не покидают Связку ключей этого iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till den publika nyckeln hos din värd en gång. Privata nycklar lämnar aldrig den här iPhonens nyckelring."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มกุญแจสาธารณะไปยังโฮสต์ของคุณครั้งเดียว กุญแจส่วนตัวจะไม่ออกจากพวงกุญแจของ iPhone เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak anahtarı sunucunuza bir kez ekleyin. Özel anahtarlar bu iPhone'un Anahtar Zinciri'nden asla çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте відкритий ключ на хост один раз. Приватні ключі ніколи не залишають Зв’язку ключів цього iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm khóa công khai vào máy chủ một lần. Khóa riêng tư không bao giờ rời khỏi Chuỗi khóa của iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需将公钥添加到你的主机一次。私钥永远不会离开此 iPhone 的钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需將公鑰加入主機一次。私鑰永遠不會離開此 iPhone 的鑰匙圈。"
          }
        }
      }
    },
