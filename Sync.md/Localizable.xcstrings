          }
        }
      }
    },
    "This will be reflected in git status as a deletion.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينعكس هذا في حالة git كحذف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil blive afspejlet i git-status som en sletning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wird im Git-Status als Löschung angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se reflejará en el estado de git como una eliminación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä heijastuu git- tilassa poistona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": cela se reflétera dans `git status` sous la forme d'une suppression."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– תופתע זה ב-git-status כמחיקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "— यह Git Status में 'deletion' के रूप में प्रतिबिंबित होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ez a Git állapotban törölésként jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal ini akan tercermin dalam status Git sebagai penghapusan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo si rifletterà nel `git status` come una eliminazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "は、git statusで削除として反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "는 Git Status에서 삭제로 반영될 것입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Dette vil reflekteres i Git-status som en sletting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal in de Git-status worden weergegeven als verwijdering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– to będzie oddane w `git status` jako usunięcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Isso será refletido no `git status` como uma exclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это отразится в `git status` как удаление."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Detta kommer att reflekteras i Git-status som en radering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนี้จะสะท้อนใน `git status` ในลักษณะของการลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", git durumu içinde silme işlemi olarak yansıtılacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відображатиметься у `git status` як видалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Điều này sẽ được phản ánh trong git status dưới dạng xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，这将在 Git 状态中体现为删除操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，這將在 Git 狀態中體現爲刪除操作。"
          }
        }
      }
    },
    "This will delete all local files for this repository. This cannot be undone.": {
      "comment": "Alert message warning that removing a repository is permanent",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع الملفات المحلية لهذا المستودع. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle lokale filer for dette repository. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lokalen Dateien dieses Repositories werden gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all local files for this repository. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los archivos locales de este repositorio. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki tämän tietovaraston paikalliset tiedostot. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers locaux de ce dépôt seront supprimés. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק את כל הקבצים המקומיים של מאגר זה. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस रिपॉज़िटरी की सभी स्थानीय फ़ाइलें हट जाएँगी। यह पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel az összes helyi fájl törlődik ebből a tárolóból. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua file lokal untuk repositori ini akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i file locali di questo repository verranno eliminati. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリのローカルファイルがすべて削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소의 모든 로컬 파일이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle lokale filer for dette repositoriet. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lokale bestanden van deze repository worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich lokalnych plików tego repozytorium. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os arquivos locais deste repositório serão excluídos. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все локальные файлы этого репозитория будут удалены. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla lokala filer för detta förråd kommer att raderas. Detta kan inte ångras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบไฟล์ในเครื่องทั้งหมดของ repository นี้ ไม่สามารถยกเลิกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depoya ait tüm yerel dosyalar silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі локальні файли цього репозиторію буде видалено. Цю дію неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa tất cả tệp cục bộ của kho lưu trữ này. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除该仓库的所有本地文件，此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除此儲存庫的所有本機檔案，且無法復原。"
          }
        }
      }
    },
