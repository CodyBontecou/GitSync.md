    "You stay in control": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل أنت المتحكم"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bevarer kontrollen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie behalten die Kontrolle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usted mantiene el control"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinä päätät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gardez le contrôle"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השליטה נשארת בידיך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रण आपके हाथ में"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Önnél marad az irányítás"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tetap memegang kendali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo resta nelle sue mani"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも管理できます"
          }
