    "All conflicts resolved. Continue or abort the rebase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حل جميع التعارضات. متابعة أو إحباط إعادة الأساس."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
