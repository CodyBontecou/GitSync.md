    "The author email is stored in Git history. Use your GitHub noreply address if you want to keep your personal email private.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزن البريد الإلكتروني للمؤلف في سجل Git. استخدم عنوان noreply من GitHub إذا أردت إبقاء بريدك الشخصي خاصًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfatter-e-mailen gemmes i Git-historikken. Brug din GitHub-noreply-adresse, hvis du vil holde din personlige e-mail privat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Autor-E-Mail wird im Git-Verlauf gespeichert. Verwenden Sie Ihre GitHub-noreply-Adresse, wenn Ihre persönliche E-Mail privat bleiben soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El email del autor se guarda en el historial de Git. Usa tu dirección noreply de GitHub si quieres mantener privado tu email personal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekijän sähköposti tallentuu Git-historiaan. Käytä GitHubin noreply-osoitetta, jos haluat pitää henkilökohtaisen sähköpostisi yksityisenä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’e-mail de l’auteur est stocké dans l’historique Git. Utilisez votre adresse noreply GitHub si vous voulez garder votre e-mail personnel privé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דוא״ל המחבר נשמר בהיסטוריית ה-Git. השתמשו בכתובת ה-noreply שלכם ב-GitHub אם ברצונכם לשמור על פרטיות הדוא״ל האישי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक का ईमेल Git इतिहास में संग्रहीत होता है। अपना निजी ईमेल गोपनीय रखना हो तो अपने GitHub noreply पते का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerző e-mail-címe a Git-előzményekben tárolódik. Használja a GitHub noreply címét, ha privát akarja tartani a személyes e-mail-címét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email penulis disimpan dalam riwayat Git. Gunakan alamat noreply GitHub Anda jika ingin menjaga email pribadi tetap privat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'email dell'autore viene salvata nella cronologia Git. Usa il tuo indirizzo noreply di GitHub se vuoi mantenere privata la tua email personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成者のメールアドレスは Git 履歴に保存されます。個人のメールアドレスを非公開にしたい場合は、GitHub の noreply アドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성자 이메일은 Git 기록에 저장됩니다. 개인 이메일을 비공개로 유지하려면 GitHub noreply 주소를 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfatter-e-posten lagres i Git-historikken. Bruk GitHub-noreply-adressen din hvis du vil holde den personlige e-posten privat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het auteurs-e-mailadres wordt in de Git-geschiedenis opgeslagen. Gebruik uw GitHub-noreply-adres als u uw persoonlijke e-mail privé wilt houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail autora jest zapisywany w historii Git. Użyj adresu noreply z GitHuba, jeśli chcesz zachować prywatność swojego e-maila."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O e-mail do autor é armazenado no histórico Git. Use seu endereço noreply do GitHub se quiser manter seu e-mail pessoal privado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Email автора хранится в истории Git. Используйте адрес noreply от GitHub, если хотите сохранить личный email в тайне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Författarens e-post lagras i Git-historiken. Använd din noreply-adress från GitHub om du vill hålla din personliga e-post privat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลผู้เขียนจะถูกเก็บในประวัติ Git ใช้ที่อยู่ noreply ของ GitHub หากต้องการเก็บอีเมลส่วนตัวไว้เป็นความลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazar e-postası Git geçmişinde saklanır. Kişisel e-postanızı gizli tutmak istiyorsanız GitHub noreply adresinizi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Email автора зберігається в історії Git. Використовуйте адресу noreply від GitHub, якщо хочете зберегти особистий email у таємниці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email tác giả được lưu trong lịch sử Git. Hãy dùng địa chỉ noreply của GitHub nếu bạn muốn giữ kín email cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作者邮箱会存储在 Git 历史记录中。如果你想保护个人邮箱的隐私，请使用你的 GitHub noreply 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作者電子郵件會儲存在 Git 歷史記錄中。若想保護個人電子郵件的隱私，請使用你的 GitHub noreply 地址。"
          }
        }
      }
    },
    "The branch moved since that commit, so it can't be undone here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الفرع منذ ذلك الـ commit، لذا لا يمكن التراجع عنه هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenen har flyttet sig siden det commit, så det kan ikke fortrydes her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Branch hat sich seit diesem Commit geändert, daher kann er hier nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rama ha cambiado desde ese commit, así que no se puede deshacer aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haara on edennyt tuon commitin jälkeen, joten sitä ei voi kumota täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche a changé depuis ce commit, il ne peut donc pas être annulé ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הענף התקדם מאז ה-commit הזה, ולכן אי אפשר לבטל אותו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस commit के बाद ब्रांच आगे बढ़ गई, इसलिए उसे यहाँ पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ág azóta elmozdult, ezért ez a commit itt nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch telah berubah sejak commit itu, jadi tidak dapat dibatalkan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il branch è cambiato da quel commit, quindi non può essere annullato qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのコミット以降にブランチが進んだため、ここでは取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 커밋 이후 브랜치가 변경되었으므로 여기서 취소할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenen har flyttet seg siden den commiten, så den kan ikke angres her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De branch is sinds die commit veranderd en kan hier dus niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gałąź zmieniła się od tego commita, więc nie można go tu cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O branch avançou desde esse commit, então ele não pode ser desfeito aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ветка изменилась после этого commit, поэтому здесь его не отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchen har flyttats sedan den commit, så den kan inte ångras här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาขาเปลี่ยนไปตั้งแต่ commit นั้น จึงเลิกทำที่นี่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal o commit'ten beri ilerlediği için burada geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гілка змінилася після цього commit, тож тут його не скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh đã thay đổi kể từ commit đó nên không thể hoàn tác ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该提交之后分支已有变动，因此无法在此撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該提交之後分支已有變動，因此無法在此復原。"
          }
        }
      }
    },
    "The chosen clone location could not be saved. Existing files have been preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ موقع الاستنساخ المحدد. تم الاحتفاظ بالملفات الموجودة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte klonplacering kunne ikke gemmes. Eksisterende filer er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Klon-Speicherort konnte nicht gespeichert werden. Vorhandene Dateien wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la ubicación de clonación elegida. Los archivos existentes se han conservado."
