          }
        }
      }
    },
    "All conflicts resolved. Continue to replay your commits on top of the remote.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حل جميع التعارضات. تابع لإعادة تطبيق عمليات commit الخاصة بك فوق remote."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle konflikter er løst. Fortsæt for at afspille dine commits oven på remote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Konflikte gelöst. Fahren Sie fort, um Ihre Commits auf dem Remote-Stand erneut anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los conflictos resueltos. Continúa para aplicar de nuevo tus commits sobre el remoto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki ristiriidat ratkaistu. Jatka, niin commitisi toistetaan etäversion päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les conflits sont résolus. Continuez pour rejouer vos commits par-dessus le distant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההתנגשויות נפתרו. המשיכו כדי להחיל מחדש את ה-commits שלכם מעל ה-remote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी कॉन्फ़्लिक्ट सुलझ गए। अपने commit को remote के ऊपर फिर से लागू करने के लिए जारी रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden ütközés feloldva. Folytassa, hogy a commitjai a távoli állapot tetejére kerüljenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua konflik teratasi. Lanjutkan untuk memutar ulang commit Anda di atas remote."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i conflitti risolti. Continua per riapplicare i tuoi commit sopra il remoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのコンフリクトを解決しました。続行すると、リモートの上にあなたのコミットを再適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 충돌이 해결되었습니다. 계속하면 원격 위에 커밋을 다시 적용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle konflikter er løst. Fortsett for å spille av commitene dine på toppen av remote."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle conflicten opgelost. Ga verder om uw commits opnieuw toe te passen bovenop de remote."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie konflikty rozwiązane. Kontynuuj, aby odtworzyć Twoje commity na zdalnym repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os conflitos resolvidos. Continue para reaplicar seus commits sobre o remoto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все конфликты разрешены. Продолжите, чтобы применить ваши commit поверх удалённой ветки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla konflikter är lösta. Fortsätt för att spela upp dina commits ovanpå remote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขความขัดแย้งทั้งหมดแล้ว ดำเนินการต่อเพื่อนำ commit ของคุณไปวางต่อบน remote"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm çakışmalar çözüldü. Commit'lerinizi uzak sürümün üzerine yeniden uygulamak için devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі конфлікти розв’язано. Продовжте, щоб застосувати ваші commit поверх віддаленої гілки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã giải quyết mọi xung đột. Tiếp tục để áp dụng lại các commit của bạn lên trên remote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有冲突已解决。继续以在远程版本之上重放你的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有衝突已解決。繼續以在遠端版本之上重新套用你的提交。"
          }
        }
      }
    },
    "All debug log entries will be permanently deleted.": {
      "localizations": {
