          "stringUnit": {
            "state": "translated",
            "value": "Знайдено плагін Obsidian Git"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tìm thấy phần bổ trợ Obsidian Git"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现 Obsidian Git 插件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 Obsidian Git 外掛"
          }
        }
      }
    },
    "Obsidian could not connect. Check that this repository is signed in and its connection request has not expired.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر اتصال Obsidian. تحقق من أن هذا المستودع مسجّل الدخول وأن طلب الاتصال الخاص به لم تنتهِ صلاحيته."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian kunne ikke forbinde. Tjek, at dette repository er logget ind, og at dets forbindelsesanmodning ikke er udløbet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian konnte keine Verbindung herstellen. Prüfen Sie, ob dieses Repository angemeldet ist und seine Verbindungsanfrage nicht abgelaufen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian no pudo conectarse. Comprueba que este repositorio tenga sesión iniciada y que su solicitud de conexión no haya caducado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian ei saanut yhteyttä. Tarkista, että tähän tietovarastoon on kirjauduttu eikä sen yhteyspyyntö ole vanhentunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian n’a pas pu se connecter. Vérifiez que ce dépôt est connecté et que sa demande de connexion n’a pas expiré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian לא הצליח להתחבר. ודאו שהמאגר הזה מחובר ושבקשת החיבור שלו לא פגה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian कनेक्ट नहीं हो सका। जाँचें कि यह रिपॉज़िटरी साइन इन है और इसका कनेक्शन अनुरोध समाप्त नहीं हुआ है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Obsidian nem tudott csatlakozni. Ellenőrizze, hogy ez a tároló be van-e jelentkezve, és a kapcsolódási kérése nem járt-e le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian tidak dapat terhubung. Pastikan repositori ini sudah masuk dan permintaan koneksinya belum kedaluwarsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian non è riuscito a connettersi. Controlla che questo repository abbia l'accesso eseguito e che la sua richiesta di connessione non sia scaduta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian が接続できませんでした。このリポジトリがサインイン済みで、接続リクエストが期限切れになっていないことを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian이 연결할 수 없습니다. 이 저장소에 로그인되어 있고 연결 요청이 만료되지 않았는지 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian kunne ikke koble til. Sjekk at dette repositoriet er pålogget og at tilkoblingsforespørselen ikke er utløpt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian kon geen verbinding maken. Controleer of deze repository is ingelogd en of het verbindingsverzoek niet is verlopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian nie mógł się połączyć. Sprawdź, czy to repozytorium jest zalogowane, a jego żądanie połączenia nie wygasło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Obsidian não conseguiu se conectar. Verifique se este repositório tem login e se a solicitação de conexão não expirou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian не удалось подключиться. Убедитесь, что в этом репозитории выполнен вход и запрос на подключение не истёк."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian kunde inte ansluta. Kontrollera att det här arkivet är inloggat och att dess anslutningsbegäran inte har gått ut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian เชื่อมต่อไม่ได้ ตรวจสอบว่าที่เก็บนี้ลงชื่อเข้าแล้วและคำขอเชื่อมต่อยังไม่หมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian bağlanamadı. Bu depoda oturum açıldığını ve bağlantı isteğinin süresinin dolmadığını denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian не вдалося підключитися. Переконайтеся, що в цьому репозиторії виконано вхід і запит на підключення не закінчився."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian không thể kết nối. Hãy kiểm tra rằng kho lưu trữ này đã đăng nhập và yêu cầu kết nối của nó chưa hết hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian 无法连接。请检查此仓库已登录，且其连接请求未过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian 無法連線。請確認此儲存庫已登入，且其連線請求尚未過期。"
          }
        }
      }
    },
