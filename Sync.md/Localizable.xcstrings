    "Independent, default-off publishing consent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موافقة مستقلة على النشر، متوقفة افتراضيًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uafhængigt samtykke til publicering, slået fra som standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unabhängige Zustimmung zum Veröffentlichen, standardmäßig deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentimiento independiente para publicar, desactivado de forma predeterminada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Erillinen, oletuksena pois käytöstä oleva julkaisusuostumus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentement de publication indépendant, désactivé par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסכמה עצמאית לפרסום, כבויה כברירת מחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतंत्र, डिफ़ॉल्ट रूप से बंद प्रकाशन सहमति।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Független, alapértelmezés szerint kikapcsolt közzétételi hozzájárulás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan publikasi terpisah, nonaktif secara default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenso indipendente alla pubblicazione, disattivato per impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個別の公開同意。デフォルトではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독립적인 게시 동의이며 기본적으로 꺼져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uavhengig samtykke til publisering, av som standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afzonderlijke toestemming voor publiceren, standaard uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezależna zgoda na publikowanie, domyślnie wyłączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentimento independente para publicação, desativado por padrão."
          }
        },
        "ru": {
