          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट ने एक अनुरोध किया। SSH कुंजी है, लेकिन नहीं। SSH उपयोगकर्ता नाम को कॉन्फ़िगर किया गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A távvezérlés kéri a következőt SSH kulcs, de nincs SSH felhasználónév beállítva van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote telah meminta sebuah hal\nKunci SSH , tetapi tidak ada. SSH : nama pengguna telah dikonfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo remoto ha richiesto un\nChiave SSH , ma non presente\nIl nome utente SSH è configurato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモートから要求がありました。 SSH キーは存在しますが、ありません。 SSH のユーザー名は設定済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 원격 시스템이 요청하였습니다. SSH 키가 있으나 없습니다. SSH 사용자 이름이 설정되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernanropen har foreslått et SSH -nyckel, men ikke SSH -brukernavn er konfigurert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De externe systeem heeft een verzoek gedaan SSH -kluis, maar niet\nDe gebruikersnaam SSH is geconfigureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Odległy klient złożył żądanie\nKlucz SSH , ale nie istnieje.\nNazwa użytkownika SSH jest skonfigurowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O dispositivo remoto solicitou algo.\nChave SSH , mas não existe. SSH foi configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": удалённый клиент запросил\nКлюч SSH , но его нет.\nПользовательский идентификатор SSH настроен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjärransökan har begått en ansökan. SSH -skyddande nyckel, men inte finns. SSH -användarnamn är konfigurerat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ระบบระยะไกลได้ส่งคำขอ SSH คีย์ มีอยู่แต่ไม่มี SSH : ชื่อผู้ใช้ได้รับการกำหนดค่าแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uzaktan arayış bir işlemi talep etti. SSH anahtarı var, ancak bulunmuyor. SSH kullanıcı adı yapılandırılmıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистанційний пристрій запросив\nКлюч SSH , але немає.\nПользовательське ім'я SSH налаштоване."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thiết bị từ xa đã yêu cầu\nChìa khóa SSH , nhưng không có.\nTên người dùng SSH đã được cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程请求了 SSH 密钥，但不存在。 SSH 用户名已配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠程請求了 SSH 密鑰，但不存在 SSH 用戶名已配置。"
          }
        }
      }
    },
