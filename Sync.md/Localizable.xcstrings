    "GitHub did not authorize Push Sync. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يأذن GitHub لـ Push Sync. يُرجى المحاولة مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub godkendte ikke Push Sync. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat Push Sync nicht autorisiert. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no autorizó Push Sync. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
