    "Deletion is pending. Background Sync and conflicting relay controls remain disabled until the authenticated removal succeeds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف معلّق. يظل Background Sync وعناصر تحكم المُرحِّل المتعارضة معطّلة حتى تنجح الإزالة الموثّقة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletning afventer. Background Sync og modstridende relæfunktioner er fortsat deaktiveret, indtil den godkendte fjernelse lykkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung steht aus. Background Sync und damit in Konflikt stehende Relay-Steuerelemente bleiben deaktiviert, bis die authentifizierte Entfernung erfolgreich ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación está pendiente. Background Sync y los controles del relé que entran en conflicto seguirán desactivados hasta que la eliminación autenticada se complete correctamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poisto odottaa. Background Sync ja ristiriitaiset välityspalvelun säätimet pysyvät poissa käytöstä, kunnes todennettu poisto onnistuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression est en attente. Background Sync et les commandes de relais incompatibles restent désactivés jusqu’à la réussite de la suppression authentifiée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחיקה ממתינה. Background Sync ופקדי ממסר מתנגשים נשארים מושבתים עד שההסרה המאומתת תצליח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिटाना लंबित है। प्रमाणित निष्कासन सफल होने तक Background Sync और परस्पर-विरोधी रिले नियंत्रण बंद रहेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törlés függőben van. A Background Sync és az ütköző továbbítóvezérlők mindaddig letiltva maradnak, amíg a hitelesített eltávolítás sikerrel nem jár."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan tertunda. Background Sync dan kontrol relay yang berkonflik tetap dinonaktifkan sampai penghapusan terautentikasi berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione è in sospeso. Background Sync e i controlli relay in conflitto restano disattivati finché la rimozione autenticata non riesce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除は保留中です。認証済みの削除が完了するまで、Background Sync と競合する relay コントロールは無効のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제가 대기 중입니다. 인증된 삭제가 완료될 때까지 Background Sync 및 충돌하는 릴레이 제어 기능은 비활성화된 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettingen venter. Background Sync og relekontroller som er i konflikt, forblir deaktivert til den autentiserte fjerningen lykkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdering is in behandeling. Background Sync en conflicterende relaybediening blijven uitgeschakeld totdat de geauthenticeerde verwijdering is geslaagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwanie oczekuje na wykonanie. Background Sync i kolidujące z nim elementy sterujące usługi pośredniczącej pozostaną wyłączone do czasu pomyślnego uwierzytelnionego usunięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão está pendente. O Background Sync e os controles conflitantes do retransmissor permanecem desativados até que a remoção autenticada seja concluída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление ожидает выполнения. Background Sync и конфликтующие элементы управления ретранслятором останутся выключенными до успешного аутентифицированного удаления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderingen väntar. Background Sync och motstridiga reläkontroller förblir avstängda tills den autentiserade borttagningen lyckas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบกำลังรอดำเนินการ Background Sync และตัวควบคุมรีเลย์ที่ขัดแย้งกันจะยังคงปิดใช้จนกว่าการนำออกที่ผ่านการตรวจสอบสิทธิ์จะสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme işlemi bekliyor. Kimliği doğrulanmış kaldırma işlemi başarılı olana kadar Background Sync ve çakışan aktarıcı denetimleri devre dışı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення очікує на виконання. Background Sync і конфліктні елементи керування ретранслятором залишатимуться вимкненими, доки автентифіковане видалення не завершиться успішно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu xóa đang chờ xử lý. Background Sync và các tùy chọn điều khiển chuyển tiếp xung đột vẫn bị tắt cho đến khi quá trình xóa có xác thực hoàn tất thành công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除操作待处理。在通过身份验证的移除成功前，Background Sync 和有冲突的中继控制项仍将停用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除作業待處理。在通過身分驗證的移除成功前，Background Sync 和有衝突的中繼控制項仍將停用。"
          }
        }
      }
    },
