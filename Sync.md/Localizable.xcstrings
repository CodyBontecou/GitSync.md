    "Could not stage local file changes before push.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إجراء تغييرات على الملف المحلي قبل الدفع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke iscenesætte lokale filændringer før push."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Dateiänderungen konnten vor dem Push nicht bereitgestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar los cambios del archivo local antes de la inserción."
          }
        },
        "fi": {
