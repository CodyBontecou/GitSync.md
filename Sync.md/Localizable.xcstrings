          "stringUnit": {
            "state": "translated",
            "value": "Folder lokal Di iPhone Saya dan file biasa hingga 10 MiB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle locali Su iPhone e file normali fino a 10 MiB."
          }
        },
        "ja": {
          "stringUnit": {
