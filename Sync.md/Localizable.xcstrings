    "Create an ed25519 key here, then add its public half to your host.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ مفتاح ed25519 هنا، ثم أضف نصفه العام إلى المضيف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ed25519-nøgle her, og tilføj derefter dens offentlige del til din vært."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie hier einen ed25519-Schlüssel und fügen Sie dann seine öffentliche Hälfte bei Ihrem Host hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea aquí una clave ed25519 y luego añade su parte pública a tu host."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo ed25519-avain täällä ja lisää sen julkinen osa palvelimellesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez ici une clé ed25519, puis ajoutez sa partie publique à votre hôte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צרו כאן מפתח ed25519, ואז הוסיפו את החצי הציבורי שלו למארח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ एक ed25519 की बनाएँ, फिर उसका पब्लिक हिस्सा अपने होस्ट में जोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzon létre itt egy ed25519 kulcsot, majd adja hozzá a nyilvános felét a kiszolgálóhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat kunci ed25519 di sini, lalu tambahkan bagian publiknya ke host Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea qui una chiave ed25519, poi aggiungi la sua parte pubblica al tuo host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで ed25519 鍵を作成し、その公開鍵をホストに追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 ed25519 키를 만든 뒤 공개 키를 호스트에 추가하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en ed25519-nøkkel her, og legg deretter til den offentlige delen hos verten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak hier een ed25519-sleutel en voeg daarna het publieke deel toe aan uw host."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz tu klucz ed25519, a potem dodaj jego część publiczną do hosta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma chave ed25519 aqui e adicione a metade pública ao seu host."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте здесь ключ ed25519, затем добавьте его открытую часть на хост."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en ed25519-nyckel här och lägg sedan till dess publika del hos din värd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างกุญแจ ed25519 ที่นี่ แล้วเพิ่มส่วนสาธารณะไปยังโฮสต์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bir ed25519 anahtarı oluşturun, ardından ortak yarısını sunucunuza ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть тут ключ ed25519, потім додайте його відкриту частину на хост."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo khóa ed25519 tại đây, rồi thêm nửa công khai của nó vào máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里创建 ed25519 密钥，然后将其公钥添加到你的主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡建立 ed25519 密鑰，然後將其公鑰加入你的主機。"
          }
        }
      }
    },
