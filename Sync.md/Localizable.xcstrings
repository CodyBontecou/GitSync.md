    "Author Email is required before Git can create commits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب البريد الإلكتروني للمؤلف قبل أن يتمكن Git من إنشاء الالتزامات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Author Email er påkrævet, før Git kan oprette commits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse des Autors ist erforderlich, bevor Git Commits erstellen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere el correo electrónico del autor antes de que Git pueda crear confirmaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekijä Sähköposti vaaditaan ennen kuin Git voi luoda sitoumuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auteur L&#39;email est requis avant Git peut créer des commits."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– 이메יל של המחבר מצריך להתקיים לפני הפעולה. Git יכול ליצור קומיטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": लेखक का ईमेल पहले आवश्यक है। Git कमिट्स बना सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Az author e-mail címének bejegyzése előre kötelező. Git képes commitek létrehozására."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Email penulis wajib diisi sebelumnya. Git dapat membuat commit."
          }
        },
        "it": {
