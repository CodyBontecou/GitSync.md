    "The merge stopped. Pick a version for each file to finish it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الدمج. اختر نسخة لكل ملف لإكماله."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge stoppede. Vælg en version for hver fil for at afslutte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Merge wurde angehalten. Wählen Sie für jede Datei eine Version, um ihn abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El merge se detuvo. Elige una versión de cada archivo para terminarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge pysähtyi. Valitse versio jokaiselle tiedostolle viimeistelläksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le merge s’est arrêté. Choisissez une version pour chaque fichier pour le terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-merge נעצר. בחרו גרסה לכל קובץ כדי לסיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge रुक गया। इसे पूरा करने के लिए हर फ़ाइल का एक संस्करण चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A merge leállt. A befejezéshez válasszon egy verziót minden fájlhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge berhenti. Pilih versi untuk setiap file untuk menyelesaikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il merge si è interrotto. Scegli una versione per ogni file per completarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージが停止しました。完了するには各ファイルのバージョンを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합이 중단되었습니다. 완료하려면 각 파일의 버전을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge stoppet. Velg en versjon for hver fil for å fullføre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De merge is gestopt. Kies voor elk bestand een versie om hem af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge został zatrzymany. Wybierz wersję każdego pliku, aby go dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O merge parou. Escolha uma versão de cada arquivo para concluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge остановлен. Выберите версию для каждого файла, чтобы завершить его."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge stoppades. Välj en version för varje fil för att slutföra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "merge หยุดลง เลือกเวอร์ชันของแต่ละไฟล์เพื่อทำให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge durdu. Tamamlamak için her dosya için bir sürüm seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge зупинено. Виберіть версію для кожного файлу, щоб завершити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge đã dừng. Chọn một phiên bản cho mỗi tệp để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并已停止。请为每个文件选择一个版本以完成合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併已停止。請為每個檔案選擇一個版本以完成合併。"
          }
        }
      }
    },
    "The origin remote changed before push. Publication was stopped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر origin remote قبل إجراء push. تم إيقاف النشر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "origin-remoten blev ændret før push. Publiceringen blev stoppet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der origin-Remote wurde vor dem Push geändert. Das Veröffentlichen wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El remoto origin cambió antes del push. Se detuvo la publicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "origin-remote muuttui ennen pushia. Julkaiseminen pysäytettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt distant origin a changé avant le push. La publication a été interrompue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה־remote ‏origin השתנה לפני ה־push. הפרסום הופסק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "push से पहले origin remote बदल गया। प्रकाशन रोक दिया गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az origin távoli tárhelye megváltozott a push előtt. A közzétételt leállítottuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote origin berubah sebelum push. Publikasi dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il remoto origin è cambiato prima del push. La pubblicazione è stata arrestata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "push の前に origin リモートが変更されました。公開を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "push 전에 origin remote가 변경되었습니다. 게시를 중단했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "origin-remoten ble endret før push. Publiseringen ble stoppet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De origin-remote is vóór de push gewijzigd. Publiceren is gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne repozytorium origin zmieniło się przed wykonaniem push. Publikowanie zatrzymano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O remoto origin mudou antes do push. A publicação foi interrompida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote origin изменился до push. Публикация остановлена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "origin-remote ändrades före push. Publiceringen stoppades."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "remote origin เปลี่ยนแปลงก่อน push การเผยแพร่จึงหยุดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "origin uzak deposu push’tan önce değişti. Yayımlama durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддалений репозиторій origin змінився перед виконанням push. Публікування зупинено."
          }
        },
        "vi": {
