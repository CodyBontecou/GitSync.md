        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue note sono al sicuro su questo iPhone. Non è andato perso nulla. 1 vault è in attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートはこの iPhone に安全に残っています。何も失われていません。1 個の保管庫が待機中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트는 이 iPhone에 안전하게 있습니다. 잃은 것은 없습니다. 보관함 1개가 대기 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatene dine er trygge på denne iPhonen. Ingenting gikk tapt. 1 hvelv venter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw notities zijn veilig op deze iPhone. Er is niets verloren. 1 kluis wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki są bezpieczne na tym iPhonie. Nic nie zostało utracone. 1 sejf czeka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas notas estão seguras neste iPhone. Nada foi perdido. 1 cofre está aguardando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши заметки в безопасности на этом iPhone. Ничего не потеряно. 1 хранилище ждёт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina anteckningar är säkra på den här iPhonen. Inget gick förlorat. 1 valv väntar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตของคุณปลอดภัยบน iPhone เครื่องนี้ ไม่มีอะไรสูญหาย มี 1 vault รออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlarınız bu iPhone'da güvende. Hiçbir şey kaybolmadı. 1 kasa bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші нотатки в безпеці на цьому iPhone. Нічого не втрачено. 1 сховище чекає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú của bạn an toàn trên iPhone này. Không có gì bị mất. 1 vault đang chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的笔记安全地保存在此 iPhone 上。没有任何丢失。1 个库正在等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的筆記安全地保存在此 iPhone 上。沒有任何遺失。1 個保險庫正在等待。"
          }
        }
      }
    },
