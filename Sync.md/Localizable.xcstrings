    "GitHub API rate limit exceeded. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub تم تجاوز الحد الأقصى لمعدل واجهة برمجة التطبيقات (API). حاول مرة أخرى لاحقًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub API-hastighedsgrænse overskredet. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub API-Ratenbegrenzung überschritten. Versuchen Sie es später noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Se excedió el límite de tasa API. Vuelve a intentarlo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub API-nopeusraja ylittyi. Yritä myöhemmin uudestaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub limite de taux API dépassée. Essayez à nouveau plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub נפחת; נסה שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub API दर सीमा को पार किया गया है। बाद में फिर से कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub API sebességkorlát meghaladásához vezetett. Kérem, újra próbálja az operációt később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : Batas limit API telah terlampaui. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : il limite di frequenza dell'API è stato superato. Riprova in un momento successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : APIのレート制限を超えました。後で再度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub API의 레이트 제한을 초과했습니다. 이후 다시 시도해 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : API-tilgangsbegrensning overskredet. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : de API-ratebeperking is overschreden. Probeer later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub przekroczony. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : limite de taxa da API excedido. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : ограничение скорости API превышено. Попробуйте повторить попытку позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : API:s hastighetsbegränsning har överskridits. Pröva igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : จำนวนการเรียกใช้ API ถึงขีดจำกัดแล้ว กรุณาลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub API oran sınırlaması aşıldı. Daha sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : обмеження швидкості API перевищено. Спробуйте знову пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : Giới hạn tốc độ API đã bị vượt quá. Vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ：API 请求速率限制已达到上限。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
