          "stringUnit": {
            "state": "translated",
            "value": "سيظهر المجلد وكل ما فيه في git status كمحذوف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen og alt i den vises som slettet i git status."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner und sein gesamter Inhalt erscheinen in git status als gelöscht."
