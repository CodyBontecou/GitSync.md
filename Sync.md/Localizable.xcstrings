    },
    "System follows your iPhone's Light or Dark setting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع النظام إعداد الوضع الفاتح أو الداكن في الـ iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "System følger din iPhones indstilling for Lys eller Mørk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Hell- oder Dunkel-Einstellung Ihres iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema sigue el ajuste Claro u Oscuro de tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä seuraa iPhonesi Vaalea- tai Tumma-asetusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit le réglage Clair ou Sombre de votre iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מערכת עוקב אחר הגדרת המצב הבהיר או הכהה של ה-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम आपके iPhone की हल्की या गहरी सेटिंग का पालन करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Rendszer az iPhone Világos vagy Sötét beállítását követi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengikuti pengaturan Terang atau Gelap iPhone Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue l'impostazione Chiaro o Scuro del tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」は iPhone のライト/ダーク設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템은 iPhone의 라이트 또는 다크 설정을 따릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "System følger iPhonens innstilling for Lys eller Mørk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeem volgt de instelling Licht of Donker van uw iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemowy wygląd podąża za ustawieniem Jasny lub Ciemny Twojego iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue o ajuste Claro ou Escuro do seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системное» следует светлой или тёмной настройке вашего iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "System följer iPhonens inställning för Ljust eller Mörkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะใช้ตามการตั้งค่าสว่างหรือมืดของ iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, iPhone'unuzun Açık veya Koyu ayarını izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
