    "The destination repository already has history. First publication requires an empty repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستودع الوجهة يحتوي على سجل بالفعل. يتطلب النشر الأول مستودعًا فارغًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinationsrepositoryet har allerede historik. Første udgivelse kræver et tomt repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel-Repository hat bereits einen Verlauf. Die erste Veröffentlichung erfordert ein leeres Repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio de destino ya tiene historial. La primera publicación requiere un repositorio vacío."
