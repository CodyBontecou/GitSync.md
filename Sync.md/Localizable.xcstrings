            "value": "Húzza le a frissítéshez, vagy előbb hozzon létre tárolót a GitHubon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik ke bawah untuk menyegarkan, atau buat repositori di GitHub terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
