    "Star a repository on GitHub and pull down to refresh.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميّز مستودعًا بنجمة على GitHub ثم اسحب للأسفل للتحديث."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stjernemarkér et repository på GitHub, og træk ned for at opdatere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie ein Repository auf GitHub mit einem Stern und ziehen Sie zum Aktualisieren nach unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un repositorio como destacado en GitHub y desliza hacia abajo para actualizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tietovarasto tähtiin GitHubissa ja päivitä vetämällä alas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dépôt aux favoris sur GitHub et tirez vers le bas pour actualiser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמנו מאגר בכוכב ב-GitHub ומשכו למטה לרענון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub पर किसी रिपॉज़िटरी को स्टार करें और रीफ़्रेश करने के लिए नीचे खींचें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csillagozzon meg egy tárolót a GitHubon, majd húzza le a frissítéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri bintang pada repositori di GitHub dan tarik ke bawah untuk menyegarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una stella a un repository su GitHub e trascina in basso per aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub でリポジトリにスターを付けてから、引き下げて更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 저장소에 별표를 표시한 후 아래로 당겨 새로 고치십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stjernemerk et repositorium på GitHub og dra ned for å oppdatere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een repository een ster op GitHub en trek omlaag om te vernieuwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz repozytorium gwiazdką na GitHubie i przeciągnij w dół, aby odświeżyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê estrela em um repositório no GitHub e puxe para baixo para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте репозиторий звездой на GitHub и потяните вниз для обновления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stjärnmärk ett arkiv på GitHub och dra nedåt för att uppdatera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดดาวที่เก็บบน GitHub แล้วดึงลงเพื่อรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'da bir depoya yıldız verin ve yenilemek için aşağı çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте репозиторій зірочкою на GitHub і потягніть униз, щоб оновити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gắn sao một kho lưu trữ trên GitHub rồi kéo xuống để làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 上为仓库加星标，然后下拉刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 上為儲存庫加星號，然後向下拉以重新整理。"
          }
        }
      }
    },
