            "value": "リモートの変更を取得して適用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 변경사항 가져와서 적용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent og bruk fjernendringer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe wijzigingen ophalen en toepassen"
          }
        },
        "pl": {
