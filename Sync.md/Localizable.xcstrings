    "SSH host key verification failed for %@. Configure this repository with SSH key credentials or use HTTPS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH  %@: تهيئة هذا المخزن باستخدام\nيُشترط استخدام بيانات المفتاح SSH أو استخدام HTTPS.\nفشلت عملية التحقق من مفتاح المضيف في"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH er mislykket. %@. Konfigurer dette repository med SSH – brug nøgleoplysninger eller brug HTTPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ist fehlgeschlagen. %@. Konfigurieren Sie dieses Repository mit\nVerwenden Sie die Schlüsselzugangsdaten für SSH oder verwenden Sie HTTPS.\nDie Verifizierung der Host-Schlüssel für"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH no se completó correctamente para %@. Configure este repositorio con SSH o utilice HTTPS.\nLa verificación de la clave del host"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH -hostin avaintarkistus epäonnistui. %@: Konfiguroida tämä tallennusjärjestelmä seuraavien tiedoiksi: SSH -avainpalvelut tai käytä HTTPS-protokollaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH a échoué. %@. Configurez ce dépôt avec SSH ou utilisez HTTPS.\nLa vérification de la clé hôte pour"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH נכשל עבור %@– תגדיר את המאגר הזה באמצעות SSH תאימות מפתח או שימוש ב-HTTPS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH के लिए होस्ट की की सत्यापन असफल रहा। %@– इस रिपॉजिटरी को निम्नलिखित साथ सेट करें: SSH कुंजी प्रमाणनों का उपयोग करें या HTTPS का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH eszközkulcs ellenőrzése nem sikerült. %@: konfigurálja ezt a repozitóriót SSH kulcsi hitelesítő adatok használata vagy HTTPS használata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH gagal untuk %@. Konfigurasi repositori ini dengan SSH : gunakan kredensial kunci atau gunakan HTTPS.\nVerifikasi kunci host"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH non è stata eseguita con successo per %@. Configura questo repository con SSH o utilizzare HTTPS.\nLa verifica della chiave host di"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ：ホストキー検証に失敗しました。 %@：このリポジトリを以下で構成します。 SSH のキー認証情報を使用するか、またはHTTPSを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 호스트 키 검증에 실패했습니다. %@: 이 저장소를 다음과 같이 구성하십시오. SSH 키 인증 정보를 사용하거나 HTTPS를 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH : Verifisering av host-sjekk nøkkelen mislyktes for %@. Konfigurer dette repotremet med SSH – bruk nøkkelopplysninger eller bruk HTTPS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH is mislukt. %@. Configure deze repository met SSH : gebruik sleutelgegevens of gebruik HTTPS.\nDe verificatie van de hostkey voor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH nie powiodło się. %@– Konfiguruj ten repositorium za pomocą\nKluczowe dane logowania SSH lub użycie HTTPS.\nSprawdzenie klucza hosta dla"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH falhou para %@. Configure este repositório com SSH ou use HTTPS.\nA verificação da chave do host"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH не удалась. %@. Настройте этот репозиторий с помощью следующего: SSH необходимо использовать учетные данные или использовать HTTPS.\nПроверка хост-ключа"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH : verifiering av huvudnyckeln misslyckades för %@. Konfigurer detta repotre med SSH – använd nyckelautentiseringsuppgifter eller använd HTTPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH : การตรวจสอบกุญแจโฮสต์ล้มเหลวสำหรับ %@: กำหนดค่ารีโพซิทอรี่นี้ด้วย SSH ใช้ข้อมูลประจำตัวสำคัญหรือใช้ HTTPS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH için sunucu anahtarı doğrulaması başarısız oldu. %@: Bu depoyu aşağıdakiyle yapılandırın. SSH anahtar kimlik bilgilerini kullanın veya HTTPS'yi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH не вдалося для %@. Конфігуруйте цей репозиторій за допомогою\nДля ключа SSH необхідні авторизаційні дані або використовуйте HTTPS.\nПідтвердження ключа хоста для"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH : Xác minh khóa máy chủ đã thất bại cho %@. Cấu hình kho lưu trữ này với SSH : Vui lòng sử dụng thông tin đăng nhập khóa hoặc dùng HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 主机密钥验证失败 %@：使用以下方式配置此存储库 SSH ：请使用密钥凭证或使用HTTPS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 主機密鑰驗証失敗 %@：使用以下方式配置此存儲庫 SSH ：請使用密鑰憑証或啟用HTTPS。"
          }
        }
      }
    },
    "SSH host key verification failed for %@. The server did not provide a SHA-256 host-key fingerprint.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH  %@: لم يُقدِم الخادم على توفير شيء. SHA-256 : بصمة المفتاح الخاص بالمضيف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH : Verifikation af host-s nøgle mislykkedes for %@. Serveren provided ikke noget. SHA-256 – host-key fingerpræmie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ist fehlgeschlagen. %@. Der Server hat keine bereitgestellt. SHA-256 -Host-Schlüssel-Fingerabdruck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH falló para: %@. El servidor no proporcionó un SHA-256 Firma digital de la clave del host."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH -hostin avainverifiointi epäonnistui. %@– palvelin ei tarjonnut mitään. SHA-256 -hostin avainpinnoite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH a échoué. %@. Le serveur n'a pas fourni de SHA-256 empreinte digitale de clé d'hôte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH נכשל עבור %@– הסר버 לא מספק SHA-256 – טביעת מפתח המארח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH के लिए होस्ट कुंजी सत्यापन असफल रहा। %@। सर्वर ने कोई आउटपुट प्रदान नहीं किया। SHA-256 होस्ट-की फिंगरप्रिंट।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH eszközkulcs ellenőrzése nem sikerült. %@: A szerver nem adott meg egyet. SHA-256 : host kulcs függőleges képzeleti nyomata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH gagal untuk %@. Server tidak memberikan sesuatu. SHA-256 – sidik jari host-key.\nKunci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH non è stata completata per: %@. Il server non ha fornito un SHA-256 Fingerprint della chiave ospite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ：ホストキー検証に失敗しました。 %@：サーバーからデータが提供されませんでした。 SHA-256 ホストキーの指紋情報。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 호스트 키 검증에 실패했습니다. %@. 서버가 제공하지 않았습니다. SHA-256 호스트 키 지문."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH : Verifisering av host-sjekk er mislykket for %@. Serveren tilbød ikke noe. SHA-256 -hoster-skjelkefingeravtrykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH is mislukt. %@. De server heeft geen informatie verstrekt. SHA-256 host-sleutelafdruk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH nie powiodło się. %@. Serwer nie dostarczył odpowiedzi. SHA-256 – ślad klucza hosta.\nKlucz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH falhou para %@. O servidor não forneceu um SHA-256 Fingerprint da chave do hospedeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH не удалась для %@. Сервер не предоставил данных. SHA-256 Отпечаток ключа хоста."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH : verifiering av huvudnyckeln misslyckades för %@. Servern gav inte något. SHA-256 -hostnyckelfingeravtryck."
          }
        },
        "th": {
