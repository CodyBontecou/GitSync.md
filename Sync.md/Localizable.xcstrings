          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merke som løst?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Markeer als opgelost?"
          }
        },
        "pl": {
          "stringUnit": {
