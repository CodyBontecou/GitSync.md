          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remote meminta kredensial HTTPS, tetapi tidak ada token maupun kata sandi yang disimpan untuk repositori ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
