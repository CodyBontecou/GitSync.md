            "state": "translated",
            "value": "לא הצלחנו לגשת ל目录 שנבחר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": चयनित फोल्डर तक पहुँच नहीं हो सकी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A kiválasztott mappához nem tudtunk hozzáférni"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengakses folder yang dipilih"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile accedere alla cartella selezionata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：選択したフォルダにアクセスできませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 선택된 폴더에 접근할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kunne ikke få tilgang til den valgte mappen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kan de geselecteerde map niet bereiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uzyskać dostępu do wybranego katalogu"
          }
        },
        "pt-BR": {
