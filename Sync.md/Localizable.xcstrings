          "stringUnit": {
            "state": "translated",
            "value": "Apri Obsidian al mattino e trovi già tutto lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝 Obsidian を開けば、すべてがそろっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침에 Obsidian을 열면 모든 것이 이미 준비되어 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
