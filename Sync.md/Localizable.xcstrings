            "value": "Récupérer et appliquer les modifications distantes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלוף והחל שינויים מרחוק"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट बदलाव प्राप्त करें और लागू करें"
          }
        },
        "hu": {
          "stringUnit": {
