    "Sign in to the GitHub account selected for this publication. It will not be sent to a different account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى حساب GitHub المحدد لهذا النشر. لن يُرسل إلى حساب آخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på den GitHub-konto, der er valgt til denne udgivelse. Den sendes ikke til en anden konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich mit dem für diese Veröffentlichung gewählten GitHub-Konto an. Sie wird nicht an ein anderes Konto gesendet."
          }
        },
        "es": {
