    "GitHub authentication is selected, but no GitHub token is saved. Sign in again or reconnect GitHub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ، لكن لا يوجد خيار مماثل.\nتم حفظ الرمز GitHub ؛ يُرجى تسجيل الدخول مجددًا أو إعادة الاتصال.\nرمز GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub er valgt, men ikke aktiviseret. GitHub -token er gemt. Log ind igen eller forbind dig igen. GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ist die Authentifizierung aktiviert, jedoch nicht verfügbar.\nDer GitHub -Token wurde gespeichert. Bitte melden Sie sich erneut an oder verbinden Sie sich erneut. GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub , pero no está disponible.\nEl token GitHub se ha guardado. Inicie sesión nuevamente o reconecte. GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub -todistusvalinta on valittu, mutta ei ole käytössä. GitHub -tokki tallennettiin. Kirjautu kerran uudelleen tai reititä uudelleen. GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub est sélectionnée, mais aucune n'est disponible.\nLe jeton GitHub a été enregistré. Connectez-vous à nouveau ou reconnectez-vous. GitHub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub נבחרת, אך לא קיימת.\nהטוקן GitHub נשמר. היכנס שוב או חיבור מחדש GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub प्रमाणीकरण को चुना गया है, लेकिन कोई नहीं। GitHub टोकन सहेजा गया है। कृपया फिर से साइन इन करें या पुनः कनेक्शन स्थापित करें। GitHub."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ellenőrzés kiválasztva van, de nincs ilyen lehetőség.\nA GitHub token mentve lett. Visszatérjenek be vagy újra kapcsolódjanak! GitHub."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub telah dipilih, tetapi tidak tersedia.\nToken GitHub telah disimpan. Silakan masuk kembali atau hubungkan kembali.\nToken GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub è selezionata l'autenticazione, ma non è attiva.\nIl token GitHub è stato salvato. Accedi nuovamente o riconnettiti. GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 認証が選択されていますが、有効ではありません。 GitHub トークンが保存されました。再ログインまたは再接続してください。 GitHub."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 인증 옵션이 선택되었으나, 활성화되지 않았습니다. GitHub 토큰이 저장되었습니다. 다시 로그인하거나 다시 연결하세요. GitHub."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub er valgt, men ikke tilgjengelig. GitHub -token er lagret. Logg inn igjen eller forbind deg på nytt. GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub is authenticatie geselecteerd, maar er is geen\nDe GitHub -token is opgeslagen. Log u opnieuw in of verbinding herstellen. GitHub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub została wybrana, ale nie jest włączone.\nToken GitHub został zapisany. Zaloguj się ponownie lub ponownie połącz się z systemem. GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub foi selecionada, mas não está disponível.\nO token GitHub foi salvo. Faça login novamente ou recupere a conexão. GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub выбрана аутентификация, но её не существует.\nТокен GitHub сохранён. Пожалуйста, войдите в систему заново или восстановите подключение. GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub -autentisering är vald, men inte tillgänglig. GitHub -token sparats. Logga in igen eller koppla till nätet på nytt. GitHub."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ใช้การยืนยันตัวตน แต่ไม่มี\nโทเคน GitHub ถูกบันทึกเรียบร้อยแล้ว กรุณาเข้าสู่ระบบอีกครั้งหรือเชื่อมต่อใหม่ GitHub."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kimlik doğrulaması seçildi ancak yoktur. GitHub token kaydedildi. Yeniden giriş yapın veya yeniden bağlanın. GitHub."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub вибрано автентифікацію, але її немає.\nТокен GitHub збережено. Вхід повторно або підключення знову. GitHub."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub đã được chọn nhưng không có.\nToken GitHub đã được lưu. Vui lòng đăng nhập lại hoặc kết nối lại. GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 认证选项已选中，但未启用。 GitHub 令牌已保存。请重新登录或重新连接。 GitHub."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 認証選項已選中，但未啟用。 GitHub 令牌已保存。請重新登録或重新連接。 GitHub."
          }
        }
      }
    },
    "GitHub can’t find this repo for your account. It may have moved or your access changed.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع GitHub العثور على هذا المستودع لحسابك. ربما نُقل أو تغيّرت صلاحيات وصولك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan ikke finde dette repository for din konto. Det kan være flyttet, eller din adgang kan være ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub findet dieses Repository für Ihr Konto nicht. Es wurde möglicherweise verschoben oder Ihre Zugriffsrechte haben sich geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no encuentra este repositorio para tu cuenta. Puede que se haya movido o que tu acceso haya cambiado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ei löydä tätä tietovarastoa tilillesi. Se on ehkä siirretty tai käyttöoikeutesi ovat muuttuneet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ne trouve pas ce dépôt pour votre compte. Il a peut-être été déplacé ou vos droits d’accès ont changé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub לא מוצא את המאגר הזה עבור החשבון שלכם. ייתכן שהוא הועבר או שהרשאות הגישה השתנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub को आपके खाते के लिए यह रिपॉज़िटरी नहीं मिल रही है। इसे कहीं और ले जाया गया हो सकता है या आपकी पहुँच बदल गई हो सकती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub nem találja ezt a tárolót az Ön fiókjával. Lehet, hogy áthelyezték, vagy megváltoztak a hozzáférési jogai."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub tidak menemukan repositori ini untuk akun Anda. Repositori mungkin dipindahkan atau akses Anda berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non trova questo repository per il tuo account. Potrebbe essere stato spostato o i tuoi permessi potrebbero essere cambiati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub で、このアカウントからアクセスできるリポジトリが見つかりません。移動されたか、アクセス権が変更された可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 이 계정으로 접근할 수 있는 저장소를 찾을 수 없습니다. 저장소가 이동했거나 접근 권한이 변경되었을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub finner ikke dette repositoriet for kontoen din. Det kan ha blitt flyttet, eller tilgangen din kan ha blitt endret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan deze repository niet vinden voor je account. Mogelijk is hij verplaatst of is je toegang gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nie znajduje tego repozytorium dla Twojego konta. Mogło zostać przeniesione lub Twoje uprawnienia się zmieniły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não encontra este repositório para sua conta. Ele pode ter sido movido ou seu acesso pode ter mudado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не находит этот репозиторий для вашей учётной записи. Возможно, он перемещён или ваши права доступа изменились."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hittar inte detta förråd för ditt konto. Det kan ha flyttats eller din åtkomst kan ha ändrats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ไม่พบรีโพซิทอรีนี้สำหรับบัญชีของคุณ อาจมีการย้ายรีโพซิทอรีหรือเปลี่ยนสิทธิ์เข้าถึงของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub bu depoyu hesabınız için bulamıyor. Depo taşınmış veya erişiminiz değişmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не знаходить цей репозиторій для вашого облікового запису. Можливо, його переміщено або ваші права доступу змінилися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub không tìm thấy kho lưu trữ này cho tài khoản của bạn. Kho có thể đã được di chuyển hoặc quyền truy cập của bạn đã thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 找不到你的账户可访问的此仓库。仓库可能已被移动，或你的访问权限已更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 找不到你的帳號可存取的此儲存庫。儲存庫可能已被移動，或你的存取權限已變更。"
          }
        }
      }
    },
    "GitHub connection could not be verified. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من اتصال GitHub. يُرجى المحاولة مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-forbindelsen kunne ikke bekræftes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GitHub-Verbindung konnte nicht verifiziert werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la conexión con GitHub. Inténtalo de nuevo."
          }
        },
        "fi": {
