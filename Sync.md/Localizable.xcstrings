    "Manage billing and background syncing anytime in App Settings → Background Sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إدارة الفوترة والمزامنة في الخلفية في أي وقت ضمن إعدادات التطبيق → Background Sync."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer fakturering og synkronisering i baggrunden når som helst i Appindstillinger → Background Sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrechnung und Hintergrundsynchronisierung können Sie jederzeit unter App-Einstellungen → Background Sync verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestione la facturación y la sincronización en segundo plano cuando quiera en Ajustes de la app → Background Sync."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse laskutusta ja taustasynkronointia milloin tahansa kohdassa Sovelluksen asetukset → Background Sync."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez la facturation et la synchronisation en arrière-plan à tout moment dans Réglages de l’app → Background Sync."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לנהל חיוב וסנכרון ברקע בכל עת דרך הגדרות היישום → Background Sync."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप सेटिंग्स → Background Sync में कभी भी बिलिंग और बैकग्राउंड सिंकिंग प्रबंधित करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számlázás és a háttérbeli szinkronizálás bármikor kezelhető az Alkalmazásbeállítások → Background Sync pontban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola penagihan dan sinkronisasi latar belakang kapan saja di Pengaturan Aplikasi → Background Sync."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisca in qualsiasi momento fatturazione e sincronizzazione in background in Impostazioni app → Background Sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリ設定 → Background Sync」で、請求とバックグラウンド同期をいつでも管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 설정 → Background Sync에서 언제든 결제 및 백그라운드 동기화를 관리하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer betaling og bakgrunnssynkronisering når som helst i Appinnstillinger → Background Sync."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer facturering en achtergrondsynchronisatie op elk moment via Appinstellingen → Background Sync."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatnościami i synchronizacją w tle można zarządzać w dowolnej chwili w Ustawienia aplikacji → Background Sync."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie cobranças e a sincronização em segundo plano quando quiser em Ajustes do App → Background Sync."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управлять оплатой и фоновой синхронизацией можно в любое время в разделе «Настройки приложения → Background Sync»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera fakturering och bakgrundssynkronisering när som helst i Appinställningar → Background Sync."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการการเรียกเก็บเงินและการซิงค์ในเบื้องหลังได้ทุกเมื่อในตั้งค่าแอป → Background Sync"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faturalandırmayı ve arka planda eşzamanlamayı istediğiniz zaman Uygulama Ayarları → Background Sync bölümünden yönetin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте оплатою та фоновою синхронізацією будь-коли в «Налаштування застосунку → Background Sync»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý việc thanh toán và đồng bộ trong nền bất cứ lúc nào tại Cài đặt ứng dụng → Background Sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以随时在“应用设置 → Background Sync”中管理账单和后台同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以隨時在「App 設定 → Background Sync」中管理帳單和背景同步。"
          }
        }
      },
      "extractionState": "stale"
    },
