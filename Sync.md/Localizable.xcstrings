    "One switch covers every repository whenever iOS allows background work.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح واحد يشمل كل مستودع كلما سمح iOS بالعمل في الخلفية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én kontakt dækker alle arkiver, når iOS tillader baggrundsarbejde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schalter deckt jedes Repository ab, wenn iOS Hintergrundarbeit zulässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor abarca todos los repositorios cuando iOS permite trabajar en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kytkin kattaa kaikki tietovarastot aina, kun iOS sallii taustatyön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul bouton couvre tous les dépôts lorsqu’iOS autorise le travail en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתג אחד חל על כל מאגר בכל פעם ש-iOS מאפשר עבודה ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS के बैकग्राउंड कार्य की अनुमति देने पर एक स्विच हर रिपॉज़िटरी को शामिल करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kapcsoló minden tárolóra érvényes, amikor az iOS engedélyezi a háttérmunkát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tombol mencakup setiap repositori setiap kali iOS mengizinkan pekerjaan latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo interruttore copre tutti i repository ogni volta che iOS consente operazioni in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がバックグラウンド処理を許可したときに、1 つのスイッチですべてのリポジトリが対象になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 백그라운드 작업을 허용할 때마다 하나의 스위치로 모든 저장소에 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én bryter dekker alle repositorier når iOS tillater bakgrunnsarbeid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén schakelaar geldt voor elke repository wanneer iOS achtergrondwerk toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden przełącznik obejmuje każde repozytorium, gdy iOS zezwala na pracę w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão abrange todos os repositórios sempre que o iOS permite trabalho em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один переключатель охватывает все репозитории, когда iOS разрешает фоновую работу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett reglage omfattar alla arkiv när iOS tillåter bakgrundsarbete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวิตช์เดียวครอบคลุมทุกคลังเมื่อ iOS อนุญาตให้ทำงานในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS arka planda çalışmaya izin verdiğinde tek bir anahtar her depoyu kapsar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один перемикач охоплює кожен репозиторій, коли iOS дозволяє фонову роботу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một công tắc áp dụng cho mọi kho lưu trữ bất cứ khi nào iOS cho phép chạy nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 iOS 允许后台运行，一个开关即可涵盖每个仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 iOS 允許背景執行，一個開關即可涵蓋每個儲存庫。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Only folders inside GitSync.md storage can be relinked without granting access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إعادة ربط سوى المجلدات الموجودة داخل مساحة تخزين GitSync.md من دون منح صلاحية الوصول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun mapper i GitSync.md-lagringspladsen kan tilknyttes igen uden at give adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Ordner im GitSync.md-Speicher können ohne Zugriffsfreigabe erneut verknüpft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden volver a enlazar las carpetas del almacenamiento de GitSync.md sin conceder acceso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain GitSync.md-tallennustilassa olevat kansiot voidaan linkittää uudelleen myöntämättä käyttöoikeutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les dossiers du stockage GitSync.md peuvent être associés à nouveau sans autorisation d’accès."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לקשר מחדש ללא מתן גישה רק תיקיות שנמצאות באחסון GitSync.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐक्सेस दिए बिना केवल GitSync.md स्टोरेज के फ़ोल्डर ही दोबारा लिंक किए जा सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáférés megadása nélkül csak a GitSync.md-tárhelyen belüli mappák kapcsolhatók újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya folder di dalam penyimpanan GitSync.md yang dapat ditautkan kembali tanpa memberikan akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza concedere l’accesso, è possibile ricollegare solo le cartelle nello spazio di archiviazione di GitSync.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを許可せずに再リンクできるのは、GitSync.mdストレージ内のフォルダのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한을 부여하지 않고 다시 연결할 수 있는 폴더는 GitSync.md 저장 공간 안의 폴더뿐입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare mapper i GitSync.md-lagringen kan kobles til på nytt uten at du gir tilgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen mappen in de GitSync.md-opslag kunnen opnieuw worden gekoppeld zonder toegang te verlenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez udzielania dostępu można ponownie połączyć tylko foldery w miejscu przechowywania GitSync.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente pastas no armazenamento do GitSync.md podem ser revinculadas sem conceder acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без предоставления доступа можно повторно привязать только папки в хранилище GitSync.md."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast mappar i GitSync.md-lagringen kan länkas om utan att åtkomst beviljas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะโฟลเดอร์ในพื้นที่จัดเก็บ GitSync.md เท่านั้นที่เชื่อมโยงใหม่ได้โดยไม่ต้องอนุญาตให้เข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim izni vermeden yalnızca GitSync.md saklama alanındaki klasörler yeniden bağlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без надання доступу можна повторно прив’язати лише папки в сховищі GitSync.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể liên kết lại các thư mục trong bộ nhớ GitSync.md mà không cần cấp quyền truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需授予访问权限，只能重新关联 GitSync.md 储存空间内的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需授予取用權限，只能重新連結 GitSync.md 儲存空間內的檔案夾。"
          }
        }
      }
    },
    "Only works for public SSH remotes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل فقط مع أجهزة التحكم عن بعد العامة SSH"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Virker kun til offentlige SSH fjernbetjeninger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert nur für öffentliche SSH-Fernbedienungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo funciona para controles remotos públicos SSH"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "toimii vain yleisölle SSH kaukosäätimet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne uniquement pour public\nTélécommandes SSH "
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": תקף רק עבור משתמשים פубליċיים SSH – מכשירי רימוט"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सार्वजनिक उपयोगकर्ताओं के लिए कार्य करता है। SSH रिमोट्स"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "csupán a közösségi esetekhez alkalmazható. SSH távvezérlők"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "hanya berlaku untuk akun publik SSH remote control"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "funziona solo per utenti pubblici SSH telecomandi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：「public」の場合にのみ有効です。 SSH リモート装置"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 공개용에만 적용됩니다. SSH 리모트"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "fungerer kun for offentlige brukere. SSH fjernkontroller"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "werkt alleen voor openbare gebruikers. SSH afstandsbedieningen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "działa wyłącznie dla użytkowników publicznych. SSH 遥控ery"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": apenas funciona para públicos SSH controle remoto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": применимо только для публичных систем SSH — дистанционные управляющие устройства"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "fungerar endast för offentliga användare. SSH fjärrkontrollar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้งานได้เฉพาะสำหรับสาธารณะเท่านั้น SSH รีโมต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yalnızca kamu kullanıcıları için geçerlidir. SSH uzaktan kontrol cihazları"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "діє лише для публічного доступу SSH дистанційні керування"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chỉ hoạt động với tài khoản công cộng SSH – Thiết bị điều khiển từ xa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于公共环境 SSH 遥控器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於公共環境 SSH 遙控器"
          }
        }
      }
    },
