        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गंतव्य रिपॉज़िटरी में पहले से इतिहास है। पहले प्रकाशन के लिए खाली रिपॉज़िटरी ज़रूरी है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A céltárolónak már vannak előzményei. Az első közzétételhez üres tároló kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori tujuan sudah memiliki riwayat. Publikasi pertama memerlukan repositori kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository di destinazione ha già una cronologia. La prima pubblicazione richiede un repository vuoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信先のリポジトリにはすでに履歴があります。最初の公開には空のリポジトリが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 저장소에 이미 기록이 있습니다. 첫 게시에는 빈 저장소가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Målrepositoriet har allerede historikk. Første publisering krever et tomt repositorium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
