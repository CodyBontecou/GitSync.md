        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目的地儲存庫已有歷史記錄。首次發佈需要空的儲存庫。"
          }
        }
      }
    },
    "The file changed outside GitSync.md. Your edits were not saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير الملف للخارج GitSync.md. لم يتم حفظ التعديلات الخاصة بك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ השתנה בחוץ GitSync.md. העריכות שלך לא ניצלה."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er ændret uden for systemet. GitSync.mdDine redigeringer blev ikke gemt."
          }
        },
        "de": {
          "stringUnit": {
