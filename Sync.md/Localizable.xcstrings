    "Stage all changes, commit, and push one cloned GitSync.md repository — without opening the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف كل التغييرات إلى منطقة التجهيز، والتزم بها، وادفع مستودع GitSync.md مستنسخًا واحدًا — من دون فتح التطبيق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage alle ændringer, commit, og push ét klonet GitSync.md-arkiv — uden at åbne appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stagen Sie alle Änderungen, committen und pushen Sie ein geklontes GitSync.md-Repository — ohne die App zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare todos los cambios, confírmelos y envíe un repositorio clonado de GitSync.md — sin abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kaikki muutokset valmistelualueelle ja tee yhdelle kloonatulle GitSync.md-tietovarastolle commit ja push — avaamatta appia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez toutes les modifications, validez-les et envoyez un dépôt GitSync.md cloné, sans ouvrir l’app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכנת כל השינויים, ביצוע קומיט ודחיפת מאגר GitSync.md משוכפל אחד — בלי לפתוח את היישום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप खोले बिना सभी बदलाव स्टेज और कमिट करें, फिर एक क्लोन की गई GitSync.md रिपॉज़िटरी को पुश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes módosítás előkészítése és commitolása, majd egy klónozott GitSync.md-tároló feltöltése — az app megnyitása nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage semua perubahan, commit, lalu dorong satu repositori GitSync.md yang diklona — tanpa membuka app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui lo stage di tutte le modifiche, il commit e il push di un repository GitSync.md clonato, senza aprire l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての変更をステージし、アプリを開かずにクローン済みのGitSync.mdリポジトリを1つコミットしてプッシュします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 변경 사항을 스테이징하고, 앱을 열지 않고 복제된 GitSync.md 저장소 하나를 커밋하고 푸시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage alle endringer, og commit og push ett klonet GitSync.md-repositorium – uten å åpne appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage alle wijzigingen, en commit en push één gekloonde GitSync.md-repository, zonder de app te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wszystkie zmiany do indeksu, wykonaj commit i push jednego sklonowanego repozytorium GitSync.md — bez otwierania aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare todas as alterações e faça commit e push em um repositório clonado do GitSync.md — sem abrir o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте все изменения в индекс, выполните commit и push одного клонированного репозитория GitSync.md — не открывая приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered alla ändringar och kör commit och push för en klonad GitSync.md-lagringsplats — utan att öppna appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage การเปลี่ยนแปลงทั้งหมด แล้ว commit และ push ที่เก็บ GitSync.md ที่โคลนไว้หนึ่งรายการ — โดยไม่ต้องเปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açmadan klonlanmış bir GitSync.md deposundaki tüm değişiklikleri stage edin, commit edip push yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте всі зміни до stage, виконайте commit і push одного клонованого репозиторію GitSync.md, не відкриваючи програму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa tất cả thay đổi vào stage, commit và push một kho lưu trữ GitSync.md đã sao chép mà không cần mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开 App，即可暂存所有更改、提交并推送一个克隆的 GitSync.md 仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需開啟 App，即可暫存所有變更、提交並推送一個複製的 GitSync.md 儲存庫。"
          }
        }
      }
    },
