          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Obsidianben végzett módosítások itt jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editan Anda di Obsidian muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche che fai in Obsidian appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian での編集がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian에서 편집한 내용이 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer du gjør i Obsidian vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen die u in Obsidian maakt, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pojawią się zmiany wprowadzone w Obsidianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições que você faz no Obsidian aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся правки, сделанные в Obsidian."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar du gör i Obsidian visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแก้ไขที่คุณทำใน Obsidian จะแสดงที่นี่"
          }
