        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिमोट पर आधारित स्थानीय कमिट्स को पुनः लागू करना।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": helyi commitok visszajelzése a távvezérelt alapján"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Memutar ulang commit lokal di atas commit remote"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": riproduzione dei commit locali su base del commit remoto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモートの上にローカルコミットを再実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 원격 저장소 위에 로컬 커밋을 재실행합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Gjenopprettelse av lokale committinger overfor fjernversion"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Herhaling van lokale commits bovenop de remote versie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Powrót lokalnych commitów na podstawie commitów odległych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Reexecução de commits locais sobre os commits remotos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": повторное выполнение локальных коммитов на основе удалённых коммитов"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Genomför lokala kommitt på toppen av fjärrkommit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": รีเพลยการคอมมิตในเครื่องท้องถิ่นบนพื้นฐานของคอมมิตจากระยะไกล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uzak deposun üzerine yerel değişiklikleri yeniden uygula"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Повторення локальних комітів на основі віддалених"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Trả lại các commit cục bộ trên cơ sở của commit từ xa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：在远程分支之上重放本地提交"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：在遠程分支之上重放本地提交"
          }
        }
      }
    },
