    "Exclude any repository in its settings, with per-repository network and power policies.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استثنِ أي مستودع من إعداداته، مع سياسات الشبكة والطاقة الخاصة بكل مستودع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undtag et arkiv i dets indstillinger med netværks- og strømpolitikker for hvert arkiv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie einzelne Repositorys in deren Einstellungen aus und legen Sie dort Netzwerk- und Energierichtlinien fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluya cualquier repositorio desde sus ajustes y defina políticas de red y energía para cada uno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulje haluamasi tietovarasto pois sen asetuksissa ja määritä tietovarastokohtaiset verkko- ja virtakäytännöt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluez tout dépôt dans ses réglages et définissez des politiques de réseau et d’énergie pour chaque dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להחריג כל מאגר בהגדרותיו, עם מדיניות רשת וצריכת חשמל נפרדת לכל מאגר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर रिपॉज़िटरी की सेटिंग्स में उसे बाहर रखा जा सकता है और उसके लिए अलग नेटवर्क व पावर नीतियाँ तय की जा सकती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármely tároló kizárható a saját beállításaiban, tárolónkénti hálózati és energiahasználati szabályokkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecualikan repositori mana pun melalui pengaturannya, dengan kebijakan jaringan dan daya per repositori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escluda qualsiasi repository dalle relative impostazioni, con criteri di rete ed energia specifici per repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリごとのネットワークおよび電力ポリシーを設定し、設定画面で任意のリポジトリを除外できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소별 네트워크 및 전원 정책을 설정하고, 각 저장소의 설정에서 언제든 제외할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utelat et hvilket som helst repositorium i innstillingene, med egne retningslinjer for nettverk og strøm per repositorium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit elke gewenste repository uit via de instellingen, met netwerk- en energiebeleid per repository."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde repozytorium można wykluczyć w jego ustawieniach, określając osobne zasady sieci i zasilania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua qualquer repositório nos ajustes dele, com políticas de rede e energia específicas por repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой репозиторий можно исключить в его настройках, задав отдельные правила использования сети и энергии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undanta valfritt arkiv i dess inställningar, med nätverks- och energiprinciper per arkiv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเว้นคลังใดก็ได้ในการตั้งค่าของคลังนั้น พร้อมนโยบายเครือข่ายและพลังงานแยกตามคลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo başına ağ ve güç ilkeleriyle birlikte istediğiniz depoyu kendi ayarlarından hariç tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виключайте будь-який репозиторій у його налаштуваннях і задавайте окремі правила мережі та живлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại trừ kho lưu trữ bất kỳ trong phần cài đặt của kho đó, với chính sách mạng và nguồn điện riêng cho từng kho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在各仓库的设置中排除该仓库，并配置每个仓库的网络与电量策略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在各儲存庫的設定中排除該儲存庫，並設定各儲存庫的網路與電力政策。"
          }
        }
      }
    },
