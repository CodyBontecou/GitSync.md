    "Folder changes are unavailable in demo mode. Leave the demo to use this local tool.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغييرات المجلدات غير متاحة في الوضع التجريبي. اخرج من العرض التجريبي لاستخدام هذه الأداة المحلية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappeændringer er ikke tilgængelige i demotilstand. Forlad demoen for at bruge dette lokale værktøj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordneränderungen sind im Demomodus nicht verfügbar. Verlassen Sie die Demo, um dieses lokale Werkzeug zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de carpeta no están disponibles en el modo demo. Sal de la demo para usar esta herramienta local."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiomuutokset eivät ole käytettävissä esittelytilassa. Poistu esittelystä käyttääksesi tätä paikallista työkalua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de dossier sont indisponibles en mode démo. Quittez la démo pour utiliser cet outil local."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויי תיקיות אינם זמינים במצב הדגמה. צאו מההדגמה כדי להשתמש בכלי המקומי הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेमो मोड में फ़ोल्डर बदलाव उपलब्ध नहीं हैं। इस स्थानीय टूल का उपयोग करने के लिए डेमो से बाहर निकलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bemutató módban a mappamódosítások nem érhetők el. Lépjen ki a bemutatóból a helyi eszköz használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan folder tidak tersedia dalam mode demo. Keluar dari demo untuk menggunakan alat lokal ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche alle cartelle non sono disponibili in modalità demo. Esci dalla demo per usare questo strumento locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモモードではフォルダを変更できません。このローカルツールを使うにはデモを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모 모드에서는 폴더를 변경할 수 없습니다. 이 로컬 도구를 사용하려면 데모를 종료하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappeendringer er ikke tilgjengelige i demomodus. Forlat demoen for å bruke dette lokale verktøyet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapwijzigingen zijn niet beschikbaar in demomodus. Verlaat de demo om dit lokale hulpmiddel te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany folderów są niedostępne w trybie demo. Wyjdź z demo, aby użyć tego narzędzia lokalnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações de pasta não estão disponíveis no modo de demonstração. Saia da demonstração para usar esta ferramenta local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения папок недоступны в демо-режиме. Выйдите из демо, чтобы использовать этот локальный инструмент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappändringar är inte tillgängliga i demoläge. Lämna demon för att använda det här lokala verktyget."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงโฟลเดอร์ใช้ไม่ได้ในโหมดสาธิต ออกจากโหมดสาธิตเพื่อใช้เครื่องมือในเครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo modunda klasör değişiklikleri kullanılamaz. Bu yerel aracı kullanmak için demodan çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни папок недоступні в демо-режимі. Вийдіть із демо, щоб використати цей локальний інструмент."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi thư mục trong chế độ demo. Hãy thoát demo để dùng công cụ cục bộ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示模式下无法更改文件夹。请退出演示以使用此本地工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "示範模式下無法更改資料夾。請結束示範以使用此本機工具。"
          }
        }
      }
    },
