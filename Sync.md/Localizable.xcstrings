            "value": "ei voitu selvittää lähdekoodin kohdetta yhdistämiseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de résoudre la cible de branche source pour la fusion"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לפתור את מטרה השנוי של שנוי המקור עבור שילוב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": मर्ज के लिए सोर्स ब्रांच टारगेट को समाधान नहीं किया जा सका।"
          }
        },
        "hu": {
