    "These files look binary or large and are safer in Git LFS:\n\n%@%@\n\nUse Git LFS? This will update and stage .gitattributes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو هذه الملفات ثنائية أو كبيرة وتكون أكثر أمانًا في Git LFS:\n\n%@%@\n\nاستخدام Git LFS؟ سيؤدي هذا إلى تحديث ومرحلة .gitattributes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filer ser binære eller store ud og er mere sikre i Git LFS:\n\n%@%@\n\nBrug Git LFS? Dette vil opdatere og iscenesætte .gitattributes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien sehen binär oder groß aus und sind sicherer in Git LFS:\n\n%@%@\n\nVerwenden Sie Git LFS? Dadurch wird .gitattributes aktualisiert und bereitgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "These files look binary or large and are safer in Git LFS:\n\n%@%@\n\nUse Git LFS? This will update and stage .gitattributes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos parecen binarios o grandes y son más seguros en Git LFS:\n\n%@%@\n\n¿Usar Git LFS? Esto actualizará y preparará .gitattributes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä tiedostot näyttävät binääri- tai suurilta ja ovat turvallisempia Git LFS:\n\n%@%@\n\n-käyttö Git LFS? Tämä päivitetään ja vaiheet .gitattributes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ces fichiers semblent binaires ou de grande taille et sont plus sûrs dans Git LFS:\n\n%@%@\n\nUtilisation Git LFS? Cela mettra à jour et placera les données. .gitattributes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הקבצים האלה מראים כבינריים או גדולים, ומאפיינים אבטחת גבוהה יותר. Git LFS:\n\n%@%@\n\n– שימוש Git LFS– זה יעדכן ויסדר את הנתונים. .gitattributes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "— ये फ़ाइलें बाइनरी या बड़ी प्रतीत होती हैं तथा सुरक्षित हैं। Git LFS:\n\n%@%@\n\n: उपयोग Git LFS– यह अपडेट एवं स्टेज करेगा। .gitattributes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– ezek a fájlok bináris vagy nagy méretűek, és biztonságosabbak. Git LFS:\n\n%@%@\n\nHasználata Git LFS– Ez frissíti és szintezzi. .gitattributes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas-berkas ini tampak bersifat biner atau berukuran besar dan lebih aman di Git LFS:\n\n%@%@\n\nPenggunaan Git LFS? Hal ini akan memperbarui dan menyiapkan. .gitattributes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questi file sembrano binari o di grandi dimensioni e sono più sicuri in Git LFS:\n\n%@%@\n\nUtilizzo Git LFS? Questo aggiornerà e metterà in fase di staging. .gitattributes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：これらのファイルはバイナリ形式またはサイズが大きく、より安全です。 Git LFS:\n\n%@%@\n\n使用 Git LFS：この操作により、更新およびステージングが行われます。 .gitattributes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일들은 바이너리 형식 또는 크기가 큰 것으로 보이며, 더 안전합니다. Git LFS:\n\n%@%@\n\n사용 Git LFS– 이는 업데이트 및 스테이징을 수행합니다. .gitattributes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Disse filene ser binære ut eller er store, og er tryggere i Git LFS:\n\n%@%@\n\nBruk Git LFS– Dette oppdaterer og lagrer data. .gitattributes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Deze bestanden lijken binair of groot te zijn en zijn veiliger in Git LFS:\n\n%@%@\n\nGebruik Git LFS? Dit zal de gegevens bijwerken en in een stage-status plaatsen. .gitattributes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– te pliki wydają się być binarnymi lub duże, ale są bezpieczniejsze w Git LFS:\n\n%@%@\n\n– Użycie Git LFS– To polecenie aktualizuje i tworzy etap. .gitattributes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Estes arquivos parecem binários ou de grande tamanho e são mais seguros em Git LFS:\n\n%@%@\n\nUtilização Git LFS? Isto atualizará e preparará para envio. .gitattributes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": эти файлы выглядят как бинарные или имеют большой размер и являются более безопасными. Git LFS:\n\n%@%@\n\n— использование Git LFS: Это обновит и подготовит к выполнению. .gitattributes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Dessa filer ser ut som binära eller stora och är säkrare i Git LFS:\n\n%@%@\n\nAnvändning Git LFS– Detta uppdaterar och placerar. .gitattributes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เหล่านี้ดูเหมือนเป็นไฟล์ไบนารีหรือมีขนาดใหญ่ และปลอดภัยกว่าใน Git LFS:\n\n%@%@\n\nการใช้งาน Git LFS: สิ่งนี้จะทำการอัปเดตและจัดเตรียมข้อมูล .gitattributes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dosyaları ikili veya büyük görünüyor ve daha güvenlidür. Git LFS:\n\n%@%@\n\nKullanım Git LFS: Bu işlem güncelleme ve stage işlemini gerçekleştirir. .gitattributes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": ці файли виглядають як бінарні або великі і є безпечнішими. Git LFS:\n\n%@%@\n\n— Використання Git LFS– це оновить та підготує до виконання. .gitattributes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các tệp này có vẻ là định dạng nhị phân hoặc kích thước lớn và an toàn hơn khi Git LFS:\n\n%@%@\n\n– Sử dụng Git LFS: Thao tác này sẽ cập nhật và lưu vào giai đoạn. .gitattributes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：这些文件看起来为二进制文件或体积较大，更安全的处理方式是 Git LFS:\n\n%@%@\n\n使用 Git LFS？此操作将进行更新与暂存。 .gitattributes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：這些文件看起來爲二進製文件或體積較大，更安全的處理方式是 Git LFS:\n\n%@%@\n\n使用 Git LFS？此操作將進行更新與暫存。 .gitattributes."
          }
        }
      }
    },
    "They'll stay in the files, but GitHub won't get them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبقى في الملفات، لكن GitHub لن يتلقاها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De bliver i filerne, men GitHub får dem ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben in den Dateien, aber GitHub erhält sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguirán en los archivos, pero GitHub no los recibirá."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pysyvät tiedostoissa, mutta GitHub ei saa niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils resteront dans les fichiers, mais GitHub ne les recevra pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם יישארו בקבצים, אבל GitHub לא יקבל אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये फ़ाइलों में रहेंगी, लेकिन GitHub को नहीं मिलेंगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlokban maradnak, de a GitHub nem kapja meg őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tetap ada, tetapi GitHub tidak akan menerimanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resteranno nei file, ma GitHub non li riceverà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルには残りますが、GitHub には送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에는 남지만 GitHub로는 전송되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De blir værende i filene, men GitHub får dem ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze blijven in de bestanden, maar GitHub krijgt ze niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną w plikach, ale GitHub ich nie dostanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles continuam nos arquivos, mas o GitHub não os recebe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они останутся в файлах, но GitHub их не получит."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De stannar i filerna, men GitHub får dem inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์จะยังอยู่ แต่ GitHub จะไม่ได้รับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarda kalırlar ancak GitHub bunları almaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони залишаться у файлах, але GitHub їх не отримає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng vẫn nằm trong tệp, nhưng GitHub sẽ không nhận được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会保留在文件中，但不会发送到 GitHub。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會保留在檔案中，但不會傳送到 GitHub。"
          }
        }
      }
    },
    "This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voi peruuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Cela ne peut pas être annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– לא ניתן להסיר את ה결ס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": इसे रद्द नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem ismételhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
