    "Included with GitSync.md. iOS decides when background work runs; it's best effort.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضمّنة مع GitSync.md. يقرر iOS متى يعمل التطبيق في الخلفية؛ وذلك قدر الإمكان."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderet i GitSync.md. iOS bestemmer, hvornår arbejde i baggrunden kører; det sker efter bedste evne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In GitSync.md enthalten. iOS entscheidet, wann Hintergrundarbeit läuft; ohne Garantie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluido con GitSync.md. iOS decide cuándo se ejecuta el trabajo en segundo plano; sin garantías."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältyy GitSync.md:hen. iOS päättää, milloin taustatyö suoritetaan; parhaan kyvyn mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclus avec GitSync.md. iOS décide quand le travail en arrière-plan s’exécute ; c’est au mieux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלול ב-GitSync.md. ‏iOS מחליט מתי עבודה ברקע רצה; במידת האפשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md के साथ शामिल। बैकग्राउंड काम कब चलेगा, यह iOS तय करता है; यह यथासंभव है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitSync.md része. Az iOS dönti el, mikor fut a háttérmunka; lehetőség szerint."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Termasuk dalam GitSync.md. iOS menentukan kapan tugas latar belakang berjalan; sebisanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso con GitSync.md. iOS decide quando eseguire il lavoro in background; senza garanzie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md に含まれています。バックグラウンド処理の実行タイミングは iOS が決定するため、ベストエフォートです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md에 포함되어 있습니다. 백그라운드 작업의 실행 시점은 iOS가 결정하므로 최선의 노력으로 수행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkludert i GitSync.md. iOS bestemmer når bakgrunnsarbeid kjører; det skjer etter beste evne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbegrepen bij GitSync.md. iOS bepaalt wanneer achtergrondwerk draait; zonder garantie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W cenie GitSync.md. iOS decyduje, kiedy działa praca w tle; w miarę możliwości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluído no GitSync.md. O iOS decide quando o trabalho em segundo plano roda; é na medida do possível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входит в GitSync.md. iOS решает, когда выполнять фоновую работу; по мере возможности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingår i GitSync.md. iOS bestämmer när arbete i bakgrunden körs; det sker efter bästa förmåga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมอยู่ใน GitSync.md iOS เป็นผู้ตัดสินว่างานเบื้องหลังจะทำงานเมื่อใด จึงเป็นแบบเท่าที่ทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md'ye dahildir. Arka plan işinin ne zaman çalışacağına iOS karar verir; en iyi çaba esaslıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Входить у GitSync.md. iOS вирішує, коли виконувати фонову роботу; за можливості."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bao gồm trong GitSync.md. iOS quyết định khi nào tác vụ nền chạy; theo khả năng tốt nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md 已包含此功能。后台任务何时运行由 iOS 决定，属于尽力而为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md 已內含此功能。背景作業何時執行由 iOS 決定，屬於盡力而為。"
          }
        }
      }
    },
