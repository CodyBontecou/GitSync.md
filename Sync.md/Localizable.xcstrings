          "stringUnit": {
            "state": "translated",
            "value": ": Rebase виявив розходження між гілками"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các nhánh đã phân tách do quá trình tái định vị."
