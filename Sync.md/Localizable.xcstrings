    "Optional commit message. Defaults to \"Update from GitSync.md\".": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالة التزام اختيارية. الرسالة الافتراضية هي \"تحديث من GitSync.md\"."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfri commitbesked. Standarden er \"Opdatering fra GitSync.md\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Commit-Nachricht. Standardmäßig wird \"Update von GitSync.md\" verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje de commit opcional. El valor predeterminado es \"Actualización desde GitSync.md\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen commit-viesti. Oletus on \"Päivitys GitSync.md:stä\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message de commit facultatif. Par défaut : « Update from GitSync.md »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודעת קומיט אופציונלית. ברירת המחדל היא „Update from GitSync.md”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक कमिट संदेश। डिफ़ॉल्ट: “Update from GitSync.md”।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kötelező commitüzenet. Alapértelmezés: „Update from GitSync.md”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan commit opsional. Nilai default: “Update from GitSync.md”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggio di commit facoltativo. Il valore predefinito è \"Aggiornamento da GitSync.md\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のコミットメッセージ。デフォルトは「GitSync.mdから更新」です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항인 커밋 메시지입니다. 기본값은 \"GitSync.md에서 업데이트\"입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfri commit-melding. Standard er «Oppdatering fra GitSync.md»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel commitbericht. Standaard is \"Update vanuit GitSync.md\"."
          }
        },
        "pl": {
          "stringUnit": {
