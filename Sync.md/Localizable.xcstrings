    },
    "You can leave this screen. It keeps going in the background and shows on the Lock Screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مغادرة هذه الشاشة. تستمر العملية في الخلفية وتظهر على شاشة القفل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan forlade denne skærm. Den fortsætter i baggrunden og vises på låseskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können diesen Bildschirm verlassen. Es läuft im Hintergrund weiter und erscheint auf dem Sperrbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes salir de esta pantalla. Sigue en segundo plano y se muestra en la pantalla bloqueada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit poistua tästä näkymästä. Työ jatkuu taustalla ja näkyy lukitulla näytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez quitter cet écran. L’opération continue en arrière-plan et s’affiche sur l’écran verrouillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לצאת מהמסך הזה. הפעולה ממשיכה ברקע ומוצגת במסך הנעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप यह स्क्रीन छोड़ सकते हैं। यह बैकग्राउंड में चलता रहता है और लॉक स्क्रीन पर दिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elhagyhatja ezt a képernyőt. A háttérben folytatódik, és a Zárolási képernyőn is látható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat meninggalkan layar ini. Proses terus berjalan di latar belakang dan tampil di Layar Terkunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi lasciare questa schermata. Continua in background e appare nella schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面を離れても大丈夫です。バックグラウンドで続行し、ロック画面に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면을 나가도 됩니다. 백그라운드에서 계속 진행되며 잠금 화면에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan forlate denne skjermen. Den fortsetter i bakgrunnen og vises på låseskjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt dit scherm verlaten. Het gaat door op de achtergrond en verschijnt op het toegangsscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz opuścić ten ekran. Proces trwa w tle i jest widoczny na ekranie blokady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode sair desta tela. Continua em segundo plano e aparece na Tela Bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно покинуть этот экран. Процесс продолжится в фоне и отображается на экране блокировки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lämna den här skärmen. Det fortsätter i bakgrunden och visas på låsskärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออกจากหน้าจอนี้ได้ การทำงานจะดำเนินต่อในเบื้องหลังและแสดงบนหน้าจอล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekrandan çıkabilirsiniz. Arka planda sürer ve Kilitli Ekran'da görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна залишити цей екран. Процес триватиме у фоні й відображається на замкненому екрані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể rời màn hình này. Tác vụ vẫn tiếp tục trong nền và hiển thị trên Màn hình khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以离开此屏幕。它会在后台继续运行，并显示在锁定屏幕上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以離開此畫面。它會在背景繼續執行，並顯示在鎖定畫面上。"
          }
        }
      }
    },
