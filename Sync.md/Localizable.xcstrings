    "Stash changes to set them aside without committing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم stash لوضع التغييرات جانبًا دون commit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash ændringer for at lægge dem til side uden at committe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stashen Sie Änderungen, um sie ohne Commit beiseitezulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los cambios en el stash para apartarlos sin hacer commit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kätke muutokset siirtääksesi ne sivuun commitoimatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les modifications dans le stash pour les mettre de côté sans commit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו ב-stash כדי להניח שינויים בצד בלי commit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना commit किए बदलावों को अलग रखने के लिए stash करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A stash-sel commit nélkül teheti félre a módosításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash perubahan untuk menyisihkannya tanpa commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti le modifiche nello stash per accantonarle senza commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更をスタッシュすると、コミットせずに退避できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 스태시하면 커밋하지 않고 따로 보관할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash endringer for å legge dem til side uten å committe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash wijzigingen om ze apart te zetten zonder commit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj stash, aby odłożyć zmiany bez commita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde alterações no stash para deixá-las de lado sem commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте stash, чтобы отложить изменения без commit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg ändringar i stash för att lägga dem åt sidan utan commit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash การเปลี่ยนแปลงเพื่อพักไว้โดยไม่ commit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri commit etmeden kenara koymak için stash kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте stash, щоб відкласти зміни без commit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash thay đổi để cất chúng sang một bên mà không cần commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "储藏更改可以将其搁置而无需提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲藏變更可將其擱置而不需提交。"
          }
        }
      }
    },
