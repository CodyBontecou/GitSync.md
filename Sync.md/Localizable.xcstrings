    "%@ has not been cloned yet. Open GitSync.md and clone it first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لم يتم استنساخه بعد. افتح GitSync.md وقم باستنساخه أولاً."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er ikke blevet klonet endnu. Åbn GitSync.md og klon den først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde noch nicht geklont. Öffnen Sie GitSync.md und klonen Sie es zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no se ha clonado. Abra GitSync.md y clónelo primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei ole vielä kloonattu. Avaa GitSync.md ja kloonaa se ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n&#39;a pas encore été cloné. Ouvrir GitSync.md et clonez-le d&#39;abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא הושגה כлон ainda. פתור GitSync.md – הכנסו אותו ויצרו את הקלאן שלו קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को अभी तक क्लोन नहीं किया गया है। खोलें। GitSync.md को पहले चयन करें और उसका क्लोन बनाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ még nem klonálva lett. Nyitott állapotban van. GitSync.md -et használja, majd ezt klonálja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum dikloni. Buka GitSync.md dan kloningnya terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è ancora stato clonato. Apri GitSync.md e clona innanzitutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだクローン化されていません。開く GitSync.md を取得し、まずそのクローンを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 는 아직 클로닝되지 않았습니다. 열기 GitSync.md 를 먼저 확인한 후 클론하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er ikke klonert ennå. Åpne GitSync.md og kloner det først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is nog niet gekloond. Open GitSync.md en kloon dit eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie został jeszcze klonowany. Otwórz GitSync.md – najpierw klonuj go."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda não foi clonado. Abra. GitSync.md e clone-o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ещё не клонирован. Открыто GitSync.md и сначала клонируйте его."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ännu inte klonerats. Öppna GitSync.md och klona det först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังไม่ได้ถูกโคลน ให้เปิด GitSync.md และทำการโคลนก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henüz klonlanmadı. Açın GitSync.md 'yi ilk olarak klonlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще не клонований. Відкрито. GitSync.md і спочатку клонуйте його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vẫn chưa được clon hóa. Mở GitSync.md và hãy sao chép nó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍未克隆。打开 GitSync.md ，先进行克隆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍未剋隆。打開 GitSync.md ，先進行剋隆。"
          }
        }
      }
    },
