    "Select at least one file for the initial commit. Git does not store empty folders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد ملفًا واحدًا على الأقل للـ commit الأولي. لا يخزن Git المجلدات الفارغة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg mindst én fil til det første commit. Git gemmer ikke tomme mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie mindestens eine Datei für den ersten Commit. Git speichert keine leeren Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona al menos un archivo para el commit inicial. Git no guarda carpetas vacías."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse vähintään yksi tiedosto ensimmäiseen commitiin. Git ei tallenna tyhjiä kansioita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez au moins un fichier pour le commit initial. Git ne stocke pas les dossiers vides."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו לפחות קובץ אחד ל-commit הראשוני. ‏Git לא שומר תיקיות ריקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रारंभिक commit के लिए कम से कम एक फ़ाइल चुनें। Git खाली फ़ोल्डर संग्रहीत नहीं करता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon legalább egy fájlt az első commithoz. A Git nem tárol üres mappákat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih setidaknya satu file untuk commit awal. Git tidak menyimpan folder kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona almeno un file per il commit iniziale. Git non archivia le cartelle vuote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のコミットに含めるファイルを少なくとも1つ選択してください。Git は空のフォルダを保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최초 커밋에 포함할 파일을 하나 이상 선택하십시오. Git은 빈 폴더를 저장하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg minst én fil for den første commiten. Git lagrer ikke tomme mapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer minstens één bestand voor de eerste commit. Git bewaart geen lege mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz co najmniej jeden plik do pierwszego commita. Git nie przechowuje pustych folderów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione pelo menos um arquivo para o commit inicial. O Git não armazena pastas vazias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хотя бы один файл для первого commit. Git не хранит пустые папки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj minst en fil för den första commit. Git lagrar inte tomma mappar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกอย่างน้อยหนึ่งไฟล์สำหรับ commit เริ่มต้น Git ไม่เก็บโฟลเดอร์ว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk commit için en az bir dosya seçin. Git boş klasörleri saklamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть принаймні один файл для першого commit. Git не зберігає порожні папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn ít nhất một tệp cho commit đầu tiên. Git không lưu thư mục trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少为初始提交选择一个文件。Git 不存储空文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請至少為初始提交選擇一個檔案。Git 不會儲存空資料夾。"
          }
        }
      }
