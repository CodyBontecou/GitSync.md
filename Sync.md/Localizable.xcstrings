          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập thư mục gốc. Hãy kết nối lại thư mục để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
