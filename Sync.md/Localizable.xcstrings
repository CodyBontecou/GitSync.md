    "No cloned repositories to pull yet. Open GitSync.md and clone a repository first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مستودعات مستنسخة لسحبها حتى الآن. افتح GitSync.md وقم باستنساخ المستودع أولاً."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen klonede lagre at trække endnu. Åbn GitSync.md og klon et depot først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine geklonten Repositorys zum Abrufen. Öffnen Sie GitSync.md und klonen Sie zuerst ein Repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay repositorios clonados para extraer. Abra GitSync.md y clone un repositorio primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kloonattuja versioita vetää vielä. Avoin GitSync.md ja kloonaa arkisto ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dépôt cloné à tirer encore. Ouvrir GitSync.md et cloner un dépôt en premier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": אין מאגרים מותאמים להטמעה ainda – פתוח GitSync.md – תבצעו את ה-clone של המאגר לפני כן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": अभी तक कोई क्लोन्ड रिपॉजिटरी पुल के लिए उपलब्ध नहीं है। खोलें। GitSync.md को पहले रिपॉजिटरी में क्लोन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": még nincs klónozott adatmagazin, amit felhasználhatunk – Nyitva\nElőször az GitSync.md -t használja, majd egy repozitóriumban klonálja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada repositori yang dikloning untuk dipull. Buka GitSync.md dan terlebih dahulu kloning repositori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Non sono presenti repository clonati da cui estrarre dati. Aperto GitSync.md : prima clona il repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：まだプルするためのクローンリポジトリが存在しません。開く GitSync.md で、まずリポジトリをクローンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 아직 가져올 클론 저장소가 없습니다. 열기 GitSync.md 를 먼저 생성하고, 저장소를 클론하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Det er ikke noen klonede lagringssteder til å hente fra ennå. Åpne GitSync.md og kloner først et repository."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen gekloneerde opslagplaatsen om te halen. Open GitSync.md : eerst een repository kloneren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze klonowanych repositoriów do pobierania. Otwarte GitSync.md – najpierw klonuj repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nenhum repositório clonado disponível para pull. Aberto GitSync.md : primeiro clone o repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Клонированных репозиториев для извлечения ещё нет. Открыто GitSync.md : сначала клонируйте репозиторий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Inga klonade lagringsplatser finns för att hämta data än. Öppna GitSync.md och klona först ett repotre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ยังไม่มีคลอนเรโพซิทอรี่ใดสำหรับการดึงข้อมูล — เปิด GitSync.md และให้คลอนรีโพซิทอรี่ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hâliyə getirilecek klonlanmış depolama alanları yoktur. Açın GitSync.md 'yi önce bir depoya klonlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": немає клонованих репозиторіїв для підтягування. Відкрито. GitSync.md : спочатку клонуйте репозиторій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hiện chưa có kho lưu trữ được sao chép để tải dữ liệu. Mở GitSync.md và hãy sao chép trước một kho lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：尚无可拉取的克隆仓库。打开 GitSync.md ，需先克隆代码库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：尚無可拉取的剋隆倉庫。打開 GitSync.md ，需先剋隆代碼庫。"
          }
        }
      }
    },
