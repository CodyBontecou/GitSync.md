    "Could not access the scanned folder. Please scan it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى المجلد الذي تم فحصه. يُرجى فحصه مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kunne ikke opnås adgang til den scannede mappe. Scan den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den durchsuchten Ordner konnte nicht zugegriffen werden. Bitte durchsuchen Sie ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido acceder a la carpeta explorada. Vuelva a explorarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistettua kansiota ei voitu käyttää. Tarkista se uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder au dossier analysé. Veuillez l’analyser à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לגשת לתיקייה שנסרקה. יש לסרוק אותה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन किए गए फ़ोल्डर को ऐक्सेस नहीं किया जा सका। कृपया इसे फिर से स्कैन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vizsgált mappa nem érhető el. Vizsgálja meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder yang dipindai tidak dapat diakses. Silakan pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere alla cartella analizzata. Esegui di nuovo l’analisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンしたフォルダにアクセスできませんでした。もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 폴더에 접근할 수 없습니다. 다시 스캔해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikk ikke tilgang til den skannede mappen. Skann den på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gescande map is niet toegankelijk. Scan deze opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uzyskać dostępu do skanowanego folderu. Zeskanuj go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a pasta escaneada. Escaneie-a novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить доступ к отсканированной папке. Отсканируйте её снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att komma åt den genomsökta mappen. Sök igenom den igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเข้าถึงโฟลเดอร์ที่สแกนได้ โปรดสแกนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taranan klasöre erişilemedi. Lütfen klasörü yeniden tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати доступ до сканованої папки. Проскануйте її ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập thư mục đã quét. Vui lòng quét lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问扫描的文件夹。请重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取用掃描的檔案夾。請重新掃描。"
          }
        }
      }
    },
    "Could not access the selected folder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى المجلد المحدد"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke få adgang til den valgte mappe"
          }
        },
