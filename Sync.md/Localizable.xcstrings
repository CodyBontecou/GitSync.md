    "Opens GitHub to change repository access or uninstall the GitSync.md GitHub App.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح GitHub لتغيير الوصول إلى المستودعات أو إلغاء تثبيت GitHub App الخاص بـ GitSync.md."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner GitHub for at ændre repository-adgang eller afinstallere GitSync.md GitHub App."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet GitHub, um den Repository-Zugriff zu ändern oder die GitSync.md GitHub App zu deinstallieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre GitHub para cambiar el acceso a repositorios o desinstalar la GitHub App de GitSync.md."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa GitHubin, jossa voit muuttaa tietovarastojen käyttöoikeutta tai poistaa GitSync.md GitHub Appin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre GitHub pour modifier l’accès aux dépôts ou désinstaller la GitHub App GitSync.md."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את GitHub כדי לשנות גישה למאגרים או להסיר את GitHub App של GitSync.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी एक्सेस बदलने या GitSync.md GitHub App अनइंस्टॉल करने के लिए GitHub खोलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a GitHubot a tárolóhozzáférés módosításához vagy a GitSync.md GitHub App eltávolításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka GitHub untuk mengubah akses repositori atau mencopot GitHub App GitSync.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre GitHub per modificare l'accesso ai repository o disinstallare la GitHub App di GitSync.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub を開いて、リポジトリへのアクセスを変更するか GitSync.md GitHub App をアンインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub를 열어 저장소 접근 권한을 변경하거나 GitSync.md GitHub App을 제거합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner GitHub for å endre repositorietilgang eller avinstallere GitSync.md GitHub App."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent GitHub om repositorytoegang te wijzigen of de GitSync.md GitHub App te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera GitHub, aby zmienić dostęp do repozytoriów lub odinstalować GitHub App GitSync.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o GitHub para alterar o acesso aos repositórios ou desinstalar o GitHub App do GitSync.md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает GitHub, чтобы изменить доступ к репозиториям или удалить GitHub App GitSync.md."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar GitHub för att ändra arkivåtkomst eller avinstallera GitSync.md GitHub App."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด GitHub เพื่อเปลี่ยนการเข้าถึงที่เก็บหรือถอนการติดตั้ง GitHub App ของ GitSync.md"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo erişimini değiştirmek veya GitSync.md GitHub App'i kaldırmak için GitHub'ı açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває GitHub, щоб змінити доступ до репозиторіїв або видалити GitHub App GitSync.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở GitHub để thay đổi quyền truy cập kho lưu trữ hoặc gỡ cài đặt GitSync.md GitHub App."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 GitHub 以更改仓库访问权限或卸载 GitSync.md GitHub App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 GitHub 以更改儲存庫存取權或解除安裝 GitSync.md GitHub App。"
          }
        }
      }
    },
    "Opens a private email draft with this installation's opaque identifier. Review it before sending; never post these identifiers publicly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح مسودة بريد خاصة تحتوي على المعرّف المبهم لهذا التثبيت. راجعها قبل الإرسال؛ ولا تنشر هذه المعرّفات علنًا أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner en privat mailkladde med denne installations uigennemsigtige id. Gennemse den, før du sender; offentliggør aldrig disse id'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen privaten E-Mail-Entwurf mit der anonymen Kennung dieser Installation. Prüfen Sie ihn vor dem Senden; veröffentlichen Sie diese Kennungen niemals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un borrador de email privado con el identificador opaco de esta instalación. Revísalo antes de enviarlo; nunca publiques estos identificadores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa yksityisen sähköpostiluonnoksen, jossa on tämän asennuksen läpinäkymätön tunniste. Tarkista se ennen lähettämistä; älä koskaan julkaise näitä tunnisteita julkisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un brouillon d’e-mail privé avec l’identifiant opaque de cette installation. Relisez-le avant l’envoi ; ne publiez jamais ces identifiants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח טיוטת דוא״ל פרטית עם המזהה האטום של התקנה זו. בדקו אותה לפני השליחה; לעולם אל תפרסמו מזהים אלה בפומבי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इंस्टॉलेशन के अपारदर्शी पहचानकर्ता के साथ एक निजी ईमेल ड्राफ़्ट खोलता है। भेजने से पहले इसकी समीक्षा करें; इन पहचानकर्ताओं को कभी सार्वजनिक रूप से पोस्ट न करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Privát e-mail-piszkozatot nyit a telepítés átlátszatlan azonosítójával. Küldés előtt nézze át; ezeket az azonosítókat sose tegye közzé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka draf email privat dengan identitas buram instalasi ini. Tinjau sebelum mengirim; jangan pernah memposting identitas ini secara publik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una bozza email privata con l'identificatore anonimo di questa installazione. Controllala prima di inviarla; non pubblicare mai questi identificatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインストールの不透明な識別子を含むメールの下書きを非公開で開きます。送信前に内容を確認し、これらの識別子を公開しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치의 불투명 식별자가 포함된 비공개 이메일 초안을 엽니다. 보내기 전에 검토하고, 이 식별자를 공개적으로 게시하지 마십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner et privat e-postutkast med denne installasjonens anonyme ID. Les gjennom før du sender; del aldri disse ID-ene offentlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een privé-e-mailconcept met de anonieme ID van deze installatie. Controleer het vóór verzenden; publiceer deze ID's nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera prywatny szkic e-maila z nieprzejrzystym identyfikatorem tej instalacji. Przejrzyj go przed wysłaniem; nigdy nie publikuj tych identyfikatorów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um rascunho de e-mail privado com o identificador opaco desta instalação. Revise antes de enviar; nunca publique esses identificadores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает приватный черновик письма с непрозрачным идентификатором этой установки. Проверьте его перед отправкой; никогда не публикуйте эти идентификаторы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar ett privat e-postutkast med den här installationens ogenomskinliga identifierare. Granska det innan du skickar; publicera aldrig identifierarna offentligt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดร่างอีเมลส่วนตัวพร้อมตัวระบุแบบทึบของการติดตั้งนี้ ตรวจสอบก่อนส่ง และอย่าโพสต์ตัวระบุเหล่านี้ต่อสาธารณะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumun opak tanımlayıcısını içeren özel bir e-posta taslağı açar. Göndermeden önce gözden geçirin; bu tanımlayıcıları asla herkese açık paylaşmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває приватну чернетку листа з непрозорим ідентифікатором цього встановлення. Перегляньте її перед надсиланням; ніколи не публікуйте ці ідентифікатори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bản nháp email riêng tư chứa mã định danh ẩn của bản cài đặt này. Hãy xem lại trước khi gửi; không bao giờ đăng công khai các mã định danh này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一封包含此安装的不透明标识符的私密邮件草稿。发送前请检查；切勿公开发布这些标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開一封包含此安裝之不透明識別碼的私人郵件草稿。傳送前請先檢查；切勿公開張貼這些識別碼。"
          }
        }
      }
    },
    "Opens a private email draft with this installation's opaque onboarding and Background Sync identifiers. Review it before sending; never post these identifiers publicly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح مسودة بريد إلكتروني خاصة تتضمن معرّفات الإعداد الأولي ومعرّفات Background Sync المبهمة الخاصة بهذا التثبيت. راجعها قبل الإرسال؛ ولا تنشر هذه المعرّفات علنًا مطلقًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner en privat mailkladde med denne installations uigennemsigtige onboarding- og Background Sync-id’er. Gennemse den, før du sender. Offentliggør aldrig disse id’er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen privaten E-Mail-Entwurf mit den nicht aussagekräftigen Onboarding- und Background Sync-Kennungen dieser Installation. Prüfen Sie ihn vor dem Senden; veröffentlichen Sie diese Kennungen niemals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un borrador de correo privado con los identificadores opacos de incorporación y de Background Sync de esta instalación. Revíselo antes de enviarlo; nunca publique estos identificadores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa yksityisen sähköpostiluonnoksen, joka sisältää tämän asennuksen läpinäkymättömät käyttöönotto- ja Background Sync -tunnisteet. Tarkista viesti ennen lähettämistä. Älä koskaan julkaise näitä tunnisteita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un brouillon d’e-mail privé contenant les identifiants opaques d’intégration et de Background Sync de cette installation. Vérifiez-le avant l’envoi ; ne publiez jamais ces identifiants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח טיוטת דוא״ל פרטית עם מזהי ההצטרפות ומזהי Background Sync האטומים של התקנה זו. יש לעיין בה לפני השליחה; לעולם אין לפרסם מזהים אלה בפומבי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इंस्टॉलेशन के अपारदर्शी ऑनबोर्डिंग और Background Sync पहचानकर्ताओं के साथ एक निजी ईमेल ड्राफ़्ट खोलता है। भेजने से पहले इसकी समीक्षा करें; इन पहचानकर्ताओं को कभी सार्वजनिक रूप से पोस्ट न करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Privát e-mail-piszkozatot nyit meg a telepítés átlátszatlan bevezetési és Background Sync-azonosítóival. Küldés előtt ellenőrizze; soha ne tegye közzé ezeket az azonosítókat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka draf email pribadi dengan pengenal onboarding dan Background Sync yang bersifat buram untuk instalasi ini. Tinjau sebelum mengirim; jangan pernah memublikasikan pengenal ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una bozza di email privata con gli identificatori opachi di onboarding e Background Sync di questa installazione. La controlli prima dell’invio; non pubblichi mai questi identificatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインストールの不透明なオンボーディング識別子と Background Sync 識別子を含む非公開メールの下書きを開きます。送信前に確認し、これらの識別子は決して公開しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치의 불투명한 온보딩 및 Background Sync 식별자가 포함된 비공개 이메일 초안을 엽니다. 보내기 전에 검토하고, 이 식별자를 공개적으로 게시하지 마세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner et privat e-postutkast med de ugjennomsiktige identifikatorene for innføring og Background Sync i denne installasjonen. Se gjennom det før du sender. Publiser aldri disse identifikatorene offentlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een privé-e-mailconcept met de ondoorzichtige onboarding- en Background Sync-ID's van deze installatie. Controleer het voordat u het verzendt; publiceer deze ID's nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera prywatną wersję roboczą wiadomości e-mail z nieprzejrzystymi identyfikatorami wdrożenia i Background Sync tej instalacji. Sprawdź ją przed wysłaniem; nigdy nie publikuj tych identyfikatorów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um rascunho privado de e-mail com os identificadores opacos de integração e do Background Sync desta instalação. Revise-o antes de enviar; nunca publique esses identificadores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает частный черновик электронного письма с непрозрачными идентификаторами подключения и Background Sync для этой установки. Проверьте его перед отправкой; никогда не публикуйте эти идентификаторы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar ett privat e-postutkast med den här installationens ogenomskinliga identifierare för introduktion och Background Sync. Granska det innan du skickar; publicera aldrig identifierarna offentligt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดฉบับร่างอีเมลส่วนตัวที่มีตัวระบุการเริ่มต้นใช้งานและ Background Sync แบบไม่สื่อความหมายของการติดตั้งนี้ โปรดตรวจสอบก่อนส่ง และห้ามเผยแพร่ตัวระบุเหล่านี้ต่อสาธารณะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumun opak ilk katılım ve Background Sync tanımlayıcılarını içeren özel bir e-posta taslağı açar. Göndermeden önce inceleyin; bu tanımlayıcıları asla herkese açık biçimde paylaşmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває приватну чернетку електронного листа з непрозорими ідентифікаторами адаптації та Background Sync для цієї інсталяції. Перевірте її перед надсиланням; ніколи не публікуйте ці ідентифікатори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bản nháp email riêng tư có chứa các mã định danh không rõ nghĩa về quy trình thiết lập và Background Sync của bản cài đặt này. Hãy xem lại trước khi gửi; tuyệt đối không đăng công khai các mã định danh này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一封私人电子邮件草稿，其中包含此安装的不透明引导标识符和 Background Sync 标识符。发送前请检查；切勿公开发布这些标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟一封私人電子郵件草稿，其中包含此安裝項目的不透明啟用標識符和 Background Sync 標識符。傳送前請檢查；切勿公開發佈這些標識符。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Opt in once to let GitSync.md reconcile current and future repositories whenever iOS grants background time. Exclude any repository in its settings—there is no subscription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك مرة واحدة ليتمكن GitSync.md من مطابقة المستودعات الحالية والمستقبلية كلما منح iOS وقتًا في الخلفية. استبعد أي مستودع من إعداداته — لا يوجد اشتراك مدفوع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilmeld dig én gang for at lade GitSync.md afstemme nuværende og fremtidige repositories, når iOS giver tid i baggrunden. Udelad et repository i dets indstillinger – der er intet abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie es einmal, damit GitSync.md aktuelle und zukünftige Repositorys abgleicht, wann immer iOS Hintergrundzeit gewährt. Schließen Sie Repositorys in deren Einstellungen aus – es gibt kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo una vez para que GitSync.md reconcilie los repositorios actuales y futuros siempre que iOS conceda tiempo en segundo plano. Excluye cualquier repositorio en sus ajustes; no hay suscripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kerran, että GitSync.md sovittaa nykyiset ja tulevat tietovarastot aina, kun iOS myöntää tausta-aikaa. Jätä mikä tahansa tietovarasto pois sen asetuksissa – tilausta ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le une fois pour que GitSync.md réconcilie les dépôts actuels et futurs chaque fois qu’iOS accorde du temps en arrière-plan. Excluez un dépôt dans ses réglages — il n’y a pas d’abonnement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצטרפו פעם אחת כדי לאפשר ל-GitSync.md לסנכרן מאגרים נוכחיים ועתידיים בכל פעם ש-iOS מעניק זמן ברקע. החריגו כל מאגר בהגדרות שלו — אין מינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार ऑप्ट इन करें ताकि जब भी iOS बैकग्राउंड समय दे, GitSync.md मौजूदा और भविष्य की रिपॉज़िटरी का मिलान कर सके। किसी भी रिपॉज़िटरी को उसकी सेटिंग्स में बाहर रखें—कोई सदस्यता नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszeri hozzájárulással a GitSync.md egyezteti a jelenlegi és jövőbeli tárolókat, amikor az iOS háttéridőt ad. Bármely tárolót kizárhat a beállításaiban – nincs előfizetés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikut serta sekali agar GitSync.md dapat merekonsiliasi repositori saat ini dan mendatang setiap kali iOS memberikan waktu latar belakang. Kecualikan repositori mana pun di pengaturannya—tanpa langganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo una volta per permettere a GitSync.md di riconciliare i repository attuali e futuri ogni volta che iOS concede tempo in background. Escludi qualsiasi repository nelle sue impostazioni — non c'è abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度オプトインすると、iOS がバックグラウンド時間を与えるたびに GitSync.md が現在および今後のリポジトリを同期します。リポジトリはその設定で除外できます。サブスクリプションはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 선택하면 iOS가 백그라운드 시간을 허용할 때마다 GitSync.md가 현재 및 향후 저장소를 동기화합니다. 저장소별 설정에서 제외할 수 있으며, 구독은 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg det én gang for å la GitSync.md avstemme nåværende og fremtidige repositorier når iOS gir tid i bakgrunnen. Utelat et repositorium i innstillingene – det finnes ikke noe abonnement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel het één keer in zodat GitSync.md huidige en toekomstige repository's afstemt wanneer iOS achtergrondtijd geeft. Sluit een repository uit in de instellingen ervan — er is geen abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyraź zgodę raz, aby GitSync.md uzgadniał obecne i przyszłe repozytoria, gdy iOS przyzna czas w tle. Wyklucz dowolne repozytorium w jego ustawieniach — bez subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative uma vez para deixar o GitSync.md reconciliar repositórios atuais e futuros sempre que o iOS conceder tempo em segundo plano. Exclua qualquer repositório nos ajustes dele — não há assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте согласие один раз, чтобы GitSync.md согласовывал текущие и будущие репозитории, когда iOS выделяет фоновое время. Исключите любой репозиторий в его настройках — подписка не нужна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj till en gång för att låta GitSync.md stämma av nuvarande och framtida arkiv när iOS ger tid i bakgrunden. Undanta valfritt arkiv i dess inställningar – ingen prenumeration krävs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกใช้ครั้งเดียวเพื่อให้ GitSync.md กระทบยอดที่เก็บปัจจุบันและในอนาคตทุกครั้งที่ iOS ให้เวลาเบื้องหลัง ยกเว้นที่เก็บใดก็ได้ในการตั้งค่า—ไม่มีการสมัครสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS arka plan zamanı verdiğinde GitSync.md'nin mevcut ve gelecekteki depoları uzlaştırması için bir kez onay verin. Herhangi bir depoyu ayarlarından hariç tutun; abonelik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте згоду один раз, щоб GitSync.md узгоджував поточні й майбутні репозиторії, коли iOS надає фоновий час. Виключіть будь-який репозиторій у його налаштуваннях — підписка не потрібна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tham gia một lần để GitSync.md đồng bộ các kho lưu trữ hiện tại và sau này mỗi khi iOS cấp thời gian chạy nền. Loại trừ bất kỳ kho lưu trữ nào trong cài đặt của nó—không cần đăng ký gói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需开启一次，GitSync.md 便会在 iOS 授予后台时间时同步当前及将来的仓库。可在仓库设置中排除任意仓库——无需订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需選擇加入一次，GitSync.md 便會在 iOS 給予背景時間時同步目前及未來的儲存庫。可在儲存庫設定中排除任何儲存庫——不需訂閱。"
          }
        }
      }
    },
