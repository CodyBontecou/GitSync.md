    "No changes yet. Edits show up here as you write.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغييرات بعد. تظهر التعديلات هنا أثناء الكتابة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ændringer endnu. Ændringer vises her, mens du skriver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Änderungen. Änderungen erscheinen hier, während Sie schreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cambios. Aparecerán aquí mientras escribes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä muutoksia. Muokkaukset näkyvät täällä kirjoittaessasi."
