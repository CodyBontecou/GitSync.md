        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist"
          }
        }
      }
    },
    "GitSync Assist can keep every repository up to date automatically — clean, pull-only sync with GitHub event wakes. Optional subscription; all manual features stay included.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist يمكن الحفاظ على كل مستودع محدث تلقائيًا-تنظيف ، pull-only مزامنة مع GitHub يستيقظ الحدث. اشتراك اختياري ؛ تظل جميع الميزات اليدوية مدرجة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist יכול לשמור על כל מאגר מעודכן באופן אוטומטי-נקי, pull-only סנכרון עם GitHub האירוע מתעורר. מנוי אופציונלי; כל התכונות הידניות להישאר כלול."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Kan holde alle repositories automatisk opdaterede – ren. pull-only Synkroniser med GitHub Event Wake. Valgfri abonnement; alle manuelle funktioner forbliver inkluderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Passt jedes Repository automatisch auf Aktualität – sauber. pull-only Synchronisierung mit GitHub Event-Wake-up – optionales Abonnement; alle manuellen Funktionen bleiben enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Puede mantener todos los repositorios actualizados automáticamente — limpios. pull-only Sincronizar con GitHub Eventos de despertar. Suscripción opcional; todas las funciones manuales se mantienen incluidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Voit pitää jokaisen tallennuslaitteen automaattisesti päivityksissä – siisti. pull-only Synteesoi GitHub Tapahtuma herättää käyttäjän. Vapaa tilaus; kaikki manuaaliset ominaisuudet säilyvät sisällytettyinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Permet de maintenir automatiquement chaque répertoire à jour — propre. pull-only Synchroniser avec GitHub Event Wakes. Abonnement optionnel ; toutes les fonctionnalités manuelles restent incluses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist प्रत्येक रिपॉजिटरी को स्वचालित रूप से अद्यतन रख सकता है — स्वच्छ, pull-only सिंक करें GitHub इवेंट वेक। ऐच्छिक सदस्यता; सभी मैनुअल सुविधाएँ शामिल रहती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Az összes tárolót automatikusan frissítheti – tiszta és rendben. pull-only Szinkronizálás: GitHub Event Wake – opcionális előfizetés; minden manuális funkció továbbra is beépített."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Dapat memastikan setiap repositori tetap mutakhir secara otomatis — bersih, pull-only Sinkronisasi dengan GitHub Event Wakes. Langganan opsional; semua fitur manual tetap termasuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Consente di mantenere automaticamente ogni repository aggiornato — pulito. pull-only Sincronizzazione con GitHub Event Wake. Abbonamento facoltativo; tutte le funzionalità manuali rimangono incluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist すべてのリポジトリを自動的に最新状態に保つことができます — 純粋。 pull-only 同期する GitHub イベントによる起動。任意のサブスクリプションが利用可能ですが、すべての手動機能は引き続き含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist 모든 저장소를 자동으로 최신 상태로 유지할 수 있습니다 — 깔끔하게 관리합니다. pull-only 동기화 GitHub 이벤트 활성화. 선택적 구독 서비스; 모든 수동 기능은 계속 포함됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Kan holde alle lagringssteder automatisk oppdatert – ren og velorganisert. pull-only Samsvar med GitHub Event Wake – valgfritt abonnement; alle manuelle funksjoner forblir inkludert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Houd elk repository automatisch bij de nieuwste versie — schoon. pull-only Synchroniseer met GitHub Event Wakes. Optionele abonnement; alle handmatige functies blijven inbegrepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist umożliwia automatyczne aktualizowanie wszystkich repositoriów — czyste, pull-only Synchronizacja z GitHub Wzruszenie systemu – opcjonalna subskrypcja; wszystkie funkcje ręczne pozostają dostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Permite manter todos os repositórios atualizados automaticamente — limpos. pull-only Sincronizar com GitHub Eventos de despertar. Assinatura opcional; todas as funcionalidades manuais permanecem incluídas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Позволяет автоматически поддерживать все репозитории в актуальном состоянии — чисто и системно. pull-only Синхронизация с GitHub Событие «Wakes» — опциональная подписка; все функции ручного управления остаются включены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Kan hålla varje lagring automatiskt uppdaterad – ren och ordnad. pull-only Synchronisera med GitHub Event Wake – valfritt prenumeration; alla manuella funktioner förblir inkluderade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist สามารถอัปเดตรีโพซิทอรีทุกแห่งอย่างอัตโนมัติ — ให้ข้อมูลสะอาด pull-only ซิงค์กับ GitHub Event Wakes – บริการสมัครสมาชิกแบบเลือกใช้ได้; ฟีเจอร์ทั้งหมดแบบแมนนวลยังคงมีอยู่ในแพ็กเกจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Her depoyu otomatik olarak güncel tutabilir — temiz, pull-only Sinhronize et GitHub Olay: Uyandırma. İsteğe bağlı abonelik; tüm el ile yönetilebilir özellikler dahil olmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Дозволяє автоматично підтримувати кожен репозиторій у сучасному стані — чисто. pull-only Синхронізація з GitHub Подія «Wakes». Додаткова підписка; усі ручні функції залишаються включеними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist Có thể tự động cập nhật mọi kho lưu trữ — gọn gàng, pull-only Đồng bộ hóa với GitHub Event Wakes – Dịch vụ đăng ký tùy chọn; tất cả các tính năng thủ công vẫn được bao gồm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist 可自动保持所有仓库的最新状态——保持整洁 pull-only 同步至 GitHub 事件唤醒功能。可选订阅；所有手动操作功能均保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync Assist 可自動保持所有倉庫的最新狀態——保持整潔 pull-only 同步至 GitHub 事件喚醒功能。可選訂閱；所有手動操作功能均保留。"
          }
        }
      }
    },
