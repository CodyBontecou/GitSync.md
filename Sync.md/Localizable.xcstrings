    "One opt-in covers all current and future cloned or managed repositories on this installation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل موافقة واحدة جميع المستودعات الحالية والمستقبلية المستنسخة أو المُدارة في هذا التثبيت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tilvalg dækker alle nuværende og fremtidige klonede eller administrerede arkiver på denne installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zustimmung gilt für alle aktuellen und zukünftigen geklonten oder verwalteten Repositorys dieser Installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una única autorización abarca todos los repositorios clonados o gestionados, actuales y futuros, de esta instalación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi suostumus kattaa tämän asennuksen kaikki nykyiset ja tulevat kloonatut tai hallitut tietovarastot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul consentement couvre tous les dépôts clonés ou gérés, actuels et futurs, de cette installation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסכמה אחת חלה על כל המאגרים הנוכחיים והעתידיים ששוכפלו או מנוהלים בהתקנה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार सहमति देने से इस इंस्टॉलेशन की सभी मौजूदा और भावी क्लोन या प्रबंधित रिपॉज़िटरी शामिल हो जाती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen engedélyezés a telepítés minden jelenlegi és jövőbeli klónozott vagy kezelt tárolójára érvényes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu persetujuan mencakup semua repositori saat ini dan mendatang yang dikloning atau dikelola pada instalasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’unica adesione copre tutti i repository clonati o gestiti, presenti e futuri, in questa installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度のオプトインで、このインストールにある現在および今後のクローン済みまたは管理対象のすべてのリポジトリが対象になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 동의하면 이 설치에서 현재 및 향후에 복제하거나 관리하는 모든 저장소에 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett samtykke dekker alle nåværende og fremtidige klonede eller administrerte repositorier i denne installasjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén toestemming geldt voor alle huidige en toekomstige gekloonde of beheerde repository's op deze installatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna zgoda obejmuje wszystkie obecne i przyszłe sklonowane lub zarządzane repozytoria w tej instalacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma única adesão abrange todos os repositórios clonados ou gerenciados, atuais e futuros, nesta instalação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно согласие распространяется на все текущие и будущие клонированные или управляемые репозитории в этой установке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett val omfattar alla aktuella och framtida klonade eller hanterade arkiv i den här installationen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลือกเข้าร่วมครั้งเดียวครอบคลุมคลังที่โคลนหรือจัดการทั้งหมดทั้งในปัจจุบันและอนาคตในการติดตั้งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir onay, bu kurulumdaki mevcut ve gelecekteki tüm klonlanmış veya yönetilen depoları kapsar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна згода охоплює всі поточні й майбутні клоновані або керовані репозиторії в цій інсталяції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần chọn tham gia áp dụng cho mọi kho lưu trữ đã sao chép hoặc được quản lý, cả hiện tại lẫn tương lai, trên bản cài đặt này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次选择加入即可涵盖此安装上当前及未来的所有克隆或管理的仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次加入選擇即可涵蓋此安裝項目上目前及未來的所有複製或管理的儲存庫。"
          }
        }
      }
    },
    "One switch covers all your repositories": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح واحد يشمل جميع مستودعاتك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én kontakt dækker alle dine arkiver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schalter für alle Ihre Repositorys"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
