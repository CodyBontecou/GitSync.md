    "A Git history backup is in progress in this folder. Wait for it to finish before deleting local files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري نسخ احتياطي لسجل Git في هذا المجلد. انتظر حتى ينتهي قبل حذف الملفات المحلية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En backup af Git-historikken er i gang i denne mappe. Vent, til den er færdig, før du sletter lokale filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Ordner läuft gerade ein Backup des Git-Verlaufs. Warten Sie, bis es fertig ist, bevor Sie lokale Dateien löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una copia de seguridad del historial de Git en curso en esta carpeta. Espera a que termine antes de eliminar archivos locales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä kansiossa on käynnissä Git-historian varmuuskopiointi. Odota, että se valmistuu, ennen kuin poistat paikallisia tiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde de l’historique Git est en cours dans ce dossier. Attendez qu’elle se termine avant de supprimer les fichiers locaux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גיבוי היסטוריית Git מתבצע בתיקייה זו. המתינו לסיומו לפני מחיקת הקבצים המקומיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर में Git इतिहास का बैकअप चल रहा है। स्थानीय फ़ाइलें हटाने से पहले इसके पूरा होने की प्रतीक्षा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben a mappában Git-előzmény mentése zajlik. Várja meg a végét, mielőtt törli a helyi fájlokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencadangan riwayat Git sedang berjalan di folder ini. Tunggu hingga selesai sebelum menghapus file lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso un backup della cronologia Git in questa cartella. Attendi che finisca prima di eliminare i file locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダで Git 履歴のバックアップが進行中です。完了するまで待ってからローカルファイルを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에서 Git 기록 백업이 진행 중입니다. 완료될 때까지 기다린 후 로컬 파일을 삭제하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En sikkerhetskopi av Git-historikken pågår i denne mappen. Vent til den er ferdig før du sletter lokale filer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een back-up van de Git-geschiedenis gemaakt in deze map. Wacht tot die klaar is voordat u lokale bestanden verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym folderze trwa tworzenie kopii historii Git. Poczekaj na zakończenie przed usunięciem plików lokalnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup do histórico Git está em andamento nesta pasta. Aguarde a conclusão antes de excluir os arquivos locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой папке создаётся резервная копия истории Git. Дождитесь завершения, прежде чем удалять локальные файлы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En säkerhetskopiering av Git-historiken pågår i den här mappen. Vänta tills den är klar innan du raderar lokala filer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังสำรองประวัติ Git ในโฟลเดอร์นี้ รอให้เสร็จก่อนลบไฟล์ในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörde bir Git geçmişi yedeklemesi sürüyor. Yerel dosyaları silmeden önce bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій папці створюється резервна копія історії Git. Дочекайтеся завершення, перш ніж видаляти локальні файли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang sao lưu lịch sử Git trong thư mục này. Hãy đợi hoàn tất trước khi xóa tệp cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹正在备份 Git 历史记录。请等待备份完成后再删除本地文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料夾正在備份 Git 歷史記錄。請等待備份完成後再刪除本機檔案。"
          }
        }
      }
    },
    "A GitHub push wakes the app within seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية push على GitHub توقظ التطبيق خلال ثوانٍ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et push på GitHub vækker appen inden for sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein GitHub-Push weckt die App innerhalb von Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un push en GitHub despierta la app en segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-push herättää sovelluksen sekunneissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un push GitHub réveille l’app en quelques secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "push ב-GitHub מעיר את היישום תוך שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub पर push कुछ ही सेकंड में ऐप को जगा देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy GitHub-push másodperceken belül felébreszti az appot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Push di GitHub membangunkan app dalam hitungan detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un push su GitHub riattiva l'app in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub へのプッシュで数秒以内にアプリが起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 푸시하면 몇 초 안에 앱이 깨어납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En GitHub-push vekker appen i løpet av sekunder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een GitHub-push wekt de app binnen enkele seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Push na GitHubie wybudza aplikację w kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um push no GitHub ativa o app em segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Push в GitHub будит приложение за секунды."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En push till GitHub väcker appen inom några sekunder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ push บน GitHub จะปลุกแอปภายในไม่กี่วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir GitHub push'u uygulamayı saniyeler içinde uyandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Push у GitHub будить застосунок за лічені секунди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần push lên GitHub sẽ đánh thức ứng dụng trong vài giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送到 GitHub 后，App 会在几秒内被唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推送到 GitHub 後，App 會在幾秒內被喚醒。"
          }
        }
      }
    },
    "A commit couldn't be pushed. Open it to finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنفيذ push لـ commit. افتحه لإكمال العملية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et commit kunne ikke pushes. Åbn den for at gøre det færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Commit konnte nicht gepusht werden. Öffnen, um abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar un commit. Ábrelo para terminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Committia ei voitu lähettää. Viimeistele avaamalla se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commit n’a pas pu être envoyé. Ouvrez-le pour terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לבצע push ל-commit. פתחו כדי להשלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक commit push नहीं हो सका। पूरा करने के लिए इसे खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy commitot nem sikerült pusholni. Nyissa meg a befejezéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah commit tidak dapat di-push. Buka untuk menyelesaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile inviare un commit. Aprilo per completare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットをプッシュできませんでした。開いて完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋을 푸시하지 못했습니다. 열어서 마무리하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En commit kunne ikke pushes. Åpne den for å fullføre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een commit kon niet worden gepusht. Open hem om af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wykonać push commita. Otwórz, aby dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível fazer push de um commit. Abra para concluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить push commit. Откройте, чтобы завершить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En commit kunde inte pushas. Öppna den för att slutföra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "push commit ไม่สำเร็จ เปิดเพื่อดำเนินการให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir commit push edilemedi. Tamamlamak için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося виконати push commit. Відкрийте, щоб завершити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể push một commit. Mở để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一个提交未能推送。打开以完成操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一個提交無法推送。打開以完成操作。"
          }
        }
      }
    },
    "A copy of your edits is saved to the stash first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ نسخة من تعديلاتك في stash أولًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kopi af dine ændringer gemmes først i stash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie Ihrer Änderungen wird zuerst im Stash gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se guarda una copia de tus cambios en el stash."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
