    "Stops the merge and puts your branch back": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف merge ويعيد فرعك كما كان"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper merge og sætter din gren tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt den Merge und setzt Ihren Branch zurück"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la fusión y devuelve tu rama a su estado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäyttää yhdistämisen ja palauttaa haarasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la fusion et remet votre branche en place"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצר את ה-merge ומחזיר את הענף שלכם למצבו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "merge रोकता है और आपकी ब्रांच को वापस पहले जैसा करता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítja az összevonást, és visszaállítja az ágát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan merge dan mengembalikan branch Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe il merge e riporta il branch com'era"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージを中止し、ブランチを元に戻します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합을 중지하고 브랜치를 원래대로 되돌립니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper merge og setter grenen tilbake"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt de merge en zet uw branch terug"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje scalanie i przywraca Twoją gałąź"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe o merge e restaura seu branch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает слияние и возвращает вашу ветку"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppar merge och återställer din branch"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุด merge และคืนสาขาของคุณกลับเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirmeyi durdurur ve dalınızı geri koyar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє злиття й повертає вашу гілку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng merge và đưa nhánh của bạn về như cũ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止合并并将分支恢复原状"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止合併並將分支恢復原狀"
          }
        }
      }
    },
