    "Everything checks out. One clone and it’s here with its full history.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء سليم. استنسخ المستودع ليظهر هنا بسجله الكامل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er i orden. Klon det, så er det her med hele historikken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in Ordnung. Nach dem Klonen ist das Repository mit seinem vollständigen Verlauf hier verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo está correcto. Clónalo y tendrás aquí todo su historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki on kunnossa. Kloonaa tietovarasto, niin se on täällä koko historioineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est prêt. Clonez ce dépôt pour le retrouver ici avec tout son historique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול תקין. שכפלו את המאגר והוא יופיע כאן עם כל ההיסטוריה שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब ठीक है। इसे क्लोन करें और पूरा इतिहास यहाँ मिल जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden rendben. Klónozza a tárolót, és itt lesz a teljes előzménytörténettel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya beres. Kloning repositori untuk mendapatkannya di sini beserta seluruh riwayatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È tutto a posto. Clonalo e lo troverai qui con l’intera cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて問題ありません。クローンすると、全履歴とともにここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 정상입니다. 클론하면 전체 기록과 함께 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er i orden. Klon det, så er det her med hele historikken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles is in orde. Kloon de repository en je hebt hem hier met de volledige geschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko w porządku. Sklonuj repozytorium, aby mieć je tutaj wraz z całą historią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo certo. Clone o repositório para tê-lo aqui com todo o histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в порядке. Клонируйте репозиторий, и он появится здесь со всей историей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt ser bra ut. Klona förrådet så finns det här med hela historiken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างพร้อมแล้ว โคลนรีโพซิทอรีเพื่อให้มีข้อมูลพร้อมประวัติทั้งหมดอยู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey yolunda. Depoyu klonladığınızda tüm geçmişiyle birlikte burada olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе гаразд. Клонуйте репозиторій, і він з’явиться тут з усією історією."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đều ổn. Sao chép kho lưu trữ để có toàn bộ lịch sử tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切正常。克隆后，此仓库及其完整历史记录就会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切正常。複製後，此儲存庫及其完整歷史記錄就會出現在這裡。"
          }
        }
      }
    },
