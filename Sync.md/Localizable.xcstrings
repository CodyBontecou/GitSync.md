    "Folder publication progress contains duplicate identifiers. The saved file has been preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي تقدم نشر المجلد على معرّفات مكررة. تم الاحتفاظ بالملف المحفوظ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremskridt for mappeudgivelse indeholder duplikerede id'er. Den gemte fil er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fortschritt der Ordnerveröffentlichung enthält doppelte Kennungen. Die gespeicherte Datei wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso de publicación de la carpeta contiene identificadores duplicados. Se ha conservado el archivo guardado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion julkaisun edistymistiedoissa on päällekkäisiä tunnisteita. Tallennettu tiedosto on säilytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression de publication du dossier contient des identifiants en double. Le fichier enregistré a été conservé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקדמות פרסום התיקייה מכילה מזהים כפולים. הקובץ השמור נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर प्रकाशन प्रगति में डुप्लिकेट पहचानकर्ता हैं। सहेजी गई फ़ाइल सुरक्षित रखी गई है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mappa közzétételi állapota ismétlődő azonosítókat tartalmaz. A mentett fájlt megőriztük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Progres publikasi folder berisi identitas duplikat. File yang tersimpan telah dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progressi della pubblicazione della cartella contengono identificatori duplicati. Il file salvato è stato conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ公開の進捗に重複した識別子が含まれています。保存されたファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 게시 진행 상황에 중복된 식별자가 있습니다. 저장된 파일은 보존되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremdriften for mappepubliseringen inneholder dupliserte ID-er. Den lagrede filen er bevart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voortgang van de mappublicatie bevat dubbele ID's. Het bewaarde bestand is behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp publikacji folderu zawiera zduplikowane identyfikatory. Zapisany plik został zachowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso da publicação da pasta contém identificadores duplicados. O arquivo salvo foi preservado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс публикации папки содержит повторяющиеся идентификаторы. Сохранённый файл сохранён."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappens publiceringsförlopp innehåller dubblerade identifierare. Den sparade filen har bevarats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคืบหน้าการเผยแพร่โฟลเดอร์มีตัวระบุซ้ำ ไฟล์ที่บันทึกไว้ได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör yayımlama ilerlemesi yinelenen tanımlayıcılar içeriyor. Kaydedilen dosya korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогрес публікації папки містить дублікати ідентифікаторів. Збережений файл збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến trình xuất bản thư mục chứa mã định danh trùng lặp. Tệp đã lưu vẫn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹发布进度包含重复的标识符。已保存的文件已被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾發佈進度包含重複的識別碼。已儲存的檔案已保留。"
          }
        }
      }
    },
    "Folder published, but the Obsidian connection could not be prepared. Reopen GitSync.md to retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نشر المجلد، لكن تعذّر تجهيز اتصال Obsidian. أعد فتح GitSync.md لإعادة المحاولة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen er udgivet, men forbindelsen til Obsidian kunne ikke klargøres. Åbn GitSync.md igen for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner veröffentlicht, aber die Obsidian-Verbindung konnte nicht vorbereitet werden. Öffnen Sie GitSync.md erneut, um es noch einmal zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta publicada, pero no se pudo preparar la conexión con Obsidian. Vuelve a abrir GitSync.md para reintentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansio julkaistiin, mutta Obsidian-yhteyttä ei voitu valmistella. Yritä uudelleen avaamalla GitSync.md uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier publié, mais la connexion Obsidian n’a pas pu être préparée. Rouvrez GitSync.md pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיקייה פורסמה, אך לא ניתן היה להכין את החיבור ל-Obsidian. פתחו מחדש את GitSync.md כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर प्रकाशित हुआ, लेकिन Obsidian कनेक्शन तैयार नहीं हो सका। दोबारा प्रयास के लिए GitSync.md फिर से खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mappa közzétéve, de az Obsidian-kapcsolatot nem sikerült előkészíteni. Nyissa meg újra a GitSync.md-t az újrapróbáláshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder dipublikasikan, tetapi koneksi Obsidian tidak dapat disiapkan. Buka ulang GitSync.md untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella pubblicata, ma non è stato possibile preparare la connessione a Obsidian. Riapri GitSync.md per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダは公開されましたが、Obsidian との接続を準備できませんでした。GitSync.md を開き直して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더가 게시되었지만 Obsidian 연결을 준비하지 못했습니다. GitSync.md를 다시 열어 재시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen er publisert, men Obsidian-tilkoblingen kunne ikke klargjøres. Åpne GitSync.md på nytt for å prøve igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Map gepubliceerd, maar de Obsidian-verbinding kon niet worden voorbereid. Open GitSync.md opnieuw om het nog eens te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder opublikowany, ale nie udało się przygotować połączenia z Obsidianem. Otwórz ponownie GitSync.md, aby spróbować jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta publicada, mas não foi possível preparar a conexão com o Obsidian. Reabra o GitSync.md para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка опубликована, но не удалось подготовить подключение к Obsidian. Откройте GitSync.md снова, чтобы повторить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen publicerades, men anslutningen till Obsidian kunde inte förberedas. Öppna GitSync.md igen för att försöka på nytt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เผยแพร่โฟลเดอร์แล้ว แต่ไม่สามารถเตรียมการเชื่อมต่อ Obsidian ได้ เปิด GitSync.md อีกครั้งเพื่อลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör yayımlandı ancak Obsidian bağlantısı hazırlanamadı. Yeniden denemek için GitSync.md'yi tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку опубліковано, але не вдалося підготувати підключення до Obsidian. Відкрийте GitSync.md знову, щоб повторити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xuất bản thư mục, nhưng không thể chuẩn bị kết nối Obsidian. Hãy mở lại GitSync.md để thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹已发布，但无法准备 Obsidian 连接。请重新打开 GitSync.md 重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾已發佈，但無法準備 Obsidian 連線。請重新打開 GitSync.md 以重試。"
          }
        }
      }
    },
