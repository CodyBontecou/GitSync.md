    "Local and remote have diverged. Merge support is required to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تباعدت المسافة المحلية والبعيدة. مطلوب دعم الدمج للمتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalt og eksternt er adskilt. Der kræves flettesupport for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal und Remote sind auseinandergegangen. Zum Fortfahren ist Merge-Unterstützung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Local y remoto han divergido. Se requiere soporte de fusión para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset ja etäiset ovat erilaisia. Yhdistämistuki on jatkettava."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Local et distant ont divergé. Le support de fusion est nécessaire pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": בין ה-Local וה-Remote נוצרה הפרדה. יש צורך בתמיכהในการ שילוב כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'Local' और 'Remote' के बीच अंतर है। प्रक्रिया जारी रखने के लिए मर्ज सपोर्ट की आवश्यकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A helyi és távoli konfigurációk eltérnek. A folytatás érdekében a csatolás támogatása szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Konfigurasi lokal dan jarak jauh telah berbeda. Diperlukan dukungan penggabungan untuk melanjutkan proses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": i valori locali e remoti sono divergenti. È necessario il supporto per la fusione per proseguire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカルとリモートの状態が一致していません。継続するには、マージ機能が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬 및 원격 데이터가 서로 다릅니다. 계속 진행하려면 병합 지원이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokal og fjernfunksjoner er forskjellige. Samlingstilpassing er nødvendig for å kunne fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokale en externe instellingen zijn niet overeenkomend; ondersteuning voor samenvoeging is vereist om verder te kunnen werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": lokalny i odległy rejestry nie są zgodne. Do kontynuowania pracy wymagana jest funkcja połączenia (merge)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": os estados local e remoto divergiram. É necessário suporte de fusão para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": местные и удалённые данные расходятся. Для продолжения работы требуется функция объединения данных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokala och fjärranvärden har skiljt sig. Merg-support krävs för att fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": สถานะท้องถิ่นและระยะไกลไม่สอดคล้องกัน — จำเป็นต้องมีการรวมข้อมูลเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel ve uzaktaki veriler farklıdır. İşi devam ettirmek için birleştirme desteği gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": між локальним і дистанційним режимами виникли розбіжності. Для продовження роботи необхідна функція об'єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Tính năng Local và Remote đã không còn trùng khớp nhau. Cần hỗ trợ hợp nhất để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：本地与远程数据已出现差异。需启用合并功能方可继续操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：本地與遠程數據已齣現差異。需啟用閤併功能方可繼續操作。"
          }
        }
      }
    },
    "Local and remote history diverged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تباين التاريخ المحلي والتاريخ البعيد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההיסטוריה המקומית והרחוקה התבדלו זו מזו."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale og den fjerne historie divergede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale und die entfernte Historie haben sich voneinander getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La historia local y la historia remota se divergieron."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen ja kaukaisen historia erottuivat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'histoire locale et celle à distance se sont séparées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय तथा दूरस्थ इतिहास अलग हो गए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi és távoli történet eltért egymástól."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah lokal dan sejarah jarak jauh berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La storia locale e quella remota si sono diverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルとリモートの履歴が分岐しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 및 원격 역사 데이터가 분리되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal og fjern historie diverged."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale en de remote geschiedenis zijn gescheiden geworden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna i zdalna historia rozgałęzliły się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A história local e a história remota divergiram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная и удаленная истории стали разниться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala och den fjärransatta historien skiljde sig från varandra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติศาสตร์ท้องถิ่นและประวัติศาสตร์ระยะไกลแยกจากกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ve uzak tarihler ayrıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцева та віддалена історія розходилися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử cục bộ và lịch sử từ xa đã tách biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地与远程历史记录已出现差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地與遠端歷史記錄已出現差異。"
          }
        }
      }
    },
    "Local branch has commits ready to push": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفرع المحلي لديه التزامات جاهزة للدفع"
          }
        },
        "da": {
