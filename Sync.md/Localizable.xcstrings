    "Clone uses your GitHub account and the default save location. Long-press a repo to pick a branch, sign-in method or folder first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الاستنساخ حساب GitHub وموقع الحفظ الافتراضي. اضغط مطولًا على مستودع لاختيار فرع أو طريقة تسجيل دخول أو مجلد أولًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloning bruger din GitHub-konto og standardplaceringen. Tryk længe på et repo for først at vælge gren, loginmetode eller mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Klonen werden Ihr GitHub-Konto und der Standardspeicherort verwendet. Drücken Sie lange auf ein Repo, um vorher Branch, Anmeldemethode oder Ordner zu wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al clonar se usa tu cuenta de GitHub y la ubicación predeterminada. Mantén pulsado un repo para elegir antes una rama, un método de inicio de sesión o una carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloonaus käyttää GitHub-tiliäsi ja oletustallennussijaintia. Valitse haara, kirjautumistapa tai kansio ensin painamalla repoa pitkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clonage utilise votre compte GitHub et l’emplacement par défaut. Appuyez longuement sur un dépôt pour choisir d’abord une branche, une méthode de connexion ou un dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השכפול משתמש בחשבון GitHub שלכם ובמיקום השמירה המוגדר כברירת מחדל. לחצו לחיצה ארוכה על מאגר כדי לבחור קודם ענף, שיטת התחברות או תיקייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लोन आपके GitHub खाते और डिफ़ॉल्ट सहेजने के स्थान का उपयोग करता है। पहले ब्रांच, साइन-इन तरीका या फ़ोल्डर चुनने के लिए रिपो को देर तक दबाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A klónozás a GitHub-fiókját és az alapértelmezett mentési helyet használja. Tartsa lenyomva a tárolót, ha előbb ágat, bejelentkezési módot vagy mappát választana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone menggunakan akun GitHub Anda dan lokasi simpan default. Tekan lama sebuah repo untuk memilih branch, metode masuk, atau folder terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La clonazione usa il tuo account GitHub e la posizione predefinita. Tieni premuto su un repo per scegliere prima un branch, un metodo di accesso o una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローンには GitHub アカウントとデフォルトの保存場所が使われます。先にブランチ、サインイン方法、フォルダを選ぶには、リポジトリを長押ししてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클론에는 GitHub 계정과 기본 저장 위치가 사용됩니다. 먼저 브랜치, 로그인 방법 또는 폴더를 고르려면 저장소를 길게 누르십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloning bruker GitHub-kontoen din og standard lagringsplassering. Hold inne på et repo for å velge gren, påloggingsmetode eller mappe først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonen gebruikt uw GitHub-account en de standaardopslaglocatie. Houd een repo ingedrukt om eerst een branch, inlogmethode of map te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonowanie używa Twojego konta GitHub i domyślnej lokalizacji zapisu. Przytrzymaj repozytorium, aby najpierw wybrać gałąź, sposób logowania lub folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A clonagem usa sua conta do GitHub e o local padrão. Mantenha um repo pressionado para escolher antes um branch, método de login ou pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонирование использует ваш аккаунт GitHub и расположение по умолчанию. Нажмите и удерживайте репозиторий, чтобы сначала выбрать ветку, способ входа или папку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloning använder ditt GitHub-konto och standardplatsen. Tryck länge på ett arkiv för att först välja branch, inloggningsmetod eller mapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone ใช้บัญชี GitHub ของคุณและตำแหน่งบันทึกเริ่มต้น กดค้างที่รีโปเพื่อเลือกสาขา วิธีลงชื่อเข้า หรือโฟลเดอร์ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonlama GitHub hesabınızı ve varsayılan kayıt konumunu kullanır. Önce dal, oturum açma yöntemi veya klasör seçmek için bir depoya uzun basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонування використовує ваш обліковий запис GitHub і типове розташування. Натисніть і утримуйте репозиторій, щоб спершу вибрати гілку, спосіб входу чи папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone dùng tài khoản GitHub của bạn và vị trí lưu mặc định. Nhấn giữ một kho lưu trữ để chọn nhánh, cách đăng nhập hoặc thư mục trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆将使用你的 GitHub 账户和默认保存位置。长按仓库可先选择分支、登录方式或文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製會使用你的 GitHub 帳號和預設儲存位置。長按儲存庫可先選擇分支、登入方式或資料夾。"
          }
        }
      }
    },
