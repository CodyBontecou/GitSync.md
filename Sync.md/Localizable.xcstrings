    "Switch branches, view diffs, browse commit history, manage tags, and resolve conflicts — real Git, not a watered-down sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبديل الفروع، وعرض الاختلافات، وتصفح سجل الالتزام، وإدارة العلامات، وحل التعارضات - Git حقيقي، وليس مزامنة مخففة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift filialer, se forskelle, gennemse commit-historik, administrer tags og løs konflikter - ægte Git, ikke en udvandet synkronisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweige wechseln, Unterschiede anzeigen, Commit-Verlauf durchsuchen, Tags verwalten und Konflikte lösen – echtes Git, keine verwässerte Synchronisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie de rama, vea diferencias, explore el historial de confirmaciones, administre etiquetas y resuelva conflictos: Git real, no una sincronización diluida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda haarat, näytä eroja, selaa toimitushistoria, hallintaa tageja, ja ratkaista konfliktit - todellinen Git, ei vedetty-down sync."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ":切换分支,afficher les différences, parcourir l'historique des commits, gérer les étiquettes et résoudre les conflits — fonctionnalités réelles Git, ce n'est pas une synchronisation diluée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": שינויי שורשים, הצגת הבדלים, בדיקת היסטוריית הקומיטים, ניהול תגов ופתרון התנגשויות – פונקציונלי Git– לא סינק מופחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्विच शाखाएँ, डिफ़रेंस देखें, कमिट इतिहास पर नज़र रखें, टैग्स को प्रबंधित करें और संघर्षों का समाधान करें — वास्तविक सुविधा। Git, कोई सरलीकृत सिंक नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": szakaszok lekérdezése, különbségek megjelenítése, bejelentések története áttekintése, tagok kezelése és konfliktusok oldása – valódi funkció Git– nem csökkentett szinkronizáció."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Mengganti cabang repositori, melihat perbedaan kode, menjelajahi riwayat commit, mengelola tag, serta menyelesaikan konflik — benar-benar tersedia Git, bukan sinkronisasi yang telah diperlancarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": gestire i rami, visualizzare i diff, esplorare l'history dei commit, gestire i tag e risolvere i conflitti — funzionalità reale Git, non una sincronizzazione appiattita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ブランチの切り替え、差分比較、コミット履歴の閲覧、タグの管理、およびコンフリクトの解決 ― 現実的 Gitは、弱められた同期情報ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 브랜치 간 전환, diff 비교, 커밋 이력 탐색, 태그 관리 및 충돌 해결 — 실제 기능 Git는 약화된 동기화가 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Skift mellom grenser, se diff-er, bla gjennom kommittihistorikk, administrere etiketter og løse konflikter – virkelig funksjon Git, ikke en avfløret synkronisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": takken wijzigen, verschillen bekijken, de commitgeschiedenis doorzoeken, tags beheren en conflicten oplossen — werkelijk mogelijk Git, niet een verzwakte synchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": przełączanie gańków, przeglądanie różnic, przeglądanie historii commitów, zarządzanie tagami oraz rozwiązywanie konfliktów – funkcje rzeczywiste Git– nie jest to osłabiona synchronizacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Alterar ramos, visualizar diferenças, navegar pelo histórico de commits, gerenciar tags e resolver conflitos — funcionalidade real Git, não é uma sincronização enfraquecida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": переключение между ветвями, сравнение изменений, просмотр истории коммитов, управление тегами и устранение конфликтов — поддерживается на практике Git— это не упрощённая синхронизация."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Skalanderar grenar, visar skillnader, körgår den kommithistorik, hanterar etiketter och löser konflikter – verkligen funktionsfullt Git, inte en avlägset synkronisering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": สามารถสลับสาขา, ดูความแตกต่างระหว่างโค้ด, เข้าถึงประวัติการคอมมิต, จัดการแท็ก และแก้ไขความขัดแย้งได้ — ใช้งานจริง Gitไม่ใช่การซิงค์ที่ถูกปรับลดความเข้มข้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": dalları değiştirme, farkları görüntüleme, commit tarihi gözden geçirme, etiketleri yönetme ve çelişkileri çözme — gerçek işlevler Git, azaltılmış bir sink değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": переключати відгалуження, візуалізувати різниці, переглядати історію комітів, керувати тегами та вирішувати конфлікти — справжні можливості Git— це не зменшене синхронізація."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Chuyển đổi nhánh, xem sự khác biệt giữa các phiên bản, duyệt lịch sử commit, quản lý thẻ và giải quyết xung đột — khả năng thực tế Git, không phải là phiên bản đồng bộ đã được tinh giản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：切换分支、查看差异、浏览提交历史、管理标签及解决冲突——功能齐全 Git，并非水洗版同步版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：切換分支、查看差異、瀏覽提交歷史、管理標籤及解決衝突——功能齊全 Git，併非水洗版衕步版本。"
          }
        }
      },
      "extractionState": "stale"
    },
