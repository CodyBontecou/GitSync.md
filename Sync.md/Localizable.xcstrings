    "Both automatic actions are off. No background Git operation will run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلا الإجراءين التلقائيين متوقف. لن تعمل أي عملية Git في الخلفية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge automatiske handlinger er slået fra. Der køres ingen Git-handlinger i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide automatischen Aktionen sind aus. Es läuft keine Git-Operation im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas acciones automáticas están desactivadas. No se ejecutará ninguna operación de Git en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat automaattiset toiminnot ovat pois päältä. Taustalla ei suoriteta Git-toimintoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux actions automatiques sont désactivées. Aucune opération Git ne s’exécutera en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי הפעולות האוטומטיות כבויות. שום פעולת Git לא תרוץ ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों स्वचालित कार्रवाइयाँ बंद हैं। कोई बैकग्राउंड Git ऑपरेशन नहीं चलेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindkét automatikus művelet ki van kapcsolva. Háttérben nem fut Git-művelet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua tindakan otomatis nonaktif. Tidak ada operasi Git yang berjalan di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le azioni automatiche sono disattivate. Nessuna operazione Git verrà eseguita in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の自動アクションがオフです。バックグラウンドで Git 操作は実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 자동 동작이 모두 꺼져 있습니다. 백그라운드 Git 작업이 실행되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge automatiske handlinger er av. Ingen Git-operasjoner kjører i bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide automatische acties staan uit. Er wordt geen Git-bewerking op de achtergrond uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie automatyczne akcje są wyłączone. Żadna operacja Git nie zostanie uruchomiona w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas ações automáticas estão desativadas. Nenhuma operação Git será executada em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба автоматических действия выключены. Фоновые операции Git выполняться не будут."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda automatiska åtgärderna är avstängda. Ingen Git-åtgärd körs i bakgrunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานอัตโนมัติทั้งสองปิดอยู่ จะไม่มีการทำงาน Git ในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki otomatik eylem de kapalı. Arka planda hiçbir Git işlemi çalışmayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві автоматичні дії вимкнено. Жодна фонова операція Git не виконуватиметься."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai tác vụ tự động đều tắt. Sẽ không có thao tác Git nào chạy trong nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项自动操作均已关闭。不会在后台运行任何 Git 操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項自動動作皆已關閉。不會在背景執行任何 Git 操作。"
          }
        }
      }
    },
    "Both automatic actions are off. Wake delivery may remain enrolled, but no background Git operation will run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلا الإجرائين التلقائيين متوقف. قد يظل تسليم الإيقاظات مسجلًا، لكن لن تُنفّذ أي عملية Git في الخلفية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge automatiske handlinger er slået fra. Vækninglevering kan forblive tilmeldt, men ingen Git-handling i baggrunden vil køre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide automatischen Aktionen sind deaktiviert. Die Aufweckzustellung kann weiterhin registriert sein, aber es wird keine Git-Operation im Hintergrund ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos acciones automáticas están desactivadas. La entrega de activaciones puede seguir registrada, pero no se ejecutará ninguna operación de Git en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat automaattiset toiminnot ovat poissa käytöstä. Herätysten toimitus voi pysyä rekisteröitynä, mutta taustalla ei suoriteta Git-toimintoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux actions automatiques sont désactivées. La réception des réveils peut rester inscrite, mais aucune opération Git en arrière-plan ne sera exécutée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי הפעולות האוטומטיות כבויות. שליחת ההתעוררויות עשויה להישאר רשומה, אך שום פעולת Git ברקע לא תתבצע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों स्वचालित कार्रवाइयाँ बंद हैं। wake की डिलीवरी का नामांकन बना रह सकता है, लेकिन कोई भी बैकग्राउंड Git ऑपरेशन नहीं चलेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindkét automatikus művelet ki van kapcsolva. Az ébresztési kézbesítés regisztrációja megmaradhat, de háttérbeli Git-művelet nem fut le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua tindakan otomatis nonaktif. Pendaftaran pengiriman wake mungkin tetap ada, tetapi tidak ada operasi Git latar belakang yang akan berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le azioni automatiche sono disattivate. La consegna dei risvegli può restare registrata, ma non verrà eseguita alcuna operazione Git in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動操作は両方ともオフです。起動通知の登録は残る場合がありますが、バックグラウンドで Git 操作は実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 자동 작업이 모두 꺼져 있습니다. 깨우기 신호 전달 등록은 유지될 수 있지만 백그라운드 Git 작업은 실행되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge automatiske handlinger er av. Vekking kan fortsatt være registrert, men ingen Git-operasjon kjøres i bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide automatische acties zijn uitgeschakeld. De registratie voor weksignalen kan behouden blijven, maar er wordt geen Git-bewerking op de achtergrond uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie czynności automatyczne są wyłączone. Dostarczanie wybudzeń może pozostać aktywne, ale żadna operacja Git nie zostanie wykonana w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas ações automáticas estão desativadas. A entrega de ativações pode continuar inscrita, mas nenhuma operação Git será executada em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба автоматических действия выключены. Доставка пробуждений может оставаться зарегистрированной, но операции Git в фоне выполняться не будут."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda automatiska åtgärderna är avstängda. Väckningsleveransen kan fortfarande vara registrerad, men ingen Git-operation körs i bakgrunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานอัตโนมัติทั้งสองรายการปิดอยู่ การลงทะเบียนรับสัญญาณปลุกอาจยังคงอยู่ แต่จะไม่มีการทำงาน Git ในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki otomatik eylem de kapalıdır. Uyandırma teslimatı kayıtlı kalabilir ancak arka planda hiçbir Git işlemi çalışmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві автоматичні дії вимкнено. Реєстрація доставки сигналу пробудження може залишитися, але жодна фонова операція Git не виконуватиметься."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai thao tác tự động đều đã tắt. Dịch vụ đánh thức có thể vẫn được đăng ký, nhưng sẽ không có thao tác Git nào chạy trong nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个自动操作均已关闭。唤醒投递可能仍保持注册，但后台不会运行任何 Git 操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個自動操作均已關閉。喚醒傳送可能仍保持註冊，但背景不會執行任何 Git 操作。"
          }
        }
      },
      "extractionState": "stale"
    },
