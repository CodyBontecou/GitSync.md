            "state": "translated",
            "value": ": не вдалося оновити origin (дистанційний): %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thất bại trong việc cập nhật origin (cổng điều khiển từ xa): %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新失败 origin 远程： %@"
          }
