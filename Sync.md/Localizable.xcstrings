    "Local edits block this pull": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمليات التحرير المحلية تمنع هذا السحب"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale redigeringer blokerer denne pull"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Änderungen blockieren diesen Pull"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ediciones locales bloquean esta extracción"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset muokkaukset estävät vetoa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications locales bloquent cette traction"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": עריכות מקומיות מונעות את ה-\"pull\" הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्थानीय संपादन इस पुल को रोकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": helyi módosítások elkerülik ezt a kiválasztást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Edisi lokal menghambat operasi pull ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": le modifiche locali bloccano questo estratto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカル編集により、このプル操作がブロックされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬 편집이 이 패ulling을 차단합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale redigeringer blokkerer denne pullen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokaal bewerken blokkeert deze pull."
          }
        },
        "pl": {
