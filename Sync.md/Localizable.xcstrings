    "Sign in again to keep syncing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول مجددًا لمواصلة المزامنة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind igen for at fortsætte synkroniseringen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut anmelden, um weiter zu synchronisieren"
