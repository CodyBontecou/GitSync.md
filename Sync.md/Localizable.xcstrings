          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Token không hợp lệ hoặc đã hết hạn. Vui lòng đăng xuất và đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：令牌无效或已过期。请退出登录后重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：令牌無效或已過期。請退齣登録後重新登録。"
          }
        }
      }
