    "%@:%@ presented a different SSH host key for a previously pinned key type (%@).\n\nPreviously trusted:\n%@\n\nNew key:\n%@\n\nDo not trust the new key unless you intentionally rotated the server's SSH host key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ عرض مختلف SSH مفتاح مضيف لنوع مفتاح مثبت مسبقًا (%@).\n\nموثوق به سابقًا:\n%@\n\nمفتاح جديد:\n%@\n\nلا تثق في المفتاح الجديد إلا إذا قمت بالتدوير المتعمد للخادم SSH مفتاح المضيف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Præsenterede et andet SSH Hovednyckel for en tidligere fastlagt nyckeltype (%@).\n\nTidligere pålidelig:\n%@\n\nNy nøgle:\n%@\n\nTror ikke på den nye nøgle, medmindre du bevidst har roteret serverens nøgle. SSH Hovednyckel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ präsentierte etwas anderes SSH Host-Schlüssel für einen zuvor festgelegten Schlüsseltyp (%@).\n\nFrüher vertraut:\n%@\n\nNeuer Schlüssel:\n%@\n\nVertrauen Sie dem neuen Schlüssel nicht, es sei denn, Sie haben den Server bewusst gedreht. SSH Host-Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Presentó algo diferente. SSH Clave anfitriona para un tipo de clave previamente fijada (%@).\n\nAnteriormente confiable:\n%@\n\nNueva clave:\n%@\n\nNo confíe en la nueva llave a menos que haya girado intencionadamente el servidor. SSH Clave de host."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ Esiteltiin erilainen tapa SSH Host-avain aiemmin kiinnitettyyn avaintyypiin (%@).\n\nAiemmin luotettu:\n%@\n\nUusi avain:\n%@\n\nÄlä luota uuteen avaimelle, ellei olet tarkoituksellisesti kääntänyt palvelinta. SSH Host-avain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ a présenté quelque chose de différent SSH Clé hôte pour un type de clé précédemment fixée (%@).\n\nAutrefois de confiance :\n%@\n\nNouvelle clé :\n%@\n\nN'appelez pas la nouvelle clé en toute confiance, sauf si vous avez intentionnellement tourné le serveur. SSH Clé hôte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
