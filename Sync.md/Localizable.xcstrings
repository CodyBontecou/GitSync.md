    "Git metadata was preserved, but the repository connection could not be restored: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ ببيانات Git الوصفية، لكن تعذّرت استعادة اتصال المستودع: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-metadata blev bevaret, men forbindelsen til repositoryet kunne ikke gendannes: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-Metadaten wurden beibehalten, aber die Repository-Verbindung konnte nicht wiederhergestellt werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos de Git se conservaron, pero no se pudo restaurar la conexión del repositorio: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-metatiedot säilytettiin, mutta tietovaraston yhteyttä ei voitu palauttaa: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées Git ont été conservées, mais la connexion au dépôt n’a pas pu être restaurée : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטא-נתוני Git נשמרו, אך לא ניתן היה לשחזר את החיבור למאגר: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git मेटाडेटा सुरक्षित रखा गया, लेकिन रिपॉज़िटरी कनेक्शन बहाल नहीं हो सका: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git-metaadatok megmaradtak, de a tárolókapcsolatot nem sikerült visszaállítani: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata Git dipertahankan, tetapi koneksi repositori tidak dapat dipulihkan: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I metadati Git sono stati conservati, ma non è stato possibile ripristinare la connessione al repository: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git メタデータは保持されましたが、リポジトリの接続を復元できませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 메타데이터는 보존되었지만 저장소 연결을 복원할 수 없습니다: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-metadata ble bevart, men repositorietilkoblingen kunne ikke gjenopprettes: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-metadata is behouden, maar de repositoryverbinding kon niet worden hersteld: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadane Git zostały zachowane, ale nie udało się przywrócić połączenia z repozytorium: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os metadados Git foram preservados, mas não foi possível restaurar a conexão do repositório: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные Git сохранены, но подключение к репозиторию восстановить не удалось: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-metadata bevarades, men anslutningen till arkivet kunde inte återställas: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บเมทาดาทา Git ไว้แล้ว แต่ไม่สามารถกู้คืนการเชื่อมต่อที่เก็บได้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git meta verileri korundu ancak depo bağlantısı geri yüklenemedi: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Метадані Git збережено, але підключення до репозиторію не вдалося відновити: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siêu dữ liệu Git đã được giữ nguyên, nhưng không thể khôi phục kết nối kho lưu trữ: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 元数据已保留，但无法恢复仓库连接：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 中繼資料已保留，但無法恢復儲存庫連線：%@"
          }
        }
      }
    },
    "Git references updated, but the working tree checkout needs attention. Concurrent local bytes were preserved: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث مراجع Git، لكن checkout لشجرة العمل يتطلب الانتباه. تم الحفاظ على البايتات المحلية المتزامنة: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-referencerne blev opdateret, men checkout af worktree kræver opmærksomhed. Samtidige lokale bytes blev bevaret: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-Referenzen wurden aktualisiert, aber der Checkout des Worktrees erfordert Aufmerksamkeit. Gleichzeitig vorhandene lokale Bytes wurden bewahrt: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las referencias de Git se han actualizado, pero el checkout del worktree requiere atención. Se han conservado los bytes locales simultáneos: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-viitteet päivitettiin, mutta worktreen checkout vaatii huomiota. Samanaikaiset paikalliset tavut säilytettiin: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les références Git ont été mises à jour, mais le checkout du working tree nécessite votre attention. Les octets locaux concurrents ont été préservés : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפניות Git עודכנו, אך ה־checkout של עץ העבודה דורש תשומת לב. בתים מקומיים מקבילים נשמרו: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git संदर्भ अपडेट हो गए, लेकिन worktree checkout पर ध्यान देना आवश्यक है। समानांतर स्थानीय बाइट सुरक्षित रखे गए: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git-referenciák frissültek, de a working tree checkoutja figyelmet igényel. Az egyidejű helyi bájtokat megőriztük: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Referensi Git diperbarui, tetapi checkout working tree memerlukan perhatian. Byte lokal yang bersamaan dipertahankan: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I riferimenti Git sono stati aggiornati, ma il checkout del worktree richiede attenzione. I dati locali concorrenti sono stati preservati: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git の参照は更新されましたが、worktree の checkout に注意が必要です。競合したローカルのバイト列は保持されました: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 참조는 업데이트되었지만 worktree checkout에 주의가 필요합니다. 동시에 변경된 로컬 바이트는 보존되었습니다: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-referansene ble oppdatert, men checkout av worktree krever oppmerksomhet. Lokale byte fra samtidige endringer ble bevart: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Git-verwijzingen zijn bijgewerkt, maar de checkout van de worktree vereist aandacht. Gelijktijdige lokale bytes zijn behouden: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencje Git zostały zaktualizowane, ale checkout drzewa roboczego wymaga uwagi. Równoczesne lokalne dane zachowano: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As referências Git foram atualizadas, mas o checkout da árvore de trabalho requer atenção. Os dados locais concorrentes foram preservados: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки Git обновлены, но checkout рабочего дерева требует внимания. Параллельные локальные данные сохранены: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-referenserna uppdaterades, men checkout av arbetsträdet kräver åtgärd. Samtidiga lokala byte bevarades: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตข้อมูลอ้างอิง Git แล้ว แต่ checkout ของ working tree ต้องตรวจสอบ ข้อมูลในเครื่องที่เกิดขึ้นพร้อมกันได้รับการเก็บรักษาไว้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git başvuruları güncellendi ancak worktree checkout işlemi ilgilenmenizi gerektiriyor. Eşzamanlı yerel baytlar korundu: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання Git оновлено, але checkout робочого дерева потребує уваги. Паралельні локальні байти збережено: %@"
