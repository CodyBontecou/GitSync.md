    "Every repository covered": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل كل مستودع"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle arkiver er dækket"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Repositorys abgedeckt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los repositorios incluidos"
          }
        },
        "fi": {
          "stringUnit": {
