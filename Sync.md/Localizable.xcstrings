          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "— Використання GitHub : вход до системи, токен,\nКлюч SSH або публічний доступ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Sử dụng GitHub : đăng nhập, mã xác thực, một\nChìa khóa SSH hoặc quyền truy cập công khai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用说明 GitHub 登录、令牌、 SSH 密钥或公共访问权限。"
