    "Scan GitSync.md storage or any folder you grant access to. Every git working copy inside is listed for one-tap reconnect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص مساحة تخزين GitSync.md أو أي مجلد تمنحه صلاحية الوصول. ستُدرج كل نسخة عمل من Git بداخله لإعادة ربطها بنقرة واحدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan GitSync.md-lagringspladsen eller en mappe, du giver adgang til. Hver Git-arbejdskopi i den vises, så den kan tilknyttes igen med ét tryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie den GitSync.md-Speicher oder einen beliebigen Ordner, für den Sie Zugriff gewähren. Jede darin enthaltene Git-Arbeitskopie wird zur erneuten Verknüpfung mit einem Tippen aufgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore el almacenamiento de GitSync.md o cualquier carpeta a la que conceda acceso. Se mostrarán todas las copias de trabajo de Git que contenga para volver a enlazarlas con un toque."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista GitSync.md-tallennustila tai mikä tahansa kansio, johon myönnät käyttöoikeuden. Kaikki sen sisältämät Git-työkopiot luetellaan uudelleenlinkitystä varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez le stockage GitSync.md ou tout dossier auquel vous autorisez l’accès. Chaque copie de travail Git qu’il contient est répertoriée pour être reconnectée en un geste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לסרוק את אחסון GitSync.md או כל תיקייה שהענקת אליה גישה. כל עותק עבודה של Git בתוכה יוצג לצורך קישור מחדש בהקשה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md स्टोरेज या ऐक्सेस दिए गए किसी भी फ़ोल्डर को स्कैन करें। उसमें मौजूद हर Git वर्किंग कॉपी एक टैप में दोबारा कनेक्ट करने के लिए सूचीबद्ध होगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizsgálja meg a GitSync.md-tárhelyet vagy bármely mappát, amelyhez hozzáférést ad. A benne lévő összes Git-munkapéldány megjelenik, így egy koppintással újracsatlakoztatható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai penyimpanan GitSync.md atau folder apa pun yang Anda izinkan untuk diakses. Setiap salinan kerja Git di dalamnya akan dicantumkan agar dapat dihubungkan kembali dengan satu ketukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza lo spazio di archiviazione di GitSync.md o qualsiasi cartella a cui concedi l’accesso. Ogni copia di lavoro Git al suo interno verrà elencata per consentire il ricollegamento con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.mdストレージまたはアクセスを許可した任意のフォルダをスキャンします。その中のすべてのGit作業コピーが一覧表示され、1回のタップで再接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md 저장 공간 또는 접근을 허용한 폴더를 스캔합니다. 그 안의 모든 Git 작업 복사본이 표시되므로 탭 한 번으로 다시 연결할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann GitSync.md-lagringen eller en mappe du gir tilgang til. Alle Git-arbeidskopier i den vises, slik at de kan kobles til igjen med ett trykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan de GitSync.md-opslag of een map waartoe u toegang verleent. Elke Git-werkkopie erin wordt weergegeven, zodat u deze met één tik opnieuw kunt koppelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeskanuj miejsce przechowywania GitSync.md lub dowolny folder, do którego udzielisz dostępu. Każda zawarta w nim kopia robocza Git zostanie wyświetlona, aby można ją było ponownie połączyć jednym stuknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o armazenamento do GitSync.md ou qualquer pasta à qual você conceder acesso. Todas as cópias de trabalho do Git encontradas serão listadas para reconexão com um toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте хранилище GitSync.md или любую папку, к которой предоставите доступ. Все находящиеся внутри рабочие копии Git будут показаны для повторного подключения одним касанием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök igenom GitSync.md-lagringen eller valfri mapp som du beviljar åtkomst till. Alla Git-arbetskopior där visas så att de kan återanslutas med ett tryck."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนพื้นที่จัดเก็บ GitSync.md หรือโฟลเดอร์ใดก็ตามที่คุณอนุญาตให้เข้าถึง สำเนางาน Git ทั้งหมดภายในจะแสดงขึ้นเพื่อให้เชื่อมต่อใหม่ได้ในครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSync.md saklama alanını veya erişim izni verdiğiniz herhangi bir klasörü tarayın. İçindeki tüm Git çalışma kopyaları tek dokunuşla yeniden bağlanmak üzere listelenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проскануйте сховище GitSync.md або будь-яку папку, до якої надасте доступ. Усі робочі копії Git усередині буде перелічено для повторного підключення одним дотиком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét bộ nhớ GitSync.md hoặc bất kỳ thư mục nào bạn cấp quyền truy cập. Mọi bản làm việc Git bên trong sẽ được liệt kê để liên kết lại bằng một lần chạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 GitSync.md 储存空间或您授权访问的任何文件夹。其中的每个 Git 工作副本都会列出，以便轻点一下即可重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描 GitSync.md 儲存空間或您授權取用的任何檔案夾。其中的每個 Git 工作複本都會列出，以便點一下即可重新連接。"
          }
        }
      }
    },
