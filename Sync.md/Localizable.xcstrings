    "Clone any Git repository to your device — GitHub, self-hosted, SSH, or public remotes — and keep it in sync from your pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم باستنساخ أي مستودع Git على جهازك - GitHub أو الاستضافة الذاتية أو SSH أو أجهزة التحكم عن بعد العامة - واحتفظ به متزامنًا من جيبك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klon ethvert Git-lager til din enhed - GitHub, selv-hostet, SSH eller offentlige fjernbetjeninger - og hold det synkroniseret fra din lomme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonen Sie jedes Git-Repository auf Ihr Gerät – GitHub, selbst gehostet, SSH oder öffentliche Remotes – und halten Sie es von Ihrer Tasche aus synchron."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone cualquier repositorio Git en su dispositivo (GitHub, autohospedado, SSH o controles remotos públicos) y manténgalo sincronizado desde su bolsillo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloonaa kaikki Git-varastot laitteeseesi -. GitHub, itse isäntä, SSH, tai julkiset kaukosäätimet - ja pitää se synkronoituna taskustasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone tout Git référentiel à votre appareil- GitHub, auto-hébergé, SSH, ou télécommandes publiques-et le garder synchronisé de votre poche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": קлонן כל ערך\nהאחסון Git למכשירכם — GitHub, מותג מותן, SSH, או רמיטורים ציבוריים – והשמור על זה ביצוג תואם מהกระเปת שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": किसी भी प्रकार का क्लोन Git रिपॉजिटरी को आपके उपकरण पर स्थानांतरित करें — GitHub, स्वयं-होस्टेड, SSH, या सार्वजनिक रिमोट्स — और इसे अपने पॉकेट में सिंक करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– bármilyen másolat létrehozása Git adatmagazin az eszközeire – GitHub, saját környezetben futó, SSHvagy közösségi távvezérlők – és az adatokat a szállítóhoz is szinkronizálhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kloni mana pun\nMenyebarkan Git ke perangkat Anda — GitHub, self-hosted, SSH, atau remote publik — dan pertahankan sinkronisasi dari saku Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona qualsiasi\nScarica il repository Git sul tuo dispositivo — GitHub, self-hosted, SSH, o remote pubblici — e mantenetelo sincronizzato dal vostro portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：任意のクローン可能 Git リポジトリをデバイスに転送します — GitHub、自ホスト型 SSHまたは公共リモート——携帯に保存し、常に同期させましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 임의 복제 가능 Git 저장소를 기기로 전송합니다 — GitHub, 자체 호스팅형 SSH또는 공용 리모트를 사용하고, 휴대폰으로 실시간 동기화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloner hvilken som helst\nTransfere Git -repositoriet til ditt enhet — GitHub, selvhostet, SSH, eller offentlige fjernkontroller – og behold den i synk med din mobiltelefon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Alle klonen Git -repository naar uw apparaat — GitHub, zelfgehoste, SSH, of openbare afstandsbedieningen — en houd deze synchroon met uw zak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Klonuj wszystko\nPrzeniesienie repozytorium Git na urządzenie — GitHub, samostarczne hostingowe, SSH, czyli odbiorniki zdalne publiczne — a także utrzymuj je w synchronizacji z Twoim telefonem komórkowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clonar qualquer\nTransfira o repositório Git para seu dispositivo — GitHub, hospedado localmente, SSH, ou controles remotos públicos — e mantenha-os sincronizados a partir do seu bolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": клонировать любой\nСкопируйте репозиторий Git на ваше устройство — GitHub, самоуправляемый сервер, SSHили публичные дистанционные управляющие устройства — поддерживайте их в синхронизации из кармана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonera vilket som helst Git -lagringsplats till ditt enhet – GitHub, självhanterad, SSH, eller offentliga fjärrkontroller – och håll den synkroniserad från din ficka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับจำลองใดๆ\nส่ง Git repository ไปยังอุปกรณ์ของคุณ — GitHub, โฮสต์เอง SSHหรือรีโมตสาธารณะ — และรักษาความสอดคล้องของข้อมูลนี้จากกระเป๋าของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Herhangi bir klonlama Git depolama alanını cihazınızda — GitHub, kendi sunucusuyla çalışan, SSHveya kamu uzaktan kontrol cihazları — ve bunu poşetinizden hareketle uyumluluk halinde tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Копіювати будь-який\nЗавантаження репозиторію Git на ваше пристрій — GitHub, самостійно розміщений, SSH, або публічні дистанційні керування — і зберігайте їх у синхронному стані з вашою портативною пристроєм."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Sao chép bất kỳ\nChuyển hồ sơ Git đến thiết bị của bạn — GitHub, tự vận hành, SSH, hoặc các thiết bị điều khiển từ xa công cộng — và hãy giữ thiết bị này luôn đồng bộ với thiết bị của bạn ngay trong túi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆任意\n将 Git 存储库复制至您的设备—— GitHub，自托管式 SSH或公共遥控器——可将其保存在您的口袋中，并保持与设备同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剋隆任意\n將 Git 存儲庫複製至您的設備—— GitHub，自托管式 SSH或公共遙控器——可將其保存在您的口袋中，併保持與設備衕步。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Clone any repo into Files, write in Obsidian or anything else, and sync with one tap.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استنسخ أي مستودع إلى الملفات، واكتب في Obsidian أو أي تطبيق آخر، وزامن بضغطة واحدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klon et hvilket som helst repo til Filer, skriv i Obsidian eller noget andet, og synkroniser med ét tryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonen Sie jedes Repo in Dateien, schreiben Sie in Obsidian oder woanders und synchronisieren Sie mit einem Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona cualquier repo en Archivos, escribe en Obsidian o donde quieras y sincroniza con un toque."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloonaa mikä tahansa repo Tiedostoihin, kirjoita Obsidianissa tai muualla ja synkronoi yhdellä napautuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clonez n’importe quel dépôt dans Fichiers, écrivez dans Obsidian ou ailleurs, et synchronisez d’un seul toucher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שכפלו כל מאגר אל קבצים, כתבו ב-Obsidian או בכל יישום אחר, וסנכרנו בהקשה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी रिपो को फ़ाइल्स में क्लोन करें, Obsidian या किसी भी ऐप में लिखें, और एक टैप में सिंक करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Klónozzon bármilyen tárolót a Fájlokba, írjon az Obsidianben vagy bárhol, és szinkronizáljon egy koppintással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone repo apa pun ke File, menulis di Obsidian atau app lain, dan sinkronkan dengan satu ketukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona qualsiasi repo in File, scrivi in Obsidian o altrove e sincronizza con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんなリポジトリもファイルにクローンして、Obsidian などで書き、ワンタップで同期できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 저장소든 파일 앱에 클론하고, Obsidian 등에서 작성한 뒤 한 번의 탭으로 동기화하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klon et hvilket som helst repo til Filer, skriv i Obsidian eller noe annet, og synkroniser med ett trykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloon elke repo naar Bestanden, schrijf in Obsidian of elders en synchroniseer met één tik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonuj dowolne repozytorium do Plików, pisz w Obsidianie lub gdziekolwiek indziej i synchronizuj jednym stuknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone qualquer repo no Arquivos, escreva no Obsidian ou em qualquer outro app e sincronize com um toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонируйте любой репозиторий в Файлы, пишите в Obsidian или где угодно и синхронизируйте одним нажатием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klona valfritt arkiv till Filer, skriv i Obsidian eller något annat och synka med ett tryck."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone รีโปใดก็ได้ไปยังไฟล์ เขียนใน Obsidian หรือแอปใดก็ได้ แล้วซิงค์ด้วยการแตะครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir depoyu Dosyalar'a klonlayın, Obsidian'da veya başka bir yerde yazın ve tek dokunuşla eşzamanlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонуйте будь-який репозиторій у Файли, пишіть в Obsidian або деінде й синхронізуйте одним дотиком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone bất kỳ kho lưu trữ nào vào Tệp, viết trong Obsidian hoặc ứng dụng khác, và đồng bộ chỉ với một chạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将任意仓库克隆到“文件”中，用 Obsidian 或其他工具写作，一键同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將任何儲存庫複製到「檔案」中，用 Obsidian 或其他工具寫作，一鍵同步。"
          }
        }
      }
    },
