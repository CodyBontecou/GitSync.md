    "%lld large or binary files should be stored with Git LFS before committing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تخزين %lld ملفات كبيرة أو ثنائية باستخدام Git LFS قبل تنفيذ commit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld store eller binære filer bør gemmes med Git LFS, før du committer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld große oder binäre Dateien sollten vor dem Commit mit Git LFS gespeichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos grandes o binarios deberían guardarse con Git LFS antes del commit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld suurta tai binääritiedostoa kannattaa tallentaa Git LFS:llä ennen committia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers volumineux ou binaires devraient être stockés avec Git LFS avant le commit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאחסן %lld קבצים גדולים או בינאריים עם Git LFS לפני commit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld बड़ी या बाइनरी फ़ाइलों को commit से पहले Git LFS के साथ संग्रहीत करना चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nagy vagy bináris fájlt Git LFS-sel kellene tárolni a commit előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld file besar atau biner sebaiknya disimpan dengan Git LFS sebelum commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld file grandi o binari dovrebbero essere archiviati con Git LFS prima del commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個の大きなファイルまたはバイナリファイルは、コミット前に Git LFS で保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 또는 바이너리 파일 %lld개는 커밋하기 전에 Git LFS로 저장해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld store eller binære filer bør lagres med Git LFS før commit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld grote of binaire bestanden moeten vóór de commit met Git LFS worden opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duże lub binarne pliki (%lld) powinny być przechowywane w Git LFS przed utworzeniem commita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld arquivos grandes ou binários devem ser armazenados com Git LFS antes do commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больших или двоичных файлов: %lld. Перед commit их следует хранить в Git LFS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld stora eller binära filer bör lagras med Git LFS innan du gör commit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควรจัดเก็บไฟล์ขนาดใหญ่หรือไบนารี %lld ไฟล์ด้วย Git LFS ก่อน commit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld büyük veya ikili dosya, commit öncesinde Git LFS ile saklanmalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Великих або двійкових файлів: %lld. Перед commit їх слід зберігати в Git LFS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tệp lớn hoặc nhị phân nên được lưu bằng Git LFS trước khi commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个大文件或二进制文件应在提交前使用 Git LFS 存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
