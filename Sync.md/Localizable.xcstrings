    "Could not load the saved SSH key. Check the key format and passphrase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": لم يتم تحميل الملف المحفوظ.\nرمز SSH ؛ تحقق من تنسيق الرمز وعبارة التأمين.\nتم اختيار التحقق من"
          }
        },
        "da": {
