    "Anyone can see this repository and its files on GitHub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص رؤية هذا المستودع وملفاته على GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan se dette repository og dets filer på GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kann dieses Repository und seine Dateien auf GitHub sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede ver este repositorio y sus archivos en GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa voi nähdä tämän tietovaraston ja sen tiedostot GitHubissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut voir ce dépôt et ses fichiers sur GitHub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יכול לראות את המאגר הזה ואת הקבצים שלו ב-GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub पर कोई भी इस रिपॉज़िटरी और इसकी फ़ाइलों को देख सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bárki láthatja ezt a tárolót és a fájljait a GitHubon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun dapat melihat repositori ini dan file-nya di GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque può vedere questo repository e i suoi file su GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリとそのファイルは GitHub 上で誰でも閲覧できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 GitHub에서 이 저장소와 파일을 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan se dette repositoriet og filene på GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan deze repository en de bestanden ervan op GitHub zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może zobaczyć to repozytorium i jego pliki na GitHubie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode ver este repositório e seus arquivos no GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой может видеть этот репозиторий и его файлы на GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem som helst kan se det här arkivet och dess filer på GitHub."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนสามารถดูที่เก็บนี้และไฟล์บน GitHub ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depoyu ve dosyalarını GitHub'da herkes görebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто може бачити цей репозиторій і його файли на GitHub."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai cũng có thể xem kho lưu trữ này và các tệp của nó trên GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以在 GitHub 上查看此仓库及其文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以在 GitHub 上查看此儲存庫及其檔案。"
          }
        }
      }
    },
