        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ชื่อผู้เขียนไม่สามารถมีการเปลี่ยนบรรทัดหรือเครื่องหมาย Angle Bracket ได้"
          }
        },
        "tr": {
