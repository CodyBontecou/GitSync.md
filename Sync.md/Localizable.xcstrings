    "An active Background Sync subscription is required before background syncing can be enabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم اشتراك نشط في Background Sync قبل أن يمكن تمكين المزامنة في الخلفية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kræves et aktivt Background Sync-abonnement, før synkronisering i baggrunden kan aktiveres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aktives Background Sync-Abonnement ist erforderlich, bevor die Hintergrundsynchronisierung aktiviert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una suscripción activa a Background Sync para poder activar la sincronización en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustasynkronoinnin käyttöönotto edellyttää aktiivista Background Sync -tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement Background Sync actif est requis avant de pouvoir activer la synchronisation en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש מינוי פעיל ל-Background Sync לפני שניתן להפעיל סנכרון ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड सिंकिंग चालू करने से पहले एक सक्रिय Background Sync सदस्यता आवश्यक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A háttérbeli szinkronizálás bekapcsolásához aktív Background Sync-előfizetés szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan Background Sync yang aktif diperlukan sebelum sinkronisasi latar belakang dapat diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per attivare la sincronizzazione in background è necessario un abbonamento Background Sync attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド同期を有効にするには、有効な Background Sync サブスクリプションが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 동기화를 활성화하려면 유효한 Background Sync 구독이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et aktivt Background Sync-abonnement kreves før bakgrunnssynkronisering kan aktiveres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een actief Background Sync-abonnement is vereist voordat synchronisatie op de achtergrond kan worden ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed włączeniem synchronizacji w tle wymagana jest aktywna subskrypcja Background Sync."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário ter uma assinatura ativa do Background Sync antes de ativar a sincronização em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы включить фоновую синхронизацию, нужна активная подписка Background Sync."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En aktiv prenumeration på Background Sync krävs innan bakgrundssynkronisering kan aktiveras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีการสมัครใช้ Background Sync ที่ใช้งานอยู่จึงจะเปิดใช้การซิงค์ในเบื้องหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda eşzamanlama etkinleştirilmeden önce etkin bir Background Sync aboneliği gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перш ніж увімкнути фонову синхронізацію, потрібна активна підписка на Background Sync."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cần có gói đăng ký Background Sync đang hoạt động trước khi có thể bật tính năng đồng bộ trong nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须先有有效的 Background Sync 订阅，才能启用后台同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須先有有效的 Background Sync 訂閱，才能啟用背景同步。"
          }
        }
      }
    },
    "An active subscription is required to enable Background Sync.": {
      "localizations": {
        "ar": {
