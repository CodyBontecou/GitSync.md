    "Repository %@ was deleted by another operation; stale changes were not restored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستودع %@ تم حذفه بواسطة عملية أخرى ؛ لم تتم استعادة التغييرات التي لا معنى لها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאגר %@ נמחק על ידי פעולה אחרת; שינויים מעוקלים לא שוחזרו."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Var slettet ved en anden operation; forældede ændringer blev ikke genoprettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Wurde durch eine andere Operation gelöscht; veraltete Änderungen wurden nicht wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositorio %@ Fue eliminado mediante otra operación; los cambios obsoletos no se restauraron."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietokanta %@ Tiedosto poistettiin toisen operaation tuloksena; vanhentuneet muutokset eivät ole palautettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répertoire %@ A été supprimé par une autre opération ; les modifications obsolètes n'ont pas été restaurées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉजिटरी %@ यह किसी अन्य ऑपरेशन द्वारा हटा दिया गया था; पुराने परिवर्तनों को पुनर्स्थापित नहीं किया गया था।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adatmagázt %@ Ezt egy másik művelet törölte; a korábban már érvénytelenített módosításokat nem helyreállították."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori %@ Dihapus oleh operasi lain; perubahan yang sudah usang tidak dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riservorio %@ È stato eliminato da un'altra operazione; i cambiamenti obsoleti non sono stati ripristinati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリ %@ 別の操作によって削除されました。古い変更内容は復元されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
