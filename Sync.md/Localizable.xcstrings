    "All conflicts resolved. Complete or abort the merge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حل جميع التعارضات. أكمل أو ألغِ الدمج."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle konflikter er løst. Fuldfør eller afbryd fletningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Konflikte gelöst. Abschließen oder abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All conflicts resolved. Complete or abort the merge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los conflictos resueltos. Completa o cancela la fusión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki ristiriidat ratkaistu. Viimeistele tai keskeytä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les conflits sont résolus. Terminez ou annulez la fusion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההתנגשויות נפתרו. השלם או בטל את המיזוג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी विवाद हल हो गए। मर्ज पूरा करें या रद्द करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden ütközés feloldva. Fejezd be vagy szakítsd meg az összevonást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua konflik diselesaikan. Selesaikan atau batalkan penggabungan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i conflitti risolti. Completa o annulla l'unione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての競合が解消されました。マージを完了または中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 충돌이 해결되었습니다. 병합을 완료하거나 중단하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle konflikter er løst. Fullfør eller avbryt sammenslåingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle conflicten opgelost. Voltooi of annuleer de samenvoeging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie konflikty rozwiązane. Zakończ lub przerwij scalanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os conflitos resolvidos. Conclua ou cancele a mesclagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все конфликты разрешены. Завершите или отмените слияние."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla konflikter lösta. Slutför eller avbryt sammanfogningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขข้อขัดแย้งทั้งหมดแล้ว เสร็จสิ้นหรือยกเลิกการรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm çakışmalar çözüldü. Birleştirmeyi tamamlayın veya iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі конфлікти вирішено. Завершіть або скасуйте злиття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả xung đột đã được giải quyết. Hoàn tất hoặc hủy gộp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有冲突已解决。请完成或中止合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有衝突已解決。請完成或中止合併。"
          }
        }
      }
    },
    "All conflicts resolved. Continue or abort the rebase.": {
