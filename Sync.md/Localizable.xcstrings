          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống sẽ theo cài đặt Sáng hoặc Tối của iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
