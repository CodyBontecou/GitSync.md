        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase eljárása konfliktusokat eredményezett, amelyek manuális megoldásra szorulnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Proses rebase menghasilkan konflik yang memerlukan penyelesaian secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": la rebase ha generato conflitti che richiedono una risoluzione manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "のRebase処理により、手動での解決が必要なコンフリクトが発生しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
