    "Rebase aborted. Local and remote still diverge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase. المحلية والبعيدة لا تزال تتباعد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase afbrudt. Lokalt og fjerntliggende adskiller sig stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase abgebrochen. Lokal und Remote gehen immer noch auseinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase cancelada. Lo local y lo remoto aún divergen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "siirtymä keskeytetty. Paikalliset ja etäiset eroavat yhä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase avorté. Locaux et éloignés divergent encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": ה-\"Rebase\" נעצר – המיקום המקומי והRemotef עדיין שונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रीबेसिंग को रद्द कर दिया गया है। स्थानीय और दूरस्थ डेटा अभी भी भिन्न हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rebase elmaradt. A helyi és távoli adatok még mindig eltérnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rebase dibatalkan. Data lokal dan remote masih berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": la rebase è stata annullata; il locale e quello remoto continuano a divergere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：Rebase処理が中止されました。ローカルとリモートの状態は依然としてずれている状態です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase가 취소되었습니다. 로컬 및 원격 저장소는 여전히 서로 다르게 유지되어 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rebase er avbrutt. Lokal og fjern versjoner skiller seg fremdeles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rebase is beëindigd. De lokale en externe versies blijven nog steeds verschillend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": operacja rebase została przerwana; lokalne i odległe dane nadal różnią się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": A rebase foi abortada. Os valores locais e remotos ainda divergem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": операция переориентации была отменена; локальные и удалённые данные по-прежнему расходятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rebase avbrytad. Lokal och fjärrversioner fortsätter att skiljas åt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การปรับฐานข้อมูลถูกยกเลิก ทั้งข้อมูลท้องถิ่นและข้อมูลระยะไกลยังคงมีความแตกต่างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase işlemi durduruldu. Yerel ve uzaktaki veriler hâlâ farklıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": «Rebase» було припинено. Локальний і дистанційний ревізії все ще відрізняються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Quá trình Rebase đã bị hủy. Cả dữ liệu cục bộ và từ xa vẫn còn khác biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重基线操作已中止。本地与远程分支仍存在差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重基線操作已中止。本地與遠程分支仍存在差異。"
          }
        }
      }
    },
