          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan editan Anda disimpan ke stash terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia delle tue modifiche viene prima salvata nello stash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集内容のコピーが先にスタッシュに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 내용의 사본이 먼저 스태시에 저장됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kopi av endringene dine lagres først i stash."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst wordt een kopie van uw wijzigingen in de stash bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia Twoich zmian trafia najpierw do stash."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia das suas edições é salva no stash antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала копия ваших правок сохраняется в stash."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kopia av dina ändringar sparas först i stash."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาการแก้ไขของคุณจะถูกบันทึกไว้ใน stash ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce düzenlemelerinizin bir kopyası stash'e kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу копія ваших правок зберігається в stash."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bản sao các chỉnh sửa của bạn sẽ được lưu vào stash trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的编辑内容会先保存一份副本到储藏中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的編輯內容會先將副本儲存到儲藏中。"
          }
        }
      }
    },
    "A different branch is checked out. Open it to finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم سحب فرع مختلف. افتحه لإكمال العملية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden gren er tjekket ud. Åbn den for at gøre det færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Branch ist ausgecheckt. Öffnen, um abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra rama en checkout. Ábrelo para terminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloskuitattuna on eri haara. Viimeistele avaamalla se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre branche est extraite. Ouvrez-le pour terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ענף אחר נמצא ב-checkout. פתחו כדי להשלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरी ब्रांच checkout है। पूरा करने के लिए इसे खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másik ág van kiválasztva. Nyissa meg a befejezéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch lain sedang di-checkout. Buka untuk menyelesaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attivo un altro branch. Aprilo per completare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のブランチがチェックアウトされています。開いて完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 브랜치가 체크아웃되어 있습니다. 열어서 마무리하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen gren er sjekket ut. Åpne den for å fullføre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een andere branch uitgecheckt. Open hem om af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana jest inna gałąź. Otwórz, aby dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há outro branch em checkout. Abra para concluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрана другая ветка. Откройте, чтобы завершить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan branch är utcheckad. Öppna den för att slutföra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการ checkout สาขาอื่นอยู่ เปิดเพื่อดำเนินการให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir dal etkin. Tamamlamak için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано іншу гілку. Відкрийте, щоб завершити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang checkout một nhánh khác. Mở để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前检出的是另一个分支。打开以完成操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前簽出的是另一個分支。打開以完成操作。"
          }
        }
      }
    },
    "A folder publication is already running. Wait or cancel it before continuing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري نشر مجلد بالفعل. انتظر أو ألغِه قبل المتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En mappeudgivelse kører allerede. Vent, eller annuller den, før du fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ordnerveröffentlichung läuft bereits. Warten Sie oder brechen Sie sie ab, bevor Sie fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una publicación de carpeta en curso. Espera o cancélala antes de continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion julkaisu on jo käynnissä. Odota tai peru se ennen jatkamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une publication de dossier est déjà en cours. Attendez ou annulez-la avant de continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרסום תיקייה כבר מתבצע. המתינו או בטלו אותו לפני שתמשיכו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फ़ोल्डर प्रकाशन पहले से चल रहा है। जारी रखने से पहले प्रतीक्षा करें या इसे रद्द करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már fut egy mappa közzététele. Várjon, vagy szakítsa meg a folytatás előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Publikasi folder sudah berjalan. Tunggu atau batalkan sebelum melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già in corso una pubblicazione di cartella. Attendi o annullala prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダの公開がすでに実行中です。続行する前に完了を待つか、キャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 게시가 이미 진행 중입니다. 계속하기 전에 기다리거나 취소하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En mappepublisering pågår allerede. Vent eller avbryt den før du fortsetter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een mappublicatie. Wacht of annuleer die voordat u verdergaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Publikacja folderu już trwa. Poczekaj lub ją anuluj, zanim przejdziesz dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma publicação de pasta já está em andamento. Aguarde ou cancele antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикация папки уже выполняется. Дождитесь её или отмените, прежде чем продолжить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mapppublicering pågår redan. Vänta eller avbryt den innan du fortsätter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการเผยแพร่โฟลเดอร์กำลังทำงานอยู่ รอหรือยกเลิกก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasör yayımlama işlemi zaten sürüyor. Devam etmeden önce bekleyin veya iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публікація папки вже триває. Зачекайте або скасуйте її, перш ніж продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang có một lượt xuất bản thư mục chạy. Hãy đợi hoặc hủy trước khi tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有一个文件夹发布任务正在运行。请等待或取消后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有資料夾發佈作業正在執行。請等待或取消後再繼續。"
          }
        }
      }
    },
    "A folder with the same name already exists at the chosen location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد مجلد يحمل نفس الاسم بالفعل في الموقع المختار"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En mappe med samme navn findes allerede på den valgte placering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am gewählten Speicherort ist bereits ein Ordner mit demselben Namen vorhanden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una carpeta con el mismo nombre en la ubicación elegida"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saman nimen kansio on jo valitussa paikassa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier portant le même nom existe déjà à l&#39;emplacement choisi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ עם השם זה כבר קיים בمكان שנבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": चयनित स्थान पर उसी नाम का एक फोल्डर पहले से मौजूद है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Az elválasztott helyen már létezik ugyanolyan nevű mappa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Folder dengan nama yang sama sudah ada di lokasi yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": una cartella con lo stesso nome esiste già nella posizione selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：選択した場所に、同じ名前のフォルダが既に存在します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 선택한 위치에 동일한 이름의 폴더가 이미 존재합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": En mappen med samme navn finnes allerede på det valgte stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Er bestaat al een map met hetzelfde naam op de gekozen locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog o tym samym nazwie już istnieje w wybranym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uma pasta com o mesmo nome já existe no local selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": папка с таким же именем уже существует в выбранном месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mapp med samma namn finns redan på det valda platsen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": โฟลเดอร์ที่มีชื่อเดียวกันนี้ได้มีอยู่แล้วที่ตำแหน่งที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", seçilen konuda aynı adı olan bir klasör zaten mevcuttur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": папка з таким самим ім'ям вже існує у обранийому місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thư mục có tên tương tự đã tồn tại tại vị trí đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：在所选位置已存在同名文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：在所選位置已存在衕名文件夾。"
          }
        }
      }
    },
