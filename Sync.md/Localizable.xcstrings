    "Removes Git from the folder and keeps your notes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل Git من المجلد ويحتفظ بملاحظاتك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner Git fra mappen og beholder dine noter"
