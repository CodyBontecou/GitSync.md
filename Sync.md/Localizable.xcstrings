    "GitHub Account authentication is only available for GitHub HTTPS repositories while signed in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub مصادقة الحساب متاحة فقط لمستودعات GitHub HTTPS أثناء تسجيل الدخول.\nتعتبر حسابات"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Kontogodkendelse er kun tilgængelig for GitHub HTTPS-lagre, mens du er logget ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Die Kontoauthentifizierung ist nur für GitHub HTTPS-Repositorys verfügbar, wenn Sie angemeldet sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub La autenticación de cuenta solo está disponible para GitHub repositorios HTTPS mientras se inicia sesión.\nLas cuentas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub tilin tunnistus on käytettävissä vain käytettävissä GitHub HTTPS-varastot kirjautuessaan sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub est uniquement disponible pour GitHub référentiels HTTPS tandis que connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub אימות חשבון זמין רק עבור\nארכיונים HTTPS של GitHub בעת התחברות.\nהחשבונות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : खाता प्रमाणीकरण केवल निम्नलिखित के लिए उपलब्ध है। GitHub : साइन इन किए हुए स्थित HTTPS रिपॉजिटरी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : A számla authentifikálása csak az alábbi esetekben elérhető. GitHub HTTPS-repozitoriumok, ha bejelentkezve vagyunk.\nA"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Autentikasi akun hanya tersedia untuk GitHub : repositori HTTPS saat sedang login.\nAkun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : L'autenticazione del conto è disponibile solo per GitHub : repository HTTPS mentre si è autenticati.\nLe contabilità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ：アカウント認証は、以下の場合にのみ利用可能です。 GitHub ：サインイン中のHTTPSリポジトリ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 계정 인증은 다음 경우에만 가능합니다. GitHub : 로그인 상태에서 HTTPS 저장소에 접근할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Kontoinnlogging er kun tilgjengelig for GitHub HTTPS-repositorier når du er inloggedt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : Accountauthenticatie is alleen beschikbaar voor GitHub : HTTPS-repositoria bij ingelogd zijn.\nDe rekeningen van"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Autentyzacja kont jest dostępna wyłącznie dla GitHub : repositoriały HTTPS przy zalogowaniu się.\nKonto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : A autenticação de conta está disponível apenas para GitHub : repositórios HTTPS enquanto você está autenticado.\nAs contas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Аутентификация учетной записи доступна только для GitHub : доступ к репозиториям через HTTPS только при авторизации.\nСчета"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Kontoinnloggningsautentisering är endast tillgänglig för GitHub HTTPS-lagringsplatser när användaren är inloggad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub การยืนยันตัวตนบัญชีมีให้ใช้งานได้เฉพาะในกรณีดังต่อไปนี้เท่านั้น GitHub : สามารถเข้าถึง repositories HTTPS ได้เมื่อคุณเข้าสู่ระบบแล้ว\nบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hesap kimlik doğrulaması yalnızca aşağıdaki durumlarda kullanılabilir: GitHub : Giriş yapıldığınızda HTTPS depoları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Аутентифікація облікового запису доступна лише для GitHub : репозиторії HTTPS при увазі вхід.\nРахунки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Xác thực tài khoản chỉ có sẵn cho GitHub : Các kho dữ liệu HTTPS chỉ được truy cập khi đã đăng nhập.\nCác tài khoản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ：账户认证仅适用于以下情况 GitHub ：登录状态下可访问HTTPS存储库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ：賬戶認証僅適用於以下情況 GitHub ：登録狀態下可訪問HTTPS存儲庫。"
          }
        }
      }
    },
