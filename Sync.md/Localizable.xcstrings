    "Local On My iPhone folders and regular files up to 10 MiB.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلدات «على الـ iPhone» المحلية والملفات العادية حتى 10 MiB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale På min iPhone-mapper og almindelige filer op til 10 MiB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale „Auf meinem iPhone“-Ordner und normale Dateien bis 10 MiB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas locales de En mi iPhone y archivos normales de hasta 10 MiB."
          }
        },
