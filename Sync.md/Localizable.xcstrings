    "Safe pull-only updates when iOS allows background work": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديثات آمنة بنمط pull فقط عندما يسمح iOS بالعمل في الخلفية"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikre opdateringer udelukkende med pull, når iOS tillader baggrundsarbejde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Aktualisierungen ausschließlich per pull, wenn iOS Hintergrundarbeit zulässt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones seguras solo mediante pull cuando iOS permite trabajar en segundo plano"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvalliset vain pull-toimintoja käyttävät päivitykset, kun iOS sallii taustatyön"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour sûres uniquement par pull lorsqu’iOS autorise le travail en arrière-plan"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכוני pull בטוחים בלבד כאשר iOS מאפשר עבודה ברקע"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS के बैकग्राउंड कार्य की अनुमति देने पर सुरक्षित, केवल pull अपडेट"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztonságos, csak pull típusú frissítések, amikor az iOS engedélyezi a háttérmunkát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan aman khusus pull saat iOS mengizinkan pekerjaan latar belakang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamenti sicuri di solo pull quando iOS consente operazioni in background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がバックグラウンド処理を許可したときに安全な pull 専用更新を実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 백그라운드 작업을 허용할 때 안전한 pull 전용 업데이트"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trygge oppdateringer kun med pull når iOS tillater bakgrunnsarbeid"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veilige updates uitsluitend via pull wanneer iOS achtergrondwerk toestaat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpieczne aktualizacje wyłącznie przez pull, gdy iOS zezwala na pracę w tle"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações seguras somente por pull quando o iOS permite trabalho em segundo plano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасные обновления только через pull, когда iOS разрешает фоновую работу"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säkra uppdateringar enbart med pull när iOS tillåter bakgrundsarbete"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตอย่างปลอดภัยด้วย pull เท่านั้นเมื่อ iOS อนุญาตให้ทำงานในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS arka planda çalışmaya izin verdiğinde yalnızca güvenli pull güncellemeleri"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безпечні оновлення лише через pull, коли iOS дозволяє фонову роботу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật an toàn chỉ bằng pull khi iOS cho phép chạy nền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 允许后台运行时进行安全的仅 pull 更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 允許背景執行時進行安全的僅 pull 更新"
          }
        }
      },
      "extractionState": "stale"
    },
