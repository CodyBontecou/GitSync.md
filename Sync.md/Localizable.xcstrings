            "value": "Отметить как устранённое?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera som löst?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดให้ปัญหาได้รับการแก้ไขแล้ว?"
          }
        },
        "tr": {
