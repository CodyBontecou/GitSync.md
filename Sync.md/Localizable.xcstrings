    "Without GitHub: SSH, HTTPS tokens, any host, or local folders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دون GitHub: SSH أو رموز HTTPS أو أي مضيف أو مجلدات محلية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden GitHub: SSH, HTTPS-tokens, enhver vært eller lokale mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne GitHub: SSH, HTTPS-Tokens, beliebiger Host oder lokale Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin GitHub: SSH, tokens HTTPS, cualquier host o carpetas locales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman GitHubia: SSH, HTTPS-tunnukset, mikä tahansa palvelin tai paikalliset kansiot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans GitHub : SSH, jetons HTTPS, n’importe quel hôte ou dossiers locaux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי GitHub: ‏SSH, אסימוני HTTPS, כל מארח או תיקיות מקומיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub के बिना: SSH, HTTPS टोकन, कोई भी होस्ट, या स्थानीय फ़ोल्डर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nélkül: SSH, HTTPS-tokenek, bármely kiszolgáló vagy helyi mappák."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa GitHub: SSH, token HTTPS, host apa pun, atau folder lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza GitHub: SSH, token HTTPS, qualsiasi host o cartelle locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub なし: SSH、HTTPS トークン、任意のホスト、ローカルフォルダ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 없이: SSH, HTTPS 토큰, 모든 호스트 또는 로컬 폴더."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten GitHub: SSH, HTTPS-tokener, hvilken som helst vert eller lokale mapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder GitHub: SSH, HTTPS-tokens, elke host of lokale mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez GitHuba: SSH, tokeny HTTPS, dowolny host lub foldery lokalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem GitHub: SSH, tokens HTTPS, qualquer host ou pastas locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без GitHub: SSH, HTTPS-токены, любой хост или локальные папки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan GitHub: SSH, HTTPS-tokens, valfri värd eller lokala mappar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช้ GitHub: SSH, โทเคน HTTPS, โฮสต์ใดก็ได้ หรือโฟลเดอร์ในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub olmadan: SSH, HTTPS token'ları, herhangi bir sunucu veya yerel klasörler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без GitHub: SSH, HTTPS-токени, будь-який хост або локальні папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần GitHub: SSH, token HTTPS, mọi máy chủ hoặc thư mục cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 GitHub：SSH、HTTPS 令牌、任意主机或本地文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 GitHub：SSH、HTTPS 權杖、任何主機或本機資料夾。"
          }
        }
      }
    },
    "Without a default, repos save to Files › On My iPhone › GitSync.md": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون إعدادات افتراضية، يتم حفظ عمليات إعادة الشراء في الملفات › على iPhone › GitSync.md"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en standard, gentag gem til filer › På min iPhone › GitSync.md"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Standard werden Repos in Dateien gespeichert › Auf meinem iPhone › GitSync.md"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un valor predeterminado, los repositorios se guardan en Archivos › En mi iPhone › GitSync.md"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman oletusarvoa, tallennetaan tiedostoihin › Omalla iPhone › GitSync.md"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": En l'absence de valeur par défaut, les sauvegardes sont enregistrées dans « Files › On My » iPhone › GitSync.md"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללא ערך ברירת מחדל, הוראות ההתחזקות נשמרות ב-Files › On My iPhone › GitSync.md"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": डिफ़ॉल्ट के बिना, रिपोजिटरी File › On My में सहेज देते हैं। iPhone › GitSync.md"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ha nincs alapértelmezett beállítás, a repo adatokat a „Files › On My\" könyvtárba mentik. iPhone › GitSync.md"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa nilai default, repos akan disimpan ke Files › On My iPhone › GitSync.md"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": In assenza di valore predefinito, i depositi vengono salvati in Files › On My iPhone › GitSync.md"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：デフォルト設定がない場合、リポジトリは「Files › On My」に保存されます。 iPhone › GitSync.md"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 기본 설정이 없을 경우, 저장소는 '파일 › 내 폴더'에 저장됩니다. iPhone › GitSync.md"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Utelukkende uten standardverdi: repos opprettes i Filer › På min enhet iPhone › GitSync.md"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Zonder standaardwaarde worden de repos op 'Files › On My' opgeslagen. iPhone › GitSync.md"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– w przypadku braku ustawienia domyślnego, pliki są zapisywane do katalogu „Files › On My\". iPhone › GitSync.md"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem valor padrão, os repositórios são salvos em Arquivos › Em Meu iPhone › GitSync.md"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отсутствии значения по умолчанию репозиторий сохраняется в папку «Files › On My» iPhone › GitSync.md"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Utöver standardinställningen sparar reposen till Filer › På min dator iPhone › GitSync.md"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีค่าเริ่มต้น ระบบจะบันทึกข้อมูลลงในโฟลเดอร์ Files › On My iPhone › GitSync.md"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Mặcını belirlemeksizin, reposizyonlar 'Dosyalar › Benim' klasörüne kaydedilir. iPhone › GitSync.md"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без за замовчування, репозиторії зберігаються у «Файли › На мій» iPhone › GitSync.md"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nếu không có mặc định, các hồ sơ sẽ được lưu vào Files › On My. iPhone › GitSync.md"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：若未设置默认值，回购记录将保存至“文件 › 我的”目录下 iPhone › GitSync.md"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：若未設置默認值，迴購記録將保存至“文件 › 我的”目録下 iPhone › GitSync.md"
          }
        }
      }
    },
