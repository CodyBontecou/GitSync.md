          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Rebase-prosessen oppstod konflikter som krever manuell løsning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rebase heeft conflicten gegenereerd die handmatige oplossing vereisen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": operacja rebase wygenerowała konflikty wymagające ręcznego rozwiązywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
