        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune modification pour l’instant. Elles apparaissent ici pendant que vous écrivez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין שינויים. עריכות מופיעות כאן בזמן שאתם כותבים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई बदलाव नहीं। लिखते ही संपादन यहाँ दिखेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs módosítás. A szerkesztések írás közben jelennek meg itt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perubahan. Editan muncul di sini saat Anda menulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna modifica. Le modifiche appaiono qui mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ変更はありません。書くと編集内容がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 변경 사항이 없습니다. 작성하면 편집 내용이 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen endringer ennå. Endringer vises her mens du skriver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen wijzigingen. Wijzigingen verschijnen hier terwijl u schrijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zmian. Zmiany pojawiają się tu w trakcie pisania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma alteração ainda. As edições aparecem aqui conforme você escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменений пока нет. Правки появляются здесь по мере написания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga ändringar än. Ändringar visas här medan du skriver."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการเปลี่ยนแปลง การแก้ไขจะแสดงที่นี่ขณะที่คุณเขียน"
