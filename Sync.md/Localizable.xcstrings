            "state": "translated",
            "value": "Denne fil kan ikke redigeres som tekst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann nicht als Text bearbeitet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede editar como texto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä tiedostoa ei voi muokata tekstinä"
          }
        },
