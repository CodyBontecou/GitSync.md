    },
    "The destination branch differs from the reviewed commit. Its history has been preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختلف فرع الوجهة عن الـ commit الذي تمت مراجعته. تم الاحتفاظ بسجله."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinationsgrenen afviger fra det gennemgåede commit. Dens historik er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ziel-Branch unterscheidet sich vom geprüften Commit. Sein Verlauf wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rama de destino difiere del commit revisado. Su historial se ha conservado."
