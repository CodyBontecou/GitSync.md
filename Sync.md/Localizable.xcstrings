    "Choose automatic fast-forward pulls, automatic commit and push, or both whenever iOS grants background time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عمليات pull تلقائية نظيفة من نوع fast-forward، أو commit وpush تلقائيين، أو كليهما كلما منح iOS وقتًا للعمل في الخلفية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg automatiske fast-forward-pull, automatisk commit og push eller begge dele, når iOS giver baggrundstid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle automatische Fast-Forward-Pulls, automatisches Committen und Pushen oder beides, wenn iOS Hintergrundzeit gewährt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige pull automáticos fast-forward, commit y push automáticos, o ambos, cuando iOS conceda tiempo en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse automaattiset fast-forward-pullit, automaattinen commit ja push tai molemmat aina, kun iOS myöntää tausta-aikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des pull fast-forward automatiques, un commit et push automatiques, ou les deux lorsque iOS accorde du temps en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו pull אוטומטי מסוג fast-forward, commit ו־push אוטומטיים, או בשניהם כאשר iOS מעניק זמן רקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी iOS बैकग्राउंड समय दे, स्वचालित fast-forward pull, स्वचालित commit और push, या दोनों चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon automatikus fast-forward pullt, automatikus commitot és push-t, vagy mindkettőt, amikor az iOS háttéridőt biztosít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pull fast-forward otomatis, commit dan push otomatis, atau keduanya saat iOS memberikan waktu latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli pull automatici fast-forward, commit e push automatici oppure entrambe le opzioni quando iOS concede tempo in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がバックグラウンド時間を与えたときに、自動 fast-forward pull、自動 commit と push、またはその両方を選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 백그라운드 시간을 허용할 때 자동 fast-forward pull, 자동 commit 및 push 또는 둘 다를 선택합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg automatiske fast-forward-pull, automatisk commit og push eller begge deler når iOS gir tid i bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies automatische fast-forward-pulls, automatische commit en push, of beide wanneer iOS tijd op de achtergrond beschikbaar stelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz automatyczny pull fast-forward, automatyczny commit i push albo obie opcje, gdy iOS przyzna czas na działanie w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha pull fast-forward automático, commit e push automáticos ou ambos sempre que o iOS conceder tempo em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите автоматические pull fast-forward, автоматические commit и push или оба варианта, когда iOS предоставит время в фоне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj automatiska fast-forward-pull, automatisk commit och push eller båda när iOS ger tid i bakgrunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการ pull fast-forward อัตโนมัติ การสร้าง commit และ push อัตโนมัติ หรือทั้งสองอย่าง เมื่อใดก็ตามที่ iOS อนุญาตให้ทำงานเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS arka plan zamanı verdiğinde otomatik fast-forward pull’ları, otomatik commit ve push’ı veya ikisini birden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли iOS надає фоновий час, виберіть автоматичні pull типу fast-forward, автоматичні commit і push або обидва варіанти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn pull fast-forward tự động, commit và push tự động, hoặc cả hai khi iOS cấp thời gian chạy nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 提供后台时间时，可选择自动 fast-forward pull、自动 commit 和 push，或同时选择两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 提供背景時間時，可選擇自動 fast-forward pull、自動 commit 和 push，或同時選擇兩者。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Choose automatic pulls, separately consented automatic pushes, or both when iOS allows. Optional subscription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عمليات pull تلقائية، أو عمليات push تلقائية تتطلب موافقة منفصلة، أو كليهما عندما يسمح iOS. الاشتراك اختياري."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg automatiske pull, separat godkendte automatiske push eller begge dele, når iOS tillader det. Valgfrit abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
