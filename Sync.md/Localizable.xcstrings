    "Remove old on-device repository copies directly from the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإزالة نسخ المستودع القديمة الموجودة على الجهاز مباشرة من التطبيق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern gamle arkivkopier på enheden direkte fra appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie alte Repository-Kopien auf dem Gerät direkt aus der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimine las copias antiguas del repositorio del dispositivo directamente desde la aplicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista vanhat laitteiston kopiot suoraan sovelluksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les anciennes copies du référentiel sur l&#39;appareil directement depuis l&#39;application."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הסרת קבצי המאגרים הישנים על המכשיר ישירות מהapk."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": ऐप से पुराने ऑन-डिवाइस रिपॉजिटरी कॉपीज़ को सीधे हटा दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": eltávolítás az alkalmazásból a készülékre helyezett régi adatmagazin másolatainak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus salinan repositori lama di perangkat secara langsung dari aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": rimuovi direttamente dalle applicazioni le vecchie copie del repository sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：アプリ内から、既存のオンデバイスリポジトリコピーを直接削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 앱 내 기존 온디바이스 저장소 복사본을 직접 삭제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern gamle kopiene av på-enhetens lagringsmønster direkte fra appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Verwijder oude kopieën van het op de apparatuur gevestigde repository rechtstreeks uit de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Usunięcie starej kopii repositoria na urządzeniu bezpośrednio z aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Remova diretamente das cópias do repositório no dispositivo as versões antigas do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Удалите старые копии репозиториев на устройстве непосредственно из приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ta bort de gamla kopiorna av repositoryn på enheten direkt från appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ลบสำเนาคลังข้อมูลบนอุปกรณ์เก่าออกจากแอปโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Eski cihaz içi depolama kopyalarını doğrudan uygulamadan kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Видаліть старі копії репозиторію на пристрої безпосередньо з додатка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Xóa các bản sao kho lưu trữ cũ trên thiết bị trực tiếp từ ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：直接从应用中移除旧的设备端存储库副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：直接從應用中移除舊的設備端存儲庫副本。"
          }
        }
      }
    },
    "Remove without deleting files": {
      "localizations": {
