    "GitHub sign-in could not be verified. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub تعذر التحقق من تسجيل الدخول. يرجى المحاولة مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Log-ind-funktionen kunne ikke verificeres. Vær ved med at forsøge igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Die Anmeldung konnte nicht verifiziert werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub No se pudo verificar la autenticación. Por favor, inténtelo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Kirjautumista ei onnistunut vahvistaa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub L'authentification n'a pas pu être vérifiée. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub साइन-इन को सत्यापित नहीं किया जा सका। कृपया फिर से प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub A bejelentkezést nem sikerült ellenőrizni. Kérjük, próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Proses masuk tidak dapat diverifikasi. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub L'accesso non è stato verificato. Si prega di provare nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub サインインの認証に失敗しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 로그인 정보가 검증되지 않았습니다. 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Anmeldelse kunne ikke verifiseres. Vennligst prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub De aanmelding kon niet worden verificerd. Probeer dit opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Wход nie mógł zostać zweryfikowany. Proszę spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub A autenticação não pôde ser verificada. Por favor, tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Вход не удалось проверить. Пожалуйста, попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Anslutningen kunde inte verifieras. Vänligen försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ไม่สามารถยืนยันการเข้าสู่ระบบได้ กรุณาลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Giriş işlemi doğrulanamadı. Lütfen yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Вхід не було можливо підтвердити. Будь ласка, спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Việc đăng nhập không thể xác minh được. Vui lòng thử lại."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub אין אפשרות לאמת כניסה. נא לנסות שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
