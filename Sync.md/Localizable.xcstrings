    "Author Email is required before Git can create commits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب البريد الإلكتروني للمؤلف قبل أن يتمكن Git من إنشاء الالتزامات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Author Email er påkrævet, før Git kan oprette commits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse des Autors ist erforderlich, bevor Git Commits erstellen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere el correo electrónico del autor antes de que Git pueda crear confirmaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekijä Sähköposti vaaditaan ennen kuin Git voi luoda sitoumuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auteur L&#39;email est requis avant Git peut créer des commits."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– 이메יל של המחבר מצריך להתקיים לפני הפעולה. Git יכול ליצור קומיטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": लेखक का ईमेल पहले आवश्यक है। Git कमिट्स बना सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Az author e-mail címének bejegyzése előre kötelező. Git képes commitek létrehozására."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Email penulis wajib diisi sebelumnya. Git dapat membuat commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": l'indirizzo email dell'autore è obbligatorio prima di procedere. Git può creare commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：著者メールアドレスは事前に必須です。 Git はコミットを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 작성자 이메일은 입력해야 합니다. Git 는 커밋을 생성할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": E-postadresse for forfatter er obligatorisk før. Git kan lage committinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "is vereist. Git kan commits aanmaken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– adres e-mail autora jest wymagany przed przeprowadzeniem operacji. Git może tworzyć commity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O e-mail do autor é obrigatório antes de proceder. Git pode criar commits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": электронная почта автора обязательна к заполнению до этого шага. Git может создавать коммиты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": E-postadress för författaren krävs innan. Git kan skapa commitningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": จำเป็นต้องระบุอีเมลของผู้เขียนก่อน Git สามารถสร้างการยืนยันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yazar e-postası gereklidir. Git , commitler oluşturabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": електронна адреса автора обов'язкова для заповнення. Git може створювати коміті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Địa chỉ email của tác giả là bắt buộc trước khi thực hiện. Git có thể tạo commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：作者邮箱为必填项 Git 可创建提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：作者郵箱爲必填項 Git 可創建提交。"
          }
        }
      }
    },
