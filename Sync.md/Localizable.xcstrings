    "Add a Git remote or open an existing\nlocal repository to start syncing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف جهاز التحكم عن بعد لـ Git أو افتح مستودع \n المحلي الحالي لبدء المزامنة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en Git-fjernbetjening eller åbn et eksisterende\nlokalt lager for at starte synkronisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein Git-Remote hinzu oder öffnen Sie ein vorhandenes \nlocal-Repository, um die Synchronisierung zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue un control remoto de Git o abra un repositorio local \n existente para comenzar a sincronizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää Git-ohjelma\naloitetaan synkronoinnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un Git ou ouvrez une\nréférentiel local pour démarrer la synchronisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– הוספת Git – פתיחת נקודת רוחב או פתיחת נקודת קיים\n– מאגר מקומי להתחיל את הסינק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'Add' जोड़ें Git : रिमोट से या मौजूदा विकल्प को खोलें।\n: सिंक्रनाइज़ेशन शुरू करने के लिए स्थानीय रिपॉजिटरी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hozzáadás Git : távvezérléses vagy meglévő rendszer megnyitása\nhelyi adatmagazinból a szinkronizálás indítása."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan Git : mengakses dari jarak jauh atau membuka yang sudah ada\n: repositori lokal untuk memulai proses sinkronisasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un elemento Git : aprire da remoto o aprire un file esistente\n: il repository locale è pronto per iniziare la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：追加 Git ：リモートで、または既存のものをオープンします。\nローカルリポジトリで同期を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 Git : 원격으로 또는 기존을 열기\n지역 저장소에서 동기화를 시작합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til Git : Å åpne et eksisterende eller fjernet system\nlokale lagringsplattform for å starte synkroniseringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een toe Git : afstandelijk of bestaand openen\n: het lokale repository wordt gebruikt om de synchronisatie te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj Git : uruchomienie z odległości lub otwarcie istniejącego\n: lokalny repositoriusz do uruchomienia synchronizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar Git : abrir remotamente ou abrir um já existente\n: repositório local para iniciar a sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить Git : открыть удалённый или уже существующий элемент\n: используйте локальный репозиторий для запуска синхронизации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till Git : Öppna fjärranslutning eller en befintlig\nlokala lagringsplats för att starta synkroniseringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม Git : เปิดระยะไกลหรือเปิดไฟล์ที่มีอยู่แล้ว\n: ใช้คลังข้อมูลท้องถิ่นเพื่อเริ่มการซิงค์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bir öğe ekle Git : uzaktan veya mevcut sistemden açın\nyerel depoya uyumluluk başlatılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати Git : відкрити віддалене або існуюче\n: локальний репозиторій для запуску синхронізації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm Git : Kết nối từ xa hoặc mở tài khoản hiện có\n: Sử dụng kho lưu trữ cục bộ để bắt đầu quá trình đồng bộ hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Git ：远程或打开现有项\n本地仓库已准备开始同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Git ：遠程或打開現有項\n本地倉庫已準備開始衕步。"
          }
        }
      }
    },
