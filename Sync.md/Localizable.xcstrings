    "Repositories are linked to the GitHub account that added them, so switching accounts shows the matching repo list and uses the right credentials.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بحساب GitHub الذي أضافها، لذا فإن تبديل الحسابات يعرض قائمة الريبو المطابقة ويستخدم بيانات الاعتماد الصحيحة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositories er knyttet til GitHub-kontoen, der tilføjede dem, så skift af konti viser den matchende repo-liste og bruger de rigtige legitimationsoplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "-Repositorys sind mit dem GitHub-Konto verknüpft, das sie hinzugefügt hat, sodass beim Wechseln des Kontos die passende Repo-Liste angezeigt und die richtigen Anmeldeinformationen verwendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los repositorios están vinculados a la cuenta GitHub que los agregó, por lo que al cambiar de cuenta se muestra la lista de repositorios coincidentes y se utilizan las credenciales correctas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "versiovarastot GitHub tili, joka lisäsi ne, joten vaihtamalla tilejä näyttää vastaavan repo listan ja käyttää oikeita valtuuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sont liés au GitHub compte qui les a ajoutés, de sorte que les comptes de commutation affiche la liste de repo correspondant et utilise les bonnes informations d&#39;identification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– מאגרים קשורים ל-\nהחשבון GitHub הוסף את החשבונות האלה, ולכן העברת חשבון מראה את רשימת הרפוזים המתאימה ומשתמש בפרטי גישה הנכונים.\nהאחסונים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": रिपॉजिटरीज़ को इससे संबद्ध किया गया है। GitHub खाता जिसने उन्हें जोड़ा है, इसलिए खातों को स्विच करने पर मिलान वाली रिपो सूची दिखाई देती है तथा सही प्रमाणपत्रों का उपयोग किया जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "adatmagazinok az alábbihoz kapcsolódnak:\nA GitHub fiók azokat hozzáadta; ezért a fiókok átmenete megjeleníti az összehasonlító repositoryk listáját és a helyes bejelentkezési adatokat használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori terhubung ke\nAkun GitHub yang menambahkan mereka, sehingga proses pergantian akun akan menampilkan daftar repositori yang sesuai dan menggunakan kredensial yang benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": I repository sono collegati a\nIl conto GitHub ha aggiunto tali elementi; cambiando il conto viene visualizzata la lista corrispondente di repository e vengono utilizzate le credenziali corrette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リポジトリは以下にリンクされています。 GitHub は、これらの項目を追加したアカウントです。アカウント切り替えにより、一致するリポジトリリストが表示され、適切な認証情報が使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소는 다음에 연결되어 있습니다. GitHub 는 해당 항목을 추가한 계정입니다. 계정 전환 시 일치하는 리포 목록이 표시되며, 올바른 인증 정보가 사용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lagerene er knyttet til GitHub -konto som har lagt til dem; ved å skifte konto vises den passende repo-listen og de riktige autentiseringsopplysningene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repositories zijn gekoppeld aan de\nDe GitHub -account heeft hen toegevoegd; bij het wisselen van account wordt de overeenkomstige repositorylijst getoond en worden de juiste aanmeldgegevens gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Magazyny są powiązane z\nKonto GitHub dodalo te elementy, dlatego zmiana kont wyświetla odpowiedni listę repozytoriów oraz wykorzystuje poprawne dane logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Os repositórios estão ligados ao\nA conta GitHub adicionou-os; ao mudar de conta, é exibida a lista correspondente de repositórios e são utilizadas as credenciais corretas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозитории связаны с\nСчет GitHub добавил эти элементы, поэтому переключение счетов отображает соответствующий список репозиториев и использует правильные учетные данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Reposter är kopplade till GitHub -konto som har lagt till dem; vid bytning av konto visas den matchande repo-listan och används de rätta autentiseringsuppgifterna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": คลังข้อมูลถูกเชื่อมโยงกับ\nบัญชี GitHub ที่เพิ่มรายการเหล่านี้ ทำให้การสลับบัญชีสามารถแสดงรายการ repos ที่ตรงกันและใช้ข้อมูลผู้ใช้ที่ถูกต้องได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "depoları şu yapıya bağlanmıştır. GitHub , bu bilgileri ekleyen hesaptır; bu nedenle hesap değiştirme işlemi uygun repo listesini gösterir ve doğru kimlik bilgilerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозиторії пов'язані з\nЗнаходиться у рахунку GitHub , який їх додав; тому перехід між рахунками відображає відповідний список репозиторіїв і використовує правильні авторизаційні дані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các kho dữ liệu được liên kết với\nTài khoản GitHub đã thêm các tài khoản này; khi chuyển đổi tài khoản, danh sách repo tương ứng sẽ được hiển thị và hệ thống sẽ sử dụng thông tin đăng nhập phù hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储库已与以下对象关联： GitHub 账户负责添加这些条目，因此切换账户可显示对应的回购列表，并使用正确的凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存儲庫已與以下對象關聯： GitHub 賬戶負責添加這些條目，因此切換賬戶可顯示對應的迴購列錶，併使用正確的憑証。"
          }
        }
      }
    },
    "Repositories opened from existing Files folders are unlinked from GitSync.md without removing the original folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إلغاء ربط المستودعات المفتوحة من مجلدات الملفات الموجودة من GitSync.md بدون إزالة المجلد original.\nعنوان URL للمستودع"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Depoter, der åbnes fra eksisterende Filer-mapper, fjernes fra GitSync.md uden at fjerne mappen original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositorys, die aus vorhandenen Dateiordnern geöffnet werden, werden von GitSync.md getrennt, ohne dass der Ordner original entfernt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los repositorios abiertos desde carpetas de Archivos existentes se desvinculan de GitSync.md sin eliminar la carpeta original."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "nykyisistä tiedoston kansioista avatut versiovarastot GitSync.md poistamatta origina-kansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépôts ouverts à partir de dossiers de fichiers existants ne sont pas liés à partir de GitSync.md sans retirer le original dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שפתחו מ-foldרים של קבצים קיימים אינם מחוברים ל- GitSync.md ללא איפוסו origin– תיקייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": मौजूदा फ़ाइलों के फ़ोल्डरों से खुले रिपॉजिटरीज़, अनलिंक्ड हैं। GitSync.md — बिना किसी हटाए; originफ़ोल्डर में।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": az meglévő fájlok mappából nyitott adatmagazinok nem kapcsolódnak azzal. GitSync.md – a kivitel nélkül originmappában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repositori yang dibuka dari folder File yang sudah ada tidak terhubung dengan GitSync.md tanpa menghilangkan originpada folder.\nRepository"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": i repository aperti a partire da cartelle di file esistenti non sono collegati a GitSync.md senza rimuovere il originnella cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：既存の「Files」フォルダから開かれたリポジトリは、元の関連付けから解放されています。 GitSync.md ：取り外さずに originフォルダー内。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 기존의 Files 폴더에서 열린 저장소는 원래 연결된 대상과 해제되었습니다. GitSync.md – 제거하지 않고 origin폴더."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lager som åpnes fra eksisterende filmappeer er uforbindet med GitSync.md uten å fjerne det origin– mappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Repositories die zijn geopend uit bestaande 'Files'-mappen, zijn niet meer gekoppeld aan GitSync.md zonder het te verwijderen originin de map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Magazyny danych otwarte z istniejących katalogów plików nie są powiązane z tymi katalogami. GitSync.md bez usuwania\nFoldery origin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Os repositórios abertos a partir de pastas de arquivos existentes não estão vinculados a GitSync.md sem remover o originna pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозитории, открытые из существующих папок «Файлы», не связаны с основными источниками данных. GitSync.md без удаления origin— в папке.\nРепозиторий"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Reposter öppnade från befintliga filmappar är obindade från GitSync.md utan att ta bort origin-mappen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": คลังข้อมูลที่เปิดจากโฟลเดอร์ไฟล์ที่มีอยู่นั้นไม่ได้มีการเชื่อมโยงกับสิ่งอื่นแล้ว GitSync.md โดยไม่ต้องถอดออก originโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", mevcut Dosya klasörlerinden açılan depolamalar, diğer yapılarla bağlantılı değildir. GitSync.md , kaldırılmadan originklasörü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": репозиторії, відкрите з існуючих папок «Файли», не пов'язані з іншими об'єктами. GitSync.md без видалення originу папці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các kho dữ liệu được mở từ các thư mục File hiện có không còn liên kết với bất kỳ đối tượng nào. GitSync.md mà không cần tháo bỏ originthư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：从现有“Files”文件夹打开的存储库已与原位置断开链接。 GitSync.md ，无需拆卸 origin文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：從現有“Files”文件夾打開的存儲庫已與原位置斷開鏈接。 GitSync.md ，無需拆卸 origin文件夾。"
          }
        }
      }
    },
