    "GitHub sign-in now uses a private browser session so logging out and back in does not silently reuse the wrong browser account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub الآن جلسة متصفح خاصة، لذا فإن تسجيل الخروج والعودة لا يؤدي إلى إعادة استخدام حساب المتصفح الخاطئ بصمت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub log-in bruger nu en privat browsersession, så log ud og ind igen genbruger ikke den forkerte browserkonto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-Anmeldung wird jetzt eine private Browsersitzung verwendet, sodass beim Ab- und erneuten Anmelden nicht stillschweigend das falsche Browserkonto erneut verwendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub el inicio de sesión ahora utiliza una sesión de navegador privada, por lo que cerrar sesión y volver a iniciarla no reutiliza silenciosamente la cuenta de navegador incorrecta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rekisteröitynyt nyt yksityinen selaimen istunnossa, joten kirjautuminen ulos ja takaisin ei äänettömästi uudelleenkäyttöä väärä selaimen tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sign-in utilise maintenant une session de navigateur privé afin de se déconnecter et de revenir dans ne pas réutiliser silencieusement le mauvais compte de navigateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : הכניסה כעת משתמשת בsesיה מוחלטת של מודפס, ולכן ספירה או חזרה לכניסה אינה מפעילה מחדש את חשבון המודפס שגוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub में अब 'साइन-इन' के लिए एक निजी ब्राउज़र सत्र का उपयोग किया जाता है, जिसके कारण लॉगआउट और पुनः साइन-इन करने से गलत ब्राउज़र खाते का चुपचाप पुनः उपयोग नहीं होता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub alkalmazás jelenleg egy privát böngészőesetet használ, így az kilépés és újabb bejelentkezés során nem ismételhető meg a hibás böngészőfelhasználókonto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : Login sekarang menggunakan sesi peramban pribadi sehingga proses keluar dan masuk kembali tidak secara diam-diam memanfaatkan akun peramban yang salah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub utilizza ora una sessione del browser privata, in modo che l'esci e il rientro non riutilizzi silenziosamente il conto del browser errato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ：現在、サインインではプライベートブラウザセッションが使用されるため、ログアウト後に再びサインインすると、誤ったブラウザアカウントが静かに再利用されないようになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 의 로그인 기능은 이제 개인용 브라우저 세션을 사용하므로, 로그아웃 후 다시 로그인하면 잘못된 브라우저 계정이 자동으로 재사용되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : Innskjøring nå bruker en privat nettlesersesjon, så når du logg ut og deretter inn igjen, nyttes ikke det feilige nettleserkontoen i stille stil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub gebruikt de aanmeldfunctie nu een privé-browsersessie, zodat het uitloggen en opnieuw aanmelden niet zachtweg het verkeerde browseraccount hergebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub zalogowanie się teraz wykorzystuje prywatną sesję przeglądarki, dzięki czemu wylogowanie i ponowne zalogowanie nie powoduje ciemnego ponownego wykorzystania niepoprawnego konta w przeglądarce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub agora utiliza uma sessão de navegador privada, de modo que sair e voltar ao sistema não reutiliza silenciosamente a conta de navegador incorreta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub вход в систему теперь осуществляется через приватную сессию браузера, поэтому выход из системы и повторный вход не позволяют беспроблемно использовать неверный аккаунт браузера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : Inloggning nu använder en privat webbläsarsession, så att avloggning och återinloggning inte utan syn på återanvänder fel webbläsarkonto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ระบบการเข้าสู่ระบบในปัจจุบันใช้เซสชันเบราว์เซอร์ส่วนตัว ทำให้เมื่อออกจากระบบแล้วกลับเข้ามาใหม่ จะไม่มีการนำบัญชีเบราว์เซอร์ที่ผิดมาใช้ซ้ำโดยไม่แจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sistemi şu anda özel bir tarayıcı oturumu kullanır; bu nedenle çıkış yapmak ve tekrar giriş etmek, yanlış tarayıcı hesabını gizlice tekrar kullanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub систему входу тепер використовує приватну сесію браузера, тому після вихіду з системи та повторного входу не відбувається тихо повторне використання неправильного облікового запису у браузері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub : Hiện tại chức năng đăng nhập sử dụng phiên trình duyệt riêng, do đó khi đăng xuất rồi đăng nhập lại sẽ không tự động khôi phục tài khoản trình duyệt sai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ：当前登录功能已采用私有浏览器会话，因此退出并重新登录时，不会自动复用错误的浏览器账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ：當前登録功能已採用俬有瀏覽器會話，因此退齣併重新登録時，不會自動複用錯誤的瀏覽器賬戶。"
          }
        }
      }
    },
