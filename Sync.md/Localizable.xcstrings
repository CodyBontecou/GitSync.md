    "Removing without a backup permanently deletes this folder’s local Git history. You can only restore it from another copy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإزالة دون نسخة احتياطية تحذف سجل Git المحلي لهذا المجلد نهائيًا. لا يمكنك استعادته إلا من نسخة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernelse uden backup sletter permanent denne mappes lokale Git-historik. Du kan kun gendanne den fra en anden kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Backup zu entfernen löscht den lokalen Git-Verlauf dieses Ordners endgültig. Sie können ihn nur aus einer anderen Kopie wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitarlo sin copia de seguridad elimina para siempre el historial de Git local de esta carpeta. Solo podrás restaurarlo desde otra copia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaminen ilman varmuuskopiota poistaa pysyvästi tämän kansion paikallisen Git-historian. Voit palauttaa sen vain toisesta kopiosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer sans sauvegarde efface définitivement l’historique Git local de ce dossier. Vous ne pourrez le restaurer qu’à partir d’une autre copie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרה ללא גיבוי מוחקת לצמיתות את היסטוריית ה-Git המקומית של תיקייה זו. אפשר לשחזר אותה רק מעותק אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना बैकअप के हटाने से इस फ़ोल्डर का स्थानीय Git इतिहास स्थायी रूप से मिट जाता है। आप इसे केवल किसी दूसरी कॉपी से ही बहाल कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági mentés nélküli eltávolítás véglegesen törli a mappa helyi Git-előzményeit. Csak egy másik másolatból állíthatók vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus tanpa cadangan akan menghapus riwayat Git lokal folder ini secara permanen. Anda hanya dapat memulihkannya dari salinan lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere senza backup elimina definitivamente la cronologia Git locale di questa cartella. Potrai ripristinarla solo da un'altra copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップなしで削除すると、このフォルダのローカル Git 履歴は完全に削除されます。別のコピーからしか復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 없이 제거하면 이 폴더의 로컬 Git 기록이 영구적으로 삭제됩니다. 다른 사본에서만 복원할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerning uten sikkerhetskopi sletter denne mappens lokale Git-historikk permanent. Du kan bare gjenopprette den fra en annen kopi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen zonder back-up wist de lokale Git-geschiedenis van deze map definitief. U kunt die alleen herstellen vanuit een andere kopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie bez kopii zapasowej trwale kasuje lokalną historię Git tego folderu. Przywrócisz ją tylko z innej kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover sem backup exclui permanentemente o histórico Git local desta pasta. Você só poderá restaurá-lo a partir de outra cópia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление без резервной копии безвозвратно стирает локальную историю Git этой папки. Восстановить её можно только из другой копии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Borttagning utan säkerhetskopia raderar permanent den här mappens lokala Git-historik. Du kan bara återställa den från en annan kopia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบโดยไม่สำรองจะลบประวัติ Git ในเครื่องของโฟลเดอร์นี้อย่างถาวร คุณจะกู้คืนได้จากสำเนาอื่นเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeksiz kaldırmak bu klasörün yerel Git geçmişini kalıcı olarak siler. Yalnızca başka bir kopyadan geri yükleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучення без резервної копії остаточно стирає локальну історію Git цієї папки. Відновити її можна лише з іншої копії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ mà không sao lưu sẽ xóa vĩnh viễn lịch sử Git cục bộ của thư mục này. Bạn chỉ có thể khôi phục từ một bản sao khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不备份就移除会永久删除此文件夹的本地 Git 历史记录。只能从其他副本恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未備份就移除會永久刪除此資料夾的本機 Git 歷史記錄。只能從其他副本恢復。"
          }
        }
      }
    },
