    "Resume without creating another commit or repository.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف دون إنشاء commit أو مستودع آخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoptag uden at oprette endnu et commit eller repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetzen, ohne einen weiteren Commit oder ein weiteres Repository zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar sin crear otro commit ni otro repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka luomatta uutta committia tai tietovarastoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre sans créer un autre commit ni un autre dépôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשיכו בלי ליצור commit או מאגר נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा commit या रिपॉज़िटरी बनाए बिना फिर से शुरू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytatás újabb commit vagy tároló létrehozása nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan tanpa membuat commit atau repositori lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi senza creare un altro commit o repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新たなコミットやリポジトリを作成せずに再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋이나 저장소를 새로 만들지 않고 재개합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett uten å opprette en ny commit eller et nytt repositorium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervatten zonder nog een commit of repository te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznów bez tworzenia kolejnego commita ani repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retomar sem criar outro commit ou repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить без создания ещё одного commit или репозитория."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återuppta utan att skapa en ny commit eller ett nytt arkiv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการต่อโดยไม่สร้าง commit หรือที่เก็บใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir commit veya depo oluşturmadan sürdür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжити без створення ще одного commit чи репозиторію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục mà không tạo thêm commit hay kho lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续，不创建新的提交或仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續，而不建立新的提交或儲存庫。"
          }
        }
      }
