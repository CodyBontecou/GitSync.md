          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Background Sync nem tudta ezt a vásárlást a jelenlegi telepítéshez kapcsolni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
