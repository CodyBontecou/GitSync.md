        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना गया क्लोन स्थान सहेजा नहीं जा सका। मौजूदा फ़ाइलें सुरक्षित रखी गई हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt klónozási helyet nem sikerült menteni. A meglévő fájlokat megőriztük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi clone yang dipilih tidak dapat disimpan. File yang ada telah dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la posizione di clonazione scelta. I file esistenti sono stati conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したクローン先を保存できませんでした。既存のファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 클론 위치를 저장할 수 없습니다. 기존 파일은 보존되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt klonested kunne ikke lagres. Eksisterende filer er bevart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
