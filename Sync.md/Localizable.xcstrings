    "Without a default, repos save to\nFiles › On My iPhone › GitSync.md": {
      "comment": "Info hint shown when no default save location is chosen during onboarding",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون موقع افتراضي، تُحفظ المستودعات في\nالملفات › على iPhone › GitSync.md"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en standard gemmes repos i\nFiler › Paa min iPhone › GitSync.md"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Vorgabe werden Repos gespeichert unter\nDateien › Auf meinem iPhone › GitSync.md"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a default, repos save to\nFiles › On My iPhone › GitSync.md"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin una ubicación predeterminada, los repositorios se guardan en\nArchivos › En mi iPhone › GitSync.md"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman oletussijaintia tietovarastot tallennetaan kohteeseen\nTiedostot › iPhonessa › GitSync.md"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans emplacement par défaut, les dépôts sont enregistrés dans\nFichiers › Sur mon iPhone › GitSync.md"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללא ברירת מחדל, מאגרים יישמרו ב-\nקבצים › ב-iPhone שלי › GitSync.md"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट के बिना, रिपो यहाँ सहेजे जाते हैं\nFiles › On My iPhone › GitSync.md"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezés nélkül a tárolók ide mentődnek:\nFájlok › Az iPhone-omon › GitSync.md"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa lokasi default, repositori disimpan di\nFile › Di iPhone Saya › GitSync.md"
          }
        },
        "it": {
          "stringUnit": {
