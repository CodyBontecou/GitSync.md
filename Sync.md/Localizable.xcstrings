          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitys epäonnistui origin kauko: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " origin : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": לא הצלחנו לעדכן origin – רמונט: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": अपडेट करने में विफलता। origin रिमोट: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": frissítés nem sikerült origin távvezérlő: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal diperbarui origin remote: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": non è stato possibile aggiornare origin remoto: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：更新に失敗しました origin レモート： %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 업데이트 실패 origin 원격 제어: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ulykket å oppdatere origin fjernkontroll: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bij de bijwerking is er een fout opgetreden origin afstandsbediening: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nie udalo się zaktualizować origin (dostęp z daleka): %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Falha na atualização origin remoto: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Не удалось обновить данные origin (удалённый режим): %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Uppdatering misslyckades origin fjärrkontroll: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ไม่สามารถอัปเดตข้อมูลได้ origin ระยะไกล: %@"
          }
        },
        "tr": {
          "stringUnit": {
