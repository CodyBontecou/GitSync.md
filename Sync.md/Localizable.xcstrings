    "Repository settings could not be checked. Your files have been preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من إعدادات المستودع. تم الاحتفاظ بملفاتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository-indstillingerne kunne ikke tjekkes. Dine filer er bevaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository-Einstellungen konnten nicht geprüft werden. Ihre Dateien wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron comprobar los ajustes del repositorio. Tus archivos se han conservado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietovaraston asetuksia ei voitu tarkistaa. Tiedostosi on säilytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les réglages du dépôt. Vos fichiers ont été conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לבדוק את הגדרות המאגר. הקבצים שלכם נשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी सेटिंग्स जाँची नहीं जा सकीं। आपकी फ़ाइलें सुरक्षित रखी गई हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tároló beállításait nem sikerült ellenőrizni. A fájljait megőriztük."
          }
        },
        "id": {
          "stringUnit": {
