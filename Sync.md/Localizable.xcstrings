    "Terminal action: unlike turning Background Sync off, deletion permanently retires this installation's Background Sync relay identity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجراء نهائي: بخلاف إيقاف Background Sync، يؤدي الحذف إلى إنهاء هوية مُرحِّل Background Sync لهذا التثبيت نهائيًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Endelig handling: I modsætning til at slå Background Sync fra nedlægger sletning permanent denne installations Background Sync-relæidentitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültige Aktion: Anders als das Deaktivieren von Background Sync setzt das Löschen die Background Sync-Relay-Identität dieser Installation dauerhaft außer Betrieb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acción definitiva: a diferencia de desactivar Background Sync, la eliminación retira permanentemente la identidad del relé de Background Sync de esta instalación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopullinen toiminto: toisin kuin Background Sync -toiminnon poistaminen käytöstä, poistaminen lakkauttaa pysyvästi tämän asennuksen Background Sync -välityspalvelun identiteetin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Action définitive : contrairement à la désactivation de Background Sync, la suppression retire définitivement l’identité du relais Background Sync de cette installation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה סופית: בניגוד לכיבוי Background Sync, המחיקה מוציאה לצמיתות משימוש את זהות הממסר של Background Sync בהתקנה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम कार्रवाई: Background Sync बंद करने के विपरीत, मिटाने से इस इंस्टॉलेशन की Background Sync रिले पहचान स्थायी रूप से निष्क्रिय हो जाती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Végleges művelet: a Background Sync kikapcsolásával ellentétben a törlés véglegesen megszünteti a telepítés Background Sync-továbbítóazonosítóját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan final: tidak seperti menonaktifkan Background Sync, penghapusan akan menghentikan identitas relay Background Sync instalasi ini secara permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azione definitiva: diversamente dalla disattivazione di Background Sync, l’eliminazione ritira definitivamente l’identità relay di Background Sync di questa installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終的な操作：Background Sync をオフにする場合とは異なり、削除すると、このインストールの Background Sync relay ID は完全に廃止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 작업: Background Sync를 끄는 것과 달리 삭제하면 이 설치의 Background Sync 릴레이 ID가 영구적으로 폐기됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endelig handling: I motsetning til å slå av Background Sync vil sletting permanent avvikle Background Sync-releidentiteten til denne installasjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitieve actie: anders dan bij het uitschakelen van Background Sync, wordt bij verwijdering de Background Sync-relayidentiteit van deze installatie permanent buiten gebruik gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działanie nieodwracalne: w przeciwieństwie do wyłączenia Background Sync usunięcie trwale wycofuje tożsamość tej instalacji w usłudze pośredniczącej Background Sync."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ação irreversível: ao contrário de desativar o Background Sync, a exclusão desativa permanentemente a identidade do retransmissor do Background Sync desta instalação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необратимое действие: в отличие от выключения Background Sync, удаление безвозвратно деактивирует идентификатор ретранслятора Background Sync для этой установки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutgiltig åtgärd: till skillnad från att stänga av Background Sync avvecklar radering permanent den här installationens reläidentitet för Background Sync."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการขั้นสุดท้าย: การลบจะแตกต่างจากการปิด Background Sync เพราะจะปลดระวางข้อมูลประจำตัวรีเลย์ของ Background Sync สำหรับการติดตั้งนี้อย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nihai işlem: Background Sync özelliğini kapatmanın aksine silme işlemi, bu kurulumun Background Sync aktarıcı kimliğini kalıcı olarak kullanım dışı bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаточна дія: на відміну від вимкнення Background Sync, видалення назавжди припиняє дію ідентичності ретранслятора Background Sync цієї інсталяції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động cuối cùng: không giống như việc tắt Background Sync, thao tác xóa sẽ ngừng vĩnh viễn danh tính chuyển tiếp Background Sync của bản cài đặt này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终止性操作：与关闭 Background Sync 不同，删除会永久停用此安装的 Background Sync 中继身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終止性操作：與關閉 Background Sync 不同，刪除會永久停用此安裝項目的 Background Sync 中繼身分。"
          }
        }
      }
    },
