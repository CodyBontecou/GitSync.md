    "The file changed outside GitSync.md. Your edits were not saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير الملف للخارج GitSync.md. لم يتم حفظ التعديلات الخاصة بك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ השתנה בחוץ GitSync.md. העריכות שלך לא ניצלה."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er ændret uden for systemet. GitSync.mdDine redigeringer blev ikke gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde außerhalb geändert. GitSync.mdEure Änderungen wurden nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se modificó desde fuera. GitSync.mdLas tuas ediciones no se guardaron."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto muutettiin ulkopuolelta. GitSync.mdMuokkauksetasi ei ole tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a été modifié depuis l'extérieur. GitSync.mdVos modifications n'ont pas été enregistrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल में बाहरी रूप से परिवर्तन हुआ है। GitSync.mdआपके संपादन सहेजे नहीं गए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlok külső forrásból módosultak. GitSync.mdA módosítások nem mentették meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas telah diubah dari luar. GitSync.mdPerubahan Anda tidak tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è stato modificato da esterno. GitSync.mdLe tue modifiche non sono state salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが外部で変更されました。 GitSync.md編集内容は保存されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 외부에서 변경되었습니다. GitSync.md수정 사항이 저장되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen ble endret utenfor. GitSync.mdDine redigeringer ble ikke lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestand is van buitenaf gewijzigd. GitSync.mdUw bewerkingen zijn niet opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zmieniono z zewnątrz. GitSync.mdTwoje modyfikacje nie zostały zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo foi alterado externamente. GitSync.mdAs suas edições não foram salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл был изменен снаружи. GitSync.mdВаши изменения не сохранены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen har ändrats utanför. GitSync.mdDina redigeringar sparas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ถูกแก้ไขจากภายนอก GitSync.mdการแก้ไขของคุณยังไม่ถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya dışarıdan değiştirildi. GitSync.mdDüzenlemeleriniz kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл було змінено ззовні. GitSync.mdВаші зміни не були збережені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp đã được thay đổi từ bên ngoài. GitSync.mdCác chỉnh sửa của bạn chưa được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在外部被修改了 GitSync.md您的编辑内容未保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案在外部被修改了 GitSync.md您的編輯內容未儲存。"
