          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リモートからHTTPS認証情報を要求しましたが、このリポジトリに対してトークンまたはパスワードが保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 원격 시스템이 HTTPS 인증 정보를 요청했으나, 해당 저장소에 토큰 또는 비밀번호가 저장되어 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Den fjernenheten har foreslått HTTPS-kredensialer, men det er ingen token eller passord lagret for dette lagringsmottakeret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De externe functie heeft HTTPS-gegevens verzocht, maar er is geen token of wachtwoord voor dit repository opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Zasób odległy żąda danych uwierzytelniających dla HTTPS, jednak nie jest zapisany żaden token ani hasło dla tego reposituarium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": O remoto solicitou credenciais HTTPS, mas nenhum token ou senha foi salvo para este repositório."
          }
