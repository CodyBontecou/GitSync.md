        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ustawienia domyślnego repozytoria zapisują się w\nPliki › Na moim iPhonie › GitSync.md"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um local padrão, os repositórios serão salvos em\nArquivos › No Meu iPhone › GitSync.md"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без настройки репозитории сохраняются в\nФайлы › На iPhone › GitSync.md"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan standardval sparas förråd i\nFiler › På min iPhone › GitSync.md"
