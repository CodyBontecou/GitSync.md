    "The App Store transaction could not be verified.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من معاملة متجر التطبيقات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את עסקת חנות האפליקציות."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen i App Store kunne ikke verificeres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion im App Store konnte nicht verifiziert werden."
          }
        },
        "es": {
