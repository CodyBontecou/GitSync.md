    "Background Sync could not bind this purchase to the current installation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Background Sync ربط عملية الشراء هذه بالتثبيت الحالي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Sync kunne ikke knytte dette køb til den aktuelle installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Sync konnte diesen Kauf nicht mit der aktuellen Installation verknüpfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Sync no ha podido vincular esta compra a la instalación actual."
          }
        },
        "fi": {
