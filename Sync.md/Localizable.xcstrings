    "Use public access, an HTTPS token, or an SSH private key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الوصول العام أو رمز HTTPS أو المفتاح الخاص SSH."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug offentlig adgang, et HTTPS-token eller en SSH privat nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie öffentlichen Zugriff, ein HTTPS-Token oder einen privaten Schlüssel SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice acceso público, un token HTTPS o una clave privada SSH."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": " SSH yksityinen avain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'accès public, un jeton HTTPS ou un SSH : clé privée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– השתמש באcesso ציבורית, בטוקן HTTPS או ב- SSH – מפתח פרטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": सार्वजनिक पहुँच, HTTPS टोकन या किसी अन्य तरीके का उपयोग करें। SSH – निजी कुंजी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Használja a közösségi hozzáférést, egy HTTPS-tokenet vagy egy másik eszközt. SSH magánkulcs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan akses publik, token HTTPS, atau SSH kunci privat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare l'accesso pubblico, un token HTTPS o un SSH chiave privata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：公開アクセス、HTTPSトークン、またはその他の手段を使用してください。 SSH 私鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 공개 액세스, HTTPS 토큰 또는 기타 방법을 사용하십시오. SSH 개인 키."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk offentlig tilgang, et HTTPS-token eller et SSH privat nøkkel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik openbaar toegang, een HTTPS-token of een SSH privékey."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Użyj publicznego dostępu, tokena HTTPS lub SSH – prywatny klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use acesso público, um token HTTPS ou um SSH chave privada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": используйте публичный доступ, токен HTTPS или другой способ SSH — приватный ключ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd offentlig åtkomst, ett HTTPS-token eller en SSH privatnyckel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การเข้าถึงสาธารณะ, เทกน์ HTTPS, หรือ SSH : คีย์ส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kamu erişimini, HTTPS token'ını veya bir başka yöntemden yararlanın. SSH özel anahtar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте громадський доступ, токен HTTPS або SSH – приватний ключ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Sử dụng quyền truy cập công cộng, mã token HTTPS hoặc một SSH – khóa riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：可使用公共访问方式、HTTPS令牌或 SSH 私钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：可使用公共訪問方式、HTTPS令牌或 SSH 俬鑰。"
          }
        }
      }
    },
