    "Your saved commit is on GitHub, and this folder has been added to GitSync.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الـ commit المحفوظ موجود على GitHub، وتمت إضافة هذا المجلد إلى GitSync.md."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gemte commit er på GitHub, og denne mappe er tilføjet til GitSync.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr gespeicherter Commit ist auf GitHub, und dieser Ordner wurde zu GitSync.md hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu commit guardado está en GitHub y esta carpeta se ha añadido a GitSync.md."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu commitisi on GitHubissa, ja tämä kansio on lisätty GitSync.md:hen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre commit enregistré est sur GitHub, et ce dossier a été ajouté à GitSync.md."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-commit השמור שלכם נמצא ב-GitHub, והתיקייה הזו נוספה ל-GitSync.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सहेजा गया commit GitHub पर है, और यह फ़ोल्डर GitSync.md में जोड़ दिया गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett commitja a GitHubon van, és ez a mappa bekerült a GitSync.md-be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit tersimpan Anda ada di GitHub, dan folder ini telah ditambahkan ke GitSync.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo commit salvato è su GitHub e questa cartella è stata aggiunta a GitSync.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのコミットは GitHub にあり、このフォルダは GitSync.md に追加されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 커밋이 GitHub에 있으며, 이 폴더가 GitSync.md에 추가되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede commiten din er på GitHub, og denne mappen er lagt til i GitSync.md."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bewaarde commit staat op GitHub en deze map is aan GitSync.md toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zapisany commit jest na GitHubie, a ten folder został dodany do GitSync.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu commit salvo está no GitHub, e esta pasta foi adicionada ao GitSync.md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сохранённый commit на GitHub, и эта папка добавлена в GitSync.md."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sparade commit finns på GitHub och den här mappen har lagts till i GitSync.md."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ที่บันทึกไว้อยู่บน GitHub แล้ว และเพิ่มโฟลเดอร์นี้ไปยัง GitSync.md แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen commit'iniz GitHub'da ve bu klasör GitSync.md'ye eklendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш збережений commit на GitHub, і цю папку додано до GitSync.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit đã lưu của bạn đã có trên GitHub, và thư mục này đã được thêm vào GitSync.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已保存的提交已在 GitHub 上，并且此文件夹已添加到 GitSync.md。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已儲存的提交已在 GitHub 上，且此資料夾已加入 GitSync.md。"
          }
        }
      }
    },
