    "Pull every cloned GitSync.md repository, then commit and push local edits. Stops safely on conflicts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفّذ pull لكل مستودع GitSync.md مستنسخ، ثم commit وpush للتعديلات المحلية. يتوقف بأمان عند التعارضات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull alle klonede GitSync.md-repositories, og commit og push derefter lokale ændringer. Stopper sikkert ved konflikter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes geklonte GitSync.md-Repository pullen, dann lokale Änderungen committen und pushen. Stoppt bei Konflikten sicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer pull de cada repositorio clonado de GitSync.md y luego commit y push de los cambios locales. Se detiene de forma segura ante conflictos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae kaikki kloonatut GitSync.md-tietovarastot, sitten commitoi ja lähetä paikalliset muokkaukset. Pysähtyy turvallisesti ristiriitoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire un pull de chaque dépôt GitSync.md cloné, puis commit et push des modifications locales. S’arrête en sécurité en cas de conflit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "pull לכל מאגר GitSync.md משוכפל, ואז commit ו-push לעריכות מקומיות. נעצר בבטחה בהתנגשויות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर क्लोन की गई GitSync.md रिपॉज़िटरी को pull करें, फिर स्थानीय संपादनों को commit और push करें। कॉन्फ़्लिक्ट पर सुरक्षित रूप से रुकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull minden klónozott GitSync.md-tárolóra, majd a helyi módosítások commitolása és pusholása. Ütközéskor biztonságosan megáll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull setiap repositori GitSync.md yang di-clone, lalu commit dan push editan lokal. Berhenti dengan aman saat ada konflik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai pull di ogni repository GitSync.md clonato, poi commit e push delle modifiche locali. Si ferma in sicurezza in caso di conflitti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローン済みのすべての GitSync.md リポジトリをプルしてから、ローカルの編集をコミットしてプッシュします。コンフリクト時は安全に停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클론된 모든 GitSync.md 저장소를 풀한 다음 로컬 편집 내용을 커밋하고 푸시합니다. 충돌 시 안전하게 멈춥니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull alle klonede GitSync.md-repositorier, og commit og push deretter lokale endringer. Stopper trygt ved konflikter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull elke gekloonde GitSync.md-repository en commit en push daarna lokale wijzigingen. Stopt veilig bij conflicten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonaj pull każdego sklonowanego repozytorium GitSync.md, a potem commit i push lokalnych zmian. Bezpiecznie zatrzymuje się przy konfliktach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz pull de todos os repositórios clonados no GitSync.md e depois commit e push das edições locais. Para com segurança em conflitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнить pull всех клонированных репозиториев GitSync.md, затем commit и push локальных правок. Безопасно останавливается при конфликтах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta alla klonade GitSync.md-arkiv och gör sedan commit och push av lokala ändringar. Stoppar säkert vid konflikter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull ทุกที่เก็บ GitSync.md ที่ clone ไว้ แล้ว commit และ push การแก้ไขในเครื่อง หยุดอย่างปลอดภัยเมื่อมีความขัดแย้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonlanmış her GitSync.md deposunu pull edin, ardından yerel düzenlemeleri commit ve push edin. Çakışmalarda güvenle durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконати pull усіх клонованих репозиторіїв GitSync.md, потім commit і push локальних правок. Безпечно зупиняється на конфліктах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull mọi kho lưu trữ GitSync.md đã clone, rồi commit và push chỉnh sửa cục bộ. Dừng an toàn khi có xung đột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取所有已克隆的 GitSync.md 仓库，然后提交并推送本地编辑。遇到冲突时安全停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取所有已複製的 GitSync.md 儲存庫，然後提交並推送本機編輯。遇到衝突時會安全停止。"
          }
        }
      }
    },
