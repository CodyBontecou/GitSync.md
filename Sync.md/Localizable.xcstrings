    "Stored in Keychain. Paste an OpenSSH private key; passphrase is optional.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزنة في سلسلة المفاتيح. الصق المفتاح الخاص OpenSSH؛ عبارة المرور اختيارية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt i nøglering. Indsæt en OpenSSH privat nøgle; adgangssætning er valgfri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schlüsselbund gespeichert. Fügen Sie einen privaten Schlüssel OpenSSH ein; Passphrase ist optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenado en llavero. Pegue una clave privada OpenSSH; la frase de contraseña es opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu avainketjuun. Liitä on OpenSSH yksityinen avain; salasana on valinnainen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké dans le Keychain. Collez un OpenSSH : clé privée ; le mot de passe est optionnel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאוחס ב-Keychain. תבנית: OpenSSH – מפתח פרטי; המפתח ההדירוגי הוא opcional."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "– कीचेन में संग्रहित। एक पास्ट करें। OpenSSH : निजी कुंजी; पासवर्ड वैकल्पिक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A Keychainbe tárolt adat – illesztse be egyet! OpenSSH : privát kulcs; a passzfrázs opcionális."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "disimpan di Keychain. Tempelkan sebuah OpenSSH kunci privat; passphrase bersifat opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": salvato nel Keychain. Incolla un OpenSSH : chiave privata; la frase di password è opzionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：Keychainに保存されています。貼り付けしてください。 OpenSSH ：プライベートキー；パスフレーズは任意です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 키체인에 저장됨. 붙여넣기 OpenSSH : 개인 키; 패스프레시는 선택 사항입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "lagret i Keychain. Feste et OpenSSH privat nøkkel; passord er valgfritt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "is opgeslagen in Keychain. Plak een OpenSSH : privékey; de passphrase is optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– zapisane w Keychain. Wklej: OpenSSH – klucz prywatny; fraza hasła jest opcjonalna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenado no Keychain. Colar um OpenSSH chave privada; a frase de senha é opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "хранится в Keychain. Вставьте: OpenSSH — приватный ключ; фраза для доступа является опциональной."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "lagrad i Keychain. Fäst en OpenSSH – privat nyckel; passphras är valfri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดเก็บใน Keychain — วางข้อความลง OpenSSH : คีย์ส่วนตัว; passphrase เป็นข้อมูลที่ไม่จำเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", Keychain'de saklanmıştır. Bir şeyi yapıştırın. OpenSSH özel anahtarı; şifre parolası seçkindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "зберігається в Keychain. Вставте: OpenSSH – приватний ключ; фраза для доступу є необов'язковою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "được lưu trong Keychain. Hãy dán một OpenSSH : khóa riêng; passphrase là tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储于钥匙串中。请粘贴： OpenSSH 私钥；密码短语为可选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已存儲於鑰匙串中。請粘貼： OpenSSH 俬鑰；密碼短語爲可選項。"
          }
        }
      }
    },
