    "New repositories will be saved to the app's default location instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حفظ المستودعات الجديدة في الموقع الافتراضي للتطبيق بدلاً من ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye depoter vil i stedet blive gemt på appens standardplacering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Repositorys werden stattdessen am Standardspeicherort der App gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos repositorios se guardarán en la ubicación predeterminada de la aplicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet arkistot tallennetaan sen sijaan sovelluksen oletuspaikkaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveaux dépôts seront enregistrés à l&#39;emplacement par défaut de l&#39;application à la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": המאגרים החדשים יוכלו לה永久ית במקומם mặcומני של האפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": नए रिपॉजिटरी ऐप के डिफ़ॉल्ट स्थान पर सहेजे जाएंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A új adatmagazinok az alkalmazás alapértelmezett helyére kerülnek mentésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori baru akan disimpan ke lokasi bawaan aplikasi tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": i nuovi repository verranno salvati invece nella posizione predefinita dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：新しいリポジトリは、アプリのデフォルト保存場所に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 새로운 저장소는 앱의 기본 위치에 저장됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nye repositorier vil lagres til appens standardsted i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nieuwe repositoryn worden in plaats daarvan op de standaardlocatie van de app opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe repositoriały zostaną zapisane na domyślnym lokalizacji aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Novos repositórios serão salvados na localização padrão do aplicativo em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": новые репозитории будут сохраняться в стандартное расположение приложения вместо этого."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Nyckellagringsplatser kommer att sparas till applikationens standardplats istället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": คลังข้อมูลใหม่จะถูกบันทึกไว้ที่ตำแหน่งเริ่มต้นของแอปแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yeni depolamalar, uygulamanın varsayılan konusuna kaydedilecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": нові репозиторії будуть зберігатися на за замовленням додатка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các kho dữ liệu mới sẽ được lưu tại vị trí mặc định của ứng dụng thay vì nơi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：新存储库将保存至应用的默认位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：新存儲庫將保存至應用的默認位置。"
          }
        }
      }
    },
