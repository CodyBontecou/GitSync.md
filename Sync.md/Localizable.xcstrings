    "You’re offline. Connect to the internet, then check again.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. اتصل بالإنترنت ثم أعد التحقق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Opret forbindelse til internettet, og kontrollér igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind offline. Stellen Sie eine Internetverbindung her und prüfen Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Conéctate a Internet y repite la comprobación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Muodosta internetyhteys ja tarkista uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Connectez-vous à Internet, puis relancez la vérification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור לרשת. התחברו לאינטרנט ובדקו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। इंटरनेट से जुड़ें और फिर जाँचें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs internetkapcsolat. Csatlakozzon az internethez, majd ellenőrizze újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Hubungkan ke internet, lalu periksa lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Connettiti a Internet e ripeti il controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。インターネットに接続して、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 인터넷에 연결한 후 다시 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er frakoblet. Koble til internett og kontroller på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Maak verbinding met internet en controleer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Połącz się z internetem i sprawdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Conecte-se à internet e repita a verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не в сети. Подключитесь к интернету и повторите проверку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Anslut till internet och kontrollera igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ เชื่อมต่ออินเทอร์เน็ตแล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
