    "The remote requested %@, but the saved %@ credentials are not compatible.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ": طلب عن بُعد %1$@، ولكن البيانات المحفوظة\nبيانات %2$@ غير متوافقة."
          }
        },
        "da": {
