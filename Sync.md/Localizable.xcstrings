          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum repositório corresponde a “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет репозиториев, соответствующих «%@»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget arkiv matchar “%@”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีที่เก็บที่ตรงกับ “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ile eşleşen depo yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає репозиторіїв, що відповідають «%@»."
          }
        },
        "vi": {
          "stringUnit": {
