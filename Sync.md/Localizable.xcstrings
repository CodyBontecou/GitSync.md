    "%@ already exists here. Try another name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موجود هنا بالفعل. جرّب اسمًا آخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ findes allerede her. Prøv et andet navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist hier bereits vorhanden. Versuchen Sie einen anderen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya existe aquí. Prueba con otro nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on jo olemassa täällä. Kokeile toista nimeä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe déjà ici. Essayez un autre nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ כבר קיים כאן. נסו שם אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ यहाँ पहले से मौजूद है। कोई दूसरा नाम आज़माएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ már létezik itt. Próbáljon másik nevet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sudah ada di sini. Coba nama lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste già qui. Prova un altro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでにここにあります。別の名前を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이미 여기에 있습니다. 다른 이름을 사용해 보십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finnes allerede her. Prøv et annet navn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bestaat hier al. Probeer een andere naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ już tu istnieje. Wybierz inną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já existe aqui. Tente outro nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже существует здесь. Выберите другое имя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finns redan här. Prova ett annat namn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี %@ อยู่ที่นี่แล้ว ลองใช้ชื่ออื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ burada zaten var. Başka bir ad deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже існує тут. Виберіть іншу назву."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã có ở đây. Hãy thử tên khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在于此处。请换一个名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在於此處。請換一個名稱。"
          }
        }
      }
    },
