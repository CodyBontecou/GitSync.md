          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": helyi fájlok eltávolítása, de a tároló működését nem érintve GitHub."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "membersihkan file lokal tanpa memengaruhi repositori. GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Pulizia dei file locali senza influire sul repository. GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：リポジトリに影響を与えない状態でローカルファイルをクリーンアップします。 GitHub."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 저장소에 영향을 주지 않고 로컬 파일을 정리합니다. GitHub."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Rengjør lokale filer uten å påvirke lagringsplatsen. GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De lokale bestanden opschonen zonder de repository te beïnvloeden. GitHub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Usunięcie lokalnych plików bez wpływu na repositorium. GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
