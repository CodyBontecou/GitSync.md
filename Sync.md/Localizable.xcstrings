            "state": "translated",
            "value": "：コミットおよびプッシュを実行して、マージを完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 커밋과 푸시를 통해 병합을 완료합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
