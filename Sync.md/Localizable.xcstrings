    "Origin did not confirm that the branch was published. Publication status is unknown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكد origin نشر الفرع. حالة النشر غير معروفة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin bekræftede ikke, at branchen blev publiceret. Publiceringsstatus er ukendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin hat nicht bestätigt, dass der Branch veröffentlicht wurde. Der Veröffentlichungsstatus ist unbekannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin no confirmó que se hubiera publicado la rama. El estado de publicación es desconocido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin ei vahvistanut, että haara julkaistiin. Julkaisun tila on tuntematon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin n’a pas confirmé que la branche a été publiée. L’état de publication est inconnu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin לא אישר שהענף פורסם. מצב הפרסום אינו ידוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin ने पुष्टि नहीं की कि branch प्रकाशित हुआ है। प्रकाशन की स्थिति अज्ञात है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Origin nem erősítette meg, hogy az ág közzé lett téve. A közzététel állapota ismeretlen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin tidak mengonfirmasi bahwa branch telah dipublikasikan. Status publikasi tidak diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin non ha confermato che il ramo sia stato pubblicato. Lo stato della pubblicazione è sconosciuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "origin はブランチが公開されたことを確認しませんでした。公開状態は不明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "origin이 브랜치 게시를 확인하지 않았습니다. 게시 상태를 알 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "origin bekreftet ikke at branchen ble publisert. Publiseringsstatusen er ukjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "origin heeft niet bevestigd dat de branch is gepubliceerd. De publicatiestatus is onbekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin nie potwierdził opublikowania gałęzi. Stan publikacji jest nieznany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O origin não confirmou que a branch foi publicada. O status da publicação é desconhecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin не подтвердил публикацию ветки. Статус публикации неизвестен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin bekräftade inte att branchen publicerades. Publiceringsstatusen är okänd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin ไม่ได้ยืนยันว่าเผยแพร่ branch แล้ว ไม่ทราบสถานะการเผยแพร่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin, dalın yayımlandığını doğrulamadı. Yayımlama durumu bilinmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin не підтвердив, що гілку опубліковано. Стан публікування невідомий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin không xác nhận nhánh đã được xuất bản. Trạng thái xuất bản không xác định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin 未确认该分支已发布。发布状态未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin 未確認該分支已發佈。發佈狀態未知。"
          }
        }
      }
    },
    "Origin did not confirm the expected branch update. Publication status is unknown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكد origin تحديث الفرع المتوقع. حالة النشر غير معروفة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin bekræftede ikke den forventede branch-opdatering. Publiceringsstatus er ukendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin hat die erwartete Branch-Aktualisierung nicht bestätigt. Der Veröffentlichungsstatus ist unbekannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin no confirmó la actualización esperada de la rama. El estado de publicación es desconocido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin ei vahvistanut odotettua haaran päivitystä. Julkaisun tila on tuntematon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin n’a pas confirmé la mise à jour attendue de la branche. L’état de publication est inconnu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin לא אישר את עדכון הענף הצפוי. מצב הפרסום אינו ידוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin ने अपेक्षित branch अपडेट की पुष्टि नहीं की। प्रकाशन की स्थिति अज्ञात है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Origin nem erősítette meg a várt ágfrissítést. A közzététel állapota ismeretlen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin tidak mengonfirmasi pembaruan branch yang diharapkan. Status publikasi tidak diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin non ha confermato l’aggiornamento previsto del ramo. Lo stato della pubblicazione è sconosciuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "origin は期待されたブランチの更新を確認しませんでした。公開状態は不明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "origin이 예상된 브랜치 업데이트를 확인하지 않았습니다. 게시 상태를 알 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "origin bekreftet ikke den forventede oppdateringen av branchen. Publiseringsstatusen er ukjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "origin heeft de verwachte branch-update niet bevestigd. De publicatiestatus is onbekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin nie potwierdził oczekiwanej aktualizacji gałęzi. Stan publikacji jest nieznany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O origin não confirmou a atualização esperada da branch. O status da publicação é desconhecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin не подтвердил ожидаемое обновление ветки. Статус публикации неизвестен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin bekräftade inte den förväntade branch-uppdateringen. Publiceringsstatusen är okänd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin ไม่ได้ยืนยันการอัปเดต branch ที่คาดไว้ ไม่ทราบสถานะการเผยแพร่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin, beklenen dal güncellemesini doğrulamadı. Yayımlama durumu bilinmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin не підтвердив очікуване оновлення гілки. Стан публікування невідомий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin không xác nhận bản cập nhật nhánh dự kiến. Trạng thái xuất bản không xác định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin 未确认预期的分支更新。发布状态未知。"
          }
        },
