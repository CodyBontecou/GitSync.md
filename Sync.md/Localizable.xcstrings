          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторій %@ Дане дане було видалено під час іншої операції; застарілі зміни не відновлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báu kho dữ liệu %@ Được xóa bởi một thao tác khác; các thay đổi lỗi không được khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码仓库 %@ 该操作已被另一项操作删除；过时的更改未被恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式碼倉庫 %@ 該操作已被另一項操作刪除；過時的更改未被恢復。"
          }
        }
      }
    },
    "Repository '%@' is not cloned yet — open GitSync.md and clone it first": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@لم يتم استنساخه بعد-افتح GitSync.md وقم باستنساخه أولاً"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "lager &#39;%@&#39; er ikke klonet endnu - åbent GitSync.md og klon først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository&#39;%@&#39; ist noch nicht geklont-offen GitSync.md und klonen Sie es zuerst"
          }
        },
        "es": {
