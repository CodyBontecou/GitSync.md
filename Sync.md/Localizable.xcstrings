    "GitHub returned a different account, name, or visibility. Check the destination before continuing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد GitHub حسابًا أو اسمًا أو مستوى ظهور مختلفًا. تحقق من الوجهة قبل المتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returnerede en anden konto, et andet navn eller en anden synlighed. Tjek destinationen, før du fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat ein anderes Konto, einen anderen Namen oder eine andere Sichtbarkeit zurückgegeben. Prüfen Sie das Ziel, bevor Sie fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub devolvió otra cuenta, nombre o visibilidad. Revisa el destino antes de continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub palautti eri tilin, nimen tai näkyvyyden. Tarkista kohde ennen jatkamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a renvoyé un compte, un nom ou une visibilité différents. Vérifiez la destination avant de continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub החזיר חשבון, שם או נראוּת שונים. בדקו את היעד לפני שתמשיכו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ने अलग खाता, नाम या दृश्यता लौटाई। जारी रखने से पहले गंतव्य जाँचें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub más fiókot, nevet vagy láthatóságot adott vissza. Folytatás előtt ellenőrizze a célt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub mengembalikan akun, nama, atau visibilitas yang berbeda. Periksa tujuan sebelum melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha restituito un account, un nome o una visibilità diversi. Controlla la destinazione prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub から異なるアカウント、名前、または公開範囲が返されました。続行する前に送信先を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 다른 계정, 이름 또는 공개 범위를 반환했습니다. 계속하기 전에 대상을 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returnerte en annen konto, et annet navn eller en annen synlighet. Sjekk målet før du fortsetter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub gaf een ander account, een andere naam of zichtbaarheid terug. Controleer de bestemming voordat u verdergaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub zwrócił inne konto, nazwę lub widoczność. Sprawdź miejsce docelowe, zanim przejdziesz dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub retornou uma conta, nome ou visibilidade diferente. Verifique o destino antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub вернул другой аккаунт, имя или видимость. Проверьте место назначения, прежде чем продолжить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returnerade ett annat konto, namn eller synlighet. Kontrollera målet innan du fortsätter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ส่งคืนบัญชี ชื่อ หรือการมองเห็นที่ต่างออกไป ตรวจสอบปลายทางก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub farklı bir hesap, ad veya görünürlük döndürdü. Devam etmeden önce hedefi denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub повернув інший обліковий запис, назву чи видимість. Перевірте місце призначення, перш ніж продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub trả về tài khoản, tên hoặc chế độ hiển thị khác. Hãy kiểm tra đích trước khi tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 返回了不同的账户、名称或可见性。继续之前请检查目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 傳回了不同的帳號、名稱或可見性。繼續之前請檢查目的地。"
          }
        }
      }
    },
