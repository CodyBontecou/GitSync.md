    "Its changes, files and history open here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح هنا تغييراته وملفاته وسجله."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens ændringer, filer og historik åbnes her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen, Dateien und Verlauf öffnen sich hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cambios, archivos e historial se abren aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen muutokset, tiedostot ja historia avautuvat tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses modifications, fichiers et historique s’ouvrent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינויים, הקבצים וההיסטוריה שלו נפתחים כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बदलाव, फ़ाइलें और इतिहास यहाँ खुलते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosításai, fájljai és előzményei itt nyílnak meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan, file, dan riwayatnya terbuka di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue modifiche, i file e la cronologia si aprono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更、ファイル、履歴がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항, 파일, 기록이 여기서 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer, filer og historikk åpnes her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijzigingen, bestanden en geschiedenis openen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu otwierają się jego zmiany, pliki i historia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações, arquivos e histórico abrem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь открываются его изменения, файлы и история."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess ändringar, filer och historik öppnas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลง ไฟล์ และประวัติจะเปิดที่นี่"
