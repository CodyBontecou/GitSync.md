        }
      }
    },
    "This will be reflected in git status as a deletion.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينعكس هذا في حالة git كحذف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil blive afspejlet i git-status som en sletning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wird im Git-Status als Löschung angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se reflejará en el estado de git como una eliminación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä heijastuu git- tilassa poistona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": cela se reflétera dans `git status` sous la forme d'une suppression."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– תופתע זה ב-git-status כמחיקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "— यह Git Status में 'deletion' के रूप में प्रतिबिंबित होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– Ez a Git állapotban törölésként jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal ini akan tercermin dalam status Git sebagai penghapusan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo si rifletterà nel `git status` come una eliminazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "は、git statusで削除として反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "는 Git Status에서 삭제로 반영될 것입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Dette vil reflekteres i Git-status som en sletting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal in de Git-status worden weergegeven als verwijdering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– to będzie oddane w `git status` jako usunięcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Isso será refletido no `git status` como uma exclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это отразится в `git status` как удаление."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Detta kommer att reflekteras i Git-status som en radering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนี้จะสะท้อนใน `git status` ในลักษณะของการลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", git durumu içinde silme işlemi olarak yansıtılacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відображатиметься у `git status` як видалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Điều này sẽ được phản ánh trong git status dưới dạng xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，这将在 Git 状态中体现为删除操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，這將在 Git 狀態中體現爲刪除操作。"
          }
        }
      }
    },
    "This will delete all local files for this repository. This cannot be undone.": {
      "comment": "Alert message warning that removing a repository is permanent",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع الملفات المحلية لهذا المستودع. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle lokale filer for dette repository. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lokalen Dateien dieses Repositories werden gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete all local files for this repository. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los archivos locales de este repositorio. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki tämän tietovaraston paikalliset tiedostot. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers locaux de ce dépôt seront supprimés. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק את כל הקבצים המקומיים של מאגר זה. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस रिपॉज़िटरी की सभी स्थानीय फ़ाइलें हट जाएँगी। यह पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel az összes helyi fájl törlődik ebből a tárolóból. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua file lokal untuk repositori ini akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i file locali di questo repository verranno eliminati. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリのローカルファイルがすべて削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소의 모든 로컬 파일이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle lokale filer for dette repositoriet. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lokale bestanden van deze repository worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich lokalnych plików tego repozytorium. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os arquivos locais deste repositório serão excluídos. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все локальные файлы этого репозитория будут удалены. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla lokala filer för detta förråd kommer att raderas. Detta kan inte ångras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบไฟล์ในเครื่องทั้งหมดของ repository นี้ ไม่สามารถยกเลิกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depoya ait tüm yerel dosyalar silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі локальні файли цього репозиторію буде видалено. Цю дію неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa tất cả tệp cục bộ của kho lưu trữ này. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除该仓库的所有本地文件，此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除此儲存庫的所有本機檔案，且無法復原。"
          }
        }
      }
    },
    "This will permanently delete:\n%@\n\nThis cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف نهائيًا:\n%@\n\nلا يمكن التراجع عن هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil permanent slette:\n%@\n\nDette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird dauerhaft gelöscht:\n%@\n\nDies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente:\n%@\n\nEsto no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi:\n%@\n\nTätä ei voi peruuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": cela supprimera définitivement :\n%@\n\n: Cela ne peut pas être annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– זה ימחק באופן קבוע:\n%@\n\n– לא ניתן להסיר את ה결ס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह स्थायी रूप से निष्क्रिय करेगा:\n%@\n\n: इसे रद्द नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– ezzel mindig eltávolítják:\n%@\n\n– Ez nem ismételhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hal ini akan menghapus secara permanen:\n%@\n\nTindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questo comando eliminerà permanentemente:\n%@\n\nQuesto non può essere annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：以下の内容を永続的に削除します：\n%@\n\n：取り消すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 다음 항목을 영구 삭제합니다:\n%@\n\n: 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Dette fjerne permanent:\n%@\n\n– Dette kan ikke reverseres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Dit verwijdert permanent:\n%@\n\nDit kan niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– poniższe elementy zostaną na zawsze usunięte:\n%@\n\nNie można tego odwrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando excluirá permanentemente:\n%@\n\nEsta operação não pode ser revertida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": это будет выполнять постоянное удаление:\n%@\n\n: Это действие не может быть отменено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Detta kommer permanent att radera:\n%@\n\n– Det här kan inte återställas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": สิ่งนี้จะลบอย่างถาวร:\n%@\n\nข้อมูลนี้ไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu işlem aşağıdaki öğeleri kalıcı olarak siler:\n%@\n\n: Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": це буде постійно видалення:\n%@\n\nЦього неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "– Thao tác này sẽ xóa vĩnh viễn:\n%@\n\n: Không thể khôi phục thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作将永久删除：\n%@\n\n此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：此操作將永久刪除：\n%@\n\n此操作不可撤銷。"
          }
        }
      }
    },
    "This will sign out @%@. Repositories for this account will be hidden until you sign back in, and local files will stay on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى تسجيل الخروج @%@. سيتم إخفاء مستودعات هذا الحساب حتى تقوم بتسجيل الدخول مرة أخرى، وستبقى الملفات المحلية على جهازك.\nرمز"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil logge ud @%@. Lagre for denne konto vil være skjult, indtil du logger ind igen, og lokale filer forbliver på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird @%@ abgemeldet. Repositorys für dieses Konto werden ausgeblendet, bis Sie sich erneut anmelden, und lokale Dateien bleiben auf Ihrem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cerrará sesión en @%@. Los repositorios de esta cuenta estarán ocultos hasta que vuelva a iniciar sesión y los archivos locales permanecerán en su dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tämän tilin versiot piilotetaan kunnes kirjaudut takaisin sisään, ja paikalliset tiedostot pysyvät laitteessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Cela permettra de se déconnecter @%@: Les référentiels associés à ce compte seront masqués jusqu'à votre prochain redémarrage, et les fichiers locaux resteront sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– זה יסגר את החשבון של @%@– המאגרים של חשבון זה יישארו скрыtiים עד שתקבלו חתימה מחדש, והקובץ המקומיים יישארו על המכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": यह @ को साइन आउट करेगा।%@– इस खाते के लिए रिपॉजिटरी तब तक छिपे रहेंगे जब तक आप पुनः साइन इन न करेंगे, और स्थानीय फ़ाइलें आपके डिवाइस पर बनी रहेंगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az @-ot kilépésre vonzza.%@: Ez a számítógépre vonatkozó adatmagazinok csak újra bejelentkezés előtt rejtett maradnak, a helyi fájlok pedig az eszközeleteden maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan melakukan penutupan akun @%@. Repositori untuk akun ini akan disembunyikan sampai Anda masuk kembali, dan file lokal akan tetap tersimpan di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": Questo effettuerà la disconnessione @%@: I repository per questo account saranno nascosti fino a quando non effettuerai nuovamente l&#039;accesso; i file locali rimarranno sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：サインアウトします。%@：このアカウントのリポジトリは、再度サインインするまで非表示となり、ローカルファイルは端末上に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 이로 인해 로그아웃됩니다.%@: 해당 계정의 저장소는 다시 로그인할 때까지 숨겨지며, 로컬 파일은 기기에 계속 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil avslutte logginnstatusen @%@– Lagringsplattformer for dette kontoen vil bli skjult til du logger inn igjen, og lokale filer vil forbli på enheten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal de aanmelding beëindigen @%@: De opslagplaatsen voor dit account worden verborgen totdat u opnieuw inlogt, en de lokale bestanden blijven op uw apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– Zakończenie sesji @%@– Magazyny danych dla tego konta będą ukrywane aż do ponownego zalogowania się, a lokalne pliki pozostaną na Twoim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando realiza a saída de sessão @%@– Os repositórios para esta conta serão ocultados até você se autenticar novamente, e os arquivos locais permanecerão no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Это отменит вход @%@: репозитории для данного аккаунта будут скрыты до тех пор, пока вы не войдёте в систему повторно, а локальные файлы останутся на вашем устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Detta avslutar inloggningen @%@– Reposter för denna konto kommer att vara skymdat tills du loggar in igen, och lokala filer kommer att behållas på din enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": จะทำการออกจากระบบ @%@: คลังข้อมูลสำหรับบัญชีนี้จะถูกซ่อนจนกว่าคุณจะเข้าสู่ระบบอีกครั้ง และไฟล์ท้องถิ่นจะยังคงอยู่บนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Bu işlem @'i çıkış yapar.%@: Bu hesabın depoları yeniden giriş yapmak üzere gizlenir ve yerel dosyalar cihazınızda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це призведе до виходу з системи @%@. Репозиторії для цього облікового запису будуть прихованими до моменту повторного входу, а локальні файли залишатимуться на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Hành động này sẽ thoát đăng nhập @%@: Các kho dữ liệu cho tài khoản này sẽ bị ẩn cho đến khi bạn đăng nhập lại, và các tệp cục bộ sẽ vẫn được lưu trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将执行登出操作@%@：该账户的存储库将暂时隐藏，直至您重新登录；本地文件则会保留在您的设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將執行登齣操作@%@：該賬戶的存儲庫將暫時隱藏，直至您重新登録；本地文件則會保留在您的設備上。"
          }
        }
      }
    },
    "This will sign you out of GitHub. Your local repositories will be kept.": {
      "comment": "Sign-out confirmation dialog message",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تسجيل خروجك من GitHub. ستبقى مستودعاتك المحلية محفوظة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger dig ud af GitHub. Dine lokale repositories beholdes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst von GitHub abgemeldet. Deine lokalen Repositories bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will sign you out of GitHub. Your local repositories will be kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará tu sesión de GitHub. Tus repositorios locales se conservarán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kirjaa sinut ulos GitHub-palvelusta. Paikalliset tietovarastosi säilytetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté de GitHub. Vos dépôts locaux seront conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תנתק אותך מ-GitHub. המאגרים המקומיים שלך יישמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपको GitHub से साइन आउट कर देगा। आपकी स्थानीय रिपॉज़िटरीज़ सुरक्षित रहेंगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel kijelentkezel a GitHub-ból. A helyi tárolóid megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan keluar dari GitHub. Repositori lokal Anda akan tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrai disconnesso da GitHub. I tuoi repository locali saranno conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub からサインアウトします。ローカルのリポジトリは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 로그아웃됩니다. 로컬 저장소는 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger deg ut av GitHub. Dine lokale repositorier beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wordt uitgelogd bij GitHub. Je lokale repository's blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to wylogowanie z GitHub. Lokalne repozytoria zostaną zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será desconectado do GitHub. Seus repositórios locais serão mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы будете отключены от GitHub. Ваши локальные репозитории сохранятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du loggas ut från GitHub. Dina lokala förråd behålls."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะออกจากระบบ GitHub ของคุณ Repository ในเครื่องจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub oturumunuz kapatılacak. Yerel depolarınız korunacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вийдете з GitHub. Ваші локальні репозиторії збережуться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ được đăng xuất khỏi GitHub. Các kho lưu trữ cục bộ sẽ được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将退出你的 GitHub 账户。本地仓库将被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將會登出您的 GitHub 帳號。您的本機儲存庫將會保留。"
          }
        }
      }
    },
