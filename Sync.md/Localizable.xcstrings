    "Wait for the current Git operation to finish before backing up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر انتهاء عملية Git الحالية قبل النسخ الاحتياطي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent, til den aktuelle Git-handling er færdig, før du tager backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis der aktuelle Git-Vorgang abgeschlossen ist, bevor Sie sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la operación de Git actual antes de hacer la copia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odota nykyisen Git-toiminnon valmistumista ennen varmuuskopiointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de l’opération Git en cours avant de sauvegarder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתינו לסיום פעולת ה-Git הנוכחית לפני הגיבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप से पहले वर्तमान Git ऑपरेशन पूरा होने की प्रतीक्षा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentés előtt várja meg az aktuális Git-művelet végét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu operasi Git saat ini selesai sebelum mencadangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi la fine dell'operazione Git in corso prima del backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップする前に、現在の Git 操作が終わるのを待ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업하기 전에 현재 Git 작업이 끝날 때까지 기다리십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent til den gjeldende Git-operasjonen er ferdig før du tar sikkerhetskopi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de huidige Git-bewerking klaar is voordat u een back-up maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie bieżącej operacji Git przed tworzeniem kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a operação Git atual terminar antes de fazer backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения текущей операции Git перед резервным копированием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänta tills den aktuella Git-åtgärden är klar innan du säkerhetskopierar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอให้การทำงาน Git ปัจจุบันเสร็จก่อนสำรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeklemeden önce geçerli Git işleminin bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дочекайтеся завершення поточної операції Git перед резервним копіюванням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đợi thao tác Git hiện tại hoàn tất trước khi sao lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前 Git 操作完成后再备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待目前的 Git 操作完成後再備份。"
          }
        }
      }
    },
    "Wait for the current Git operation to finish before removing tracking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر انتهاء عملية Git الحالية قبل إزالة التتبع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent, til den aktuelle Git-handling er færdig, før du fjerner sporing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis der aktuelle Git-Vorgang abgeschlossen ist, bevor Sie das Tracking entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la operación de Git actual antes de quitar el seguimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odota nykyisen Git-toiminnon valmistumista ennen seurannan poistamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de l’opération Git en cours avant de supprimer le suivi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתינו לסיום פעולת ה-Git הנוכחית לפני הסרת המעקב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैकिंग हटाने से पहले वर्तमान Git ऑपरेशन पूरा होने की प्रतीक्षा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A követés eltávolítása előtt várja meg az aktuális Git-művelet végét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu operasi Git saat ini selesai sebelum menghapus pelacakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi la fine dell'operazione Git in corso prima di rimuovere il tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡を解除する前に、現在の Git 操作が終わるのを待ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적을 제거하기 전에 현재 Git 작업이 끝날 때까지 기다리십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent til den gjeldende Git-operasjonen er ferdig før du fjerner sporing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de huidige Git-bewerking klaar is voordat u tracking verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie bieżącej operacji Git przed usunięciem śledzenia."
