    "Could not resolve HEAD after continuing rebase": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حل HEAD بعد متابعة عملية إعادة الأساس"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke løse HEAD efter fortsat rebase"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HEAD konnte nach Fortsetzung des Rebase nicht aufgelöst werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo resolver HEAD después de continuar con el cambio de base"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "HEAD ei voitu selvittää jälkeen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "n&#39;a pas pu résoudre HEAD après avoir continué le rebase"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לפתור את ה-HEAD לאחר המשך ה-rebase"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": 'rebase' को जारी रखने के बाद 'HEAD' को समाधान नहीं किया जा सका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": A rebase folytatása után a HEAD-t nem sikerült megoldani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyelesaikan HEAD setelah proses rebase dilanjutkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": non è stato possibile risolvere HEAD dopo il completamento del rebase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ": レバス再実行後、HEADを解決できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 재기반화를 계속 진행한 후에도 HEAD를 해결할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kunne ikke løse HEAD etter at rebase ble fortsettet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Kon HEAD niet oplossen na het voortzetten van de rebase"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się rozwiązać HEAD po kontynuowaniu operacji rebase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível resolver o HEAD após a continuação do rebase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разрешить ссылку HEAD после продолжения операции rebase"
          }
        },
        "sv": {
