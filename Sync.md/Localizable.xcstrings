            "value": "تغيّر السجل منذ آخر ملف zip. أنشئ ملفًا جديدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Historikken er ændret siden den seneste zip. Lav en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf hat sich seit dem letzten ZIP geändert. Erstellen Sie ein neues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial cambió desde el último zip. Crea uno nuevo."
