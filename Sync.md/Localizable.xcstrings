    "%@ is a plain folder now. Its Git history is in the zip below. The GitHub repository stays on GitHub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح %@ مجلدًا عاديًا الآن. سجل Git الخاص به موجود في ملف zip أدناه. يبقى مستودع GitHub على GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er nu en almindelig mappe. Dens Git-historik ligger i zip-filen nedenfor. GitHub-repositoryet bliver på GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist jetzt ein normaler Ordner. Der Git-Verlauf befindet sich im ZIP unten. Das GitHub-Repository bleibt auf GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ahora es una carpeta normal. Su historial de Git está en el zip de abajo. El repositorio de GitHub sigue en GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on nyt tavallinen kansio. Sen Git-historia on alla olevassa zip-tiedostossa. GitHub-tietovarasto pysyy GitHubissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est maintenant un dossier ordinaire. Son historique Git se trouve dans le zip ci-dessous. Le dépôt GitHub reste sur GitHub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ היא עכשיו תיקייה רגילה. היסטוריית ה-Git שלה נמצאת בקובץ ה-zip למטה. המאגר ב-GitHub נשאר ב-GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अब एक साधारण फ़ोल्डर है। इसका Git इतिहास नीचे दी गई zip में है। GitHub रिपॉज़िटरी GitHub पर ही रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ most már egyszerű mappa. A Git-előzményei a lenti zipben vannak. A GitHub-tároló a GitHubon marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kini folder biasa. Riwayat Git-nya ada di zip di bawah. Repositori GitHub tetap ada di GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora è una normale cartella. La sua cronologia Git è nello zip qui sotto. Il repository GitHub resta su GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は通常のフォルダになりました。Git の履歴は下の zip にあります。GitHub リポジトリは GitHub に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이제 일반 폴더입니다. Git 기록은 아래 zip에 있습니다. GitHub 저장소는 GitHub에 그대로 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er nå en vanlig mappe. Git-historikken ligger i zip-filen nedenfor. GitHub-repositoriet blir værende på GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is nu een gewone map. De Git-geschiedenis staat in de zip hieronder. De GitHub-repository blijft op GitHub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest teraz zwykłym folderem. Jego historia Git jest w archiwum zip poniżej. Repozytorium GitHub pozostaje na GitHubie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ agora é uma pasta comum. O histórico Git está no zip abaixo. O repositório no GitHub continua no GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь обычная папка. Её история Git — в zip-архиве ниже. Репозиторий GitHub остаётся на GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är nu en vanlig mapp. Dess Git-historik finns i zip-filen nedan. GitHub-arkivet ligger kvar på GitHub."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ %@ เป็นโฟลเดอร์ธรรมดาแล้ว ประวัติ Git อยู่ในไฟล์ zip ด้านล่าง ที่เก็บบน GitHub ยังคงอยู่บน GitHub"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ artık sıradan bir klasör. Git geçmişi aşağıdaki zip dosyasında. GitHub deposu GitHub'da kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тепер звичайна папка. Її історія Git — у zip-архіві нижче. Репозиторій GitHub залишається на GitHub."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ giờ là thư mục thường. Lịch sử Git của nó nằm trong tệp zip bên dưới. Kho lưu trữ GitHub vẫn ở trên GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在是普通文件夹。其 Git 历史记录在下方的 zip 中。GitHub 仓库仍保留在 GitHub 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 現在是一般資料夾。其 Git 歷史記錄在下方的 zip 中。GitHub 儲存庫仍保留在 GitHub 上。"
          }
        }
      }
    },
    "%@ is a plain folder now. Its local Git history was deleted without a backup. The GitHub repository stays on GitHub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح %@ مجلدًا عاديًا الآن. حُذف سجل Git المحلي الخاص به دون نسخة احتياطية. يبقى مستودع GitHub على GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er nu en almindelig mappe. Dens lokale Git-historik blev slettet uden backup. GitHub-repositoryet bliver på GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist jetzt ein normaler Ordner. Der lokale Git-Verlauf wurde ohne Backup gelöscht. Das GitHub-Repository bleibt auf GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ahora es una carpeta normal. Su historial de Git local se eliminó sin copia de seguridad. El repositorio de GitHub sigue en GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on nyt tavallinen kansio. Sen paikallinen Git-historia poistettiin ilman varmuuskopiota. GitHub-tietovarasto pysyy GitHubissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est maintenant un dossier ordinaire. Son historique Git local a été supprimé sans sauvegarde. Le dépôt GitHub reste sur GitHub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ היא עכשיו תיקייה רגילה. היסטוריית ה-Git המקומית שלה נמחקה ללא גיבוי. המאגר ב-GitHub נשאר ב-GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अब एक साधारण फ़ोल्डर है। इसका स्थानीय Git इतिहास बिना बैकअप के हटा दिया गया। GitHub रिपॉज़िटरी GitHub पर ही रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ most már egyszerű mappa. A helyi Git-előzményeit biztonsági mentés nélkül töröltük. A GitHub-tároló a GitHubon marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kini folder biasa. Riwayat Git lokalnya dihapus tanpa cadangan. Repositori GitHub tetap ada di GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora è una normale cartella. La sua cronologia Git locale è stata eliminata senza backup. Il repository GitHub resta su GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は通常のフォルダになりました。ローカルの Git 履歴はバックアップなしで削除されました。GitHub リポジトリは GitHub に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이제 일반 폴더입니다. 로컬 Git 기록은 백업 없이 삭제되었습니다. GitHub 저장소는 GitHub에 그대로 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er nå en vanlig mappe. Den lokale Git-historikken ble slettet uten sikkerhetskopi. GitHub-repositoriet blir værende på GitHub."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is nu een gewone map. De lokale Git-geschiedenis is zonder back-up verwijderd. De GitHub-repository blijft op GitHub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest teraz zwykłym folderem. Jego lokalna historia Git została usunięta bez kopii zapasowej. Repozytorium GitHub pozostaje na GitHubie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ agora é uma pasta comum. O histórico Git local foi excluído sem backup. O repositório no GitHub continua no GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь обычная папка. Её локальная история Git удалена без резервной копии. Репозиторий GitHub остаётся на GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är nu en vanlig mapp. Dess lokala Git-historik raderades utan säkerhetskopia. GitHub-arkivet ligger kvar på GitHub."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ %@ เป็นโฟลเดอร์ธรรมดาแล้ว ประวัติ Git ในเครื่องถูกลบโดยไม่มีข้อมูลสำรอง ที่เก็บบน GitHub ยังคงอยู่บน GitHub"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ artık sıradan bir klasör. Yerel Git geçmişi yedeksiz silindi. GitHub deposu GitHub'da kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тепер звичайна папка. Її локальну історію Git видалено без резервної копії. Репозиторій GitHub залишається на GitHub."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ giờ là thư mục thường. Lịch sử Git cục bộ đã bị xóa mà không có bản sao lưu. Kho lưu trữ GitHub vẫn ở trên GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在是普通文件夹。其本地 Git 历史记录已被删除且未备份。GitHub 仓库仍保留在 GitHub 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 現在是一般資料夾。其本機 Git 歷史記錄已被刪除且未備份。GitHub 儲存庫仍保留在 GitHub 上。"
          }
        }
      }
    },
