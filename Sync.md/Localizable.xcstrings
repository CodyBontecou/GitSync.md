    "Use GitHub sign-in, a token, an SSH key, or public access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تسجيل الدخول GitHub، أو الرمز المميز، أو مفتاح SSH، أو الوصول العام."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug GitHub-logon, et token, en SSH-nøgle eller offentlig adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Anmeldung GitHub, ein Token, einen Schlüssel SSH oder öffentlichen Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el inicio de sesión GitHub, un token, una clave SSH o acceso público."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "-käyttö GitHub sisäänkirjautuminen, SSH avain, tai yleinen pääsy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation GitHub connexion : un jeton, un\nClé SSH ou accès public."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– שימוש GitHub – כניסה, טוקן, אֶת\nקוד SSH או גישה ציבורית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": उपयोग GitHub साइन-इन, एक टोकन, एक SSH कुंजी या सार्वजनिक पहुँच।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használata GitHub bejelentkezéshez szükséges token: SSH kulcs vagy nyilvános hozzáférés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan GitHub login, token, sebuah\nKunci SSH atau akses publik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzo GitHub : accesso, un token, un\nChiave SSH o accesso pubblico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GitHub ：サインイン、トークン、および SSH キーまたは公開アクセス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 GitHub 로그인: 토큰, SSH 키 또는 공개 접근 권한입니다."
          }
        },
        "nb": {
          "stringUnit": {
