    "Failed to update origin remote: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل في تحديث origin جهاز التحكم عن بعد: %@\nجلب"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke opdatere origin fjernbetjening: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler beim Aktualisieren von origin remote: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar origin control remoto: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitys epäonnistui origin kauko: %@"
          }
        },
        "fr": {
