    "Git updated before cancellation completed. Verify the working tree before the next sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Git تم التحديث قبل اكتمال الإلغاء. تحقق من شجرة العمل قبل المزامنة التالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Git עודכן לפני ביטול הושלם. לאמת את עץ העבודה לפני הסינכרון הבא."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Opdateret før aflysningsprocessen er afsluttet. Overvåg arbejdstræet før den næste synkronisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Aktualisiert vor Abschluss der Abbrechung. Überprüfen Sie den Arbeitsbaum vor der nächsten Synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Actualizado antes de que se complete la cancelación. Verifique el árbol de trabajo antes de la próxima sincronización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Päivitetty ennen peruttamisen valmistumista. Tarkista työpuu ennen seuraavaa synkronointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Mise à jour avant la finalisation de l'annulation. Vérifiez l'arbre de travail avant la prochaine synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git रद्दीकरण पूरा होने से पहले अपडेट करें। अगले सिंक से पहले 'working tree' को सत्यापित करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Frissítse a rendszert a megszüntetés befejezése előtt. Ellenőrizze a működő fastruktúrát a következő szinkronizáció előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Diperbarui sebelum pembatalan selesai. Verifikasi pohon kerja sebelum sinkronisasi berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Aggiornamento effettuato prima che la cancellazione sia completata. Verificare l'albero di lavoro prima della prossima sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git キャンセル処理完了前に更新してください。次の同期前に、ワークトリーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 취소가 완료되기 전에 업데이트하세요. 다음 동기화 전에 작업 트리를 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Oppdatert før avlysningsprosessen er fullført. Verifiser arbeidstreet før neste synkronisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Bijgewerkt voordat de annulering is voltooid. Controleer de werkboom vóór de volgende synchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Aktualizacja dokonana przed zakończeniem anulowania. Weryfikuj drzewo pracy przed kolejną synchronizacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Atualizado antes de concluir o cancelamento. Verifique a árvore de trabalho antes da próxima sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Обновление выполнено до завершения отмены. Проверьте рабочую ветку перед следующей синхронизацией."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Uppdaterad innan avbokning är slutförd. verifiera arbetsträet innan nästa synkronisering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Git อัปเดตก่อนที่การยกเลิกจะเสร็จสิ้น ตรวจสอบโครงสร้าง working tree ก่อนการซิงค์ครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git İptal işlemi tamamlanmadan önce güncellendi. Bir sonraki senkronizasyondan önce çalışma ağaçını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Оновлено до завершення скасування. Перевірте робоче дерево перед наступною синхронізацією."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Cập nhật trước khi quá trình hủy hoàn tất. Hãy kiểm tra cây làm việc trước khi thực hiện thao tác đồng bộ hóa tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 在取消操作完成前已更新。请在下一次同步前验证工作树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 在取消操作完成前已更新。請在下一次同步前驗證工作樹。"
          }
        }
      }
    },
    "Git updated, but Git LFS authentication or trust needs attention: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Git تحديث ولكن Git LFS تحتاج المصادقة أو الثقة إلى الاهتمام: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Git מעודכן, אבל Git LFS אימות או אמון צריך תשומת לב: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Opdateret, men Git LFS Autentificering eller tillit kræver opmærksomhed: %@"
