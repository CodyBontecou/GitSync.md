    "Notes on your phone and commits on GitHub meeting at one sync point": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظات على هاتفك وعمليات commit على GitHub تلتقي عند نقطة مزامنة واحدة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter på din telefon og commits på GitHub, der mødes i ét synkroniseringspunkt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen auf Ihrem Telefon und Commits auf GitHub treffen sich an einem Sync-Punkt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de tu teléfono y los commits de GitHub se encuentran en un punto de sincronización"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimen muistiinpanot ja GitHubin commitit kohtaavat yhdessä synkronointipisteessä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de votre téléphone et les commits sur GitHub se rejoignent en un point de synchronisation"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתקים בטלפון ו-commits ב-GitHub נפגשים בנקודת סנכרון אחת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फ़ोन के नोट्स और GitHub के commit एक सिंक पॉइंट पर मिलते हुए"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefon jegyzetei és a GitHub commitjai egyetlen szinkronpontban találkoznak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan di ponsel Anda dan commit di GitHub bertemu di satu titik sinkronisasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note sul tuo telefono e i commit su GitHub si incontrano in un unico punto di sincronizzazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォン上のノートと GitHub 上のコミットが一つの同期点で出会う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰의 노트와 GitHub의 커밋이 하나의 동기화 지점에서 만나는 모습"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notater på telefonen og commits på GitHub som møtes i ett synkroniseringspunkt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities op uw telefoon en commits op GitHub komen samen in één synchronisatiepunt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki na telefonie i commity na GitHubie spotykające się w jednym punkcie synchronizacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas no seu celular e commits no GitHub se encontrando em um ponto de sincronização"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки на телефоне и commit на GitHub встречаются в одной точке синхронизации"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningar på telefonen och commits på GitHub som möts i en synkpunkt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตบนโทรศัพท์และ commit บน GitHub มาบรรจบกันที่จุดซิงค์เดียว"
          }
        },
        "tr": {
          "stringUnit": {
