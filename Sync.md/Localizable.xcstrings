            "state": "translated",
            "value": "Ada satu hal yang perlu diperbaiki terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima c’è un aspetto da correggere."
          }
        },
        "ja": {
