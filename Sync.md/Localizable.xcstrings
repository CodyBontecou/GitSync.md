    "TLS certificate verification failed for %@. Check your network or the remote's certificate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " %@: تحقق من شبكةك أو شهادة جهاز الاتصال عن بعد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ": TLS-certifikatverifikationen er mislykket for %@– Undersøg netværket eller certifikatet på fjernafslutningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ": Die Verifizierung des TLS-Zertifikats ist fehlgeschlagen für %@– Überprüfen Sie Ihr Netzwerk oder das Zertifikat des Fernbedieners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ": la verificación del certificado TLS no se completó para %@. Verifique su red o el certificado del dispositivo remoto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS-luvan tarkistus epäonnistui. %@– Tarkista verkkosi tai kaukolaitteen sertifikaatti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "a échoué. %@: Vérifiez votre réseau ou le certificat du dispositif distant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נכשל עבור %@– בדьте את רשתכם או את תעודת ה-remote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS प्रमाणपत्र सत्यापन असफल रहा। %@– अपने नेटवर्क या रिमोट के प्रमाणपत्र की जाँच करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS ellenőrzés nem sikerült. %@– Próbálja meg a hálózatát vagy a távvezérlő ellenértékét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "gagal untuk %@. Periksa jaringan Anda atau sertifikat remotenya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "non è riuscita. %@. Controllare la rete o il certificato del dispositivo remoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：TLS証明書検証に失敗しました。 %@：ネットワークまたはリモート端末の証明書を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 인증 검증에 실패했습니다. %@: 네트워크 또는 리모트 장치의 인증서를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": TLS-sertifikatverifisering mislyktes for %@– Sjekk nettverket ditt eller fjernapparatets sertifikat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "is mislukt. %@: Controleer uw netwerk of het certificaat van de externe apparatuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "nie powiodł się. %@– Sprawdź sieć lub certyfikat odulatora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "falhou para %@– Verifique sua rede ou o certificado do dispositivo remoto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": проверка сертификата TLS не удалась для %@. Проверьте сеть или сертификат удалённого устройства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": TLS-certifikatverifiering misslyckades för %@– Kontrollera ditt nätverk eller fjärrkontrollens certifikat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": การตรวจสอบใบรับรอง TLS ล้มเหลวสำหรับ %@– ตรวจสอบเครือข่ายหรือใบรับรองของอุปกรณ์ระยะไกล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS sertifikası doğrulaması başarısız oldu. %@: Ağınız veya uzaktan cihazın sertifikasını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": перевірка сертифіката TLS не вдала для %@. Перевірте свій мережевий зв'язок або сертифікат дистанційного пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Xác minh chứng thư TLS đã thất bại cho %@– Vui lòng kiểm tra mạng hoặc chứng chỉ của thiết bị từ xa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "的 TLS 证书验证失败 %@：请检查您的网络或远程设备的证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "的 TLS 証書驗証失敗 %@：請檢查您的網絡或遠程設備的証書。"
          }
        }
      }
    },
