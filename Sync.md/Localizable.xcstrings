    "These files look binary or large and are safer in Git LFS:\n\n%@%@\n\nUse Git LFS? This will update and stage .gitattributes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو هذه الملفات ثنائية أو كبيرة وتكون أكثر أمانًا في Git LFS:\n\n%1$@%2$@\n\nاستخدام Git LFS؟ سيؤدي هذا إلى تحديث ومرحلة .gitattributes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filer ser binære eller store ud og er mere sikre i Git LFS:\n\n%1$@%2$@\n\nBrug Git LFS? Dette vil opdatere og iscenesætte .gitattributes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien sehen binär oder groß aus und sind sicherer in Git LFS:\n\n%1$@%2$@\n\nVerwenden Sie Git LFS? Dadurch wird .gitattributes aktualisiert und bereitgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "These files look binary or large and are safer in Git LFS:\n\n%1$@%2$@\n\nUse Git LFS? This will update and stage .gitattributes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos parecen binarios o grandes y son más seguros en Git LFS:\n\n%1$@%2$@\n\n¿Usar Git LFS? Esto actualizará y preparará .gitattributes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä tiedostot näyttävät binääri- tai suurilta ja ovat turvallisempia Git LFS:\n\n%1$@%2$@\n\n-käyttö Git LFS? Tämä päivitetään ja vaiheet .gitattributes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ces fichiers semblent binaires ou de grande taille et sont plus sûrs dans Git LFS:\n\n%1$@%2$@\n\nUtilisation Git LFS? Cela mettra à jour et placera les données. .gitattributes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הקבצים האלה מראים כבינריים או גדולים, ומאפיינים אבטחת גבוהה יותר. Git LFS:\n\n%1$@%2$@\n\n– שימוש Git LFS– זה יעדכן ויסדר את הנתונים. .gitattributes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "— ये फ़ाइलें बाइनरी या बड़ी प्रतीत होती हैं तथा सुरक्षित हैं। Git LFS:\n\n%1$@%2$@\n\n: उपयोग Git LFS– यह अपडेट एवं स्टेज करेगा। .gitattributes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "– ezek a fájlok bináris vagy nagy méretűek, és biztonságosabbak. Git LFS:\n\n%1$@%2$@\n\nHasználata Git LFS– Ez frissíti és szintezzi. .gitattributes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas-berkas ini tampak bersifat biner atau berukuran besar dan lebih aman di Git LFS:\n\n%1$@%2$@\n\nPenggunaan Git LFS? Hal ini akan memperbarui dan menyiapkan. .gitattributes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": questi file sembrano binari o di grandi dimensioni e sono più sicuri in Git LFS:\n\n%1$@%2$@\n\nUtilizzo Git LFS? Questo aggiornerà e metterà in fase di staging. .gitattributes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：これらのファイルはバイナリ形式またはサイズが大きく、より安全です。 Git LFS:\n\n%1$@%2$@\n\n使用 Git LFS：この操作により、更新およびステージングが行われます。 .gitattributes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일들은 바이너리 형식 또는 크기가 큰 것으로 보이며, 더 안전합니다. Git LFS:\n\n%1$@%2$@\n\n사용 Git LFS– 이는 업데이트 및 스테이징을 수행합니다. .gitattributes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Disse filene ser binære ut eller er store, og er tryggere i Git LFS:\n\n%1$@%2$@\n\nBruk Git LFS– Dette oppdaterer og lagrer data. .gitattributes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Deze bestanden lijken binair of groot te zijn en zijn veiliger in Git LFS:\n\n%1$@%2$@\n\nGebruik Git LFS? Dit zal de gegevens bijwerken en in een stage-status plaatsen. .gitattributes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "– te pliki wydają się być binarnymi lub duże, ale są bezpieczniejsze w Git LFS:\n\n%1$@%2$@\n\n– Użycie Git LFS– To polecenie aktualizuje i tworzy etap. .gitattributes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Estes arquivos parecem binários ou de grande tamanho e são mais seguros em Git LFS:\n\n%1$@%2$@\n\nUtilização Git LFS? Isto atualizará e preparará para envio. .gitattributes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": эти файлы выглядят как бинарные или имеют большой размер и являются более безопасными. Git LFS:\n\n%1$@%2$@\n\n— использование Git LFS: Это обновит и подготовит к выполнению. .gitattributes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Dessa filer ser ut som binära eller stora och är säkrare i Git LFS:\n\n%1$@%2$@\n\nAnvändning Git LFS– Detta uppdaterar och placerar. .gitattributes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เหล่านี้ดูเหมือนเป็นไฟล์ไบนารีหรือมีขนาดใหญ่ และปลอดภัยกว่าใน Git LFS:\n\n%1$@%2$@\n\nการใช้งาน Git LFS: สิ่งนี้จะทำการอัปเดตและจัดเตรียมข้อมูล .gitattributes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dosyaları ikili veya büyük görünüyor ve daha güvenlidür. Git LFS:\n\n%1$@%2$@\n\nKullanım Git LFS: Bu işlem güncelleme ve stage işlemini gerçekleştirir. .gitattributes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": ці файли виглядають як бінарні або великі і є безпечнішими. Git LFS:\n\n%1$@%2$@\n\n— Використання Git LFS– це оновить та підготує до виконання. .gitattributes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Các tệp này có vẻ là định dạng nhị phân hoặc kích thước lớn và an toàn hơn khi Git LFS:\n\n%1$@%2$@\n\n– Sử dụng Git LFS: Thao tác này sẽ cập nhật và lưu vào giai đoạn. .gitattributes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：这些文件看起来为二进制文件或体积较大，更安全的处理方式是 Git LFS:\n\n%1$@%2$@\n\n使用 Git LFS？此操作将进行更新与暂存。 .gitattributes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：這些文件看起來爲二進製文件或體積較大，更安全的處理方式是 Git LFS:\n\n%1$@%2$@\n\n使用 Git LFS？此操作將進行更新與暫存。 .gitattributes."
          }
        }
      }
    },
    "This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voi peruuttaa."
          }
        },
        "fr": {
