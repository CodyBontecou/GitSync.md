        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 zip 이후 기록이 변경되었습니다. 새로 만드십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Historikken er endret siden forrige zip. Lag en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geschiedenis is veranderd sinds de laatste zip. Maak een nieuwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia zmieniła się od ostatniego archiwum zip. Utwórz nowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico mudou desde o último zip. Crie um novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История изменилась после последнего архива. Создайте новый."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Historiken har ändrats sedan den senaste zip-filen. Skapa en ny."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติเปลี่ยนไปตั้งแต่ zip ล่าสุด สร้างใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş son zip'ten beri değişti. Yenisini oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія змінилася після останнього архіву. Створіть новий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử đã thay đổi kể từ tệp zip lần trước. Hãy tạo tệp mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次生成 zip 以来历史记录已更改。请重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次產生 zip 以來歷史記錄已變更。請重新產生。"
          }
        }
      }
    },
    "The local Git history in %@ will be permanently deleted without a backup.\n\nYour notes and files stay in place. The GitHub repository is not touched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف سجل Git المحلي في %@ نهائيًا دون نسخة احتياطية.\n\nتبقى ملاحظاتك وملفاتك في مكانها. لا يتم المساس بمستودع GitHub."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale Git-historik i %@ slettes permanent uden backup.\n\nDine noter og filer bliver, hvor de er. GitHub-repositoryet røres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Git-Verlauf in %@ wird ohne Backup endgültig gelöscht.\n\nIhre Notizen und Dateien bleiben, wo sie sind. Das GitHub-Repository wird nicht angetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de Git local de %@ se eliminará para siempre sin copia de seguridad.\n\nTus notas y archivos se quedan donde están. El repositorio de GitHub no se toca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion %@ paikallinen Git-historia poistetaan pysyvästi ilman varmuuskopiota.\n\nMuistiinpanosi ja tiedostosi pysyvät paikallaan. GitHub-tietovarastoon ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique Git local dans %@ sera définitivement supprimé sans sauvegarde.\n\nVos notes et fichiers restent en place. Le dépôt GitHub n’est pas modifié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היסטוריית ה-Git המקומית ב-%@ תימחק לצמיתות ללא גיבוי.\n\nהפתקים והקבצים שלכם נשארים במקומם. המאגר ב-GitHub לא מושפע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का स्थानीय Git इतिहास बिना बैकअप के स्थायी रूप से हटा दिया जाएगा।\n\nआपके नोट्स और फ़ाइलें अपनी जगह रहती हैं। GitHub रिपॉज़िटरी को छुआ नहीं जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ helyi Git-előzményei biztonsági mentés nélkül véglegesen törlődnek.\n\nA jegyzetei és fájljai a helyükön maradnak. A GitHub-tároló érintetlen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat Git lokal di %@ akan dihapus secara permanen tanpa cadangan.\n\nCatatan dan file Anda tetap di tempatnya. Repositori GitHub tidak disentuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia Git locale in %@ verrà eliminata definitivamente senza backup.\n\nLe tue note e i tuoi file restano dove sono. Il repository GitHub non viene toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のローカル Git 履歴はバックアップなしで完全に削除されます。\n\nノートとファイルはそのまま残ります。GitHub リポジトリには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 로컬 Git 기록이 백업 없이 영구적으로 삭제됩니다.\n\n노트와 파일은 그대로 유지됩니다. GitHub 저장소는 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale Git-historikken i %@ blir slettet permanent uten sikkerhetskopi.\n\nNotatene og filene dine blir der de er. GitHub-repositoriet berøres ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale Git-geschiedenis in %@ wordt definitief verwijderd zonder back-up.\n\nUw notities en bestanden blijven staan. De GitHub-repository wordt niet aangeraakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna historia Git w %@ zostanie trwale usunięta bez kopii zapasowej.\n\nTwoje notatki i pliki zostają na miejscu. Repozytorium GitHub pozostaje nietknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico Git local em %@ será excluído permanentemente sem backup.\n\nSuas notas e arquivos ficam no lugar. O repositório no GitHub não é alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная история Git в %@ будет безвозвратно удалена без резервной копии.\n\nВаши заметки и файлы остаются на месте. Репозиторий GitHub не затрагивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala Git-historiken i %@ raderas permanent utan säkerhetskopia.\n\nDina anteckningar och filer ligger kvar. GitHub-arkivet påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติ Git ในเครื่องใน %@ จะถูกลบถาวรโดยไม่สำรอง\n\nโน้ตและไฟล์ของคุณยังอยู่ที่เดิม ที่เก็บบน GitHub จะไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki yerel Git geçmişi yedeksiz olarak kalıcı şekilde silinecek.\n\nNotlarınız ve dosyalarınız yerinde kalır. GitHub deposuna dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальну історію Git у %@ буде остаточно видалено без резервної копії.\n\nВаші нотатки й файли залишаються на місці. Репозиторій GitHub не зачіпається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử Git cục bộ trong %@ sẽ bị xóa vĩnh viễn mà không có bản sao lưu.\n\nGhi chú và tệp của bạn vẫn ở nguyên chỗ. Kho lưu trữ GitHub không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的本地 Git 历史记录将被永久删除，且不做备份。\n\n你的笔记和文件保持原位。GitHub 仓库不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的本機 Git 歷史記錄將被永久刪除，且不做備份。\n\n你的筆記和檔案會保持原位。GitHub 儲存庫不受影響。"
          }
        }
      }
    },
    "The local branch changed before commit. Publication was stopped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الفرع المحلي قبل إنشاء commit. تم إيقاف النشر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale branch blev ændret før commit. Publiceringen blev stoppet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Branch wurde vor dem Commit geändert. Das Veröffentlichen wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rama local cambió antes del commit. Se detuvo la publicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen haara muuttui ennen committia. Julkaiseminen pysäytettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche locale a changé avant le commit. La publication a été interrompue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הענף המקומי השתנה לפני ה־commit. הפרסום הופסק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "commit से पहले स्थानीय branch बदल गई। प्रकाशन रोक दिया गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi ág megváltozott a commit előtt. A közzétételt leállítottuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch lokal berubah sebelum commit. Publikasi dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ramo locale è cambiato prima del commit. La pubblicazione è stata arrestata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "commit の前にローカルブランチが変更されました。公開を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "commit 전에 로컬 브랜치가 변경되었습니다. 게시를 중단했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale branchen ble endret før commit. Publiseringen ble stoppet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale branch is vóór de commit gewijzigd. Publiceren is gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna gałąź zmieniła się przed utworzeniem commita. Publikowanie zatrzymano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A branch local mudou antes do commit. A publicação foi interrompida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная ветка изменилась до создания commit. Публикация остановлена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala branchen ändrades före commit. Publiceringen stoppades."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "branch ในเครื่องเปลี่ยนแปลงก่อนสร้าง commit การเผยแพร่จึงหยุดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel dal commit’ten önce değişti. Yayımlama durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна гілка змінилася перед створенням commit. Публікування зупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh cục bộ đã thay đổi trước khi commit. Đã dừng xuất bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地分支在 commit 前发生了变化。发布已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機分支在 commit 前發生了變更。發佈已停止。"
          }
        }
      }
    },
