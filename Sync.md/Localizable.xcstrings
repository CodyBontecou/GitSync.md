          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：令牌无效或已过期。请退出登录后重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
