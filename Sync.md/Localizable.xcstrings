    "Every file goes back to how it was before the remote changes came in. Nothing is lost on the remote.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعود كل ملف إلى ما كان عليه قبل وصول تغييرات remote. لا يضيع شيء على remote."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle filer vender tilbage til, hvordan de var, før remote-ændringerne kom ind. Intet går tabt på remote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Datei kehrt zu ihrem Zustand vor den Remote-Änderungen zurück. Auf dem Remote geht nichts verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada archivo vuelve a como estaba antes de que llegaran los cambios remotos. No se pierde nada en el remoto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen tiedosto palautuu tilaan, jossa se oli ennen etämuutosten saapumista. Etäpalvelimelta ei katoa mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fichier revient à son état d’avant l’arrivée des modifications distantes. Rien n’est perdu sur le distant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל קובץ חוזר למצבו לפני שהשינויים מה-remote הגיעו. שום דבר לא אובד ב-remote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फ़ाइल वैसी ही हो जाती है जैसी remote बदलाव आने से पहले थी। remote पर कुछ भी नहीं खोता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden fájl visszaáll a távoli módosítások érkezése előtti állapotba. A távoli oldalon semmi sem vész el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap file kembali seperti sebelum perubahan remote masuk. Tidak ada yang hilang di remote."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni file torna com'era prima dell'arrivo delle modifiche remote. Sul remoto non si perde nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのファイルがリモートの変更が入る前の状態に戻ります。リモート上では何も失われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 파일이 원격 변경 사항이 들어오기 전 상태로 돌아갑니다. 원격에서는 아무것도 잃지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver fil går tilbake til slik den var før remote-endringene kom inn. Ingenting går tapt på remote."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk bestand gaat terug naar hoe het was voordat de remote-wijzigingen binnenkwamen. Op de remote gaat niets verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy plik wraca do stanu sprzed nadejścia zdalnych zmian. Na zdalnym repozytorium nic nie zostanie utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os arquivos voltam a como estavam antes das alterações remotas chegarem. Nada é perdido no remoto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый файл вернётся к состоянию до поступления удалённых изменений. На удалённой стороне ничего не потеряется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla filer återgår till hur de var innan fjärrändringarna kom in. Inget går förlorat på remote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกไฟล์จะกลับไปเป็นเหมือนก่อนที่การเปลี่ยนแปลงจาก remote จะเข้ามา ไม่มีอะไรสูญหายบน remote"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dosya, uzak değişiklikler gelmeden önceki hâline döner. Uzak tarafta hiçbir şey kaybolmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен файл повернеться до стану до надходження віддалених змін. На віддаленій стороні нічого не втратиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tệp sẽ trở về như trước khi các thay đổi từ remote được đưa vào. Không có gì bị mất trên remote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个文件都会恢复到远程更改进入之前的状态。远程上不会丢失任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個檔案都會回到遠端變更進來之前的狀態。遠端上不會遺失任何內容。"
          }
        }
      }
    },
    "Every repository covered": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل كل مستودع"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle arkiver er dækket"
