            "value": "Lager %@ Var slettet av en annen operasjon; forårsaket endringer ble ikke gjenopprettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository %@ Is verwijderd door een andere operatie; verouderde wijzigingen zijn niet geresumeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium %@ Użytej operacji usunięto; nie przywrócono starych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório %@ Foi excluído por outra operação; as alterações obsoletas não foram restauradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
