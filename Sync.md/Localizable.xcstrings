    "Local edits block this pull": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمليات التحرير المحلية تمنع هذا السحب"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale redigeringer blokerer denne pull"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Änderungen blockieren diesen Pull"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ediciones locales bloquean esta extracción"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset muokkaukset estävät vetoa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications locales bloquent cette traction"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": עריכות מקומיות מונעות את ה-\"pull\" הזה"
