          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actief GitSync Assist Een abonnement is vereist voordat automatische synchronisatie kan worden ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny GitSync Assist Należy najpierw nabyć abonament, aby można było włączyć automatyczne synchronizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
