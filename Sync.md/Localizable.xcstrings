        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Sonucu kaydedin ve bu dosyayı çözüldü olarak işaretleyin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти результат і позначити цей файл як вирішений?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
