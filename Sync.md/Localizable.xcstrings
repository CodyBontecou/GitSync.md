    "Downloaded LFS object %@ failed SHA-256/size verification.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تنزيل كائن LFS %@ SHA-256/التحقق من الحجم.\nتعديل"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadet LFS-objekt %@ mislykkedes SHA-256/størrelsesbekræftelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim heruntergeladenen LFS-Objekt %@ ist die SHA-256/Größenüberprüfung fehlgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objeto LFS descargado %@ falló en la verificación SHA-256/tamaño."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladattu LFS-objekti %@ epäonnistui SHA-256/ kokovarmennus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objet LFS téléchargé %@ a échoué SHA-256/vérification de la taille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": אובייקט LFS שנוריד %@ נכשל SHA-256/אימות גודל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "– डाउनलोड किया गया LFS ऑब्जेक्ट %@ विफल हुआ। SHA-256/आकार सत्यापन।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "letöltött LFS objektum %@ hibás volt SHA-256/méretellenőrzés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Objek LFS yang diunduh %@ gagal SHA-256/verifikasi ukuran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggetto scaricato LFS %@ ha fallito SHA-256/Verifica delle dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：LFSオブジェクトがダウンロードされました %@ に失敗しました SHA-256/サイズ検証。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": LFS 객체 다운로드 완료 %@ 실패하였습니다 SHA-256/사이즈 검증."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "– Lastet ned LFS-objekt %@ mislyktes SHA-256/ størrelsesverifisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": gedownload LFS-object %@ is mislukt SHA-256/maatverificatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Pobrany obiekt LFS %@ nie powiódło się SHA-256/verifikasija rozmiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Objeto LFS baixado %@ falhou SHA-256/verificação do tamanho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": загружен объект LFS %@ : неудача SHA-256/верификация размера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "– Nedladdat LFS-objekt %@ misslyckades SHA-256/storleksskyddning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ดาวน์โหลดออบเจกต์ LFS %@ ล้มเหลว SHA-256/การตรวจสอบขนาด"
