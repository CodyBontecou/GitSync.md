          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gỡ .git nằm trực tiếp trong thư mục đã chọn. Chỉ áp dụng cho thư mục cục bộ Trên iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除所选文件夹中直接包含的 .git。仅限“我的 iPhone”中的本地文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除所選資料夾中直接包含的 .git。僅限「我的 iPhone」中的本機資料夾。"
          }
        }
      }
    },
    "Only a single-parent commit can be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن التراجع فقط عن commit له أصل واحد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et commit med én forælder kan fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Commit mit einem einzigen Parent kann rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede deshacer un commit con un único padre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain yhden vanhemman commitin voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un commit à parent unique peut être annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבטל רק commit עם הורה יחיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एक पैरेंट वाला commit ही पूर्ववत किया जा सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak egyszülős commit vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya commit dengan satu induk yang dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può annullare solo un commit con un solo genitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せるのは親が1つのコミットのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부모가 하나인 커밋만 취소할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en commit med én forelder kan angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een commit met één ouder kan ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnąć można tylko commit z jednym rodzicem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas um commit com um único pai pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить можно только commit с одним родителем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast en commit med en förälder kan ångras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกทำได้เฉพาะ commit ที่มี parent เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tek üst öğeli bir commit geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати можна лише commit з одним батьком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể hoàn tác commit có một commit cha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能撤销单个父提交的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能復原單一父提交的提交。"
          }
        }
      }
    },
    "Only folders inside GitSync.md storage can be relinked without granting access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إعادة ربط سوى المجلدات الموجودة داخل مساحة تخزين GitSync.md من دون منح صلاحية الوصول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun mapper i GitSync.md-lagringspladsen kan tilknyttes igen uden at give adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Ordner im GitSync.md-Speicher können ohne Zugriffsfreigabe erneut verknüpft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden volver a enlazar las carpetas del almacenamiento de GitSync.md sin conceder acceso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain GitSync.md-tallennustilassa olevat kansiot voidaan linkittää uudelleen myöntämättä käyttöoikeutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les dossiers du stockage GitSync.md peuvent être associés à nouveau sans autorisation d’accès."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לקשר מחדש ללא מתן גישה רק תיקיות שנמצאות באחסון GitSync.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐक्सेस दिए बिना केवल GitSync.md स्टोरेज के फ़ोल्डर ही दोबारा लिंक किए जा सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáférés megadása nélkül csak a GitSync.md-tárhelyen belüli mappák kapcsolhatók újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya folder di dalam penyimpanan GitSync.md yang dapat ditautkan kembali tanpa memberikan akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza concedere l’accesso, è possibile ricollegare solo le cartelle nello spazio di archiviazione di GitSync.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを許可せずに再リンクできるのは、GitSync.mdストレージ内のフォルダのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한을 부여하지 않고 다시 연결할 수 있는 폴더는 GitSync.md 저장 공간 안의 폴더뿐입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare mapper i GitSync.md-lagringen kan kobles til på nytt uten at du gir tilgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen mappen in de GitSync.md-opslag kunnen opnieuw worden gekoppeld zonder toegang te verlenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez udzielania dostępu można ponownie połączyć tylko foldery w miejscu przechowywania GitSync.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente pastas no armazenamento do GitSync.md podem ser revinculadas sem conceder acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без предоставления доступа можно повторно привязать только папки в хранилище GitSync.md."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast mappar i GitSync.md-lagringen kan länkas om utan att åtkomst beviljas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะโฟลเดอร์ในพื้นที่จัดเก็บ GitSync.md เท่านั้นที่เชื่อมโยงใหม่ได้โดยไม่ต้องอนุญาตให้เข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim izni vermeden yalnızca GitSync.md saklama alanındaki klasörler yeniden bağlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без надання доступу можна повторно прив’язати лише папки в сховищі GitSync.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể liên kết lại các thư mục trong bộ nhớ GitSync.md mà không cần cấp quyền truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需授予访问权限，只能重新关联 GitSync.md 储存空间内的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需授予取用權限，只能重新連結 GitSync.md 儲存空間內的檔案夾。"
          }
        }
      }
    },
    "Only metadata is read. No notes are downloaded until you clone.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ البيانات الوصفية فقط. لا تُنزّل الملاحظات حتى تستنسخ المستودع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun metadata læses. Ingen noter downloades, før du kloner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Metadaten gelesen. Bis zum Klonen werden keine Notizen heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se leen los metadatos. No se descarga ninguna nota hasta que clones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain metatiedot luetaan. Muistiinpanoja ei ladata ennen kloonausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les métadonnées sont lues. Aucune note n’est téléchargée avant le clonage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקראים רק מטא-נתונים. הערות לא יורדו עד לשכפול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल मेटाडेटा पढ़ा जाता है। क्लोन करने तक कोई नोट डाउनलोड नहीं होता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a metaadatokat olvassuk be. A jegyzetek csak klónozáskor töltődnek le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya metadata yang dibaca. Catatan tidak diunduh sampai Anda mengkloning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono letti solo i metadati. Le note vengono scaricate solo quando cloni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータのみを読み取ります。クローンするまでノートはダウンロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터만 읽습니다. 클론하기 전에는 노트를 다운로드하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare metadata leses. Ingen notater lastes ned før du kloner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen metadata worden gelezen. Er worden geen notities gedownload totdat je kloont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytywane są tylko metadane. Notatki nie są pobierane przed klonowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os metadados são lidos. Nenhuma nota é baixada até você clonar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаются только метаданные. Заметки не скачиваются до клонирования."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast metadata läses. Inga anteckningar hämtas förrän du klonar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเฉพาะเมตาดาตาเท่านั้น จะไม่ดาวน์โหลดโน้ตจนกว่าคุณจะโคลน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca meta veriler okunur. Klonlayana kadar hiçbir not indirilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаються лише метадані. Нотатки не завантажуються до клонування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đọc siêu dữ liệu. Các ghi chú chưa được tải xuống cho đến khi bạn sao chép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取元数据。克隆前不会下载任何笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅讀取中繼資料。複製前不會下載任何筆記。"
          }
        }
      }
    },
    "Only on this iPhone": {
      "localizations": {
        "ar": {
