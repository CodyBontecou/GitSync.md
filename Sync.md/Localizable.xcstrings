    "Save the result and mark this file resolved?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حفظ النتيجة ووضع علامة على هذا الملف كحل؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du gemme resultatet og markere denne fil som løst?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnis speichern und diese Datei als gelöst markieren?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Guardar el resultado y marcar este archivo como resuelto?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna tulos ja merkitse tämä tiedosto ratkaistu?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer le résultat et marquer ce fichier résolu?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "– האם ברצונכם לשמור את התוצאה ו отметить את הקובץ כהוספת פתרון?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": परिणाम को सहेजें और इस फ़ाइल को 'समाधान' के रूप में चिह्नित करें?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Mentse a eredményt és jelölje meg ezt a fájlt megoldottnak?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan hasil dan tandai file ini sebagai teratasi?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il risultato e segnala questo file come risolto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：結果を保存し、このファイルを解決済みとする？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 결과를 저장하고 이 파일을 해결된 것으로 표시하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lagre resultatet og merke denne filen som løst?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Het resultaat opslaan en deze bestand als opgelost markeren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz wynik i oznacz ten plik jako rozwiążony?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar o resultado e marcar este arquivo como resolvido?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить результат и пометить этот файл как устранённый?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Spara resultatet och markera denna fil som löst?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": บันทึกผลลัพธ์และกำหนดให้ไฟล์นี้ได้รับการแก้ไขแล้วหรือไม่?"
          }
