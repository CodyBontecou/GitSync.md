    "Edits made on this iPhone since then are gone for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعديلات التي أُجريت على هذا الـ iPhone منذ ذلك الحين ستضيع نهائيًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer foretaget på denne iPhone siden da er væk for altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitdem auf diesem iPhone vorgenommene Änderungen sind endgültig verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios hechos en este iPhone desde entonces se pierden para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä iPhonessa sen jälkeen tehdyt muokkaukset menetetään pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications faites sur cet iPhone depuis sont définitivement perdues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עריכות שנעשו ב-iPhone הזה מאז אבדו לתמיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब से इस iPhone पर किए गए संपादन हमेशा के लिए चले गए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az azóta ezen az iPhone-on végzett módosítások végleg elvesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editan di iPhone ini sejak saat itu hilang selamanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche fatte su questo iPhone da allora sono perse per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以降にこの iPhone で行った編集は完全に失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 이후 이 iPhone에서 한 편집 내용은 영구적으로 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer gjort på denne iPhonen siden da er borte for godt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen die sindsdien op deze iPhone zijn gemaakt, zijn definitief weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany wprowadzone na tym iPhonie od tamtej pory przepadną na zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições feitas neste iPhone desde então foram perdidas para sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правки, сделанные на этом iPhone с тех пор, будут потеряны навсегда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar som gjorts på den här iPhonen sedan dess är borta för gott."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแก้ไขบน iPhone เครื่องนี้ตั้งแต่นั้นจะหายไปถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zamandan beri bu iPhone'da yapılan düzenlemeler kalıcı olarak gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правки, зроблені на цьому iPhone відтоді, буде втрачено назавжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chỉnh sửa trên iPhone này kể từ lúc đó sẽ mất vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此后在此 iPhone 上所做的编辑将永久丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此後在此 iPhone 上所做的編輯將永久遺失。"
          }
        }
      }
    },
    "Edits you make in Obsidian show up here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا التعديلات التي تجريها في Obsidian."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer, du laver i Obsidian, vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen, die Sie in Obsidian vornehmen, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios que hagas en Obsidian aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidianissa tekemäsi muokkaukset näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications faites dans Obsidian apparaissent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עריכות שתבצעו ב-Obsidian יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
