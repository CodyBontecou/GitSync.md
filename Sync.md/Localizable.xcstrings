        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": удалённый клиент запросил учетные данные для HTTPS, но для данного репозитория не сохранено ни токена, ни пароля."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
