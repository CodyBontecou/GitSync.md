          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте необмежену кількість репозиторіїв одноразовою покупкою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
