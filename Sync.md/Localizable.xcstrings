    "Git LFS SSH authentication could not determine the repository path.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH تحديد مسار المستودع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH-godkendelse kunne ikke bestemme lagerstien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH Authentifizierung konnte den Repository-Pfad nicht ermitteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH la autenticación no pudo determinar la ruta del repositorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH -varmennus ei voitu määrittää versiovarastoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH n&#39;a pas pu déterminer le chemin du référentiel.\nL&#39;authentification"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS SSH לא הצלחה לאמתת קביעת 경ทาง של המאגר.\nאימות"
          }
        },
        "hi": {
