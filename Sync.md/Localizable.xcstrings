    "New repositories will be saved to the app’s default location instead.": {
      "comment": "Alert message explaining what happens after removing the custom default location",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حفظ المستودعات الجديدة في الموقع الافتراضي للتطبيق بدلاً من ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye repositories gemmes i stedet paa appens standardplacering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Repositories werden stattdessen am Standard-Speicherort der App gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New repositories will be saved to the app’s default location instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos repositorios se guardarán en la ubicación predeterminada de la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet tietovarastot tallennetaan sen sijaan sovelluksen oletussijaintiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux dépôts seront enregistrés à l'emplacement par défaut de l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאגרים חדשים יישמרו במיקום ברירת המחדל של האפליקציה במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई रिपॉज़िटरीज़ इसके बजाय ऐप के डिफ़ॉल्ट स्थान पर सहेजी जाएँगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új tárolók ehelyett az alkalmazás alapértelmezett helyére kerülnek mentésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori baru akan disimpan di lokasi default aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi repository verranno salvati nella posizione predefinita dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいリポジトリはアプリのデフォルトの場所に保存されるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 저장소는 앱의 기본 위치에 저장됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye repositorier lagres på appens standardplassering i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe repository's worden in plaats daarvan opgeslagen op de standaardlocatie van de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe repozytoria będą zapisywane w domyślnej lokalizacji aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos repositórios serão salvos no local padrão do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые репозитории будут сохраняться в расположение по умолчанию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nya förråd sparas på appens standardplats istället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository ใหม่จะถูกบันทึกไว้ที่ตำแหน่งเริ่มต้นของแอปแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni depolar bunun yerine uygulamanın varsayılan konumuna kaydedilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натомість нові репозиторії зберігатимуться у типовому місці застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ mới sẽ được lưu vào vị trí mặc định của ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新仓库将改为保存到应用的默认位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新儲存庫將改為儲存至應用程式的預設位置。"
          }
        }
      }
    },
