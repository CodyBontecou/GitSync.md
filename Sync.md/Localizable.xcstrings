        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon automatikus pullt, külön hozzájárulással engedélyezett automatikus push-t, vagy mindkettőt, amikor az iOS engedi. Opcionális előfizetés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
