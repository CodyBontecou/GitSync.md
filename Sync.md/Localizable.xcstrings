    "Pull down to refresh, or create a repository on GitHub first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للأسفل للتحديث، أو أنشئ مستودعًا على GitHub أولًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk ned for at opdatere, eller opret først et repository på GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aktualisieren nach unten ziehen oder zuerst ein Repository auf GitHub erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo para actualizar o crea primero un repositorio en GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä vetämällä alas tai luo ensin tietovarasto GitHubiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez vers le bas pour actualiser, ou créez d’abord un dépôt sur GitHub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משכו למטה לרענון, או צרו קודם מאגר ב-GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीफ़्रेश करने के लिए नीचे खींचें, या पहले GitHub पर रिपॉज़िटरी बनाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
