    "GitHub didn’t accept your sign-in. Sign in again, then check again.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل GitHub تسجيل دخولك. سجّل الدخول مجددًا ثم أعد التحقق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub accepterede ikke dit login. Log ind igen, og kontrollér igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat Ihre Anmeldung nicht akzeptiert. Melden Sie sich erneut an und wiederholen Sie die Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no aceptó tu inicio de sesión. Inicia sesión de nuevo y repite la comprobación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ei hyväksynyt kirjautumistasi. Kirjaudu uudelleen ja toista tarkistus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n’a pas accepté votre connexion. Reconnectez-vous, puis relancez la vérification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub לא אישר את הכניסה שלכם. היכנסו שוב ובדקו מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ने आपका साइन-इन स्वीकार नहीं किया। फिर से साइन इन करें और दोबारा जाँचें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub nem fogadta el a bejelentkezést. Jelentkezzen be újra, majd ismételje meg az ellenőrzést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub tidak menerima proses masuk Anda. Masuk kembali, lalu periksa lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non ha accettato l’accesso. Accedi di nuovo e ripeti il controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub にサインインが受け付けられませんでした。再度サインインして、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 로그인을 수락하지 않았습니다. 다시 로그인한 후 확인해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub godtok ikke påloggingen. Logg på igjen og kontroller på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub heeft je aanmelding niet geaccepteerd. Meld je opnieuw aan en controleer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nie zaakceptował logowania. Zaloguj się ponownie i powtórz sprawdzanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não aceitou seu login. Entre novamente e repita a verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не принял данные входа. Войдите снова и повторите проверку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub godkände inte din inloggning. Logga in igen och upprepa kontrollen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ไม่ยอมรับการลงชื่อเข้าใช้ของคุณ โปรดลงชื่อเข้าใช้อีกครั้งแล้วตรวจสอบใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub oturum açmanızı kabul etmedi. Tekrar oturum açıp yeniden kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не прийняв ваш вхід. Увійдіть знову та повторіть перевірку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub không chấp nhận thông tin đăng nhập. Hãy đăng nhập lại rồi kiểm tra lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 未接受你的登录。请重新登录，然后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 未接受你的登入。請重新登入，然後再次檢查。"
          }
        }
      }
    },
    "GitHub event wakes use only opaque identifiers — never repository names, contents, paths, or credentials. Everything manual stays included with the app you already own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub يستخدم مستيقظ الأحداث معرفات معتم فقط-لا يستخدم أبدًا أسماء مستودع أو محتويات أو مسارات أو بيانات اعتماد. كل شيء يقام يدويًا متضمنة في التطبيق الذي لديك بالفعل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub מתעורר האירוע משתמש רק מזהה עמום-אף פעם לא מאגר שמות, תוכן, נתיבים, או אישורים. כל מדריך נשאר כלול עם האפליקציה שכבר בבעלותך."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake-brugere bruger kun opaque identificatorer – aldrig repository-navne, indhold, sti eller adgangsoplysninger. Alt manuelt indhold er fortsat inkluderet i den app, som du allerede besidder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event-Wakes verwenden ausschließlich opake Identifikatoren – niemals Repository-Namen, Inhalte, Pfade oder Anmeldeinformationen. Alle manuellen Elemente bleiben in der App, die Sie bereits besitzen, enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Los eventos de activación utilizan únicamente identificadores opacos; nunca se emplean nombres de repositorio, contenido, rutas ni credenciales. Todo lo que requiera intervención manual se incluye junto con la aplicación que ya posees."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake -työkalu käyttää ainoastaan epäkuvallisia tunnisteita – ei koskaan tallennuslaitteiden nimiä, sisältöjä, polkuja tai kirjautumistietoja. Kaikki manuaaliset asennukset jäävät yhtenäisiksi jo olemassa olevan sovelluksen kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Les événements « Wakes » utilisent uniquement des identifiants opaques — jamais des noms de dépôt, du contenu, de chemins ou de données d'identification. Tout ce qui nécessite une intervention manuelle reste inclus dans l'application que vous possédez déjà."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub EventWakes केवल अपारदर्शी पहचानकर्ताओं का उपयोग करता है — कभी भी रिपॉजिटरी के नामों, सामग्री, पथों या प्रमाणपत्रों का उपयोग नहीं किया जाता। सभी मैनुअल तत्व उस ऐप के साथ शामिल रहते हैं जो आप पहले से ही रखते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Az Event Wake-kor csak opacitású azonosítókat használnak – sosem a tárolóneveket, tartalmait, utakat vagy hitelesítő adatokat. Minden manuális funkció továbbra is azon a alkalmazásban található, amelyet már rendelkezésre állítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake hanya menggunakan identifikator opak — tidak pernah menggunakan nama repositori, konten, jalur, atau kredensial. Semua fitur manual tetap disertakan dalam aplikasi yang sudah Anda miliki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Gli eventi «Wakes» utilizzano esclusivamente identificatori opachi — mai nomi di repository, contenuti, percorsi o credenziali. Tutte le funzionalità manuali rimangono incluse nell'app che già possiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wakesでは、不透明な識別子のみを使用します。リポジトリ名、コンテンツ、パス、または認証情報は一切使用しません。すべての手動操作は、既にご所有のアプリ内に含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wakes는 오직 불투명 식별자만을 사용합니다 — 저장소 이름, 내용, 경로 또는 인증 정보는 절대 사용하지 않습니다. 모든 수동 설정은 이미 사용 중인 앱과 함께 제공됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake-tiltak bruker kun opak identifikatorer – aldri repozitorienavn, innhold, stier eller autentiseringsopplysninger. Alt manuelt innhold er fortsatt inkludert iappen du allerede eier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake's gebruiken uitsluitend ondoorzichtige identificatoren — nooit repositorynamen, inhoud, paden of toegangsgegevens. Alle handmatige functies blijven bij de app die u al bezit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarzenia wybudzające GitHub używają wyłącznie nieprzejrzystych identyfikatorów — nigdy nazw repozytoriów, zawartości, ścieżek ani danych uwierzytelniających. Wszystkie funkcje ręczne pozostają dostępne w posiadanej już aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Os Event Wakes utilizam apenas identificadores opacos — nunca nomes de repositórios, conteúdos, caminhos ou credenciais. Tudo o que for feito manualmente permanece incluído no aplicativo que você já possui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События пробуждения GitHub используют только непрозрачные идентификаторы — никогда названия репозиториев, содержимое, пути или учётные данные. Все ручные функции остаются доступными в уже принадлежащем вам приложении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Event Wake använder endast opak identifierare – aldrig repozitorienamn, innehåll, sökvägar eller autentiseringsuppgifter. Allt manuellt behövs fortfarande med appen som du redan äger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub EventWakes ใช้เพียงตัวระบุแบบไม่โปร่งใสเท่านั้น — ไม่ใช้ชื่อคลังข้อมูล เนื้อหา เส้นทาง หรือข้อมูลการเข้าสู่ระบบแต่อย่างใด ทุกสิ่งที่ต้องดำเนินการด้วยตนเองยังคงรวมอยู่ในแอปพลิเคชันที่คุณมีอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub olay uyandırmaları yalnızca opak tanımlayıcılar kullanır — depo adlarını, içerikleri, yolları veya kimlik bilgilerini asla kullanmaz. Tüm manuel özellikler zaten sahip olduğunuz uygulamada yer almaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Події використовують лише непрозорі ідентифікатори — ніколи не імена репозиторіїв, вміст, шляхи чи дані автентифікації. Усі ручні налаштування залишаються в тому додатку, який ви вже маєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Các sự kiện Wake chỉ sử dụng các định danh không trong suốt — không bao giờ sử dụng tên kho lưu trữ, nội dung, đường dẫn hay thông tin xác thực. Mọi thao tác thủ công đều được tích hợp sẵn trong ứng dụng mà bạn đã sở hữu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 事件唤醒功能仅支持使用不透明标识符——绝不使用仓库名称、内容、路径或凭据。所有手动操作均可直接在您已拥有的应用程序中完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 事件喚醒功能僅支援使用不透明識別符號——絕不使用倉庫名稱、內容、路徑或憑據。所有手動操作均可直接在您已擁有的應用程式中完成。"
          }
        }
      },
      "extractionState": "stale"
    },
    "GitHub has %@/%@ (%@). Its name does not prove it was created by this attempt. Use this repository as the destination for your saved commit?\n\n%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى GitHub المستودع %@/%@ (%@). اسمه لا يثبت أنه أُنشئ بهذه المحاولة. هل تريد استخدام هذا المستودع كوجهة للـ commit المحفوظ؟\n\n%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub har %@/%@ (%@). Navnet beviser ikke, at det blev oprettet af dette forsøg. Vil du bruge dette repository som destination for dit gemte commit?\n\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat %@/%@ (%@). Der Name beweist nicht, dass es durch diesen Versuch erstellt wurde. Dieses Repository als Ziel für Ihren gespeicherten Commit verwenden?\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub tiene %@/%@ (%@). Su nombre no demuestra que se creara en este intento. ¿Usar este repositorio como destino de tu commit guardado?\n\n%@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubissa on %@/%@ (%@). Sen nimi ei todista, että se luotiin tällä yrityksellä. Käytetäänkö tätä tietovarastoa tallennetun commitisi kohteena?\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub contient %@/%@ (%@). Son nom ne prouve pas qu’il a été créé par cette tentative. Utiliser ce dépôt comme destination de votre commit enregistré ?\n\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-GitHub קיים %@/%@ (%@). השם שלו אינו מוכיח שהוא נוצר בניסיון הזה. להשתמש במאגר הזה כיעד ל-commit השמור שלכם?\n\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub पर %@/%@ (%@) मौजूद है। इसका नाम यह साबित नहीं करता कि इसे इसी प्रयास ने बनाया। अपने सहेजे गए commit के गंतव्य के रूप में इस रिपॉज़िटरी का उपयोग करें?\n\n%@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHubon létezik: %@/%@ (%@). A név nem bizonyítja, hogy ez a kísérlet hozta létre. Ezt a tárolót használja a mentett commit céljaként?\n\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub memiliki %@/%@ (%@). Namanya tidak membuktikan bahwa repositori itu dibuat oleh upaya ini. Gunakan repositori ini sebagai tujuan commit tersimpan Anda?\n\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha %@/%@ (%@). Il nome non dimostra che sia stato creato da questo tentativo. Usare questo repository come destinazione del commit salvato?\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub に %@/%@（%@）があります。名前だけでは、今回の試行で作成されたものとは断定できません。このリポジトリを保存済みコミットの送信先として使用しますか？\n\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 %@/%@(%@)이(가) 있습니다. 이름만으로는 이번 시도에서 생성되었다고 확신할 수 없습니다. 이 저장소를 저장된 커밋의 대상으로 사용하겠습니까?\n\n%@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub har %@/%@ (%@). Navnet beviser ikke at det ble opprettet av dette forsøket. Vil du bruke dette repositoriet som mål for den lagrede commiten?\n\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub heeft %@/%@ (%@). De naam bewijst niet dat deze door deze poging is gemaakt. Deze repository gebruiken als bestemming voor uw bewaarde commit?\n\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ma %@/%@ (%@). Sama nazwa nie dowodzi, że utworzyła je ta próba. Użyć tego repozytorium jako miejsca docelowego dla zapisanego commita?\n\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub tem %@/%@ (%@). O nome não prova que ele foi criado por esta tentativa. Usar este repositório como destino do seu commit salvo?\n\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На GitHub есть %@/%@ (%@). Имя не доказывает, что он создан этой попыткой. Использовать этот репозиторий как место назначения для сохранённого commit?\n\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub har %@/%@ (%@). Namnet bevisar inte att det skapades vid det här försöket. Vill du använda det här arkivet som mål för din sparade commit?\n\n%@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub มี %@/%@ (%@) ชื่อนี้ไม่ได้พิสูจน์ว่าถูกสร้างโดยความพยายามครั้งนี้ ใช้ที่เก็บนี้เป็นปลายทางของ commit ที่บันทึกไว้ไหม\n\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'da %@/%@ (%@) var. Adı, bu denemeyle oluşturulduğunu kanıtlamaz. Kaydedilen commit'iniz için hedef olarak bu depo kullanılsın mı?\n\n%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На GitHub є %@/%@ (%@). Назва не доводить, що його створено цією спробою. Використати цей репозиторій як місце призначення для збереженого commit?\n\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub có %@/%@ (%@). Tên của nó không chứng minh được rằng nó được tạo trong lần thử này. Dùng kho lưu trữ này làm đích cho commit đã lưu?\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上有 %@/%@（%@）。仅凭名称无法证明它是由本次尝试创建的。要将此仓库用作已保存提交的目标吗？\n\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上有 %@/%@（%@）。僅憑名稱無法證明它是由這次嘗試建立的。要將此儲存庫作為已儲存提交的目的地嗎？\n\n%@"
          }
        }
      }
    },
    "GitHub is rate-limiting requests right now. Wait a minute, then check again.": {
      "comment": "AI-authored localization draft (2026-11-08); human linguistic review pending. Existing catalog terminology reused where equivalent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّ GitHub من الطلبات حاليًا. انتظر دقيقة ثم أعد التحقق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub begrænser i øjeblikket antallet af anmodninger. Vent et minut, og kontrollér igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub begrenzt derzeit die Anfragen. Warten Sie eine Minute und wiederholen Sie die Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub está limitando las solicitudes. Espera un minuto y repite la comprobación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rajoittaa pyyntöjä tällä hetkellä. Odota minuutti ja tarkista uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub limite actuellement les requêtes. Patientez une minute, puis relancez la vérification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub מגביל כרגע את מספר הבקשות. המתינו דקה ובדקו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub अभी अनुरोधों की संख्या सीमित कर रहा है। एक मिनट रुकें और फिर जाँचें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub jelenleg korlátozza a kérések számát. Várjon egy percet, majd ellenőrizze újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sedang membatasi permintaan. Tunggu satu menit, lalu periksa lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sta limitando le richieste. Attendi un minuto e ripeti il controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub が現在リクエスト数を制限しています。1分待ってから、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 현재 요청 수를 제한하고 있습니다. 1분 후 다시 확인해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub begrenser antall forespørsler akkurat nå. Vent et minutt og kontroller på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub beperkt momenteel het aantal verzoeken. Wacht een minuut en controleer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ogranicza teraz liczbę żądań. Poczekaj minutę i sprawdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub está limitando as solicitações. Aguarde um minuto e repita a verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub сейчас ограничивает число запросов. Подождите минуту и повторите проверку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub begränsar antalet förfrågningar just nu. Vänta en minut och kontrollera igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub กำลังจำกัดจำนวนคำขอ โปรดรอหนึ่งนาทีแล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub şu anda istek sayısını sınırlıyor. Bir dakika bekleyip yeniden kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub зараз обмежує кількість запитів. Зачекайте хвилину та повторіть перевірку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hiện đang giới hạn số yêu cầu. Hãy đợi một phút rồi kiểm tra lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 目前正在限制请求数量。请稍等一分钟，然后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 目前正在限制請求數量。請稍等一分鐘，然後再次檢查。"
          }
        }
      }
    },
    "GitHub may have created the repository before the response was lost. Check its current state before continuing. A matching repository requires your explicit approval.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما أنشأ GitHub المستودع قبل فقدان الاستجابة. تحقق من حالته الحالية قبل المتابعة. يتطلب المستودع المطابق موافقتك الصريحة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan have oprettet repositoryet, før svaret gik tabt. Tjek dets aktuelle tilstand, før du fortsætter. Et matchende repository kræver din udtrykkelige godkendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat das Repository möglicherweise erstellt, bevor die Antwort verloren ging. Prüfen Sie den aktuellen Zustand, bevor Sie fortfahren. Ein passendes Repository erfordert Ihre ausdrückliche Zustimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que GitHub creara el repositorio antes de que se perdiera la respuesta. Comprueba su estado actual antes de continuar. Un repositorio coincidente requiere tu aprobación explícita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub on ehkä luonut tietovaraston ennen kuin vastaus katosi. Tarkista sen nykyinen tila ennen jatkamista. Vastaava tietovarasto vaatii nimenomaisen hyväksyntäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a peut-être créé le dépôt avant que la réponse ne soit perdue. Vérifiez son état actuel avant de continuer. Un dépôt correspondant nécessite votre accord explicite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן ש-GitHub יצר את המאגר לפני שהתגובה אבדה. בדקו את מצבו הנוכחי לפני שתמשיכו. מאגר תואם דורש את אישורכם המפורש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है GitHub ने जवाब खोने से पहले रिपॉज़िटरी बना दी हो। जारी रखने से पहले इसकी वर्तमान स्थिति जाँचें। मेल खाने वाली रिपॉज़िटरी के लिए आपकी स्पष्ट मंज़ूरी ज़रूरी है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehet, hogy a GitHub létrehozta a tárolót, mielőtt a válasz elveszett. Folytatás előtt ellenőrizze az aktuális állapotát. Egyező tárolóhoz kifejezett jóváhagyása szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub mungkin sudah membuat repositori sebelum responsnya hilang. Periksa kondisinya sebelum melanjutkan. Repositori yang cocok memerlukan persetujuan eksplisit Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub potrebbe aver creato il repository prima che la risposta andasse persa. Controlla il suo stato attuale prima di continuare. Un repository corrispondente richiede la tua approvazione esplicita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答が失われる前に、GitHub がリポジトリを作成した可能性があります。続行する前に現在の状態を確認してください。一致するリポジトリを使うには、あなたの明示的な承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 유실되기 전에 GitHub에서 저장소를 만들었을 수 있습니다. 계속하기 전에 현재 상태를 확인하십시오. 일치하는 저장소를 사용하려면 명시적인 승인이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan ha opprettet repositoriet før svaret gikk tapt. Sjekk gjeldende tilstand før du fortsetter. Et samsvarende repositorium krever eksplisitt godkjenning fra deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub heeft de repository mogelijk gemaakt voordat het antwoord verloren ging. Controleer de huidige status voordat u verdergaat. Een overeenkomende repository vereist uw uitdrukkelijke goedkeuring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub mógł utworzyć repozytorium, zanim odpowiedź zaginęła. Sprawdź jego bieżący stan, zanim przejdziesz dalej. Pasujące repozytorium wymaga Twojej wyraźnej zgody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub pode ter criado o repositório antes de a resposta se perder. Verifique o estado atual antes de continuar. Um repositório correspondente exige sua aprovação explícita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub мог создать репозиторий до того, как ответ потерялся. Проверьте его текущее состояние, прежде чем продолжить. Для подходящего репозитория требуется ваше явное одобрение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan ha skapat arkivet innan svaret gick förlorat. Kontrollera dess aktuella status innan du fortsätter. Ett matchande arkiv kräver ditt uttryckliga godkännande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub อาจสร้างที่เก็บไปแล้วก่อนที่การตอบกลับจะหายไป ตรวจสอบสถานะปัจจุบันก่อนดำเนินการต่อ ที่เก็บที่ตรงกันต้องได้รับการอนุมัติอย่างชัดเจนจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub, yanıt kaybolmadan önce depoyu oluşturmuş olabilir. Devam etmeden önce güncel durumunu denetleyin. Eşleşen bir depo açık onayınızı gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub міг створити репозиторій до того, як відповідь загубилася. Перевірте його поточний стан, перш ніж продовжити. Для відповідного репозиторію потрібне ваше явне схвалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub có thể đã tạo kho lưu trữ trước khi phản hồi bị mất. Hãy kiểm tra trạng thái hiện tại trước khi tiếp tục. Kho lưu trữ khớp cần bạn chấp thuận rõ ràng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 可能在响应丢失前已创建了仓库。继续之前请检查其当前状态。使用匹配的仓库需要你明确批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 可能在回應遺失前已建立儲存庫。繼續之前請檢查其目前狀態。使用相符的儲存庫需要你明確核准。"
          }
        }
      }
    },
    "GitHub may have created the repository. Check GitHub and confirm the destination before continuing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما أنشأ GitHub المستودع. تحقق من GitHub وأكّد الوجهة قبل المتابعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan have oprettet repositoryet. Tjek GitHub, og bekræft destinationen, før du fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat das Repository möglicherweise erstellt. Prüfen Sie GitHub und bestätigen Sie das Ziel, bevor Sie fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que GitHub haya creado el repositorio. Revisa GitHub y confirma el destino antes de continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub on ehkä luonut tietovaraston. Tarkista GitHub ja vahvista kohde ennen jatkamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a peut-être créé le dépôt. Vérifiez GitHub et confirmez la destination avant de continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן ש-GitHub יצר את המאגר. בדקו ב-GitHub ואשרו את היעד לפני שתמשיכו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है GitHub ने रिपॉज़िटरी बना दी हो। जारी रखने से पहले GitHub जाँचें और गंतव्य की पुष्टि करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehet, hogy a GitHub létrehozta a tárolót. Folytatás előtt ellenőrizze a GitHubot, és erősítse meg a célt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub mungkin sudah membuat repositori. Periksa GitHub dan konfirmasi tujuan sebelum melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub potrebbe aver creato il repository. Controlla GitHub e conferma la destinazione prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub がリポジトリを作成した可能性があります。続行する前に GitHub を確認し、送信先を確定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 저장소를 만들었을 수 있습니다. 계속하기 전에 GitHub를 확인하고 대상을 확정하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan ha opprettet repositoriet. Sjekk GitHub og bekreft målet før du fortsetter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub heeft de repository mogelijk gemaakt. Controleer GitHub en bevestig de bestemming voordat u verdergaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub mógł utworzyć repozytorium. Sprawdź GitHub i potwierdź miejsce docelowe, zanim przejdziesz dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub pode ter criado o repositório. Verifique o GitHub e confirme o destino antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub мог создать репозиторий. Проверьте GitHub и подтвердите место назначения, прежде чем продолжить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kan ha skapat arkivet. Kontrollera GitHub och bekräfta målet innan du fortsätter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub อาจสร้างที่เก็บไปแล้ว ตรวจสอบ GitHub และยืนยันปลายทางก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub depoyu oluşturmuş olabilir. Devam etmeden önce GitHub'ı denetleyin ve hedefi onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub міг створити репозиторій. Перевірте GitHub і підтвердьте місце призначення, перш ніж продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub có thể đã tạo kho lưu trữ. Hãy kiểm tra GitHub và xác nhận đích trước khi tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 可能已创建了仓库。继续之前请检查 GitHub 并确认目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 可能已建立儲存庫。繼續之前請檢查 GitHub 並確認目的地。"
          }
        }
      }
    },
    "GitHub repository access could not be verified. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من الوصول إلى مستودع GitHub. يُرجى المحاولة مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til GitHub-repositoryet kunne ikke bekræftes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das GitHub-Repository konnte nicht verifiziert werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el acceso al repositorio de GitHub. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-tietovaraston käyttöoikeutta ei voitu vahvistaa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au dépôt GitHub n’a pas pu être vérifié. Veuillez réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לאמת את הגישה למאגר ב-GitHub. נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub रिपॉज़िटरी एक्सेस सत्यापित नहीं हो सका। कृपया फिर से प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub-tároló hozzáférését nem sikerült ellenőrizni. Próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses repositori GitHub tidak dapat diverifikasi. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l'accesso al repository GitHub. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub リポジトリへのアクセスを確認できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 저장소 접근 권한을 확인할 수 없습니다. 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgangen til GitHub-repositoriet kunne ikke bekreftes. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de GitHub-repository kon niet worden geverifieerd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować dostępu do repozytorium GitHub. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o acesso ao repositório do GitHub. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить доступ к репозиторию GitHub. Попробуйте ещё раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomsten till GitHub-arkivet kunde inte verifieras. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการเข้าถึงที่เก็บ GitHub ไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub depo erişimi doğrulanamadı. Lütfen yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити доступ до репозиторію GitHub. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh quyền truy cập kho lưu trữ GitHub. Vui lòng thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证 GitHub 仓库访问权限。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證 GitHub 儲存庫存取權。請再試一次。"
          }
        }
      }
    },
