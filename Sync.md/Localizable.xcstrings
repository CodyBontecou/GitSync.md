          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton non valide ou expiré. Signez et signez à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": טוקן לא תקין או שנסיים有效期. הורחайте ונסדרו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": अमान्य या समाप्त हुआ टोकन। बाहर निकलें और फिर से साइन इन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": Érvénytelen vagy lejáró token. Kijelentkezzen, majd újra bejelentkezzen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token tidak valid atau telah kedaluwarsa. Keluar dari akun dan masuk kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token non valido o scaduto. Disconnettati e accedi nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：無効または有効期限が切れたトークンです。サインアウトし、再びサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 무효 또는 만료된 토큰입니다. 로그아웃 후 다시 로그인해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ugyldig eller utløpt token. Logg ut og logg inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ongeldig of verlopen token. U kunt zich uitloggen en opnieuw inloggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": nieprawidłowy lub wygasły token. Wyloguj się i ponownie zaloguj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Token inválido ou expirado. Sair e fazer login novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Неверный или истёкший токен. Выходите и войдите в систему заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Okej eller utgått token. Logga ut och logga in igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": โทเคนไม่ถูกต้องหรือหมดอายุแล้ว กรุณาออกจากระบบและเข้าสู่ระบบอีกครั้ง"
