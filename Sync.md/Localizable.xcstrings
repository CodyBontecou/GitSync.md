    "Paste a GitHub token with repo access. It is stored in the Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رمز GitHub مع صلاحية repo. يُخزن في سلسلة المفاتيح."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt et GitHub-token med repo-adgang. Det gemmes i nøgleringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein GitHub-Token mit repo-Zugriff ein. Es wird im Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un token de GitHub con acceso repo. Se guarda en el llavero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä GitHub-tunnus, jolla on repo-oikeus. Se tallennetaan Avainnippuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un jeton GitHub avec l’accès repo. Il est stocké dans le trousseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו אסימון GitHub עם גישת repo. הוא נשמר במחזיק המפתחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "repo एक्सेस वाला GitHub टोकन पेस्ट करें। यह कीचेन में संग्रहीत होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illesszen be egy repo-hozzáférésű GitHub-tokent. A Kulcskarikában tárolódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel token GitHub dengan akses repo. Token disimpan di Rantai Kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un token GitHub con accesso repo. Viene salvato nel Portachiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "repo アクセス権のある GitHub トークンを貼り付けてください。キーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "repo 접근 권한이 있는 GitHub 토큰을 붙여 넣으십시오. 키체인에 저장됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn et GitHub-token med repo-tilgang. Det lagres i nøkkelringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een GitHub-token met repo-toegang. Het wordt bewaard in de sleutelhanger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej token GitHub z dostępem do repo. Jest przechowywany w pęku kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um token do GitHub com acesso a repo. Ele é armazenado nas Chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте токен GitHub с доступом repo. Он хранится в Связке ключей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in en GitHub-token med repo-åtkomst. Den lagras i nyckelringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางโทเคน GitHub ที่มีสิทธิ์ repo โทเคนจะถูกเก็บในพวงกุญแจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo erişimli bir GitHub token'ı yapıştırın. Anahtar Zinciri'nde saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте токен GitHub з доступом repo. Він зберігається в Зв’язці ключів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán token GitHub có quyền truy cập repo. Token được lưu trong Chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴具有 repo 访问权限的 GitHub 令牌。它将存储在钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上具備 repo 存取權的 GitHub 權杖。它會儲存在鑰匙圈中。"
          }
        }
      }
    },
