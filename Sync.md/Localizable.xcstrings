    "An active GitSync Assist subscription is required before automatic sync can be enabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشط GitSync Assist الاشتراك مطلوب قبل تمكين المزامنة التلقائية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv GitSync Assist Abonnement er påkrævet, før automatisk synkronisering kan aktiveres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv GitSync Assist Ein Abonnement ist erforderlich, bevor die automatische Synchronisation aktiviert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo GitSync Assist Se requiere una suscripción antes de poder activar la sincronización automática."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivinen GitSync Assist Aikaisempi tilauksen määrääminen on välttämätöntä, jotta automaattinen synkronointi voidaan käyttöönottaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif GitSync Assist Une abonnement est requise avant de pouvoir activer la synchronisation automatique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय GitSync Assist स्वचालित सिंकरेशन को सक्षम करने से पहले सदस्यता आवश्यक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktív GitSync Assist A automatikus szinkronizálás bekapcsolásához először előfizetésre van szükség."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif GitSync Assist Langganan diperlukan sebelum sinkronisasi otomatis dapat diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo GitSync Assist È necessaria un'abbonamento prima di poter attivare la sincronizzazione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブ GitSync Assist 自動同期機能を有効にするには、事前にサブスクリプションを購入する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 상태 GitSync Assist 자동 동기화 기능을 활성화하려면 구독이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
