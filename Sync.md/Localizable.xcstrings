            "state": "translated",
            "value": "Не удалось получить доступ к выбранной папке"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte få tillgång till den valda mappen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ไม่สามารถเข้าถึงโฟลเดอร์ที่เลือกได้"
          }
        },
        "tr": {
          "stringUnit": {
