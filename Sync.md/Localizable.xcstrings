        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소는 아직 복제되지 않았습니다.\n아래를 탭하여 다운로드하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
