    "Pull requires a merge because local and remote have diverged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدمج نظرًا لتباين المحلي والبعيد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull kræver en fletning, fordi lokal og ekstern er divergeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull erfordert eine Zusammenführung, da lokal und remote voneinander abweichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extracción requiere una combinación porque lo local y lo remoto han divergido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull vaatii yhdistämistä, koska paikallinen ja etäinen ovat erilaisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull nécessite une fusion parce que local et distant ont divergé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": הפעולה Pull דורשת שילוב, מכיוון שה состояния המקומי והremot differ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "के लिए मर्ज की आवश्यकता है, क्योंकि स्थानीय और दूरस्थ संस्थान अलग-अलग हो गए हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Pull\" operációhoz egy összevonás szükséges, mivel a helyi és távoli változatok eltérnek egymástól."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull memerlukan proses penggabungan karena versi lokal dan remote telah berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": il pull richiede una fusione poiché il locale e quello remoto sono divergenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "のPull操作では、ローカルとリモートが分岐しているため、マージが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull 작업은 로컬과 원격 저장소가 서로 다른 상태인 경우 병합이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull krever en merging fordi lokale og fjernere data er divergeret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": De pull-opdracht vereist een merge omdat de lokale en externe versies afwijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": operacja pull wymaga połączenia, ponieważ lokalny i odległy stan są różne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": A operação de pull requer uma fusão, pois os dados locais e remotos divergiram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": операция Pull требует слияния, поскольку локальный и удалённый репозитории не совпадают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull kräver en sammanföling eftersom den lokala och den fjärransvända versionen har skiljats åt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull จำเป็นต้องมีการรวมข้อมูล เนื่องจากข้อมูลที่ใช้ในระบบภายในและระบบระยะไกลแตกต่างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "çekme işlemi, yerel ve uzaktaki veriler farklılaşmış olduğundan birleşim gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": операція «Pull» вимагає злиття, оскільки локальний і дистанційний версії не збігаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Thao tác Pull yêu cầu hợp nhất vì dữ liệu tại cục bộ và từ xa đã khác biệt với nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取操作需要合并，因为本地与远程版本已出现差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取操作需要閤併，因爲本地與遠程版本已齣現差異。"
          }
        }
      }
    },
