            "value": ": Thao tác rebase phát sinh thêm các xung đột — hãy giải quyết chúng trước, sau đó tiếp tục thao tác rebase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重基操作存在更多冲突——请先解决这些冲突，再继续执行重基操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重基操作存在更多衝突——請先解決這些衝突，再繼續執行重基操作"
          }
        }
      }
    },
    "Rebase produced conflicts that require manual resolution.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنتجت Rebase تعارضات تتطلب حلاً يدويًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase producerede konflikter, der kræver manuel løsning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase erzeugte Konflikte, die eine manuelle Lösung erfordern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase produjo conflictos que requieren resolución manual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebase tuotetut konfliktit, jotka vaativat manuaalista ratkaisua."
          }
        },
        "fr": {
          "stringUnit": {
