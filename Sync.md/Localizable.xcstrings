    "ANY GIT REPO, SYNCED TO YOUR IPHONE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي GIT REPO، تتم مزامنته مع هاتف IPHONE الخاص بك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "ENHVER GIT REPO, SYNCERET TIL DIN IPHONE"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JEDES GIT-REPO, SYNCHRONISIERT MIT IHREM IPHONE"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CUALQUIER REPO DE GIT, SINCRONIZADO CON TU IPHONE"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "mikä tahansa GIT REPO, SYNCEDIN IPHONELLE"
          }
        },
