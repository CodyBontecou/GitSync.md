        }
      }
    },
    "Local edits detected. Commit, stash, or discard changes before pulling.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف تعديلات محلية. تنفيذ التغييرات أو تخزينها أو تجاهلها قبل السحب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale redigeringer fundet. Begå, gemme eller kassere ændringer, før du trækker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Bearbeitungen erkannt. Übernehmen Sie Änderungen, speichern Sie sie oder verwerfen Sie sie, bevor Sie sie abrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectaron ediciones locales. Confirme, guarde o descarte los cambios antes de realizarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset muokkaukset havaittu. Toimita, piilota tai hävitä muutokset ennen vetoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications locales détectées. Commettre, planquer ou rejeter les modifications avant de tirer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": נמצאו עריכות מקומיות – יש להאיץ, לשמור או למחוק את העריכות לפני הפעלת Pull."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्थानीय संशोधन पाए गए। पुलिंग से पहले परिवर्तनों को कमिट करें, स्टैश करें या डिस्कार्ड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": helyi módosítások kimutathatók. Először is alkalmazza a „commit\", „stash\" vagy „discard\" parancsot, mielőtt felvonom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Edisi lokal terdeteksi. Lakukan commit, stash, atau discard perubahan sebelum melakukan pull."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": sono state rilevate modifiche locali. Commetti, stacca o scarta le modifiche prima di eseguire il pull."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカル編集が検出されました。プル前に、コミット、スタッシュ、またはディスカインドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬에서 변경 사항이 감지되었습니다. 피드라인을 가져오기 전에 커밋, 스타시 또는 드리스드를 수행하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokale redigeringer er oppdaget. Følg en av følgende handlinger før du puller: commit, stash eller discard endringene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokale bewerkingen zijn gedetecteerd. Commit, stash of discard de wijzigingen voordat u pull uitvoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": wykryto lokalne modyfikacje. Zapisz zmiany, zarchiwuj je lub pominij zmiany przed pobraniem kodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Edições locais detectadas. Comita, armazene ou descarte as alterações antes de realizar o pull."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": обнаружены локальные изменения. Перед выполнением pull-операции необходимо сдать изменения в коммит, сохранить их или отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokala redigeringar upptäckts. Försök att bekräfta, förvara eller avstå från ändringar innan du pullar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ตรวจพบการแก้ไขในระบบภายใน — ควรดำเนินการ Commit, stash หรือ discard การเปลี่ยนแปลงก่อนทำการ pull"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel değişiklikler tespit edildi. Çekmeden önce değişiklikleri commit etmek, stash etmek veya discard etmek gerekebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Виявлено місцеві зміни. Перед виконанням pull-запиту варто захистити, зберегти або видалити ці зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Phát hiện các chỉnh sửa cục bộ. Hãy thực hiện commit, stash hoặc discard thay đổi trước khi pull."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：检测到本地修改。在拉取代码前，请先提交、暂存或丢弃这些更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：檢測到本地修改。在拉取代碼前，請先提交、暫存或丟棄這些更改。"
          }
        }
      }
    },
    "Local edits detected. Commit, stash, or discard changes before rebasing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف تعديلات محلية. تنفيذ التغييرات أو تخزينها أو تجاهلها قبل إعادة التأسيس."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale redigeringer fundet. Bekræft, gem eller kasser ændringer før rebasering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Bearbeitungen erkannt. Übernehmen, speichern oder verwerfen Sie Änderungen vor dem Rebasieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectaron ediciones locales. Confirme, guarde o descarte los cambios antes de cambiar la base."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset muokkaukset havaittu. Toimita, piilota tai hylkää muutokset ennen sijoitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications locales détectées. Commit, stash ou rejettent les modifications avant de rebaser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ": נמצאו עריכות מקומיות – יש להאשר, לשמור או למחוק את העריכות לפני إعادة הבסיס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ": स्थानीय संशोधन पाए गए। रीबेस करने से पहले परिवर्तनों को कमिट करें, स्टैश करें या डिस्कार्ड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ": helyi módosítások detektálva. Először is átirányítsa a módosításokat, majd hajtsa végre a commit-t, a stash-t vagy a discard-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": Ditemukan edisi lokal. Lakukan commit, stash, atau discard perubahan sebelum melakukan rebasing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": sono state rilevate modifiche locali. Commetti, stacca o scarta le modifiche prima di eseguire il rebase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：ローカル編集が検出されました。再ベースング前に、コミット、スタッシュ、またはディスカインドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 로컬 편집이 감지되었습니다. 리베이징 전에 변경 사항을 커밋, 스타시 또는 드리스드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokale redigeringer er oppdaget. Følg en av følgende retninger før du baserer på nytt: commit, stash eller discard endringene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokale bewerkingen zijn gedetecteerd. Bewaar de wijzigingen met commit, stash of verwijder ze voordat u de basis verlegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ": Znalezione lokalne modyfikacje. Zapisz zmiany, zarchiwuj je lub pominij zmiany przed ponownym podstawowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": Edições locais detectadas. Efetue o commit, o stash ou a descarte das alterações antes de realizar o rebase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": обнаружены локальные изменения. Перед повторным базированием необходимо выполнить коммит, стэш или отмену изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ": Lokala redigeringar upptäckts. Följ en av följande åtgärder innan du ombasar: kommitera, stasha eller avskaffa ändringarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": ตรวจพบการแก้ไขในระบบภายใน — ควรดำเนินการ Commit, stash หรือ discard การเปลี่ยนแปลงก่อนทำการ rebasing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ": Yerel değişiklikler tespit edildi. Yeniden basamağa geçmeden önce değişiklikleri commit etmek, stash etmek veya discard etmek gerekebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ": Виявлено місцеві зміни. Необхідно зафіксувати, зберегти або викинути зміни перед повторним базуванням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": Phát hiện các chỉnh sửa cục bộ. Hãy thực hiện commit, stash hoặc discard thay đổi trước khi thực hiện rebase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：检测到本地修改。在重新基线之前，请选择提交、暂存或丢弃这些更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：檢測到本地修改。在重新基線之前，請選擇提交、暫存或丟棄這些更改。"
          }
        }
      }
    },
