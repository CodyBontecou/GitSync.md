    "Manual Git, Shortcuts, callbacks, and local repository features stay included — Background Sync is entirely optional.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل ميزات Git اليدوية وShortcuts وعمليات رد الاتصال وميزات المستودعات المحلية متاحة — فـ Background Sync اختياري تمامًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuel Git, Shortcuts, callbacks og lokale arkivfunktioner er fortsat inkluderet — Background Sync er helt valgfrit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelles Git, Shortcuts, Callbacks und lokale Repository-Funktionen bleiben inbegriffen — Background Sync ist vollkommen optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones manuales de Git, Shortcuts, las devoluciones de llamada y las funciones de repositorios locales siguen incluidas — Background Sync es totalmente opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuaalinen Git, Shortcuts, takaisinkutsut ja paikallisten tietovarastojen ominaisuudet sisältyvät edelleen — Background Sync on täysin valinnainen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités manuelles de Git et de Shortcuts, les rappels et les fonctionnalités des dépôts locaux restent incluses — Background Sync est entièrement facultatif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Git ידני, Shortcuts, קריאות חוזרות ותכונות המאגר המקומי נשארים כלולים — Background Sync הוא אופציונלי לחלוטין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैन्युअल Git, Shortcuts, कॉलबैक और स्थानीय रिपॉज़िटरी सुविधाएँ शामिल रहती हैं — Background Sync पूरी तरह वैकल्पिक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kézi Git, a Shortcuts, a visszahívások és a helyi tárolófunkciók továbbra is az alkalmazás részei — a Background Sync teljesen opcionális."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Git manual, Shortcuts, callback, dan fitur repositori lokal tetap disertakan — Background Sync sepenuhnya opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git manuale, Shortcuts, callback e funzioni dei repository locali restano inclusi — Background Sync è del tutto facoltativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動の Git、Shortcuts、コールバック、ローカルリポジトリ機能は引き続き含まれます — Background Sync は完全に任意です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 Git, Shortcuts, 콜백 및 로컬 저장소 기능은 계속 포함됩니다 — Background Sync는 전적으로 선택 사항입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuell Git, Shortcuts, tilbakekall og lokale repositoriefunksjoner er fortsatt inkludert — Background Sync er helt valgfritt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handmatige Git, Shortcuts, callbacks en lokale repositoryfuncties blijven inbegrepen — Background Sync is volledig optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręczne operacje Git, Shortcuts, wywołania zwrotne i lokalne funkcje repozytorium pozostają dostępne — Background Sync jest całkowicie opcjonalny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Git manual, Shortcuts, callbacks e recursos de repositório local continuam incluídos — o Background Sync é totalmente opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручные операции Git, Shortcuts, обратные вызовы и локальные функции репозитория остаются доступными — Background Sync полностью необязателен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuell Git, Shortcuts, återanrop och lokala arkivfunktioner ingår fortfarande — Background Sync är helt valfritt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Git แบบดำเนินการเอง, Shortcuts, การเรียกกลับ และฟีเจอร์คลังในเครื่องยังคงรวมอยู่ — Background Sync เป็นทางเลือกทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuel Git, Shortcuts, geri çağırmalar ve yerel depo özellikleri dahil olmaya devam eder — Background Sync tamamen isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручна робота з Git, Shortcuts, зворотні виклики та локальні функції репозиторіїв залишаються включеними — Background Sync цілком необов’язковий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git thủ công, Shortcuts, lệnh gọi lại và các tính năng kho lưu trữ cục bộ vẫn được bao gồm — Background Sync hoàn toàn không bắt buộc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动 Git、Shortcuts、回调和本地仓库功能仍包含在内 — Background Sync 完全可选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動 Git、Shortcuts、回呼和本機儲存庫功能仍包含在內 — Background Sync 完全可選用。"
          }
        }
      }
    },
    "Mark as resolved?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تم تحديد الحل؟\nلم ينتج عن تحليل الدمج"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markere som løst?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gelöst markieren?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Marcar como resuelto?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark kuten ratkaistu?"
          }
