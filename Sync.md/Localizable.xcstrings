    "Clone this repository to enable automatic sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استنساخ هذا المستودع لتمكين المزامنة التلقائية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier dette repository for at aktivere automatisk synkronisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonieren Sie dieses Repository, um die automatische Synchronisation zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona este repositorio para habilitar la sincronización automática."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloonaa tämä tallennusjärjestelmä käytännössä automaattisen synkronoinnin käyttöönottoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clonez ce répertoire pour activer la synchronisation automatique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित सिंक्रनाइज़ेशन सक्षम करने के लिए इस रिपॉजिटरी को क्लोन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloneálja ezt a repositoryt az automatikus szinkronizálás beállításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonikan repositori ini untuk mengaktifkan sinkronisasi otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona questo repository per attivare la sincronizzazione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリをクローンすることで、自動同期を有効にできます。"
          }
        },
        "ko": {
