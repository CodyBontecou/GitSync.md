        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": Управление GitHub вход: токен,\nКлюч SSH или публичный доступ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användning GitHub inloggning, ett token, en SSH -säkerhetsnyckel eller offentlig åtkomst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้งาน GitHub : การเข้าสู่ระบบ, โทเคน, และอื่นๆ SSH คีย์ หรือการเข้าถึงสาธารณะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
